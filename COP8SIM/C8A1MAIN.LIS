   1                     #crossref
   2                     #noformfeed
   3                     #noheadings
   4                              .TITLE  c8a1main,'Simple Multi-Module COP8 As
   5                              .LIST   X'FF             ;complete listing
   6                              .CONTRL 0                ;disable all code al
   7                              .CHIP   840              ;(doesn't really mat
   8                     ;        .MAXROM X'0FFF
   9                     ;=====================================================
  10                     ; Output a pulse pattern on bit/pin 0 of PORTD
  11                     ;=====================================================
  12                              .INCLD C8A1INC.INC       ;Equates, Variables
                         ;File:  C8A1INC.INC

                         ; Bit Definitions
          0000           outbit   =     0                  ;Bit #0 in PORTD
          0001           outmsk   =     X'01               ;Mask for Bit #0 in

                         ; Register Definitions
          00DC           PORTD    =     X'DC               ;standard PORTD regi

                         ; Register Variable Definitions
     0000                         .SECT    reg_variables,REG,COMMON
     0000                r0:      .dsb     1                 ;=     X'F0
     0001                tmpcnt:  .dsb     1                 ;=     X'F1
     0002                trpcnt:  .dsb     1                 ;=     X'F2
     0000                         .ENDSECT
  13                     ;=====================================================
  14 0000                         .SECT  code,ROM
  15                              .EXTRN spin
  16 0000 DD2F      3    reset:   LD    SP,#X'2F           ;(make it work on al
  17 0002 D2FF      3 R  start:   LD    trpcnt,#X'FF       ;
  18 0004 BDDC68    4    outer:     RBIT  outbit,PORTD     ;outbit <- 0  ------
  19 0007 D10A      3 R             LD    tmpcnt,#10       ;
  20 0009 3000      5 X  inner:       JSR   spin           ;-------------------
  21 000B 9DDC      3                 LD    A,PORTD        ;Complement
  22 000D 9601      2                 XOR   A,#outmsk      ;  bit #0
  23 000F 9CDC      3                 X     A,PORTD        ;  in PORTD
  24 0011 5F        1                 LD    B,#0           ;B register reflects
  25 0012 BDDC70    4                 IFBIT outbit,PORTD   ;  current state of
  26 0015 5E        1                 LD    B,#1           ;  'outbit' in PORTD
  27 0016 C1        3 R               DRSZ  tmpcnt         ;
  28 0017 F1        3                 JP    inner          ;-------------------
  29 0018 C2        3 R             DRSZ  trpcnt           ;tripcnt--,
  30 0019 B8        1               NOP                    ;  and nothing more
  31 001A 3000      5 X             JSR   spin             ;
  32 001C 3000      5 X             JSR   spin             ;
  33 001E E5        3               JP    outer            ;
  34 001F 2002      3 R  endprg:  JMP   start              ;-------------------
  35                     ;=================================;
  36 0021                         .END  reset              ;program starting ad





