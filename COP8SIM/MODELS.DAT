%<HELP>	#.sp 2
%<HELP>	#\bEMULATOR BASE & PROBE CARD CATALOG\r
%<HELP>	#.sp 1
%<HELP>	#Effective:  1995 September 15
%<HELP>	#.sp 1
%<HELP>	#.ba {
%<HELP>	#******************
%<HELP>	#* Emulator Bases *
%<HELP>	#******************
%<HELP>	#.ea }
%<HELP>	#.sp 1
%<HELP>	#\b%rs1-MCS251 Modular Emulators\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#All \b%rs1-MCS251 Modular\r 400 emulators support
%<HELP>	#full probe card interchangeability within the Intel MCS251
%<HELP>	#family of devices.
%<HELP>	#To emulate several different devices, you need purchase only a single
%<HELP>	#emulator base unit and then one probe card for each unique device
%<HELP>	#or group of devices to be emulated.
%<HELP>	#.sp 1
%<HELP>	#The %rs1-MCS251 emulator comes with 256Kb of emulation memory
%<HELP>	#and a 16K-Frame Trace Buffer (which can be viewed during emulation).
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#.ba {
%<HELP>	#***************
%<HELP>	#* Probe Cards *
%<HELP>	#***************
%<HELP>	#.ea }
%<HELP>	#.sp 1
%<HELP>	#All %rs2 %rs1 probe cards include a Break-Input signal clip,
%<HELP>	#a Trigger-Output signal clip and eight user-placeable
%<HELP>	#Trace-Capture-Input signal clips.
%<HELP>	#Most probe cards have
%<HELP>	#user-selectable jumpers to control/configure the
%<HELP>	#unique capabilities of each particular device.
%<HELP>	#\b%rs1\r \ufully\r supports:
%<HELP>	#.sp 1
%<HELP>	#.in +4 {
%<HELP>	#.in +3 {
%<HELP>	#.ti -3
%<HELP>	#\x07^^All I/O ports, with no restrictions.
%<HELP>	#.sp 1
%<HELP>	#.ti -3
%<HELP>	#\x07^^The Power Down (Sleep and Standby) modes of operation,
%<HELP>	#in those devices having such capabilities.
%<HELP>	#.sp 1
%<HELP>	#.ti -3
%<HELP>	#\x07^^The Watchdog Timer (WDT),
%<HELP>	#in those devices having such a capability.
%<HELP>	#.in -3 }
%<HELP>	#.in -4 }
%<HELP>	#.sp 1
%<HELP>	#Following is a list of all Intel MCS251 Probe Cards which %rs2
%<HELP>	#currently offers.
%<HELP>	#Since %rs2 is constantly adding to its list of supported devices,
%<HELP>	#please contact %rs2 for information on any device not listed below.
%<HELP>	#.sp 2
%<HELP>	#.ba {
%<HELP>	#\b========== %rs1-MCS251 Modular Emulator Base ==========\r
%<HELP>	#.ea }
%<HELP>	#.sp 1
%<HELP>	#If support for a particular device is available in different
%<HELP>	#packages, the description of the Probe Card appears only once,
%<HELP>	#with the packaging variations listed before the description.
%<HELP>	#.sp 1
%<HELP>	#.ba {
%<HELP>	#\b8XC251SB^^^^^^44-lead^PLCC^^^^^^^^0.5-16MHz,^5V^^Probe Card\r
%<HELP>	#.ea }
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#The Intel MCS251 8XC251SB Probe Card supports device operation
%<HELP>	#from 0.5 to 16.0MHz XTAL.  This probe card supports the following
%<HELP>	#MCS251 devices:  83C251SB, 87C251SB and 80C251SB.
%<HELP>	#.in -2 }
%<HELP>	#.($552)Catalog of iceMASTER 78xxx Products
%<HELP>	#.sp 1
%<HELP>	#.in +3 {
%<HELP>	#.ti -3
%<HELP>	#\b%rs1-K4 Modular Emulator\r:
%<HELP>	#.sp 1
%<HELP>	#The %rs2 \b%rs1-K4 Modular\r emulator supports the
%<HELP>	#NEC K4 family of devices.
%<HELP>	#The \b%rs1-K4 Modular\r emulator consists of a small
%<HELP>	#emulator base unit,
%<HELP>	#attached to a small probe card (pod) via an umbilical cable.
%<HELP>	#The probe card, which contains the device being emulated,
%<HELP>	#inserts into the socket for the device in your target
%<HELP>	#development system.  Probe cards are available supporting the entire
%<HELP>	#NEC K4 family.
%<HELP>	#The emulator base unit connects to the
%<HELP>	#host PC (personal computer) via either a standard bi-directional
%<HELP>	#parallel port, or a standard RS-232-C serial
%<HELP>	#communications link operating at 57.6K baud.
%<HELP>	#.sp 1
%<HELP>	#The \b%rs1-K4 Modular\r emulator is an advanced,
%<HELP>	#high-performance, full-featured, economical,
%<HELP>	#small profile/footprint emulator supporting
%<HELP>	#full probe card interchangeability within the NEC K4 family.
%<HELP>	#.in -3 }
%<HELP>	#.sp 2
