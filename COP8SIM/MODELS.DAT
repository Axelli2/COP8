%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#.ba {
%<HELP>	#Feature/Attribute              Size/Range/Presence
%<HELP>	#------------------------------ -------------------
%<HELP>	#Emulation Memory
%<HELP>	#  Program/Data                 32K
%<HELP>	#Real Time Operating Freq.      DC-4.0MHz XTAL
%<HELP>	#Code Break-points              32K
%<HELP>	#Write Access Break-points      64K
%<HELP>	#Write Protect Break-points     64K
%<HELP>	#Trace-On-points                64K
%<HELP>	#Trace-Off-points               64K
%<HELP>	#Trigger Conditions
%<HELP>	#  PC address & range           X
%<HELP&CBE>	#  Opcode Value                 X
%<HELP&CBE>	#  Opcode Class                 X
%<HELP&CBE>	#  Registers/SFRs               X
%<HELP&CBE>	#  Direct byte address & range  X
%<HELP&CBE>	#  Extended address & range     X
%<HELP&CBE>	#  Immediate operand value      X
%<HELP&CBE>	#  Read/Write to bit address    X
%<HELP&CBE>	#  Register addressing modes    X
%<HELP&CBE>	#  Read/Write to Register addr  X
%<HELP&CBE>	#  Logical AND/OR of the above  X
%<HELP>	#  Break Count overflow         X
%<HELP>	#  External input               X
%<HELP>	#Operating Mode
%<HELP>	#  Single-Chip/ROM              X
%<HELP>	#Max # of Main Screen Windows
%<HELP>	#  Memory (as Data)             5
%<HELP>	#.ea }
%<HELP>	#.in -2 }
%<HELP>	#.sp 2
%<HELP>	#\bEMULATOR BASE & PROBE CARD CATALOG\r
%<HELP>	#.sp 1
%<HELP>	#Effective:  1995 September 15
%<HELP>	#.sp 1
%<HELP>	#.ba {
%<HELP>	#******************
%<HELP>	#* Emulator Bases *
%<HELP>	#******************
%<HELP>	#.ea }
%<HELP>	#.sp 1
%<HELP>	#\b%rs1-68HC05 Modular Model 200 & Model 400 Emulators\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#All \b%rs1-68HC05 Modular\r Model 200 & Model 400 emulators support
%<HELP>	#full probe card interchangeability.
%<HELP>	#To emulate several different devices, you need purchase only a single
%<HELP>	#emulator base unit for the 68HC05 architecture and then one probe card
%<HELP>	#for each unique 68HC05 family derivative device to be emulated.
%<HELP>	#.sp 1
%<HELP>	#Every %rs1-68HC05 Modular Model 200 and Model 400
%<HELP>	#emulator comes with 32K of emulation memory.
%<HELP>	#.sp 1
%<HELP>	#The \b%rs1-68HC05^Modular^Model^400\r emulator has the following
%<HELP>	#additional features/capabilities (beyond those in a Model 200):
%<HELP>	#.sp 1
%<HELP>	#.in +4 {
%<HELP>	#.in +4 {
%<HELP>	#.ti -4
%<HELP>	#1.^^4K-Frame Trace Buffer
%<HELP>	#.ti -4
%<HELP>	#2.^^Performance Analyzers
%<HELP>	#.in +4 {
%<HELP>	#.ti -4
%<HELP>	#a.^^High Resolution
%<HELP>	#.ti -4
%<HELP>	#b.^^High Bin Count
%<HELP>	#.in -4 }
%<HELP>	#.ti -4
%<HELP>	#3.^^Full Watchdog Timer (WDT) Support in all emulation modes
%<HELP>	#.in -4 }
%<HELP>	#.in -4 }
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#.ba {
%<HELP>	#***************
%<HELP>	#* Probe Cards *
%<HELP>	#***************
%<HELP>	#.ea }
%<HELP>	#.sp 1
%<HELP>	#All %rs2 %rs1 probe cards include a Break-Input signal clip,
%<HELP>	#a Trigger-Output signal clip and seven user-placeable
%<HELP>	#Trace-Capture-Input signal clips.  In addition, there
%<HELP>	#is a user-selectable jumper/control for XTAL source.
%<HELP>	#Most probe cards have other
%<HELP>	#user-selectable jumpers to control/configure the
%<HELP>	#unique capabilities of each particular device.
%<HELP>	#Some probe cards also contain a user-selectable jumper for Vcc source.
%<HELP>	#\b%rs1\r \ufully\r supports:
%<HELP>	#.sp 1
%<HELP>	#.in +4 {
%<HELP>	#.in +3 {
%<HELP>	#.ti -3
%<HELP>	#\x07^^All I/O ports, with no restrictions.
%<HELP>	#.sp 1
%<HELP>	#.ti -3
%<HELP>	#\x07^^The CMOS Idle and Power Down (Halt) modes of operation,
%<HELP>	#in those devices having such capabilities.
%<HELP>	#.sp 1
%<HELP>	#.ti -3
%<HELP>	#\x07^^The Watchdog Timer (WDT),
%<HELP>	#in those devices having such a capability.
%<HELP>	#(\b%rs1 Model 400\r only)
%<HELP>	#.in -3 }
%<HELP>	#.in -4 }
%<HELP>	#.sp 1
%<HELP>	#Following is a list of all 68HC05 Probe Cards which %rs2
%<HELP>	#currently offers.
%<HELP>	#Since %rs2 is constantly adding to its list of supported devices,
%<HELP>	#please contact %rs2 for information on any device not listed below.
%<HELP>	#.sp 2
%<HELP>	#.ba {
%<HELP>	#\b========== %rs1-68HC05 Modular Emulator Base ==========\r
%<HELP>	#.ea }
%<HELP>	#.sp 1
%<HELP>	#If support for a particular device is available in different
%<HELP>	#packages, the description of the Probe Card appears only once,
%<HELP>	#with the packaging variations listed before the description.
%<HELP>	#.sp 1
%<HELP>	#.ba {
%<HELP>	#\b68HC05C9^^40-lead^DIP^^^0.5-4.0MHz^^Probe Card\r
%<HELP>	#.sp 0
%<HELP>	#\b68HC05C9^^44-lead^PLCC^^0.5-4.0MHz^^Probe Card\r
%<HELP>	#.ea }
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#The 68HC05C9 Mode Probe Cards support device operation
%<HELP>	#from 0.5 to 4.0MHz XTAL.
%<HELP>	#Each of these probe cards supports
%<HELP>	#the following devices:  68HC05C9 and 68HC705C9.
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#.ba {
%<HELP>	#\b68HC05C8^^40-lead^DIP^^^0.5-4.0MHz^^Probe Card\r
%<HELP>	#.sp 0
%<HELP>	#\b68HC05C8^^44-lead^PLCC^^0.5-4.0MHz^^Probe Card\r
%<HELP>	#.ea }
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#The 68HC05C8 Mode Probe Cards support device operation
%<HELP>	#from 0.5 to 4.0MHz XTAL.
%<HELP>	#Each of these probe cards supports
%<HELP>	#the following devices:  68HC05C2, 68HC05C3, 68HC05C4, 68HC05C8
%<HELP>	#and 68HC705C8.
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#.ba {
%<HELP>	#\b68HC05C4^^40-lead^DIP^^^0.5-4.0MHz^^Probe Card\r
%<HELP>	#.sp 0
%<HELP>	#\b68HC05C4^^44-lead^PLCC^^0.5-4.0MHz^^Probe Card\r
%<HELP>	#.ea }
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#The 68HC05C4 Mode Probe Cards support device operation
%<HELP>	#from 0.5 to 4.0MHz XTAL.
%<HELP>	#Each of these probe cards supports
%<HELP>	#the following devices:  68HC05C2, 68HC05C3, 68HC05C4 and 68HC805C4.
%<HELP>	#.in -2 }
%<HELP>	#.($545)Catalog of iceMASTER nX65K Products
%<HELP>	#.sp 1
%<HELP>	#.in +3 {
%<HELP>	#.ti -3
%<HELP>	#\b%rs1-nX65K Modular Emulator\r:
%<HELP>	#.sp 1
%<HELP>	#The %rs2 \b%rs1-nX65K Modular\r emulator supports the
%<HELP>	#OKI nX65K family of devices.
%<HELP>	#The \b%rs1-nX65K Modular\r emulator consists of a small
%<HELP>	#emulator base unit,
%<HELP>	#attached to a small probe card (pod) via an umbilical cable.
%<HELP>	#The probe card, which contains the device being emulated,
%<HELP>	#inserts into the socket for the device in your target
%<HELP>	#development system.  Probe cards are available supporting the entire
%<HELP>	#OKI nX65K family.
%<HELP>	#The emulator base unit connects to the
%<HELP>	#host PC (personal computer) via a standard RS-232-C serial
%<HELP>	#communications link operating at 57.6K baud.
%<HELP>	#.sp 1
%<HELP>	#The \b%rs1-nX65K Modular\r emulator is an advanced,
%<HELP>	#high-performance, full-featured, economical,
%<HELP>	#small profile/footprint emulator supporting
%<HELP>	#full probe card interchangeability within the OKI nX65K family.
%<HELP>	#.in -3 }
%<HELP>	#.sp 2
