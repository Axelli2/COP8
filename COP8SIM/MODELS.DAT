%<HELP>	#.sp 2
%<HELP>	#\bEMULATOR BASE & PROBE CARD CATALOG\r
%<HELP>	#.sp 1
%<HELP>	#Effective:  1995 September 15
%<HELP>	#.sp 1
%<HELP>	#.ba {
%<HELP>	#******************
%<HELP>	#* Emulator Bases *
%<HELP>	#******************
%<HELP>	#.ea }
%<HELP>	#.sp 1
%<HELP>	#\b%rs1-68HC11 Modular Model 200 & Model 400 Emulators\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#All \b%rs1-68HC11 Modular\r Model 200 & Model 400 emulators support full
%<HELP>	#probe card interchangeability.
%<HELP>	#To emulate several different devices, you need purchase only a single
%<HELP>	#emulator base unit for the 68HC11 architecture and then one probe card
%<HELP>	#for each unique 68HC11 family derivative device to be emulated.
%<HELP>	#.sp 1
%<HELP>	#Every %rs1-68HC11 Modular Model 200 and Model 400
%<HELP>	#emulator comes with 64K of emulation memory.
%<HELP>	#.sp 1
%<HELP>	#The \b%rs1-68HC11^Modular^Model^400\r emulator has the following
%<HELP>	#additional features/capabilities (beyond those in a Model 200):
%<HELP>	#.sp 1
%<HELP>	#.in +4 {
%<HELP>	#.in +4 {
%<HELP>	#.ti -4
%<HELP>	#1.^^4K-Frame Trace Buffer
%<HELP>	#.ti -4
%<HELP>	#2.^^Performance Analyzers
%<HELP>	#.in +4 {
%<HELP>	#.ti -4
%<HELP>	#a.^^High Resolution
%<HELP>	#.ti -4
%<HELP>	#b.^^High Bin Count
%<HELP>	#.in -4 }
%<HELP>	#.ti -4
%<HELP>	#3.^^Full Watchdog Timer (WDT) Support in all emulation modes
%<HELP>	#.in -4 }
%<HELP>	#.in -4 }
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#.ba {
%<HELP>	#***************
%<HELP>	#* Probe Cards *
%<HELP>	#***************
%<HELP>	#.ea }
%<HELP>	#.sp 1
%<HELP>	#All %rs2 %rs1 probe cards include a Break-Input signal clip,
%<HELP>	#a Trigger-Output signal clip and seven user-placeable
%<HELP>	#Trace-Capture-Input signal clips.  In addition, there
%<HELP>	#is a user-selectable jumper/control for XTAL source.
%<HELP>	#Most probe cards have other
%<HELP>	#user-selectable jumpers to control/configure the
%<HELP>	#unique capabilities of each particular device.
%<HELP>	#Some probe cards also contain a user-selectable jumper for Vcc source.
%<HELP>	#\b%rs1\r \ufully\r supports:
%<HELP>	#.sp 1
%<HELP>	#.in +4 {
%<HELP>	#.in +3 {
%<HELP>	#.ti -3
%<HELP>	#\x07^^All I/O ports, with no restrictions.
%<HELP>	#.sp 1
%<HELP>	#.ti -3
%<HELP>	#\x07^^The CMOS Idle and Power Down (Halt) modes of operation,
%<HELP>	#in those devices having such capabilities.
%<HELP>	#.sp 1
%<HELP>	#.ti -3
%<HELP>	#\x07^^The Watchdog Timer (WDT),
%<HELP>	#in those devices having such a capability.
%<HELP>	#(\b%rs1 Model 400\r only)
%<HELP>	#.in -3 }
%<HELP>	#.in -4 }
%<HELP>	#.sp 1
%<HELP>	#Following is a list of all 68HC11 Probe Cards which %rs2
%<HELP>	#currently offers.
%<HELP>	#Since %rs2 is constantly adding to its list of supported devices,
%<HELP>	#please contact %rs2 for information on any device not listed below.
%<HELP>	#.sp 2
%<HELP>	#.ba {
%<HELP>	#\b========== %rs1-68HC11 Modular Emulator Base ==========\r
%<HELP>	#.ea }
%<HELP>	#.sp 1
%<HELP>	#If support for a particular device is available in different
%<HELP>	#packages and/or maximum clock frequencies (MHz E-Clock),
%<HELP>	#the description of the
%<HELP>	#Probe Card appears only once, with the packaging and speed
%<HELP>	#variations listed before the description.
%<HELP>	#.sp 1
%<HELP>	#.ba {
%<HELP>	#\bHC11^A0/A1^Expanded^Mode^^48-lead^DIP^^^0.5-2.1MHz^E^^Probe Card\r
