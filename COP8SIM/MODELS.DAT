%<HELP>	#.ba {
%<HELP>	#0.5lbs   0.3kg
%<HELP>	#.ea }
%<HELP>	#.in -2 }
%<HELP>	#.in -2 }
%<HELP>	#.in -2 }
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#\bWarranty\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#One (1) year limited warranty, parts and labor.
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#\bHost Computer\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#.in +2 {
%<HELP>	#.ti -2
%<HELP>	#IBM PC or a fully-compatible PC clone
%<HELP>	#.ti -2
%<HELP>	#1 5\xAC" 1.2Mb or 1 3.5" 1.44Mb floppy diskette drive
%<HELP>	#.ti -2
%<HELP>	#1 hard disk drive
%<HELP>	#.ti -2
%<HELP>	#640K bytes of memory
%<HELP>	#.ti -2
%<HELP>	#Standard RS-232-C serial communication interface board
%<HELP>	#.ti -2
%<HELP>	#PC-DOS or MS-DOS Version 3.1 or later
%<HELP>	#.in -2 }
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#\b%rs1-8051 Modular Emulators:\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#.ba {
%<HELP>	#Feature/Attribute              Size/Range/Presence
%<HELP>	#------------------------------ -------------------
%<HELP>	#Emulation Memory
%<HELP>	#  Program                      64K
%<HELP>	#  External Data                64K
%<HELP>	#Mapping Resolution
%<HELP>	#  Program       (bytes/block)  16
%<HELP>	#  External Data (bytes/block)  16
%<HELP>	#Real Time Operating Freq.      0.5-24MHz
%<HELP>	#Code Break-points              64K
%<HELP>	#External Data Break-points     64K
%<HELP>	#Trace-On-points                64K
%<HELP>	#Trace-Off-points               64K
%<HELP>	#Trigger Conditions
%<HELP>	#  PC address & range           X
%<HELP&CBE>	#  Opcode Value                 X
%<HELP&CBE>	#  Opcode Class                 X
%<HELP&CBE>	#  Registers/SFRs               X
%<HELP&CBE>	#  Direct byte address & range  X
%<HELP&CBE>	#  Direct bit address & range   X
%<HELP&CBE>	#  Immediate operand value      X
%<HELP&CBE>	#  Read/Write to bit address    X
%<HELP&CBE>	#  Register addressing modes    X
%<HELP&CBE>	#  Read/Write to Register addr  X
%<HELP&CBE>	#  Logical AND/OR of the above  X
%<HELP>	#  External Data addr & range   X
%<HELP>	#  Break Count overflow         X
%<HELP>	#  External input               X
%<HELP>	#Operating Mode
%<HELP>	#  Single-Chip/ROM              X
%<HELP>	#  Expanded-Chip/ROMless        X
%<HELP>	#Max # of Main Screen Windows
%<HELP>	#  Internal Data Memory         5
%<HELP>	#  External Data Memory         5
%<HELP>	#  Code Memory Memory           5
%<HELP>	#.ea }
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#\b%rs1-PE Integrated and %rs1-HSM Modular Emulators:\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#.ba {
%<HELP>	#Feature/Attribute              Size/Range/Presence
%<HELP>	#------------------------------ -------------------
%<HELP>	#Emulation Memory
%<HELP>	#  Program                      64K
%<HELP>	#  External Data                64K
%<HELP>	#Mapping Resolution
%<HELP>	#  Program       (bytes/block)  down to 1
%<HELP>	#  External Data (bytes/block)  down to 1
%<HELP>	#Real Time Operating Freq.      DC-42MHz (%rs1-PE Integrated)
%<HELP>	#                               DC-33MHz (%rs1-HSM Modular)
%<HELP>	#Code Break-points              64K
%<HELP>	#External Data Break-points     up to 64K
%<HELP>	#Trace-On-points                up to 64K
%<HELP>	#Trace-Off-points               up to 64K
%<HELP>	#Pass-Count-points              up to 64K
%<HELP>	#Trigger Conditions
%<HELP>	#  PC address & range           X
%<HELP&CBE>	#  Opcode Value                 X
%<HELP&CBE>	#  Opcode Class                 X
%<HELP&CBE>	#  Registers/SFRs               X
%<HELP&CBE>	#  Direct byte address & range  X
%<HELP&CBE>	#  Direct bit address & range   X
%<HELP&CBE>	#  Immediate operand value      X
%<HELP&CBE>	#  Read/Write to bit address    X
%<HELP&CBE>	#  Register addressing modes    X
%<HELP&CBE>	#  Read/Write to Register addr  X
%<HELP&CBE>	#  Logical AND/OR of the above  X
%<HELP>	#  External Data addr & range   X
%<HELP>	#  Break Count overflow         X
%<HELP>	#  Pass Count overflow          X
%<HELP>	#  External input               X
%<HELP>	#Operating Mode
%<HELP>	#  Single-Chip/ROM              X
%<HELP>	#  Expanded-Chip/ROMless        X
%<HELP>	#Max # of Main Screen Windows
%<HELP>	#  Internal Data Memory         5
%<HELP>	#  External Data Memory         5
%<HELP>	#  Code Memory Memory           5
%<HELP>	#.ea }
%<HELP>	#.in -2 }
%<HELP>	#.sp 2
%<HELP>	#\bEMULATOR BASE & PROBE CARD CATALOG\r
%<HELP>	#.sp 1
%<HELP>	#Effective:  1995 September 15
%<HELP>	#.sp 1
%<HELP>	#.ba {
%<HELP>	#******************
%<HELP>	#* Emulator Bases *
%<HELP>	#******************
%<HELP>	#.ea }
%<HELP>	#.sp 1
%<HELP>	#\b%rs1-8051 Modular Model 200 & Model 400 Emulators\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#All \b%rs1-8051 Modular\r Model 200 & Model 400 emulators support full
%<HELP>	#probe card interchangeability.
%<HELP>	#To emulate several different devices, you need purchase only a single
%<HELP>	#emulator base unit for the 8051 architecture and then one probe card
%<HELP>	#for each unique 8051 family derivative device to be emulated.
%<HELP>	#.sp 1
%<HELP>	#Every %rs1-8051 Modular Model 200 and Model 400
%<HELP>	#emulator comes with 64K of Code memory and 64K of External Data
%<HELP>	#memory.
%<HELP>	#.sp 1
%<HELP>	#The \b%rs1-8051^Modular^Model^400\r emulator has the following
%<HELP>	#additional features/capabilities (beyond those in a Model 200):
%<HELP>	#.sp 1
%<HELP>	#.in +4 {
%<HELP>	#.in +4 {
%<HELP>	#.ti -4
%<HELP>	#1.^^4K-Frame Trace Buffer
%<HELP>	#.ti -4
%<HELP>	#2.^^Performance Analyzers
%<HELP>	#.in +4 {
%<HELP>	#.ti -4
%<HELP>	#a.^^High Resolution
%<HELP>	#.ti -4
%<HELP>	#b.^^High Bin Count
%<HELP>	#.in -4 }
%<HELP>	#.ti -4
%<HELP>	#3.^^Full Watchdog Timer (WDT) Support in all emulation modes
%<HELP>	#.in -4 }
%<HELP>	#.in -4 }
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#\b%rs1-PE Integrated Model 200 & Model 400 Emulators\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#The \b%rs1-PE Integrated\r emulators for selected members
%<HELP>	#of the 8051 family are self-contained
%<HELP>	#units, each dedicated to a particular member of the 8051 family.
%<HELP>	#The emulator and probe card electronics are combined into a single,
%<HELP>	#small package.  Every %rs1-PE Integrated Model 200
%<HELP>	#and %rs1-PE Integrated Model 400
%<HELP>	#emulator comes with 64K of Code memory and 64K of External Data
%<HELP>	#memory and full Watchdog Timer (WDT) Support.
%<HELP>	#.sp 1
%<HELP>	#The \b%rs1-PE Integrated Model 400\r emulator has the following
%<HELP>	#additional
%<HELP>	#features/capabilities (beyond those in a Model 200):
%<HELP>	#.sp 1
%<HELP>	#.in +4 {
%<HELP>	#.in +4 {
%<HELP>	#.ti -4
%<HELP>	#1.^^16K-Frame Trace Buffer (which can be viewed during emulation)
%<HELP>	#.ti -4
%<HELP>	#2.^^High Bin Count Performance Analyzer
%<HELP>	#.in -4 }
%<HELP>	#.in -4 }
%<HELP>	#.sp 1
%<HELP>	#The following \b%rs1-PE Integrated\r emulators are currently available:
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#.in +2 {
%<HELP>	#.ti -2
%<HELP>	#\bPE-8032/200-24\r
%<HELP>	#.ti -2
%<HELP>	#\bPE-8032/400-24\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#These emulators support device operation from 3.5 to 24MHz
%<HELP>	#and have a 40-lead DIP footprint and supports the 8031,
%<HELP>	#80C31, 8032 and 80C32 devices from any IC manufacturer,
%<HELP>	#regardless of process variation.
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#.ti -2
%<HELP>	#\bPE-8032/200-42\r
%<HELP>	#.ti -2
%<HELP>	#\bPE-8032/400-42\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#This emulator supports device operation from 0.5 to 42MHz and has
%<HELP>	#a 40-lead DIP footprint.  This emulator supports the 8031,
%<HELP>	#80C31, 8032, 80C32 and C501 devices from any IC manufacturer,
%<HELP>	#regardless of process variation.
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#.ti -2
%<HELP>	#\bPE-8351FX/200-16\r
%<HELP>	#.ti -2
%<HELP>	#\bPE-8351FX/400-16\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#This emulator supports device operation from 3.5 to 16MHz and has
%<HELP>	#a 40-lead DIP footprint.  This emulator supports the 8031,
%<HELP>	#80C31, 8032, 80C32, 8051, 80C51, 8751, 87C51, 80C51FA, 83C51FA,
%<HELP>	#87C51FA, 83C51FB, 87C51FB, 87C51FC (with some limitations), 8052,
%<HELP>	#80C52, 8752, 87C52, 83C54, 87C54, 83C58 and 87C58 devices from any IC
%<HELP>	#manufacturer, regardless of process variation.
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#.ti -2
%<HELP>	#\bPE-83752/200-16\r
%<HELP>	#.ti -2
%<HELP>	#\bPE-83752/400-16\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#This emulator supports device operation from DC to 16MHz and has
%<HELP>	#a 28-lead DIP footprint.  This emulator supports the 87C750, 83C751,
%<HELP>	#87C751, 83C752 and 87C752 devices from any IC manufacturer,
%<HELP>	#regardless of process variation.
%<HELP>	#This emulator is supplied with a 28-lead DIP to 24-lead DIP converter
%<HELP>	#(CONV11) for 8xC751 support.
%<HELP>	#.in -2 }
%<HELP>	#.in -2 }
%<HELP>	#.in -2 }
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#\b%rs1-HSM Modular Model 200 & Model 400 Emulators\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#All \b%rs1-HSM Modular\r Model 200 & Model 400 emulators support
%<HELP>	#full probe card interchangeability within the Dallas High Speed Micro
%<HELP>	#(HSM) family.
%<HELP>	#To emulate several different devices, you need purchase only a single
%<HELP>	#emulator base unit and then one probe card for each unique device
%<HELP>	#or group of devices to be emulated.
%<HELP>	#.sp 1
%<HELP>	#Both the %rs1-HSM Model 200
%<HELP>	#and the %rs1-HSM Model 400 emulators
%<HELP>	#come with 64K of Code memory
%<HELP>	#and 64K of External Data memory.
%<HELP>	#.sp 1
%<HELP>	#The \b%rs1-HSM Modular Model 400\r emulator has the following
%<HELP>	#additional features/capabilities (beyond those in a Model 200):
%<HELP>	#.sp 1
%<HELP>	#.in +4 {
%<HELP>	#.in +4 {
%<HELP>	#.ti -4
%<HELP>	#1.^^16K-Frame Trace Buffer (which can be viewed during emulation)
%<HELP>	#.ti -4
%<HELP>	#2.^^High Bin Count Performance Analyzer
%<HELP>	#.in -4 }
%<HELP>	#.in -4 }
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#\b%rs1-RB Modular Model 200 & Model 400 Emulators\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#All \b%rs1-RB Modular\r Model 200 & Model 400 emulators support
%<HELP>	#full probe card interchangeability for a limited set of 8051-based
%<HELP>	#devices from Siemens (C500) and Philips (PCx509x).
%<HELP>	#To emulate several different devices, you need purchase only a single
%<HELP>	#emulator base unit and then one probe card for each unique device
%<HELP>	#or group of devices to be emulated.
%<HELP>	#.sp 1
%<HELP>	#Both the %rs1-RB Model 200
%<HELP>	#and the %rs1-RB Model 400 emulators
%<HELP>	#come with 64K of Code memory
%<HELP>	#and 64K of External Data memory.
%<HELP>	#.sp 1
%<HELP>	#The \b%rs1-RB Modular Model 400\r emulator has the following
%<HELP>	#additional features/capabilities (beyond those in a Model 200):
%<HELP>	#.sp 1
%<HELP>	#.in +4 {
%<HELP>	#.in +4 {
%<HELP>	#.ti -4
%<HELP>	#1.^^16K-Frame Trace Buffer (which can be viewed during emulation)
%<HELP>	#.ti -4
%<HELP>	#2.^^High Bin Count Performance Analyzer
%<HELP>	#.in -4 }
%<HELP>	#.in -4 }
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#.ba {
%<HELP>	#***************
%<HELP>	#* Probe Cards *
%<HELP>	#***************
%<HELP>	#.ea }
%<HELP>	#.sp 1
%<HELP>	#All %rs2 %rs1 probe cards include a Break-Input signal clip,
%<HELP>	#a Trigger-Output signal clip and seven user-placeable
%<HELP>	#Trace-Capture-Input signal clips.  In addition, there
%<HELP>	#is a user-selectable jumper/control for XTAL source.
%<HELP>	#Most probe cards have other
%<HELP>	#user-selectable jumpers to control/configure the
%<HELP>	#unique capabilities of each particular device.
%<HELP>	#Some probe cards also contain a user-selectable jumper for Vcc source.
%<HELP>	#\b%rs1\r \ufully\r supports:
%<HELP>	#.sp 1
%<HELP>	#.in +4 {
%<HELP>	#.in +3 {
%<HELP>	#.ti -3
%<HELP>	#\x07^^All I/O ports, with no restrictions.
%<HELP>	#.sp 1
%<HELP>	#.ti -3
%<HELP>	#\x07^^The CMOS Idle and Power Down (Halt) modes of operation,
%<HELP>	#in those devices having such capabilities.
%<HELP>	#.sp 1
%<HELP>	#.ti -3
%<HELP>	#\x07^^The Watchdog Timer (WDT),
%<HELP>	#in those devices having such a capability.
%<HELP>	#(\b%rs1 Model 400\r only)
%<HELP>	#.in -3 }
%<HELP>	#.in -4 }
%<HELP>	#.sp 1
%<HELP>	#Following is a list of all 8051 and HSM Probe Cards which %rs2
%<HELP>	#currently offers.
%<HELP>	#Since %rs2 is constantly adding to its list of supported devices,
%<HELP>	#please contact %rs2 for information on any device not listed below.
%<HELP>	#.sp 2
%<HELP>	#.ba {
%<HELP>	#\b========== %rs1-8051 Modular Emulator Base ==========\r
%<HELP>	#.ea }
%<HELP>	#.sp 1
%<HELP>	#If support for a particular device is available at different maximum
%<HELP>	#frequencies (MHz), the description of the Probe Card appears only
%<HELP>	#once, with the speed variations noted in the Probe Card names above
%<HELP>	#the description.
%<HELP>	#Example:^^\b8031-16\r for a 16MHz 8031 Probe Card and
%<HELP>	#\b8031-20\r for a 20MHz 8031 Probe Card.
%<HELP>	#.sp 1
%<HELP>	#\b8031-20 Probe Card\r
%<HELP>	#.sp 0
%<HELP>	#\b8031-24 Probe Card\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#The 8031 Probe Card supports device operation from 0.5 to 24MHz and has a
%<HELP>	#40-lead DIP package interface.  This probe card supports 8031 and 80C31
%<HELP>	#devices from any IC manufacturer, regardless of process variation.
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#\b8032-20 Probe Card\r
%<HELP>	#.sp 0
%<HELP>	#\b8032-24 Probe Card\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#The 8032 Probe Card supports device operation from 0.5 to 24MHz and has a
%<HELP>	#40-lead DIP package interface.  This probe card supports 8031, 80C31, 8032,
%<HELP>	#80C32 and 80C32 devices from any IC manufacturer, regardless of process
%<HELP>	#variation.
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#\b8344-12 Probe Card\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#The 8344 Probe Card supports device operation from 3.5 to 12MHz and has
%<HELP>	#a 40-lead DIP package interface.  This probe card supports the 8344
%<HELP>	#device, regardless of process variation.
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#\b80C51FA-16^Probe Card\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#The 80C51FA Probe Card supports device operation from 0.5 to 16MHz and
%<HELP>	#has a 40-lead DIP package interface.  This probe card supports
%<HELP>	#8031, 80C31, 8032, 80C51FA (80C252) and 80C32 devices from
%<HELP>	#any IC manufacturer, regardless of process variation.
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#\b83C51FX-16^Probe Card\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#The 83C51FX Probe Card supports device operation from 0.5 to 16MHz and
%<HELP>	#has either a 40-lead DIP or a 44-lead PLCC package interface.
%<HELP>	#This probe card supports
%<HELP>	#8031, 80C31, 8032, 80C32, 8051, 80C51, 8751, 87C51, 8x51FA, 8x51FB,
%<HELP>	#8x51FC (with some limitations), 8052, 80C52, 8752 and 87C52
%<HELP>	#devices from any IC manufacturer, regardless of process variation.
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#\b8052-16^Probe Card\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#The 8052 Probe Card supports device operation from 0.5 to 16MHz and has
%<HELP>	#a 40-lead DIP package interface.  This probe card supports 8031, 80C31,
%<HELP>	#8032, 80C32, 8051, 80C51, 8052, 80C52, 80C154, 8751, 87C51,
%<HELP>	#8752, 87C52, 85C154 and 83C154
%<HELP>	#devices from any IC manufacturer, regardless of process variation.
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#\b83C055-12 Probe Card\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#The 83C055 Probe Card supports device operation from 6 to 12MHz and
%<HELP>	#has a 42-lead Shrink DIP package interface.  This probe card supports
%<HELP>	#83C053, 83C054, 87C054, 83C055 and 87C055 devices, regardless of
%<HELP>	#process variation.
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#\b83C152-16 Probe Card\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#The 83C152 Probe Card supports device operation from 3.5 to 16.5MHz and
%<HELP>	#has a 68-lead PLCC package interface.  This probe card supports
%<HELP>	#80C152JA/JC and 83C152JA/JC devices, regardless of process variation.
%<HELP>	#80C152JB/JD devices can be supported with some limitations.
%<HELP>	#Converter #8 is available to convert the probe card interface to a
%<HELP>	#40-lead DIP footprint for operation as an 8031 or 8051.
%<HELP>	#Converter #9 is available to convert the probe card interface to a
%<HELP>	#48-lead DIP footprint.
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#\b80C154-16^Probe Card\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
