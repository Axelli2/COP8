%<HELP&DEM>	#.sp 1
%<HELP&DEM>	#At the DOS command prompt, to invoke the \b%rs1-%rs5\r
%<HELP&DEM>	#demo emulator
%<HELP&DEM>	#emulator simulator
%<HELP&DEM>	#at some later time and automatically load
%<HELP&DEM& A80>	#the supplied demo program,
%<HELP&DEM&!A80>	#one of the supplied demo programs,
%<HELP&DEM>	#you need only type:
%<HELP&DEM>	#.sp 1
%<HELP&DEM>	#.in +4 {
%<HELP&DEM>	#.in +21 {
%<HELP&DEM&A51>	#.ti -21
%<HELP&DEM&A51>	#ICEDEMO^DEMO.DBG^^^^^to load the assembly language demo program
%<HELP&DEM&A51>	#.ti -21
%<HELP&DEM&A51>	#ICEDEMO^A_DEMO.AOM^^^to load the Archimedes/IAR C demo program
%<HELP&DEM&A51>	#.ti -21
%<HELP&DEM&A51>	#ICEDEMO^F_DEMO.AOM^^^to load the Franklin/Keil C demo program
%<HELP&DEM&A51>	#.ti -21
%<HELP&DEM&A51>	#ICEDEMO^TD51.AOM^^^^^to load the Franklin/Keil C demo program
%<HELP&DEM&A68>	#.ti -21
%<HELP&DEM&A68>	#ICEDEMO^DEMO_H11.AOM^to load the assembly language demo program
%<HELP&DEM&A68>	#.ti -21
%<HELP&DEM&A68>	#ICEDEMO^H_DEMO.AOM^^^to load the Archimedes/IAR C demo program
%<HELP&DEM&A80>	#.ti -21
%<HELP&DEM&A80>	#ICEDEMO^DEMO_C8.SHF^^to load the assembly language demo program
%<HELP&DEM&A80>	#.ti -21
%<HELP&DEM&A80>	#ICEDEMO^BC82MAIN.COD^to load the Byte Craft C demo program
%<HELP&DEM&A05>	#.ti -21
%<HELP&DEM&A05>	#ICEDEMO^B5_MAIN.COD^^to load the Byte Craft C demo program
%<HELP&DEM&A65>	#.ti -21
%<HELP&DEM&A65>	#ICEDEMO^DEMO_65K.HEX^to load the assembly language demo program
%<HELP&DEM&A65>	#.ti -21
%<HELP&DEM&A65>	#ICEDEMO^DEMOC65K.DBG^to load the IAR C demo program
%<HELP&DEM&A85>	#.ti -21
%<HELP&DEM&A85>	#ICEDEMO^DEMO_H85.ABS^to load the Hitachi H8/500 assembly language demo program
%<HELP&DEM&A85>	#.ti -21
%<HELP&DEM&A85>	#ICEDEMO^TAHT85N.ABS^^to load an Hitachi H8/500 C language demo program
%<HELP&DEM&A85>	#.ti -21
%<HELP&DEM&A85>	#ICEDEMO^TAIA85S.DBG^^to load an IAR H8/500 C language demo program
%<HELP&DEM&A25>	#.ti -21
%<HELP&DEM&A25>	#ICEDEMO^DEMO251B.AOM^to load the Keil MCS251 Binary mode assembly language demo program
%<HELP&DEM&A25>	#.ti -21
%<HELP&DEM&A25>	#ICEDEMO^TAKSL.AOM^^^^to load the Keil MCS251 Source mode Large model 'C' language demo program
%<HELP&DEM&A78>	#.ti -21
%<HELP&DEM&A78>	#ICEDEMO^DEMO78K4.LNK^to load the NEC 78K/IV RA78K4 assembly language demo program
%<HELP&DEM&A78>	#.ti -21
%<HELP&DEM&A78>	#ICEDEMO^TANS.LNK^^^^^to load the NEC 78K/IV CC78K4 'C' language demo program (Small memory model)
%<HELP&DEM&A78>	#.ti -21
%<HELP&DEM&A78>	#ICEDEMO^TANL.LNK^^^^^to load the NEC 78K/IV CC78K4 'C' language demo program (Large memory model)
%<HELP&DEM>	#.ti -21
