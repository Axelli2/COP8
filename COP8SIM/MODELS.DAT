%<HELP>	#.(Begin_Help_File)
%<HELP>	#.($3)Configure
%<HELP>	#The \bConfigure\r pull-down menu allows you to set up and customize
%<HELP>	#various aspects of the operation of the emulator hardware and
%<HELP>	#the host software.
%<HELP>	#.($4)Emulator
%<HELP>	#The \bEmulator\r command invokes a pull-down menu to allow you to
%<HELP>	#establish the operational characteristics of the emulator base
%<HELP>	#and the probe card (pod).  These include such things as
%<HELP>	#the \l($17)communication^port\m
%<HELP>	#and \l($20)baud^rate\m
%<HELP>	#to be used for the RS-232 communication
%<HELP>	#link between the host PC and the emulator base.
%<HELP&(!(A80|A05))>		#In addition, you can specify the
%<HELP&  (A51|A65|A85)>		#probe card's \l($6)mode\m of operation.
%<HELP&   A68>				#value that your program will place into the
%<HELP&   A68>				#68HC11's \l($362)INIT^Register\m.
%<HELP>	#.($5)Execute
%<HELP>	#The \bExecute\r command first establishes communication between
%<HELP>	#the host software system and the emulator base unit.
%<HELP>	#Then, the host software initializes the emulator base.
%<HELP>	#This initialization usually only needs to be performed once
%<HELP>	#at the beginning of each session.
%<HELP>	#.sp 1
%<HELP>	#The host software uses the current values associated with
%<HELP&(A25|A51|A65|A85)>	#\l($6)Mode\m,
%<HELP&(A68)>				#\l($362)INIT^Register\m, \l($392)EEPROM\m,
%<HELP>						#\l($17)Comm^port\m and \l($20)Baud^rate\m
%<HELP>	#to establish communication and initialize the emulator base.
%<HELP>	#When you change any of these values, all are written to
%<HELP>	#the \l($250)$CONFIG\m file.  The host software automatically reads
%<HELP>	#this file when it begins executing.  Thus, if you change any
%<HELP>	#of these values, the new settings become your defaults.
%<HELP>	#.($6)Mode
%<HELP>	#The \bMode\r command allows you to specify the probe card's mode
%<HELP>	#of operation.  This command is available (active) only for those probe
%<HELP>	#cards which can operate in different modes.  The available modes are
%<HELP>	#different for each probe card. Typically, these modes consist of
%<HELP>	#combinations of:
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#.in +3 {
%<HELP>	#.ti -3
%<HELP>	#-^^ROM mode / ROMless mode
%<HELP>	#.ti -3
%<HELP>	#-^^WDT (Watchdog Timer) On / WDT Off
%<HELP>	#.in -3 }
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#Determine how the probe card should operate, based on your
%<HELP>	#application and your target system environment, and then select
%<HELP>	#the appropriate mode.
%<HELP>	#.sp 1
%<HELP>	#Note that if you change the mode of operation, the host software
%<HELP>	#updates (or creates) the \l($250)$CONFIG\m file automatically.
%<HELP>	#However, the actual mode of operation of the device does not change
%<HELP>	#until you select the \l($5)Execute\m command.
%<HELP>	#.($17)Comm port
%<HELP>	#The \bComm^port\r command allows to select the RS-232 communication
%<HELP>	#port on your computer which the host software will use to communicate
%<HELP>	#with the emulator base.  The available communication ports are COM1
%<HELP>	#and COM2.
%<HELP>	#.($20)Baud rate
%<HELP>	#The \bBaud^rate\r command allows you to select the baud rate
%<HELP>	#that the host software will use during communication with the
%<HELP>	#emulator base.  Normally, you should choose the highest (fastest)
%<HELP>	#available baud rate to maximize system throughput.
%<HELP>	#However, you may need to select a lower (slower) baud rate if:
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#.in +3 {
%<HELP>	#.ti -3
%<HELP>	#-^^the emulator base is a long distance from your computer
%<HELP>	#.ti -3
%<HELP>	#-^^the 8250 UART chip in your computer cannot sustain
%<HELP>	#high-speed RS-232 communications
%<HELP>	#.in -3 }
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#After establishing communication with the emulator base,
%<HELP>	#the baud rate may not be changed
%<HELP>	#unless the emulator is reset.
%<HELP>	#.sp 1
%<HELP>	#The host software establishes the baud rate you specify here
%<HELP>	#independently of any baud rate you might have set from DOS.
%<HELP>	#.sp 1
%<HELP>	#Note that if you change the baud rate, the host software
%<HELP>	#updates (or creates) the \l($250)$CONFIG\m file automatically.
%<HELP>	#However, the actual baud rate used in communicating with the emulator
%<HELP>	#does not change until you select the \l($5)Execute\m command.
%<HELP&(!A65)>	#.($30)Code Memory Mapping
%<HELP&( A65)>	#.($30)General Memory Mapping
%<HELP&(!A65)>	#The \bCode^Memory\r
%<HELP&( A65)>	#The \bGeneral^Memory\r
%<HELP>	#command invokes a menu allowing you to map
%<HELP&(!A65)>	#code
%<HELP&( A65)>	#general
%<HELP>	#memory either to memory supplied in the emulator base or to memory
%<HELP>	#(which you must provide) in your target system.
%<HELP>	#.sp 1
%<HELP>	#The host software downloads (to the emulator) changes in the map
%<HELP>	#settings on exit from the
%<HELP&(!A65)>	#Code
%<HELP&( A65)>	#General
%<HELP>	#Memory Mapping menu.
%<HELP>	#.sp 1
%<HELP>	#Note that there are some mapping constraints due to emulator and/or
%<HELP>	#device dependencies
%<HELP>	#(e.g., in ROM mode, all ROM space must be mapped to the emulator base).
%<HELP>	#The host software enforces these mapping constraints, if any.
%<HELP>	#Since these constraints are usually dependent on the
%<HELP>	#operating \l($6)mode\m, this menu also displays the device's current
%<HELP>	#operating mode, if applicable.
%<HELP&(!A65)>	#.($31)Map Code Block To Emulator
%<HELP&( A65)>	#.($31)Map General Block To Emulator
%<HELP>	#The \bEmulator\r command allows you to map blocks of
%<HELP&(!A65)>	#code
%<HELP&( A65)>	#general
%<HELP>	#memory to the
%<HELP>	#emulator base.  The software prompts you for the starting and ending
%<HELP>	#addresses of the range you wish to map to the emulator base.
%<HELP&(!A65)>	#.($32)Map Code Block To Target
%<HELP&( A65)>	#.($32)Map General Block To Target
%<HELP>	#The \bTarget\r command allows you to map blocks of
%<HELP&(!A65)>	#code
%<HELP&( A65)>	#general
%<HELP>	#memory to your
%<HELP>	#target board.  The software prompts you for the starting and ending
%<HELP>	#addresses of the range you wish to map to your target board.
%<HELP&(!A65)>	#.($33)Map All Code Memory
%<HELP&( A65)>	#.($33)Map All General Memory
%<HELP>	#The \bAll\r command quickly maps all of
%<HELP&(!A65)>	#code
%<HELP&( A65)>	#general
%<HELP>	#memory to either
%<HELP>	#the emulator base or your target board.  After selecting the \bAll\r
%<HELP>	#command, the host software displays a pull-down menu with the two
%<HELP>	#choices \l($34)Emulator\m and \l($35)Target\m available.
%<HELP>	#The host software automatically enforces all mapping constraints,
%<HELP>	#if applicable.
%<HELP&(!A65)>	#.($34)Map All Code Memory To Emulator
%<HELP&( A65)>	#.($34)Map All General Memory To Emulator
%<HELP>	#The \bEmulator\r command quickly maps all
%<HELP&(!A65)>	#code
%<HELP&( A65)>	#general
%<HELP>	#memory to the emulator base.
%<HELP>	#The host software automatically enforces all mapping constraints,
%<HELP>	#if applicable.
%<HELP&(!A65)>	#.($35)Map All Code Memory To Target
%<HELP&( A65)>	#.($35)Map All General Memory To Target
%<HELP>	#The \bTarget\r command quickly maps all of
%<HELP&(!A65)>	#code
%<HELP&( A65)>	#general
%<HELP>	#memory to the target board.
%<HELP>	#The host software automatically enforces all mapping constraints,
%<HELP>	#if applicable.
%<HELP&(!A65)>	#.($36)Load Code Memory Mapping
%<HELP&( A65)>	#.($36)Load General Memory Mapping
%<HELP>	#The \bLoad\r command reads (and displays)
%<HELP&(!A65)>	#code
%<HELP&( A65)>	#general
%<HELP>	#memory mapping information from a file previously
%<HELP>	#\l($37)Save\md using the \l($37)Save\m command.
%<HELP&(!A65)>	#.($37)Save Code Memory Mapping
%<HELP&( A65)>	#.($37)Save General Memory Mapping
%<HELP>	#The \bSave\r command saves (writes) the current
%<HELP&(!A65)>	#code
%<HELP&( A65)>	#general
%<HELP>	#memory mapping information into a file.  At a later time, you can
%<HELP>	#restore the mapping to this state by using
%<HELP>	#the \l($36)Load\m command.
%<HELP&A51>	#.($38)Xdata Memory Mapping
%<HELP&A51>	#The \bXdata^Memory\r command invokes a menu allowing
%<HELP&A51>	#you to map External Data memory
%<HELP&A51>	#either to memory supplied in the emulator base or to memory
%<HELP&A51>	#(which you must provide) in your target system.
%<HELP&A51>	#.sp 1
%<HELP&A51>	#The host software downloads (to the emulator) changes in the map
%<HELP&A51>	#settings on exit from the Xdata Mapping menu.
%<HELP&A51>	#.sp 1
%<HELP&A51>	#Note that there are some mapping constraints due to emulator
%<HELP&A51>	#and/or device dependencies
%<HELP&A51>	#(e.g., on emulators with only 16K of External Data memory, only 16K
%<HELP&A51>	#can be mapped to the emulator base).
%<HELP&A51>	#The host software enforces these mapping constraints, if any.
%<HELP&A51>	#Since these constraints are often dependent on the
%<HELP&A51>	#operating \l($6)mode\m, this menu also displays the device's
%<HELP&A51>	#current operating mode, if applicable.
%<HELP&A51>	#.sp 1
%<HELP&A51>	#Note also that this command will be de-activated if the device
%<HELP&A51>	#being used (or the mode of operation) cannot access External
%<HELP&A51>	#Data memory.
%<HELP&A51>	#.($39)Map Xdata Block to Emulator
%<HELP&A51>	#The \bEmulator\r command maps a block of External Data memory to
%<HELP&A51>	#the emulator base.  The software prompts you for the starting and
%<HELP&A51>	#ending addresses of the range you wish to map to the emulator base.
%<HELP&A51>	#.($40)Map Xdata Block to Target
%<HELP&A51>	#The \bTarget\r command maps a block of External Data memory to your
%<HELP&A51>	#target board.  The software prompts you for the starting and ending
%<HELP&A51>	#addresses of the range you wish to map to your target board.
%<HELP&A51>	#.($41)Map All Xdata Memory
%<HELP&A51>	#The \bAll\r command quickly maps all of External Data memory to
%<HELP&A51>	#either the emulator base or your target board.  After selecting the
%<HELP&A51>	#\bAll\r command, the host software displays a pull-down menu with
%<HELP&A51>	#the two choices \l($42)Emulator\m and \l($43)Target\m available.
%<HELP&A51>	#The host software automatically enforces all mapping constraints,
%<HELP&A51>	#if applicable.
%<HELP>	#.($42)Map All Xdata Memory | Emulator
%<HELP&A51>	#The \bEmulator\r command quickly maps all of External Data memory
%<HELP&A51>	#to the emulator base.
%<HELP&A51>	#The host software automatically enforces all mapping constraints,
%<HELP&A51>	#if applicable.
%<HELP&A51>	#.($43)Map All Xdata Memory | Target
%<HELP&A51>	#The \bTarget\r command quickly maps all of External Data memory to
%<HELP&A51>	#your target board.
%<HELP&A51>	#The host software automatically enforces all mapping constraints,
%<HELP&A51>	#if applicable.
%<HELP&A51>	#.($44)Xdata Memory Mapping | Load
%<HELP&A51>	#The \bLoad\r command reads External Data memory mapping information
%<HELP&A51>	#previously \l($45)Save\md in a file
%<HELP&A51>	#and establishes that External Data memory mapping.
%<HELP&A51>	#.($45)Xdata Memory Mapping | Save
%<HELP&A51>	#The \bSave\r command saves (writes) the current External Data
%<HELP&A51>	#memory mapping information into a file.  At a later time, you
%<HELP&A51>	#can restore the mapping to its current state by using the
%<HELP&A51>	#\l($44)Load\m command.
%<HELP>	#.($46)Display Attributes
%<HELP>	#The display \bAttributes\r command invokes a pull-down menu which
%<HELP>	#allows you to customize the characteristics of the video display
%<HELP>	#on your host PC.
%<HELP>	#.($47)Lines
%<HELP>	#The \bLines\r command allows you change the total number of
%<HELP>	#lines displayed on your screen.
%<HELP>	#The choices available are dependent on the
%<HELP>	#video display adapter installed in your host PC:
%<HELP>	#.sp 1
%<HELP>	#.in +4 {
%<HELP>	#.ba {
%<HELP>	#MDA (Monochrome Display  Adapter):   25 lines
%<HELP>	#.sp 1
%<HELP>	#CGA (Color      Graphics Adapter):   25 lines
%<HELP>	#.sp 1
%<HELP>	#EGA (Enhanced   Graphics Adapter):   25 lines
%<HELP>	#                                     43 lines
%<HELP>	#.sp 1
%<HELP>	#VGA (Video      Graphics Array  ):   25 lines
%<HELP>	#                                     28 lines
%<HELP>	#                                     50 lines
%<HELP>	#.ea }
%<HELP>	#.in -4 }
%<HELP>	#.sp 1
%<HELP>	#Note that if you specify the \l($249)-v\m command line option,
%<HELP>	#the host software deactivates this (\bLines\r) command selection.
%<HELP>	#.($48)
%<HELP>	#The 25-line display mode is the default and is available
%<HELP>	#when using any video adapter or monitor in your PC.
%<HELP>	#.($49)
%<HELP>	#The 28-line display mode is available only when certain video
%<HELP>	#adapters are installed in your PC.  See \l($47)Lines\m for details.
%<HELP>	#.($50)
%<HELP>	#The 43-line display mode is available only when certain video
%<HELP>	#adapters are installed in your PC.  See \l($47)Lines\m for details.
%<HELP>	#.($51)
%<HELP>	#The 50-line display mode is available only when certain video
%<HELP>	#adapters are installed in your PC.  See \l($47)Lines\m for details.
%<HELP>	#.($53)CGA/EGA/VGA Default
%<HELP>	#The \bCGA/EGA/VGA Default\r command sets up video colors and other
%<HELP>	#display attributes suitable for all color monitor types.
%<HELP>	#The supplied binary file \l($250)$CLR1$\m contains these color definitions.
%<HELP>	#These definitions make use of 16 foreground colors,
%<HELP>	#but only 8 background colors.  If you have an EGA or VGA installed
%<HELP>	#in your system, the \l($54)EGA/VGA^Default\m provides a full
%<HELP>	#16 background colors.
%<HELP>	#.($54)EGA/VGA Default
%<HELP>	#The \bEGA/VGA Default\r command sets up video colors and other
%<HELP>	#display attributes suitable for EGA & VGA color monitors.
%<HELP>	#The supplied binary file \l($250)$CLR2$\m contains these color definitions.
%<HELP>	#These definitions make full use of 16 foreground \uand\r 16 background
%<HELP>	#colors.  If you accidentally (or intentionally) select this command
%<HELP>	#when the display adapter installed in your PC is actually a CGA
%<HELP>	#or Monochrome adapter, many areas of the screen will blink!
%<HELP>	#This is because the $CLR2$ file is set up assuming that the
%<HELP>	#video display attribute control bit for "blink" actually means
%<HELP>	#"bold (or bright) background".
%<HELP>	#.($55)Monochrome Default
%<HELP>	#The \bMonochrome Default\r command sets up video
%<HELP>	#display attributes suitable for monochrome adapters/monitors.
%<HELP>	#The supplied binary file \l($250)$CLRM$\m contains these color definitions.
%<HELP>	#The only "color", other than black & white, available
%<HELP>	#for monochrome adapters is blue.  However, "blue" does not display
%<HELP>	#as blue, but rather as \uunderline\ring.
%<HELP>	#If you accidentally (or intentionally) select this command
%<HELP>	#when the display adapter installed in your PC is actually
%<HELP>	#something other than a Monochrome adapter, the video display
%<HELP>	#indeed \uwill\r be painted in a rather hideous combination
%<HELP>	#of black, white and blue.
%<HELP>	#.($56)User
%<HELP>	#The \bUser\r command sets up video colors and other
%<HELP>	#display attributes to your customized settings.
%<HELP>	#The binary file \l($250)$COLOR\m (not supplied) contains these color
%<HELP>	#definitions.
%<HELP>	#.sp 1
%<HELP>	#To create your own customized, default color definitions, first
%<HELP>	#invoke the \l($57)Select\m command to change individual display
%<HELP>	#attribute settings.  Then, \l($76)Save\m those settings into
%<HELP>	#the $COLOR file, making sure that the \bSave Option\r
%<HELP>	#for \l($79)Colors\m is \uon\r.
%<HELP>	#.sp 1
%<HELP>	#The \b%rs1\r host software reads the $COLOR file during initialization,
%<HELP>	#thus establishing your own customized, default color definitions.
%<HELP>	#.($57)Select
%<HELP>	#The \bSelect\r command pops up a menu which allows you to
%<HELP>	#select/modify video colors and other display attributes for all
%<HELP>	#fields in all windows and menus individually.
%<HELP>	#See \l($345)Select^Color\m for detailed information about the fields
%<HELP>	#that you can modify in this menu.
%<HELP>	#.($58)Configure|Windows
%<HELP>	#The \bWindows\r command invokes a pop-menu allowing you to customize
%<HELP>	#certain characteristics of the windows on the main screen.
%<HELP>	#.sp 1
%<HELP>	#The data in each of the windows is updated after every emulation
%<HELP>	#cycle (\l($96)Run\m command) or whenever you change the value in a
%<HELP>	#register, memory location or variable.
%<HELP>	#.sp 1
%<HELP>	#We recommend that you first \l($59)Modify\m the windows to:
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#.in +4 {
%<HELP>	#.ti -4
%<HELP>	#1)^^Specify which windows will be active (present) or
%<HELP>	#inactive (absent).
%<HELP>	#.ti -4
%<HELP>	#2)^^Determine the order in which the windows will be
%<HELP>	#displayed (top of screen {1} to bottom of screen {n}).
%<HELP>	#.in -4 }
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#and then \l($60)Size\m the windows to suit your needs.
%<HELP>	#.($59)Configure|Windows|Modify
%<HELP>	#The \bModify\r command allows you to define the layout and content
%<HELP>	#of all the windows on the main screen.
%<HELP>	#Use the arrow keys to move the highlighted cursor to the attribute
%<HELP>	#you wish to change and then follow the directions displayed
%<HELP>	#on the bottom border of the box.
%<HELP>	#.sp 1
%<HELP>	#The window attributes which you can change in this menu are:
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#.in +5 {
%<HELP>	#.ti -5
%<HELP>	#\bActive\r
%<HELP>	#.sp 1
%<HELP>	#Each window can either be active (present, \bYes\r)
%<HELP>	#or inactive (absent, \bNo\r).  By default, the only active windows
%<HELP>	#are the Register, Stack, Source and Status Windows.  And yes, you can
%<HELP>	#operate the \b%rs1\r system with all the windows inactive.
%<HELP>	#.sp 1
%<HELP>	#.ti -5
%<HELP>	#\bOrder\r
%<HELP>	#.sp 1
%<HELP>	#The order of presentation of the window names in
%<HELP>	#the \bWindow\r & \bOrder\r columns mirrors the order in which the
%<HELP>	#windows will appear on the main screen (top to bottom).
%<HELP>	#.sp 1
%<HELP>	#.ti -5
%<HELP>	#\bStarting^Address\r
%<HELP>	#.sp 1
%<HELP>	#The Source Window always reflects the source lines and/or machine
%<HELP>	#instructions in the vicinity of the value in the Program Counter
%<HELP>	#register (@PC).
%<HELP>	#.sp 1
%<HELP>	#For most of the "dump" style windows (all except the Stack Window),
%<HELP>	#you can choose whether the starting address for the data
%<HELP>	#displayed in the window will be fixed (\bFixed\r), or varying based
%<HELP>	#on the value of an expression that you specify (\b@Exp\r).
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#.ti -2
%<HELP>	#\bFixed\r
%<HELP>	#.sp 1
%<HELP>	#You can select a fixed starting address by pressing the
%<HELP>	#Enter key when the cursor is positioned in the leftmost column under
%<HELP>	#the "Starting Address" heading.
%<HELP>	#Note that even if you choose to have a fixed starting address for a
%<HELP>	#window, you can still associate a "Current Position" expression with
%<HELP>	#that window (see \bCurrent Position\r below).
%<HELP>	#.sp 1
%<HELP>	#.ti -2
%<HELP>	#\b@Exp\r
%<HELP>	#.sp 1
%<HELP>	#You can select the \b@Exp\r ("at-expression" or "@<expression>") style
%<HELP>	#of window painting by pressing the Enter key when the cursor is
%<HELP>	#positioned in the rightmost column (over '@Exp') under the
%<HELP>	#"Starting Address" heading.  See \bCurrent Position\r below for
%<HELP>	#details on specifying the current-position expression.
%<HELP>	#.sp 1
%<HELP>	#Any "dump" style window which has associated with it a
%<HELP>	#current-position expression can be set up for
%<HELP>	#painting "@<expression>".  What this means is that the host software
%<HELP>	#will dynamically and
%<HELP>	#continually adjust the window's starting address to ensure that
%<HELP>	#the location designated by the expression is always visible in
%<HELP>	#the window.  An example of this kind of window painting is
%<HELP>	#the Stack Window (@SP).
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#As long as the location designated by the current-position expression
%<HELP>	#is within the
%<HELP>	#range of addresses visible in the window, the host software does not
%<HELP>	#change the window's starting address, just the location of the
%<HELP>	#current-position indicator character (typically, an arrow).
%<HELP>	#As soon as the current-expression value goes "out of the window"
%<HELP>	#(in either direction), the host software automatically changes the
%<HELP>	#window's starting address so that the byte which is '@<expression>'
%<HELP>	#is exactly in the middle of the window.  When the host software does
%<HELP>	#change the window's starting address in this way, the software also
%<HELP>	#highlights the entire address column in the window to alert you that
%<HELP>	#the window has been "re-ORG"ed.
%<HELP>	#If you \l($61)goto/peruse/browse\m the window
%<HELP>	#and scroll the data in the window, the host software will leave the
%<HELP>	#data in the window positioned as you last left it as long as the
%<HELP>	#location which is '@<expression>' is still visible in the window.
%<HELP>	#.in -2 }
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#.ti -5
%<HELP>	#\bCurrent^Position\r
%<HELP>	#.sp 1
%<HELP>	#Any "dump" style window can have associated with it an arbitrary
%<HELP>	#"Current Position" expression
%<HELP&A51>	#(e.g., SP or DPTR).
%<HELP&A68>	#(e.g., SP or X or Y).
%<HELP&A05>	#(e.g., SP or X).
%<HELP&A80>	#(e.g., SP or B or X).
%<HELP&A65>	#(e.g., SP or ER0 or ER1).
%<HELP&A85>	#(e.g., SP or any Rn register).
%<HELP&A25>	#(e.g., SP or any register).
%<HELP&A78>	#(e.g., SP or any general register).
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#.in +7 {
%<HELP>	#.ti -7
%<HELP>	#NOTE:^^The current-position expression associated with the Stack Window
%<HELP>	#is always "SP";  you cannot change the current-position expression
%<HELP>	#associated with the Stack Window.
%<HELP>	#.in -7 }
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#A current-position indicator character (e.g., an arrow --
%<HELP>	#see \bCurrent Position:^^Indicator\r below) appears next to the
%<HELP>	#corresponding data byte/bit if the location designated by the
%<HELP>	#current-position expression is within the range of locations being
%<HELP>	#displayed in the window.  You have control over the character used for
%<HELP>	#the current-position marker, and whether it appears to the left
%<HELP>	#or right of the corresponding data byte/bit.
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#.in +2 {
%<HELP>	#.ti -2
%<HELP>	#\bCurrent^Position:^^Expression\r
%<HELP>	#.sp 1
%<HELP>	#If the window has a current-position expression associated with it,
%<HELP>	#that expression appears here preceded by an at-sign (@).
%<HELP>	#If the window does not have now have a current-position expression
%<HELP>	#associated with it, this field contains "@---------".
%<HELP>	#If the window \ucannot\r have a current-position expression associated
%<HELP>	#with it, this field contains "----------".
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#To change the current-position expression associated with a window,
%<HELP>	#follow the instructions at the bottom of the menu.  When you enter
%<HELP>	#a new expression, do \unot\r include the leading at-sign (@) in what
%<HELP>	#you type.
%<HELP>	#.sp 1
%<HELP>	#To clear (erase/delete) the current-position expression associated with
%<HELP>	#a window, proceed as if you are going to change the expression, but
%<HELP>	#enter an empty expression (press the Enter key when the cursor is at
%<HELP>	#the first character of the input field).
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#.ti -2
%<HELP>	#\bCurrent^Position:^^Indicator\r
%<HELP>	#.sp 1
%<HELP>	#Here you can specify the display character to be used for the
%<HELP>	#current-position marker (typically some kind of arrow character).
%<HELP>	#In addition, you can specify whether that character should appear to
%<HELP>	#the left or right of the corresponding data byte/bit in the window.
%<HELP>	#.in -2 }
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#.ti -5
%<HELP>	#\bOptions\r
%<HELP>	#.sp 1
%<HELP>	#Each window has certain unique, user-controllable display
%<HELP>	#characteristics.
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#For all of the "dump" style windows, you can
%<HELP>	#specify whether you want to see the data in both hexadecimal
%<HELP>	#and ASCII formats, or in hexadecimal format only.
%<HELP>	#.sp 1
%<HELP>	#For the Register Window, you can define the fill character
%<HELP>	#which separates a register's name from its current content (value).
%<HELP>	#.sp 1
%<HELP>	#For the Source Window, you can specify one of three display modes:
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#.in +4 {
%<HELP>	#.ti -4
%<HELP>	#1)^^Code -- the software displays the window as disassembled
%<HELP>	#instructions.
%<HELP>	#.sp 1
%<HELP>	#.ti -4
%<HELP>	#2)^^Mixed -- the software displays the window as disassembled
%<HELP>	#instructions, intermixed with code-generating Higher-Level Language
%<HELP>	#(HLL) source lines, if available.
%<HELP>	#.sp 1
%<HELP>	#.ti -4
%<HELP>	#3)^^HLL -- the software displays the window in HLL source-only mode,
%<HELP>	#including both code-generating and non-code-generating source lines.
%<HELP>	#Note that this display mode is also available if you are using an
%<HELP>	#Assembler which generates line number information.
%<HELP>	#.in -4 }
%<HELP>	#.in -2 }
%<HELP>	#.in -2 }
%<HELP>	#.in -5 }
%<HELP>	#.in -2 }
%<HELP>	#.($60)Configure|Windows|Size
%<HELP>	#The \bSize\r command allows you to make each window on the main screen
%<HELP>	#larger (taller) or smaller (shorter).
%<HELP>	#We recommend that you size the windows from top-of-screen to
%<HELP>	#bottom-of-screen.
%<HELP>	#The sizes of all windows \ubelow\r the one you are currently
%<HELP>	#adjusting will change automatically in response to your adjustments.
%<HELP>	#The sizes of all windows \uabove\r the one on which you are currently
%<HELP>	#working will remain unchanged.
%<HELP>	#.sp 1
%<HELP>	#The Quick Help line at the bottom of the screen shows you which
%<HELP>	#keys to use to affect the size changes.  If you 'Exit' without
%<HELP>	#'Accept'ing the changes made to the last selected window,
%<HELP>	#that window will revert to its former size.
%<HELP>	#.($61)Configure|Windows|Goto
%<HELP>	#The \bGoto\r command allows you to select, or "jump into",
%<HELP>	#the windows on the main screen.
%<HELP>	#When you do this (what we call "entering \bChange Mode\r"),
%<HELP>	#you can browse/peruse and/or change the data in the
%<HELP>	#windows.  Just use the cursor keys to move the highlight bar to
%<HELP>	#the item of interest.
%<HELP>	#To change a value, you don't even have to press the
%<HELP>	#\bEnter\r key to pop-up the dialog box -- simply start typing
%<HELP>	#the new value for the highlighted location/item and the
%<HELP>	#dialogue box pops up automatically.
%<HELP>	#.sp 1
%<HELP>	#The Quick Help line at the bottom of the screen shows you which
%<HELP>	#keys to use in perusing the windows.
%<HELP>	#.sp 1
%<HELP>	#You can find more specific information about the unique characteristics
%<HELP>	#of Change Mode in each of the main screen windows in:
%<HELP>	#.sp 1
%<HELP>	#.ba {
%<HELP>	#.in +2 {
%<HELP>	#\l($382)Goto^|^Memory^Dump^Windows\m
%<HELP>	#.sp 1
%<HELP>	#\l($381)Goto^|^Register^Window\m
%<HELP>	#.sp 1
%<HELP>	#\l($383)Goto^|^Source^Window\m
%<HELP>	#.sp 1
%<HELP>	#\l($385)Goto^|^Status^Window\m
%<HELP>	#.sp 1
%<HELP>	#\l($384)Goto^|^Watch^Window\m
%<HELP>	#.in -2 }
%<HELP>	#.ea }
%<HELP>	#.sp 1
%<HELP>	#The host software remembers the window that you were last in
%<HELP>	#and places you into that same window the next time you select this
%<HELP>	#command.
%<HELP>	#.sp 1
%<HELP>	#\bHint:\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#As an additional, convenient shortcut to invoke
%<HELP>	#the \bConfigure|Windows|Goto\r command,
%<HELP>	#you can press the \bTab\r or \bShift-Tab\r keys when
%<HELP>	#no pull-down menus are hanging off the top menu bar on the
%<HELP>	#main screen.
%<HELP>	#.sp 1
%<HELP>	#Furthermore, you can use any of the following keys to do the same
%<HELP>	#thing.  These keys differ from the \bTab\r and \bShift-Tab\r keys
%<HELP>	#above in that they perform the action indicated by the key
%<HELP>	#(e.g., \x19 scrolls down one line in the window's display)
%<HELP>	#after the host software goes to the window:
%<HELP>	#.sp 1
%<HELP>	#.in +3 {
%<HELP>	#.in +12 {
%<HELP>	#.ti -12
%<HELP>	#Keystroke^^^Effect/Action
%<HELP>	#.ti -12
%<HELP>	#---------^^^-------------
%<HELP>	#.ti -12
%<HELP>	#\x18^^^^^^^^^^^Go into window and move highlight bar or cursor
%<HELP>	#up one line.
%<HELP>	#.ti -12
%<HELP>	#\x19^^^^^^^^^^^Go into window and move highlight bar or cursor
%<HELP>	#down one line.
%<HELP>	#.ti -12
%<HELP>	#Home^^^^^^^^Go into window and move highlight bar or cursor to
%<HELP>	#the beginning of the data in the window.
%<HELP>	#.ti -12
%<HELP>	#End^^^^^^^^^Go into window and move highlight bar or cursor to
%<HELP>	#the end of the data in the window.
%<HELP>	#.ti -12
%<HELP>	#PgUp^^^^^^^^Go into window and move highlight bar or cursor
%<HELP>	#one screenful back in the data in the window.
%<HELP>	#.ti -12
%<HELP>	#PgDn^^^^^^^^Go into window and move highlight bar or cursor
%<HELP>	#one screenful ahead in the data in the window.
%<HELP>	#.ti -12
%<HELP>	#Ctrl-B^^^^^^Go into window and toggle (on or off) a permanent
%<HELP>	#simple break-point at the currently highlighted location
%<HELP>	#(Source Window only).
%<HELP>	#.ti -12
%<HELP>	#Ctrl-T^^^^^^Go into window and set a temporary break-point
%<HELP>	#at the currently highlighted location in the Source Window and
%<HELP>	#begin emulation immediately (Source Window only).
%<HELP>	#.in -12 }
%<HELP>	#.in -3 }
%<HELP>	#.in -2 }
%<HELP>	#.($62)Configure|Windows|Watch|Add
%<HELP>	#The \bAdd\r command allows you to add a Watch \l($244)Expression\m
%<HELP>	#to the \l($384)Watch^Window\m.
%<HELP>	#.sp 1
%<HELP>	#You can think of the Watch Window as one or more
%<HELP>	#peepholes into different areas of
%<HELP>	#memory, where you specify the starting addresses symbolically
%<HELP>	#(the names of the variables, registers or bits) or
%<HELP>	#numerically (expressions), and where the displayed values
%<HELP>	#are interpreted according to the individual data types of the
%<HELP>	#variables (if such information is available in the program file).
%<HELP>	#.sp 1
%<HELP>	#The Watch Window must be active before you can add anything to it.
%<HELP>	#.sp 1
%<HELP>	#There is no limit on the number of entities which can be
%<HELP>	#watched -- the Watch Window is scrollable.
%<HELP>	#.sp 1
%<HELP>	#If the value of a Watch Expression in the Watch Window changes
%<HELP>	#from one emulation cycle to the next
%<HELP>	#(see \l($96)Run\m),
%<HELP>	#that value will be highlighted to alert you of the change.
%<HELP>	#.($63)Configure|Windows|Watch|Delete
%<HELP>	#The \bDelete\r command allows you to delete (remove) a
%<HELP>	#Watch \l($244)Expression\m from the \l($384)Watch^Window\m.
%<HELP>	#.($64)Identification
%<HELP>	#The \bIdentification\r command pops up a window
%<HELP>	#describing the properties of your \b%rs1\r emulator system.
%<HELP>	#The information displayed includes such things as hardware,
%<HELP>	#firmware and software version numbers, memory sizes, model numbers
%<HELP>	#and option configurations.
%<HELP>	#Such information is useful, for example, when you
%<HELP>	#call %rs2 for Technical Support at %rs3.
%<HELP>	#.($65)Options
%<HELP>	#The \bOptions\r command pops up a menu which allows you
%<HELP>	#to customize miscellaneous characteristics of the user
%<HELP>	#interface configuration.
%<HELP>	#.($67)Alert|Diagnostics
%<HELP>	#The \bDiagnostics\r command toggles whether or not
%<HELP>	#your computer will beep when the host software pops up a diagnostic
%<HELP>	#message box.  This toggle command applies to all types of
%<HELP>	#diagnostics:  errors, warnings and informative diagnostics.
%<HELP>	#.($68)Alert|Bad Key/Command
%<HELP>	#The \bBad^key/command\r command toggles whether or not
%<HELP>	#your computer will beep when you:
%<HELP>	#.sp 1
%<HELP>	#.in +4 {
%<HELP>	#.in +4 {
%<HELP>	#.ti -4
%<HELP>	#1)^^Press a key that is not recognized (does not apply)
%<HELP>	#in a particular context.
%<HELP>	#.ti -4
%<HELP>	#2)^^Select an inactive (inaccessible) command in a pull-down
%<HELP>	#or pop-up menu.
%<HELP>	#.in -4 }
%<HELP>	#.in -4 }
%<HELP>	#.($69)Alert|Host-break
%<HELP>	#Pressing the \bEsc\r key to break (stop) emulation is called
%<HELP>	#"stopping emulation via a Host-break".
%<HELP>	#.sp 1
%<HELP>	#The \bAlert|Host-break\r command toggles whether or not
%<HELP>	#your computer will beep when you break emulation via a "Host-break".
%<HELP>	#(The computer will never beep when emulation stops because a normal
%<HELP>	#hardware break-point was reached.)
%<HELP>	#.($70)Flicker
%<HELP>	#The \bFlicker/command\r command toggles whether or not
%<HELP>	#the host software will flicker displayed information in
%<HELP>	#various contexts.
%<HELP>	#The software uses flickering as a form of
%<HELP>	#immediate visual feedback to confirm that
%<HELP>	#"something has happened" or "this action was taken".
%<HELP>	#.sp 1
%<HELP>	#Currently, the software employs flickering to show the:
%<HELP>	#.sp 1
%<HELP>	#.in +4 {
%<HELP>	#.in +4 {
%<HELP>	#.ti -4
%<HELP>	#1)^^selected response in a "Yes/No/Cancel" dialog.
%<HELP>	#.sp 1
%<HELP>	#.ti -4
%<HELP>	#2)^^new value assigned to a variable or register when that
%<HELP>	#variable or register is changed using the \l($118)Expression\m command
%<HELP>	#\uand\r both the name and new value are typed in the
%<HELP>	#same input box.
%<HELP>	#.sp 1
%<HELP>	#.ti -4
%<HELP>	#3)^^selected command
%<HELP>	#(when you have activated the \l($249)-kf\m command line option).
%<HELP>	#.in -4 }
%<HELP>	#.in -4 }
%<HELP>	#.($71)Trace Prefetch
%<HELP>	#The \bTrace^prefetch\r command toggles whether or not
%<HELP>	#the host software will prefetch (read) raw trace buffer data from the
%<HELP>	#\b%rs1\r emulator during keyboard "idle" time.
%<HELP>	#.($72)Main Esc
%<HELP>	#The \bMain^Esc\r command controls the host software's behavior
%<HELP>	#when you press the \bEsc\r key when no pull-down menus are visible
%<HELP>	#(pulled down) on the main screen:
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#.in +6 {
%<HELP>	#.ti -6
%<HELP>	#On:^^^The host software asks whether or not you really
%<HELP>	#want to exit completely back to DOS.
%<HELP>	#.ti -6
%<HELP>	#Off:^^The host software treats the \bEsc\r key as an unrecognized
%<HELP>	#keystroke and handles it according to the current setting
%<HELP>	#of the \l($68)Alert|Bad^key/command\m toggle.
%<HELP>	#.in -6 }
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#Note that the \l($121)File|Exit\m command provides an alternative
%<HELP>	#method for exiting back to DOS.
%<HELP>	#.($73)Function-Keys
%<HELP>	#The \bFunction-Keys\r command displays a pull-down menu that
%<HELP>	#gives you access to commands to change the number of
%<HELP>	#\l($74)Lines\m of function key labels displayed and to
%<HELP>	#\l($75)Modify\m function key assignments.
%<HELP>	#.($74)Lines
%<HELP>	#The \bLines\r command is used to specify the number of lines of
%<HELP>	#\l($75)Function^Key\m labels to display at the bottom of the screen.
%<HELP>	#Up to four lines may be used (corresponding to all function keys
%<HELP>	#and their Shift, Alt, and Ctrl states).  Specifying 0 lines
%<HELP>	#shuts off the display of function key labels.
%<HELP>	#.($75)Modify Function Key Assignments
%<HELP>	#The \bModify\r command displays a pop-up menu from which you may
%<HELP>	#modify function key assignments.  From this menu you may
%<HELP>	#\l($107)Assign\m new commands to function keys, \l($108)Clear\m
%<HELP>	#function key assignments, activate (\l($111)Save\m) new
%<HELP>	#assignments for the duration of the current session
%<HELP>	#and \l($112)Write\m an assignment/option report.
%<HELP>	#.sp 1
%<HELP>	#The function key menu is divided into two windows, the
%<HELP>	#\l($378)Assignment^Window\m and the \l($379)Option^Window\m.
%<HELP>	#The "Tab" and "Shift-Tab" keys may be used to toggle between the
%<HELP>	#two windows and the \l($110)Display\m command is used to change the
%<HELP>	#display mode of the two windows.
%<HELP>	#.($76)Save
%<HELP>	#The \bSave\r command lets you selectively save various
%<HELP>	#facets of the current user interface configuration.
%<HELP>	#By doing so, you create new default settings for the user
%<HELP>	#interface configuration.
%<HELP>	#.($77)Save|Save
%<HELP>	#The \bSave\r command saves the current user interface configuration
%<HELP>	#environment according to the setting of the 'Save Opts' controls
%<HELP>	#which follow in this menu.
%<HELP>	#.($78)Lines
%<HELP>	#The setting of the \bLines\r toggle specifies whether or not the
%<HELP>	#current screen size (number of lines) will be saved into the
%<HELP>	#\b$LINES\r file when you select
%<HELP>	#the \l($77)Configure|Save|Save\m command.
%<HELP>	#.($79)Colors
%<HELP>	#The setting of the \bColors\r toggle specifies whether or not the
%<HELP>	#current screen colors and highlighting controls
%<HELP>	#will be saved into the \b$COLOR\r file when you select
%<HELP>	#the \l($77)Configure|Save|Save\m command.
%<HELP>	#.($80)Windows
%<HELP>	#The setting of the \bWindows\r toggle specifies whether or not the
%<HELP>	#current main screen window configuration
%<HELP>	#will be saved into the \b$WINDOW\r file when you select
%<HELP>	#the \l($77)Configure|Save|Save\m command.
%<HELP>	#.($81)Alert
%<HELP>	#The setting of the \bAlert\r toggle specifies whether or not the
%<HELP>	#current \bAlert\r Options settings
%<HELP>	#will be saved into the \b$ALERT\r file when you select
%<HELP>	#the \l($77)Configure|Save|Save\m command.
%<HELP>	#.($82)Misc
%<HELP>	#The setting of the \bMisc\r toggle specifies whether or not
%<HELP>	#the current \bMiscellaneous\r Options settings
%<HELP>	#will be saved into the \b$MISC\r file when you select
%<HELP>	#the \l($77)Configure|Save|Save\m command.
%<HELP>	#.($83)Function Keys
%<HELP>	#The setting of the \bFunction Keys\r toggle specifies whether or not
%<HELP>	#the current function (hot) key definitions
%<HELP>	#will be saved into the \b$FKEYDEF\r file when you select
%<HELP>	#the \l($77)Configure|Save|Save\m command.
%<HELP>	#.($84)Restore
%<HELP>	#The \bRestore\r command restores a previously \l($77)Save\md
%<HELP>	#user interface configuration.
%<HELP>	#.($85)File
%<HELP>	#The \bFile\r pull-down menu allows you to load programs into the
%<HELP>	#emulator, build and run macros and save/restore the current
%<HELP>	#application environment.
%<HELP>	#.($86)File|Load
%<HELP>	#The \bLoad\r command is used to load memory
%<HELP>	#with object code from a disk file. Several different
%<HELP>	#object file formats are accepted:
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#.in +3 {
%<HELP>	#.ti -3
%<HELP>	#-^^2500AD symbolic file format
%<HELP>	#.ti -3
%<HELP>	#-^^Archimedes Debug format
%<HELP>	#.ti -3
%<HELP>	#-^^Avocet AvCase 8051 symbolic file format
%<HELP>	#.ti -3
%<HELP>	#-^^Byte Craft '.COD' files (COP8 & 68HC05 'C')
%<HELP>	#.ti -3
%<HELP>	#-^^BSO absolute object modules
%<HELP>	#.ti -3
%<HELP>	#-^^Enertec absolute object modules
%<HELP>	#.ti -3
%<HELP>	#-^^Franklin absolute object modules (AOMF)
%<HELP>	#.ti -3
%<HELP>	#-^^Hitachi SYSROF
%<HELP>	#.ti -3
%<HELP>	#-^^IAR Debug format
%<HELP>	#.ti -3
%<HELP>	#-^^Intel absolute object module format (AOMF)
%<HELP>	#.ti -3
%<HELP>	#-^^Intel standard hex file format (HEX)
%<HELP>	#.ti -3
%<HELP>	#-^^Introl ICOFF file format
%<HELP>	#.ti -3
%<HELP>	#-^^Keil absolute object modules (AOMF)
%<HELP>	#.ti -3
%<HELP>	#-^^MCC absolute object modules
%<HELP>	#.ti -3
%<HELP>	#-^^Microtek Research absolute object modules
%<HELP>	#.ti -3
%<HELP>	#-^^Motorola PASM/PLD COFF files (68HC11 & 68HC05)
%<HELP>	#.ti -3
%<HELP>	#-^^National Semiconductor COP8 COFF files
%<HELP>	#.ti -3
%<HELP>	#-^^NEC K4 absolute object modules
%<HELP>	#.ti -3
%<HELP>	#-^^OKI Semiconductor OH65K Symbolic HEX files
%<HELP>	#.ti -3
%<HELP>	#-^^Sysoft absolute object modules
%<HELP>	#.ti -3
%<HELP>	#-^^%rs2 absolute object file format.
%<HELP>	#.in -3 }
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#The host software supports symbolic source-level debugging with
%<HELP>	#most formats.
%<HELP>	#For further information on file formats,
%<HELP>	#see \l($433)Symbolic^Loadable^File^Formats\m.
%<HELP>	#.sp 1
%<HELP>	#After you supply a valid program file name, the host software will ask
%<HELP>	#you if you wish to
%<HELP>	#.sp 1
%<HELP>	#.in +4 {
%<HELP>	#Merge into the current application environment?
%<HELP>	#.in -4 }
%<HELP>	#.sp 1
%<HELP>	#If you answer \bY\res, then all breakpoints, watch expressions,
%<HELP>	#map and trace settings
%<HELP>	#will be kept, and the code, data and symbols in your program file will
%<HELP>	#be merged with any existing program information currently loaded in
%<HELP>	#the emulator.  Code or data at conflicting addresses from the new file
%<HELP>	#will overwrite the same addresses from the old file.  All symbolic and
%<HELP>	#HLL information from the old file will
%<HELP> #remain and any such information in the new file will be added.
%<HELP>	#.sp 1
%<HELP>	#If you answer \bN\ro, the previous environment including breakpoints,
%<HELP>	#watch expressions, trace memory and
%<HELP&(!A65)>	#code
%<HELP&( A65)>	#general
%<HELP>	#memory will be cleared or restored to default settings
%<HELP>	#before the new program file is loaded.
%<HELP>	#.sp 1
%<HELP>	#NOTE:^^If you are loading the very first program,
%<HELP>	#or simply reloading or replacing that program,
%<HELP>	#respond \uNo\r to the "Merge..." prompt dialog.
%<HELP>	#Only respond \uYes\r to the "Merge..." prompt dialog
%<HELP>	#if you intend to merge the code, data and symbols from two or
%<HELP>	#more files -- respond \uNo\r for the first
%<HELP>	#file in the sequence and \uYes\r for all subsequent files.
%<HELP>	#.sp 1
%<HELP>	#Pressing \bEsc\r cancels the Load operation.
%<HELP&A51>	#.sp 1
%<HELP&A51>	#Please note that this command only loads your program information
%<HELP&A51>	#into the host computer and into the emulator's code memory.
%<HELP&A51>	#If your target system is set up in a Von Neuman configuration
%<HELP&A51>	#(/PSEN and /WR "AND"ed together) and you wish the code to be placed
%<HELP&A51>	#into the target system RAM, you should use the
%<HELP&A51>	#\l($89)File|Download\m command.
%<HELP>	#.sp 1
%<HELP>	#If your HLL-generated program doesn't display source line or module
%<HELP>	#information, you should check to be sure that the source files
%<HELP>	#can be found in the HLL source search path
%<HELP>	#(see \l($135)Source/Symbols|Source^Path\m).
%<HELP>	#If the HLL source search path is set properly, refer to the
%<HELP>	#\l($434)Recommended^Compilation/Linking^Options\m
%<HELP>	#to verify that you are using
%<HELP>	#the appropriate compiler/assembler and linker options.
%<HELP>	#.co }{ Help Info:  HC_FIL_STORE for CC_FIL_STORE
%<HELP>	#.($87)File|Store
%<HELP>	#The \bStore\r command allows you to store the current state of the
%<HELP>	#emulation environment to a disk file for later recall by the
%<HELP>	#\l($88)Restore\m command.
%<HELP>	#You will be prompted for the name of the disk file.
%<HELP>	#.sp 1
%<HELP>	#While the \bStore\r operation is taking place, a status box will
%<HELP>	#display each item as it is being saved.
%<HELP>	#The emulation environment is defined by:
%<HELP>	#.sp 1
%<HELP>	#.in +4 {
%<HELP>	#Current PC (program counter)
%<HELP>	#.sp 1
%<HELP>	#Mapping
%<HELP>	#.sp 1
%<HELP&(!A65)>	#Code memory
%<HELP&( A65)>	#General memory
%<HELP&A51>	#.sp 1
%<HELP&A51>	#External Data memory
%<HELP>	#.sp 1
%<HELP&(!A65)>	#Internal Data memory
%<HELP&( A65)>	#Local memory
%<HELP>	#.sp 1
%<HELP>	#Register values
%<HELP>	#.sp 1
%<HELP>	#Code file name
%<HELP>	#.sp 1
%<HELP>	#HLL source search path
%<HELP>	#.sp 1
%<HELP>	#Internal symbol table
%<HELP>	#.sp 1
%<HELP>	#Breakpoint settings
%<HELP>	#.sp 1
%<HELP>	#Watch Expressions
%<HELP>	#.in -4 }
%<HELP&A51>	#.sp 1
%<HELP&A51>	#If the device being used can access external data memory,
%<HELP&A51>	#a dialog box will ask you how many K bytes to save
%<HELP&A51>	#(from 0-64).
%<HELP>	#.($88)File|Restore
%<HELP>	#The \bRestore\r command is used to restore the
%<HELP>	#system to the same state which
%<HELP>	#was previously saved in a disk file.
%<HELP>	#It performs the complementary function
%<HELP>	#of the \l($87)Store\m command.
%<HELP>	#.($89)File|Download
%<HELP> #The \bDownload\r command is used to download code or external data
%<HELP> #from a file on the host computer to your target system.
%<HELP> #Several different object file formats are accepted.  You will
%<HELP> #be prompted for the file name and then the host software will ask:
%<HELP> #.sp 1
%<HELP> #.in +4 {
%<HELP> #Are you downloading code memory?
%<HELP> #.in -4 }
%<HELP> #.sp 1
%<HELP> #A \bY\res answer means download to the target system's code memory,
%<HELP> #and another confirmation box will ask:
%<HELP> #.in +2 {
%<HELP> #.sp 1
%<HELP> #.in +4 {
%<HELP> #Merge into the current application environment?
%<HELP> #.in -4 }
%<HELP> #.sp 1
%<HELP> #A \bY\res answer merges information from the file into the current
%<HELP> #application environment and \bN\ro clears the application environment
%<HELP> #before loading information from the file.  For more information on the
%<HELP> #"Merge..." prompt, see the \l($86)File|Load\m command.
%<HELP&A51> #Note that your target system must be designed as a Von Neuman
%<HELP&A51> #architecture (/PSEN and /WR "AND"ed together) to actually
%<HELP&A51> #download any code to the target system's code memory.
%<HELP> #.sp 1
%<HELP> #On the surface, it may not seem necessary to worry about the
%<HELP> #emulation environment if you are downloading code to the outside
%<HELP> #world, but the host software must know if it is to clear symbolic
%<HELP> #information, breakpoints or trace-On/Off-points from the emulator
%<HELP> #at load time.
%<HELP> #.in -2 }
%<HELP> #.sp 1
%<HELP> #A \bN\ro answer to the download prompt means download to the target
%<HELP> #system's external data memory.  The information from the file will
%<HELP> #be downloaded to the target's external data memory;
%<HELP> #All symbolic information in the file will be ignored.
%<HELP> #.sp 1
%<HELP> #(The \bDownload\r command is not available for some parts
%<HELP> #because they do not have the ability to access
%<HELP> #external data/code memory.)
%<HELP>	#.($90)File|Upload
%<HELP> #The \bUpload\r command allows you to upload
%<HELP&(!A65)>	#code
%<HELP&( A65)>	#general
%<HELP> #memory from your target system into the emulator's memory space, where
%<HELP> #it can be modified.  When you select this command, you will be asked
%<HELP> #for the range of addresses you wish to upload.
%<HELP>	#.sp 1
%<HELP>	#After responding, the host software will ask
%<HELP>	#you if you wish to
%<HELP>	#.sp 1
%<HELP>	#.in +4 {
%<HELP>	#Merge into the current application environment?
%<HELP>	#.in -4 }
%<HELP>	#.sp 1
%<HELP>	#A \bY\res answer will cause existing memory in the emulator within the
%<HELP>	#specified upload range to be overwritten by the memory uploaded from
%<HELP>	#your target system.  Current breakpoints and labels will be retained,
%<HELP>	#as will trace On/Off points and HLL line number information.
%<HELP>	#.sp 1
%<HELP>	#A \bN\ro answer will clear all of the emulation environment settings
%<HELP>	#currently in effect, along with
%<HELP&(!A65)>	#code
%<HELP&( A65)>	#general
%<HELP>	#memory and any symbolic or HLL line number information.
%<HELP>	#.sp 1
%<HELP>	#Pressing \bEsc\r cancels the Upload operation.
%<HELP> #.sp 1
%<HELP> #(The \bUpload\r command is not available for some parts
%<HELP> #because they do not have the ability to access off chip memory.)
%<HELP>	#.($91)File|Macro
%<HELP&A80&(DMD|EPU)>	#(Note:  The \bMacro\r command is not available in the
%<HELP&A80&(DMD|EPU)>	#COP8 Debug Module or EPU.)
%<HELP&A80&(DMD|EPU)>	#.sp 1
%<HELP>	#The \bMacro\r command pops up the Macro Menu.
%<HELP>	#In the Macro Menu you can create a macro command
%<HELP>	#file or execute (run) a previously-created macro command file.
%<HELP>	#.sp 1
%<HELP>	#A macro command file contains a series of recorded keystrokes which,
%<HELP>	#when executed, perform a macro function.  A macro command file may be
%<HELP>	#used to automate long or repetitive tasks.
%<HELP>	#.sp 1
%<HELP>	#\bMacro Environment\r
%<HELP>	#.sp 1
%<HELP>	#When the emulator is in macro \l($93)learn\m mode,
%<HELP>	#all keystrokes you type are saved to a disk file in order to be
%<HELP>	#reproduced (executed) at a later time.  Not only are the keystrokes
%<HELP>	#saved, but the Function Key assignments at macro-creation time are
%<HELP>	#saved as well.  Because of this, Function Key keystrokes will perform
%<HELP>	#the commands assigned to them at the time the macro file was created.
%<HELP>	#If the Function Keys have been redefined, you may notice that the
%<HELP>	#macro file Function Keys do not perform the same tasks as the
%<HELP>	#currently defined ones.  At macro completion, the Function Keys will be
%<HELP>	#restored to their redefined values.
%<HELP>	#.sp 1
%<HELP>	#Note that for macro files that may be used over a long period of time,
%<HELP>	#it would be wise to avoid using cursor keys to select commands and to
%<HELP>	#always use the Quick Key (the highlighted letter of the command).
%<HELP>	#This would be useful in the situation where a host software update
%<HELP>	#occurs where several commands may be added.  Execution of a macro
%<HELP>	#file using cursor keys for command selection may get "out of synch",
%<HELP>	#meaning that because of the additional new commands, commands other
%<HELP>	#than those intended may be selected.
%<HELP>	#.sp 1
%<HELP>	#\bParameter Substitution\r
%<HELP>	#.sp 1
%<HELP>	#If the same task needs to be performed repeatedly, but values may
%<HELP>	#change between runs, the same macro command file can be executed using
%<HELP>	#parameters.  In general, parameters can be used anywhere the host
%<HELP>	#software prompts you for information (filenames, numeric values,
%<HELP>	#addresses, etc.).  When creating a macro command file, you key in a
%<HELP>	#\b%P\r (see the \l($93)File|Macro|Learn\m command) wherever a parameter
%<HELP>	#value is to be used.  When a macro command file is executing,
%<HELP>	#it substitutes a parameter value whenever the \b%P\r keystroke
%<HELP>	#combination is encountered.  You supply the actual parameter list
%<HELP>	#when you invoke the macro command file
%<HELP>	#(see the \l($92)File|Macro|Execute\m command).
%<HELP>	#During macro execution, if no actual parameters are supplied and
%<HELP>	#\b%P\r is encountered, execution pauses until you supply the actual
%<HELP>	#parameter value.
%<HELP>	#.($92)Macro|Execute
%<HELP>	#The \bExecute\r command begins execution of the commands from
%<HELP>	#a macro command file created using the
%<HELP>	#\l($93)File|Macro|Learn\m command.
%<HELP>	#After entering the name of a valid macro command file, you will be
%<HELP>	#prompted for any (optional) parameters to pass to the macro command
%<HELP>	#file.
%<HELP>	#.sp 1
%<HELP>	#Your should enter all actual parameter values in the order that they
%<HELP>	#are used in the macro command file.  Pressing only \bEnter\r in
%<HELP>	#response to a parameter prompt (without entering an actual parameter
%<HELP>	#value) will start execution of the macro command file.
%<HELP>	#.sp 1
%<HELP>	#Commands are executed from the macro
%<HELP>	#command file until the end of the file is reached or until you press
%<HELP>	#the \bCtrl-C\r keystroke combination at the keyboard.
%<HELP>	#Control then returns to you (manual command entry).
%<HELP>	#.sp 1
%<HELP>	#If you type \bCtrl-C\r while the macro is executing,
%<HELP>	#the macro will terminate immediately and the session will
%<HELP>	#resume in the normal, interactive mode (manual command entry).
%<HELP>	#.sp 1
%<HELP>	#Note that you may use the \l($249)-i\m command line option
%<HELP>	#to start automatic execution of a macro command file when you
%<HELP>	#invoke the host software.
%<HELP>	#.($93)Macro|Learn
%<HELP>	#The \bLearn\r command lets you create a macro command file by
%<HELP>	#remembering every keystroke you type into a macro command file.
%<HELP>	#After you enter a valid file name, control is returned to the
%<HELP>	#Main Menu Bar and the host software enters Macro Learn Mode.
%<HELP>	#In Learn Mode every keystroke you enter is stored in the macro
%<HELP>	#command file until you enter
%<HELP>	#you enter the percent character, \b%\r,
%<HELP>	#followed by an \bE\r (\b%E\r).
%<HELP>	#You can access all host software commands in Learn Mode except
%<HELP>	#for the \l($91)File|Macro\m command.
%<HELP>	#.sp 1
%<HELP>	#\bLearn Mode Commands\r (not case sensitive)
%<HELP>	#.sp 1
%<HELP>	#.in +3 {
%<HELP>	#.in +5 {
%<HELP>	#.ti -5
%<HELP>	#\b%E\r^^^End Macro Learn Mode.
%<HELP>	#.sp 1
%<HELP>	#.ti -5
%<HELP>	#\b%%\r^^^Insert a percent sign (%) into the macro command file as
%<HELP>	#normal text.
%<HELP>	#.sp 1
%<HELP>	#.ti -5
%<HELP>	#\b%P\r^^^Parameter substitution.  Everything you type up to the next
%<HELP>	#\bEnter\r will be passed to the program and not included in the
%<HELP>	#macro command file.  When you press the \bEnter\r key, Learn Mode
%<HELP>	#resumes.  During macro execution, a parameter will be pulled from the
%<HELP>	#parameter list or, if no parameters are present, the host software
%<HELP>	#will wait for you to supply one.
%<HELP>	#.sp 1
%<HELP>	#.ti -5
%<HELP>	#\b%D\r^^^Enter a delay.  Everything you type up to the first non-digit
%<HELP>	#character is a real-time delay (in milliseconds).  This delay is not
%<HELP>	#the same as the global \l($94)File|Macro|Delay\m.  This delay is used
%<HELP>	#only between the keystrokes in which it was entered in the macro
%<HELP>	#command file.  This local delay is added to the global delay, if any.
%<HELP>	#.sp 1
%<HELP>	#.ti -5
%<HELP>	#\b%N\r^^^Execute a new macro.  Everything you type up to the \bEnter\r
%<HELP>	#is the name of a new macro file.  If you enter this during Learn Mode,
%<HELP>	#the macro command file is closed and Learn Mode ends.
%<HELP>	#If you enter this during execution of a macro command file,
%<HELP>	#the current macro command file is closed, the new macro command file
%<HELP>	#is opened and execution continues from the new file.
%<HELP>	#.in -5 }
%<HELP>	#.in -3 }
%<HELP>	#.sp 1
%<HELP>	#NOTE:  No keystrokes will be echoed to the display when entering
%<HELP>	#Learn Mode command information.  Any other \b%\r key combinations
%<HELP>	#will be ignored.
%<HELP>	#.($94)Macro|Delay
%<HELP>	#The \bDelay\r command creates a global delay in between every
%<HELP>	#keystroke read from a macro command file during macro execution.
%<HELP>	#You specify the delay time in milliseconds (1/1000th second).
%<HELP>	#Valid delay times range from 0 to 15000 milliseconds (15 seconds).
%<HELP>	#The default value for this global delay is 0.
%<HELP>	#.($95)Macro|Repeat
%<HELP>	#You use the \bRepeat\r command to specify the number of times that the
%<HELP>	#execution of a macro command file is to be repeated.
%<HELP>	#Valid repeat counts range from 0 to 60000.
%<HELP>	#The default repeat count is zero (0).
%<HELP>	#.($96)Run
%<HELP>	#The commands in the \bRun\r pull-down menu allow you to start
%<HELP>	#various types of emulations.
%<HELP>	#These include:
%<HELP>	#.sp 1
%<HELP>	#.in +4 {
%<HELP>	#.in +4 {
%<HELP>	#.ti -4
%<HELP>	#1)^^RESETing the processor in the probe card without beginning
%<HELP>	#emulation,
%<HELP>	#.ti -4
%<HELP>	#2)^^Starting emulation from RESET conditions,
%<HELP>	#.ti -4
%<HELP>	#3)^^Resuming emulation under current, or slightly modified, conditions,
%<HELP>	#.ti -4
%<HELP>	#4)^^Several varieties of single-stepping.
%<HELP>	#.in -4 }
%<HELP>	#.in -4 }
%<HELP&( A68)>	#.($97)Run|Reset|Normal|Emulator
%<HELP&(!A68)>	#.($97)Run|Reset|Emulator
%<HELP>		#The
%<HELP&( A68)>	#\bReset|Normal|Emulator\r
%<HELP&(!A68)>	#\bReset|Emulator\r
%<HELP>		#command starts emulation from a device \bReset\r condition.
%<HELP>		#The \bReset\r signal comes from the emulator base and occurs
%<HELP>		#automatically.  There is no output to synchronize the target
%<HELP>		#system, as the reset pin to the target is input only.  Some devices
%<HELP>		#have a \bReset\r-out signal on a separate pin;  this signal,
%<HELP>		#if present in the microcontroller itself, will be available.
%<HELP&A68>	#.sp 1
%<HELP&A68>	#The processor begins running in Normal Expanded Mode.
%<HELP&( A68)>	#.($98)Run|Reset|Normal|Target
%<HELP&(!A68)>	#.($98)Run|Reset|Target
%<HELP>		#The
%<HELP&( A68)>	#\bReset|Normal|Target\r
%<HELP&(!A68)>	#\bReset|Target\r
%<HELP>		#command initiates emulation in the
%<HELP>		#target application system, with emulation beginning from
%<HELP>		#the chip's normal \bReset\r state.
%<HELP>		#.sp 1
%<HELP>		#The \b%rs1\r emulator base unit does \unot\r supply the \bReset\r
%<HELP>		#pulse automatically.  Emulation will not begin until
%<HELP>		#the target application system supplies the \bReset\r pulse or until
%<HELP>		#you press the \bRESET\r button on the emulator base unit
%<HELP>		#(if so equipped).
%<HELP&A68>	#.sp 1
%<HELP&A68>	#The processor begins running in Normal Expanded Mode.
%<HELP>	#.($99)Run|Go
%<HELP>	#The \bGo\r command begins (or resumes) emulation starting from
%<HELP>	#the current PC address.
%<HELP>	#If you start the emulation session with a \bGo\r command from an
%<HELP>	#unknown state (i.e., without having first \bReset\r the device),
%<HELP>	#unpredictable behavior may result.
%<HELP>	#.($100)Run|From
%<HELP>	#The \bFrom\r command begins (or resumes) emulation starting from
%<HELP>	#a program counter (PC) address that you supply.
%<HELP>	#When you select the \bFrom\r command, the host software
%<HELP>	#will prompt you to supply the address at which to commence emulation.
%<HELP>	#.sp 1
%<HELP>	#Aside from changing the program counter (PC) address, this command
%<HELP>	#works just like the \l($99)Run|Go\m command.
%<HELP>	#.($101)Run|Until
%<HELP>	#The \bUntil\r command sets a temporary break-point
%<HELP>	#which remains in effect only for the duration of the
%<HELP>	#next emulation cycle.
%<HELP>	#When you select the \bUntil\r command, the host software
%<HELP>	#will prompt you to supply the temporary break-point address.
%<HELP>	#The software then transmits this break-point to the emulator
%<HELP>	#without disturbing any other break-points which may already exist.
%<HELP>	#Then, emulation will begin as if you had selected the
%<HELP>	#\l($99)Go\m command.  Emulation continues until the program
%<HELP>	#passes through \uany\r break-point, including the temporary
%<HELP>	#break-point just established.  When emulation stops, the
%<HELP>	#host software removes the temporary break-point from
%<HELP>	#the emulator, again,
%<HELP>	#without disturbing (deleting) any other break-points which
%<HELP>	#may have been previously established.
%<HELP>	#.sp 1
%<HELP>	#Aside from setting and clearing the temporary break-point, this command
%<HELP>	#works just like the \l($99)Run|Go\m command.
%<HELP>	#.($102)Step
%<HELP>	#You can use the \bStep\r (single-step) command to execute
%<HELP>	#one machine instruction and then stop (break emulation).
%<HELP>	#The emulator will execute the next instruction
%<HELP>	#(i.e., the one addressed by
%<HELP>	#the Program Counter (PC)) and then break.
%<HELP>	#.sp 1
%<HELP>	#Note:  The single-step operation is not, strictly speaking, real-time
%<HELP>	#emulation.  Timer-related code may not operate correctly when
%<HELP>	#single-stepped.  This may also include edge-triggered interrupts,
%<HELP>	#serial port functions and timer operation.
%<HELP>	#.($103)Line
%<HELP>	#The \bLine\r command allows you to single-step from one
%<HELP>	#code-generating source line to the next.
%<HELP>	#Emulation begins at the current PC and stops (breaks) when
%<HELP>	#execution reaches the next code-generating source line in \uany\r
%<HELP>	#module.
%<HELP>	#.sp 1
%<HELP>	#Note that this command will be de-activated if the loaded program
%<HELP>	#has no line number information.
%<HELP>	#.($104)Over
%<HELP>	#The \bOver\r command allows you to single-step from one
%<HELP>	#code-generating source line to the next.
%<HELP>	#Emulation begins at the current PC and stops (breaks) when
%<HELP>	#execution reaches the next code-generating source line in the
%<HELP>	#\ucurrent\r module.
%<HELP>	#This has the effect of "stepping over" calls to functions
%<HELP>	#or procedures in other modules.
%<HELP>	#.sp 1
%<HELP>	#Note that this command will be de-activated if the current module
%<HELP>	#in the loaded program has no line number information.
%<HELP>	#.($105)To
%<HELP>	#The \bTo\r command allows you to single-step from one
%<HELP>	#function to the next.
%<HELP>	#Emulation begins at the current PC and stops (breaks) when
%<HELP>	#execution reaches the next function, procedure \uor\r
%<HELP>	#global (public) code label.
%<HELP>	#.sp 1
%<HELP>	#.in +4 {
%<HELP>	#NOTE:^^Global code labels are included only
%<HELP>	#because not all language processors (compilers) mark
%<HELP>	#procedures/functions properly in the debug records in
%<HELP>	#the absolute object module for the program.
%<HELP>	#.in -4 }
%<HELP>	#.($106)Display/Alter
%<HELP>	#The \bDisplay/Alter\r command pulls down a menu from which you
%<HELP>	#may \l($115)Assemble\m new code instructions into memory,
%<HELP>	#\l($114)Disassemble\m existing
%<HELP&(!A65)>		#code
%<HELP&( A65)>		#general
%<HELP>	#memory, view/change \l($118)Expression\m contents,
%<HELP&A51>			#view/change \l($119)RAM-Bits\m memory,
%<HELP&A51>			#view/change \l($264)External^Data\m memory,
%<HELP&(A51|A80)>	#view/change \l($258)Internal^Data\m memory,
%<HELP&(A65)>		#view/change \l($258)Local\m memory,
%<HELP>				#and view/change raw
%<HELP&(!A65)>		#\l$(252)Code\m memory.
%<HELP&( A65)>		#\l$(252)General\m memory.
%<HELP>	#.($107)Assign
%<HELP>	#The \bAssign\r command is used to assign the current (highlighted)
%<HELP>	#option in the \l($379)Option^Window\m to the current (highlighted)
%<HELP>	#function key in the \l($378)Assignment^Window\m.
%<HELP>	#.sp 1
%<HELP>	#An alternate method of assigning an option to a function key is to
%<HELP>	#press the function key.  If the current window is the
%<HELP>	#\bAssignment^Window\r the option of the current (highlighted)
%<HELP>	#function key is copied as the option for the pressed function key.
%<HELP>	#If the current window is the \bOption^Window\r the current
%<HELP>	#(highlighted) option is copied to the pressed function key.
%<HELP>	#.sp 1
%<HELP>	#Note that when using the alternate method of assigning a function
%<HELP>	#key, if the function key that has "Help" assigned to it is pressed,
%<HELP>	#you will be asked whether your intention is to get "Help" or to
%<HELP>	#reassign that function key.
%<HELP>	#.($108)Clear
%<HELP>	#The \bClear\r command is used to clear the assignment of the
%<HELP>	#current (highlighted) function key.
%<HELP>	#.($109)Help
%<HELP>	#Help for Modify Function Key Menu Commands:
%<HELP>	#.sp 1
%<HELP>	#^^^^\l($107)Assign\m^^^^\l($108)Clear\m^^^^\l($111)Save\m
%<HELP>	#.sp 1
%<HELP>	#^^^^\l($112)Write\m^^^^^\l($110)Display\m^^\l($75)General^Help\m
%<HELP>	#.sp 1
%<HELP>	#.($110)Display
%<HELP>	#The \bDisplay\r command is used to toggle the \l($75)Function^Key\m
%<HELP>	#menu display mode.  There are two display modes.  The first display
%<HELP>	#mode shows the function key and the short description of the option
%<HELP>	#assigned to it in the \l($378)Assignment^Window\m and both the short
%<HELP>	#and long description of each option in the \l($379)Option^Window\m.
%<HELP>	#The second display mode shows the function key and both the short and
%<HELP>	#long description of the assigned option in the \bAssignment^Window\r
%<HELP>	#and just the short description of each option in the \bOption^Window\r.
%<HELP>	#.sp 1
%<HELP>	#The short description of an assignment option is the 7 character
%<HELP>	#description that is shown for the \l($74)Function^Key^Labels\m
%<HELP>	#displayed at the bottom of the screen.  The long description of an
%<HELP>	#assignment option is the full command path to a command (e.g., the
%<HELP>	#full command path to the current command is
%<HELP>	#\bConfigure|Function-Keys|Modify|Display\r).
%<HELP>	#.($111)Save
%<HELP>	#The \bSave\r command makes the edited assignments active for the
%<HELP>	#current session.  If you wish to make the assignments permanent,
%<HELP>	#you must select the \l($77)Configure|Save|Save\m command.
%<HELP>	#.($112)Write
%<HELP>	#The \bWrite\r command is used to write the function key
%<HELP>	#\bAssignments\r and \bOptions\r to a disk file.
%<HELP>	#The disk file is written in an ASCII text format.
%<HELP>	#.($113)Asm/Dasm
%<HELP>	#The \bAsm/Dasm\r command invokes a pop up menu which
%<HELP>	#allows you to peruse a disassembled view of existing
%<HELP&(!A65)>	#code
%<HELP&( A65)>	#general
%<HELP>	#memory.  The disassembled instructions will be interspersed with
%<HELP>	#HLL source images (if available) if the 'Mixed' display
%<HELP>	#\l($116)Mode\m is active.
%<HELP>	#You can also \l($115)Assemble\m (patch) new or different instructions
%<HELP>	#into any location in
%<HELP&(!A65)>	#code
%<HELP&( A65)>	#general
%<HELP>	#memory, and \l($343)Write\m the disassembly
%<HELP>	#of a region to a file of your choice.
%<HELP&(A65|A85|A78)>	#.sp 1
%<HELP&(A65|A85|A78)>	#Disassembler Notes:
%<HELP&(A65|A85|A78)>	#.sp 1
%<HELP&(A65)>	#.in +2 {
%<HELP&(A65)>	#.in +3 {
%<HELP&(A65)>	#.ti -3
%<HELP&(A65)>	#1)^Interrupt vectors and vector call vectors
%<HELP&(A65)>	#are handled specially when \l($117)Label-synch\m mode
%<HELP&(A65)>	#is ON, as follows:
%<HELP&(A65)>	#.in +2 {
%<HELP&(A65)>	#.in +2 {
%<HELP&(A65)>	#.ti -2
%<HELP&(A65)>	#ivect^^^^<addr>^^^^;interrupt vector
%<HELP&(A65)>	#.ti -2
%<HELP&(A65)>	#vvect^^^^<addr>^^^^;vector call vector
%<HELP&(A65)>	#.in -2 }
%<HELP&(A65)>	#.in -2 }
%<HELP&(A65)>	#Turn \bLabel-synch\r OFF to see the interpretation
%<HELP&(A65)>	#as instructions.
%<HELP&(A65)>	#.sp 1
%<HELP&(A65)>	#.ti -3
%<HELP&(A65)>	#2)^Some instructions have aliases (alternate forms).
%<HELP&(A65)>	#We show the alias (alternate form) as a comment during
%<HELP&(A65)>	#disassembly:
%<HELP&(A65)>	#.in +2 {
%<HELP&(A65)>	#.in +2 {
%<HELP&(A65)>	#.ti -2
%<HELP&(A65)>	#a.^SB^^^^<PSW_bit>^^^for^^^OR^^^PSW,#vvh
%<HELP&(A65)>	#.ti -2
%<HELP&(A65)>	#b.^RB^^^^<PSW_bit>^^^for^^^AND^^PSW,#vvh
%<HELP&(A65)>	#.ti -2
%<HELP&(A65)>	#c.^MUL^^^^^^^^^^^^^^^for^^^ST^^^A,<SFR_addr_mul>
%<HELP&(A65)>	#.ti -2
%<HELP&(A65)>	#d.^DIV^^^^^^^^^^^^^^^for^^^ST^^^A,<SFR_addr_div>
%<HELP&(A65)>	#.in -2 }
%<HELP&(A65)>	#.in -2 }
%<HELP&(A65)>	#Aliases (alternate forms) can also be entered
%<HELP&(A65)>	#when using the Single-Line \l($115)Assembler\m.
%<HELP&(A65)>	#.sp 1
%<HELP&(A65)>	#.ti -3
%<HELP&(A65)>	#3)^The vector table and vector number are shown as
%<HELP&(A65)>	#a comment in disassemblies of the VCAL, VCALC and
%<HELP&(A65)>	#VCALZ instructions.
%<HELP&(A65)>	#.sp 1
%<HELP&(A65)>	#.ti -3
%<HELP&(A65)>	#4)^The Host Software will lower-case the opcode
%<HELP&(A65)>	#mnemonic string for those instructions which are
%<HELP&(A65)>	#legal only with a device having 128K of General
%<HELP&(A65)>	#Memory when the current device ($MODEL) has only
%<HELP&(A65)>	#64K of General Memory. Note that currently, this is
%<HELP&(A65)>	#true for all supported parts (i.e., we currently
%<HELP&(A65)>	#do not support any part which has more than 64K
%<HELP&(A65)>	#of General Memory).
%<HELP&(A65)>	#.in -3 }
%<HELP&(A65)>	#.in -2 }
%<HELP&(A85)>	#.in +2 {
%<HELP&(A85)>	#.in +3 {
%<HELP&(A85)>	#.ti -3
%<HELP&(A85)>	#1)^":8" or ":16" notation is generally not used in
%<HELP&(A85)>	#order to save space on screen. In all cases, however,
%<HELP&(A85)>	#you can determine the size of the operand by the
%<HELP&(A85)>	#display format of the operand:
%<HELP&(A85)>	#.in +2 {
%<HELP&(A85)>	#.in +2 {
%<HELP&(A85)>	#.ti -2
%<HELP&(A85)>	#a.^^8-bit:^^^^H'01^^^^^^or^^^^#H'01
%<HELP&(A85)>	#.ti -2
%<HELP&(A85)>	#b.^16-bit:^^^^H'0001^^^^or^^^^#H'0001
%<HELP&(A85)>	#.in -2 }
%<HELP&(A85)>	#.in -2 }
%<HELP&(A85)>	#.sp 1
%<HELP&(A85)>	#.ti -3
%<HELP&(A85)>	#2)^Some branch instructions have aliases (alternate forms).
%<HELP&(A85)>	#We show the alias (alternate form) as a comment during
%<HELP&(A85)>	#disassembly:
%<HELP&(A85)>	#.in +2 {
%<HELP&(A85)>	#.in +2 {
%<HELP&(A85)>	#.ti -2
%<HELP&(A85)>	#a.^BT^^^^^for^^^^BRA
%<HELP&(A85)>	#.ti -2
%<HELP&(A85)>	#b.^BF^^^^^for^^^^BRN
%<HELP&(A85)>	#.ti -2
%<HELP&(A85)>	#c.^BHS^^^^for^^^^BCC
%<HELP&(A85)>	#.ti -2
%<HELP&(A85)>	#d.^BLO^^^^for^^^^BCS
%<HELP&(A85)>	#.in -2 }
%<HELP&(A85)>	#.in -2 }
%<HELP&(A85)>	#Aliases (alternate forms) can also be entered
%<HELP&(A85)>	#when using the Single-Line \l($115)Assembler\m.
%<HELP&(A85)>	#.sp 1
%<HELP&(A85)>	#.ti -3
%<HELP&(A85)>	#3)^In the operand field register "R6" is replaced
%<HELP&(A85)>	#by "R6FP" and "R7" is replaced by "R7SP".
%<HELP&(A85)>	#.sp 1
%<HELP&(A85)>	#.ti -3
%<HELP&(A85)>	#4)^The Host Software will lower-case the opcode
%<HELP&(A85)>	#mnemonic when:
%<HELP&(A85)>	#.in +2 {
%<HELP&(A85)>	#.in +3 {
%<HELP&(A85)>	#.ti -3
%<HELP&(A85)>	#a.^the instruction is valid in Maximum Mode only
%<HELP&(A85)>	#and the current mode is Minimum, and
%<HELP&(A85)>	#.ti -3
%<HELP&(A85)>	#b.^when there is a size mismatch (which will be
%<HELP&(A85)>	#flagged by the Hitachi H8/500 Assembler as a
%<HELP&(A85)>	#"Warning").
%<HELP&(A85)>	#.in -3 }
%<HELP&(A85)>	#.in -2 }
%<HELP&(A85)>	#.in -3 }
%<HELP&(A85)>	#.in -2 }
%<HELP&(A78)>	#.in +2 {
%<HELP&(A78)>	#.in +3 {
%<HELP&(A78)>	#.ti -3
%<HELP&(A78)>	#1)^Interrupt vectors, call table vectors, and
%<HELP&(A78)>	#RAM, general register and sfr areas are all
%<HELP&(A78)>	#handled specially when \l($117)Label-synch\m
%<HELP&(A78)>	#mode is ON, as follows:
%<HELP&(A78)>	#.in +2 {
%<HELP&(A78)>	#.in +2 {
%<HELP&(A78)>	#.ti -2
%<HELP&(A78)>	#ivect^^^^<addr>^^^^;interrupt vector
%<HELP&(A78)>	#.ti -2
%<HELP&(A78)>	#ctvect^^^<addr>^^^^;call table vector
%<HELP&(A78)>	#.ti -2
%<HELP&(A78)>	#iram^^^^^<val>^^^^^;RAM
%<HELP&(A78)>	#.ti -2
%<HELP&(A78)>	#mscw^^^^^<val>^^^^^;macro service channel
%<HELP&(A78)>	#.ti -2
%<HELP&(A78)>	#gr^^^^^^^<val>^^^^^;general register
%<HELP&(A78)>	#.ti -2
%<HELP&(A78)>	#sfr^^^^^^<val>^^^^^;sfr
%<HELP&(A78)>	#.in -2 }
%<HELP&(A78)>	#.in -2 }
%<HELP&(A78)>	#Turn \bLabel-synch\r OFF to see the interpretation
%<HELP&(A78)>	#as instructions.
%<HELP&(A78)>	#.sp 1
%<HELP&(A78)>	#.ti -3
%<HELP&(A78)>	#2)^Some instructions have aliases (alternate forms).
%<HELP&(A78)>	#We show the alias (alternate form) as a comment during
%<HELP&(A78)>	#disassembly:
%<HELP&(A78)>	#.in +2 {
%<HELP&(A78)>	#.in +2 {
%<HELP&(A78)>	#.ti -2
%<HELP&(A78)>	#a.^BC^^^^$addr^^^^^^^;BL
%<HELP&(A78)>	#.ti -2
%<HELP&(A78)>	#b.^BNC^^^$addr^^^^^^^;BNL
%<HELP&(A78)>	#.ti -2
%<HELP&(A78)>	#c.^BNV^^^$addr^^^^^^^;BPO
%<HELP&(A78)>	#.ti -2
%<HELP&(A78)>	#d.^BNZ^^^$addr^^^^^^^;BNE
%<HELP&(A78)>	#.ti -2
%<HELP&(A78)>	#d.^BV^^^^$addr^^^^^^^;BPE
%<HELP&(A78)>	#.ti -2
%<HELP&(A78)>	#d.^BZ^^^^$addr^^^^^^^;BE
%<HELP&(A78)>	#.in -2 }
%<HELP&(A78)>	#.in -2 }
%<HELP&(A78)>	#Aliases (alternate forms) can also be entered
%<HELP&(A78)>	#when using the Single-Line \l($115)Assembler\m.
%<HELP&(A78)>	#.sp 1
%<HELP&(A78)>	#.ti -3
%<HELP&(A78)>	#.in -3 }
%<HELP&(A78)>	#.in -2 }
%<HELP>	#.($114)Browse
%<HELP>	#The \bBrowse\r command allows you to specify a new starting
%<HELP>	#address for disassembly.
%<HELP>	#You can specify an absolute
%<HELP>	#address or a symbolic name (line number or label).
%<HELP>	#.sp 1
%<HELP>	#Note that if an absolute address is entered and the
%<HELP>	#\l($117)Label-synch\m mode is off, the address may or may not
%<HELP>	#correspond to an instruction boundary and may result in
%<HELP>	#an out-of-synch disassembly.
%<HELP>	#.($115)Assemble
%<HELP>	#The \bAssemble\r command pops up a box to allow you to enter
%<HELP>	#(patch) a new instruction into
%<HELP&(!A65)>	#code
%<HELP&( A65)>	#general
%<HELP>	#memory at the currently
%<HELP>	#highlighted location.  After you enter a new instruction,
%<HELP>	#the highlight bar will move down automatically to the
%<HELP>	#location following that new instruction to allow you to enter
%<HELP>	#several instructions in succession.
%<HELP>	#.sp 1
%<HELP>	#While the Assembler input box is visible, you can also move
%<HELP>	#the highlight bar up or down one line using the arrow keys
%<HELP>	#('\x19' and '\x18').
%<HELP>	#.sp 1
%<HELP>	#When entering an instruction, symbolic information may be used.
%<HELP>	#This includes the ability to define a new label at the current
%<HELP>	#address and using symbolic names in the operand part of the
%<HELP>	#instruction.  When a new label is entered, it is inserted into
%<HELP>	#the internal symbol table as a global (public) symbol.
%<HELP>	#.sp 1
%<HELP>	#Note that if the assembled instruction does not contain the
%<HELP>	#same number of bytes as the original instruction at the current
%<HELP>	#address you will be notified and asked to verify the
%<HELP>	#operation.
%<HELP>	#.sp 1
%<HELP>	#The assembler may also be used to enter data bytes or words using
%<HELP>	#the 'DB' or 'DW' mnemonic followed by a value.
%<HELP>	#A label may precede the 'DB' or 'DW' mnemonic.
%<HELP&(A85|A78)>	#.sp 1
%<HELP&(A85|A78)>	#Assembler Notes:
%<HELP&(A85|A78)>	#.sp 1
%<HELP&(A85)>	#.in +2 {
%<HELP&(A85)>	#.in +3 {
%<HELP&(A85)>	#.ti -3
%<HELP&(A85)>	#1)^The current location counter symbol is the
%<HELP&(A85)>	#dollar sign ($).
%<HELP&(A85)>	#.sp 1
%<HELP&(A85)>	#.ti -3
%<HELP&(A85)>	#2)^Some instructions have aliases (alternate forms).
%<HELP&(A85)>	#Aliases (alternate forms) can be entered instead
%<HELP&(A85)>	#of the standard form.
%<HELP&(A85)>	#.in +2 {
%<HELP&(A85)>	#.in +2 {
%<HELP&(A85)>	#.ti -2
%<HELP&(A85)>	#a.^BT^^^^^for^^^^BRA
%<HELP&(A85)>	#.ti -2
%<HELP&(A85)>	#b.^BF^^^^^for^^^^BRN
%<HELP&(A85)>	#.ti -2
%<HELP&(A85)>	#c.^BHS^^^^for^^^^BCC
%<HELP&(A85)>	#.ti -2
%<HELP&(A85)>	#d.^BLO^^^^for^^^^BCS
%<HELP&(A85)>	#.in -2 }
%<HELP&(A85)>	#.in -2 }
%<HELP&(A85)>	#.sp 1
%<HELP&(A85)>	#.ti -3
%<HELP&(A85)>	#3)^If you omit the format specification (e.g., the ":G"
%<HELP&(A85)>	#in "ADD:G") when entering an opcode mnemonic of an
%<HELP&(A85)>	#instruction which has several format variations, the
%<HELP&(A85)>	#Assembler will use the most general format, specifically
%<HELP&(A85)>	#":G".
%<HELP&(A85)>	#.sp 1
%<HELP&(A85)>	#.ti -3
%<HELP&(A85)>	#4)^If you omit the size specification (i.e., ".B" or
%<HELP&(A85)>	#".W") when entering an opcode mnemonic of an instruction
%<HELP&(A85)>	#which supports different sizes, the Assembler will
%<HELP&(A85)>	#choose the instruction variation that most closely
%<HELP&(A85)>	#matches the size of the operand (if that can be
%<HELP&(A85)>	#determined).
%<HELP&(A85)>	#.sp 1
%<HELP&(A85)>	#.ti -3
%<HELP&(A85)>	#5)^In the register list specification for the STM and
%<HELP&(A85)>	#LDM instructions, a range can be specified in either
%<HELP&(A85)>	#order (e.g., "R0-R3" or "R3-R0"). Any overlap or
%<HELP&(A85)>	#repetitions in the list are simply merged into the
%<HELP&(A85)>	#final result (e.g., "R3,R3,R1" is th same as "R3,R1").
%<HELP&(A85)>	#.sp 1
%<HELP&(A85)>	#.ti -3
%<HELP&(A85)>	#6)^When using the "@aaaa:24" addressing variation for the
%<HELP&(A85)>	#PJMP and PJSR instructions use
%<HELP&(A85)>	#.in +2 {
%<HELP&(A85)>	#.in +2 {
%<HELP&(A85)>	#.ti -2
%<HELP&(A85)>	#PJMP^^@H'123456^^^^not^^^^PJMP^^@H'3456:12
%<HELP&(A85)>	#.ti -2
%<HELP&(A85)>	#PJSR^^@H'123456^^^^not^^^^PJSR^^@H'3456:12
%<HELP&(A85)>	#.in -2 }
%<HELP&(A85)>	#.in -2 }
%<HELP&(A85)>	#where H'123456 (address H'3456 in page H'12) is the
%<HELP&(A85)>	#target address.
%<HELP&(A85)>	#.sp 1
%<HELP&(A85)>	#.ti -3
%<HELP&(A85)>	#7)^The default radix for any constant is 10 (decimal).
%<HELP&(A85)>	#.sp 1
%<HELP&(A85)>	#.ti -3
%<HELP&(A85)>	#8)^The following are synonymous reserved words:
%<HELP&(A85)>	#.in +2 {
%<HELP&(A85)>	#.in +2 {
%<HELP&(A85)>	#.ti -2
%<HELP&(A85)>	#"R6"^==^"FP"^==^"R6FP"
%<HELP&(A85)>	#.ti -2
%<HELP&(A85)>	#"R7"^==^"SP"^==^"R7SP"
%<HELP&(A85)>	#.in -2 }
%<HELP&(A85)>	#.in -2 }
%<HELP&(A85)>	#.in -3 }
%<HELP&(A85)>	#.in -2 }
%<HELP&(A78)>	#.in +2 {
%<HELP&(A78)>	#.in +3 {
%<HELP&(A78)>	#.ti -3
%<HELP&(A78)>	#1)^The current location counter symbol is the
%<HELP&(A78)>	#dollar sign ($).
%<HELP&(A78)>	#.sp 1
%<HELP&(A78)>	#.ti -3
%<HELP&(A78)>	#2)^Some instructions have aliases (alternate forms).
%<HELP&(A78)>	#Aliases (alternate forms) can be entered instead
%<HELP&(A78)>	#of the standard form.
%<HELP&(A78)>	#.in +2 {
%<HELP&(A78)>	#.in +2 {
%<HELP&(A78)>	#.ti -2
%<HELP&(A78)>	#a.^BL^^^^^for^^^^BC
%<HELP&(A78)>	#.ti -2
%<HELP&(A78)>	#b.^BNL^^^^for^^^^BNC
%<HELP&(A78)>	#.ti -2
%<HELP&(A78)>	#c.^BPO^^^^for^^^^BNV
%<HELP&(A78)>	#.ti -2
%<HELP&(A78)>	#d.^BNE^^^^for^^^^BNZ
%<HELP&(A78)>	#.ti -2
%<HELP&(A78)>	#d.^BPE^^^^for^^^^BV
%<HELP&(A78)>	#.ti -2
%<HELP&(A78)>	#d.^BE^^^^^for^^^^BZ
%<HELP&(A78)>	#.in -2 }
%<HELP&(A78)>	#.in -2 }
%<HELP&(A78)>	#.sp 1
%<HELP&(A78)>	#.ti -3
%<HELP&(A78)>	#3)^When entering an operand as part of an instruction you
%<HELP&(A78)>	#may use a register's function name in place of the absolute
%<HELP&(A78)>	#name (e.g., 'A' instead of 'R1'). The assembler will look
%<HELP&(A78)>	#for an opcode using the function name first and if not
%<HELP&(A78)>	#found for an opcode using the absolute name.
%<HELP&(A78)>	#.sp 1
%<HELP&(A78)>	#.ti -3
%<HELP&(A78)>	#4)^Note that the 'saddr2' and 'sfr' memory ranges
%<HELP&(A78)>	#overlap from 0xlFF00 through 0xlFF1F. For instructions
%<HELP&(A78)>	#that have both 'saddr2' and 'sfr' addressing modes
%<HELP&(A78)>	#the 'saddr2' addressing mode will be chosen, duplicating
%<HELP&(A78)>	#the behavior of the NEC Assembler. If you want to
%<HELP&(A78)>	#force the use of the 'sfr' addressing mode, prefix the
%<HELP&(A78)>	#.rp ~
%<HELP&(A78)>	#symbol name (or address) with the '^' character,
%<HELP&(A78)>	#as in the following example:
%<HELP&(A78)>	#.in +2 {
%<HELP&(A78)>	#.in +2 {
%<HELP&(A78)>	#.ti -2
%<HELP&(A78)>	#~~~~ADDW~~~~~RP1,^P0
%<HELP&(A78)>	#.rp ^
%<HELP&(A78)>	#.in -2 }
%<HELP&(A78)>	#.in -2 }
%<HELP&(A78)>	#.in -3 }
%<HELP&(A78)>	#.in -2 }
%<HELP>	#.($116)Mode
%<HELP>	#The \bMode\r command is used to toggle the display mode between
%<HELP>	#\b'Code'\r mode and \b'Mixed'\r mode.  The 'Code' display mode
%<HELP>	#means just display assembly language instructions.  The 'Mixed'
%<HELP>	#display mode (available only if HLL source is available) means
%<HELP>	#display HLL source images interspersed with the assembly code.
%<HELP>	#.($117)Label-synch
%<HELP>	#The \bLabel-synch\r command is used to toggle label synchronization
%<HELP>	#on and off.  When \bLabel-synch\r is on, the software uses existing
%<HELP>	#code labels and HLL source line number information to verify
%<HELP>	#that disassembly addresses are on
%<HELP>	#instruction boundaries.  If they are not, the software will adjust
%<HELP>	#the address so the disassembly begins on an instruction boundary.
%<HELP>	#If the \bLabel-synch\r mode is off, no such checks are made and
%<HELP>	#the disassembly will start at the specified or currently-highlighted
%<HELP>	#address.
%<HELP>	#.sp 1
%<HELP>	#Note that if \bLabel-synch\r mode is off, the specified or
%<HELP>	#currently-highlighted address may or may not correspond to an
%<HELP>	#instruction boundary and may result in an out-of-synch disassembly.
%<HELP>	#.($118)Display/Alter|Expression
%<HELP>	#The \bExpression\r command can be used to change the value of
%<HELP>	#any program variable, register (including the PC) or memory
%<HELP>	#address (if writable).  When \bExpression\r is selected you will
%<HELP>	#be prompted for the name of the variable, register or memory
%<HELP>	#address to change and for its new value. Memory addresses must
%<HELP>	#include the memory-space qualified constant
%<HELP>	#(see \l($244)Expression^Input\m)
%<HELP>	#to denote which memory space to write.
%<HELP>	#The current value will also be displayed.
%<HELP>	#.sp 1
%<HELP>	#Note that the \bChange^Box\r is just a subset of the
%<HELP>	#Expression Box (when we have pre-determined the variable/expression
%<HELP>	#we are going to change).  For example, when \bEnter\r is
%<HELP>	#pressed (when the \bEnter:Change\r prompt is displayed)
%<HELP>	#for a variable/expression in the \l($384)Watch^Window\m we know
%<HELP>	#what the variable/expression is.
%<HELP&A68>	#.sp 1
%<HELP&A68>	#You can also change the value in the \l($393)CONFIG\m
%<HELP&A68>	#cell/register.
%<HELP&A51>	#.($119)RAM-Bits
%<HELP&A51>	#The \bRAM-Bits\r command is used to view or change bits in the
%<HELP&A51>	#128 directly-addressable bit area of Internal Data memory.
%<HELP&A51>	#A bit's value may be toggled by typing the bit address
%<HELP&A51>	#(absolute or symbolic) or by using the cursor keys to move to
%<HELP&A51>	#the desired bit and then pressing the 'Enter' key.
%<HELP>	#.($120)Misc
%<HELP>	#The \bMisc\rellaneous pull-down menu contains commands
%<HELP>	#that give you access to:
%<HELP>	#.sp 1
%<HELP>	#.in +4 {
%<HELP>	#.in +4 {
%<HELP>	#.ti -4
%<HELP>	#1)^^Unique features of the target processor.
%<HELP>	#.ti -4
%<HELP>	#2)^^Special options/features of the \b%rs1\r emulator.
%<HELP>	#.ti -4
%<HELP>	#3)^^Miscellaneous other things.
%<HELP>	#.in -4 }
%<HELP>	#.in -4 }
%<HELP>	#.($121)File|Exit
%<HELP>	#The \bExit\r command is used to terminate the \b%rs1\r host software
%<HELP>	#and return normally to DOS.
%<HELP>	#You can also exit the host software from the Main Menu Bar by pressing
%<HELP>	#\bEsc\r if the \l$(72)Configure|Options|Main^Esc\m toggle is set to
%<HELP>	#"On".  In either case, the host software will ask you to confirm that
%<HELP>	#you really do want to exit.
%<HELP>	#.sp 1
%<HELP>	#Alternatively, if you use the Hot Key assigned to the Exit
%<HELP>	#command (\bAlt X\r), the host software will exit immediately without
%<HELP>	#asking you for confirmation.
%<HELP>	#.($122)OS Escape
%<HELP>	#The \bOS^Escape\r command suspends the
%<HELP>	#\b%rs1\r system and transfers control to DOS.
%<HELP>	#You can then type any DOS command(s) and invoke other programs
%<HELP>	#(e.g., a text editor, a compiler/assembler or a linker).
%<HELP>	#When you type the \uexit\r command at the DOS prompt,
%<HELP>	#you will resume execution in the \b%rs1\r system at the
%<HELP>	#point of suspension.
%<HELP>	#.sp 1
%<HELP>	#While the \b%rs1\r system is suspended and DOS is active,
%<HELP>	#the DOS prompt will be augmented with a string reminding
%<HELP>	#you how to resume execution in the \b%rs1\r system;
%<HELP>	#you can control whether or not the DOS prompt is augmented
%<HELP>	#in this way via the \l($360)Prompt^OS-Escape\m toggle command.
%<HELP>	#.sp 1
%<HELP>	#By default, before the \b%rs1\r host software suspends itself,
%<HELP>	#it swaps itself out of conventional DOS memory to
%<HELP>	#Expanded Memory (EMS/LIM), Extended Memory (XMS) or disk.
%<HELP>	#Then, all but a tiny amount (about 7K) of conventional
%<HELP>	#memory is freed before control transfers to DOS.
%<HELP>	#Thus, most of conventional memory is available to you while DOS
%<HELP>	#is active.
%<HELP>	#.sp 1
%<HELP>	#NOTES:
%<HELP>	#.sp 1
%<HELP>	#.in +4 {
%<HELP>	#.in +4 {
%<HELP>	#.ti -4
%<HELP>	#1.^^The programs you will use while DOS is active may
%<HELP>	#require more EMS memory or XMS memory than is available
%<HELP>	#by default.  You can control whether or not the \b%rs1\r host software
%<HELP>	#uses EMS or XMS memory to swap itself out of conventional memory
%<HELP>	#before transferring control to DOS.  See
%<HELP>	#the \b-ose\r and \b-osx\r \l($249)command^line^options\m
%<HELP>	#for full details.
%<HELP>	#.sp 1
%<HELP>	#.ti -4
%<HELP>	#2.^^While DOS is active, you cannot install a
%<HELP>	#TSR (Terminate and Stay Resident) program.
%<HELP>	#If you need access to such a TSR program while the host software is
%<HELP>	#suspended and DOS is active, make sure that you install
%<HELP>	#the TSR \ubefore\r invoking the \b%rs1\r host software.
%<HELP>	#.in -4 }
%<HELP>	#.in -4 }
%<HELP>	#.($123)Misc|Virtual Memory
%<HELP>	#(For a general description of virtual memory -- what it is,
%<HELP>	#when/why should you use it,
%<HELP>	#etc. -- see \l($398)Using^Virtual^Memory\m.)
%<HELP>	#.sp 1
%<HELP>	#The \bVirtual Memory\r command displays the following information
%<HELP>	#about the current usage of virtual heap memory:
%<HELP>	#.in +3 {
%<HELP>	#.sp 1
%<HELP>	#Expanded^Memory^Backing^Store
%<HELP>	#.sp 1
%<HELP>	#.in +3 {
%<HELP>	#.in +3 {
%<HELP>	#.ti -3
%<HELP>	#\bEMM^Version\r
%<HELP>	#is the version number of the Expanded Memory Manager (EMM)
%<HELP>	#device driver installed in your system.
%<HELP>	#You can use EMM versions 3.2 and beyond.
%<HELP>	#.sp 1
%<HELP>	#.ti -3
%<HELP>	#\bPage^Frame^Segment\r
%<HELP>	#is the segment address of the 64Kb area called the page frame.
%<HELP>	#This will be somewhere above the conventional memory area
%<HELP>	#used by DOS (0-640Kb) and below the 1Mb boundary of the upper memory
%<HELP>	#area.  The actual address depends on your computer's configuration.
%<HELP>	#.sp 1
%<HELP>	#.ti -3
%<HELP>	#\bMappable^Physical^Pages\r
%<HELP>	#is the number of physical pages in the upper memory area (640K-1M)
%<HELP>	#of your computer into which expanded memory pages can be mapped
%<HELP>	#(or swapped).  The number here is the sum of the:
%<HELP>	#.sp 1
%<HELP>	#.in +3 {
%<HELP>	#.in +4 {
%<HELP>	#.ti -4
%<HELP>	#a.^^number of pages in the Page Frame (usually 4),
%<HELP>	#.ti -4
%<HELP>	#b.^^number of additional mappable pages above the 640Kb boundary.
%<HELP>	#Note that your system may have other mappable pages below the
%<HELP>	#640Kb boundary, but the host software will not use these pages.
%<HELP>	#.in -4 }
%<HELP>	#.in -3 }
%<HELP>	#.sp 1
%<HELP>	#This number represents the amount of expanded memory that the
%<HELP>	#host software can reference directly at any particular time.
%<HELP>	#The larger the value, the more likely that the memory area/node
%<HELP>	#being referenced is directly accessible, and the less likely
%<HELP>	#that the host software will need to swap pages to access the
%<HELP>	#desired memory area/node.
%<HELP>	#.sp 1
%<HELP>	#.ti -3
%<HELP>	#\bTotal^Pages\r
%<HELP>	#is the total number of expanded memory pages in your computer.
%<HELP>	#Each page contains 16Kb of memory.
%<HELP>	#.sp 1
%<HELP>	#.ti -3
%<HELP>	#\bPages^Available\r
%<HELP>	#is the number of pages currently available for allocation by the EMM
%<HELP>	#to the host software.
%<HELP>	#The remainder, if any, of the expanded memory pages in your system are
%<HELP>	#unavailable for use by the host software because they are allocated
%<HELP>	#to other programs or device drivers.
%<HELP>	#.sp 1
%<HELP>	#.ti -3
%<HELP>	#\bPages^Allocated^to^Host^Software\r
%<HELP>	#is the number of pages of expanded memory currently allocated to
%<HELP>	#the host software.
%<HELP>	#.sp 1
%<HELP>	#.ti -3
%<HELP>	#\bCurrently^In^Use^by^Host^Software\r
%<HELP>	#is the percentage of expanded memory which the host software
%<HELP>	#is currently using from the pool of expanded memory pages allocated
%<HELP>	#to the host software.  When this percentage reaches 100%, the
%<HELP>	#host software will request more expanded memory pages from the EMM;
%<HELP>	#the \l($249)-vme\m command line option specifies how many pages
%<HELP>	#will be requested.
%<HELP>	#.sp 1
%<HELP>	#.ti -3
%<HELP>	#\bTotal^Handles^in^System\r
%<HELP>	#is the total number of handles that the EMM supports,
%<HELP>	#including the operating system handle (handle number 0).
%<HELP>	#.sp 1
%<HELP>	#.ti -3
%<HELP>	#\bHandles^Currently^in^Use\r
%<HELP>	#is the number of open (currently in use) EMM handles in the system,
%<HELP>	#including the operating system handle (handle number 0).
%<HELP>	#This includes not only the handles allocated to (in use by) the host
%<HELP>	#software, but also those allocated to all other programs in the system.
%<HELP>	#.in -3 }
%<HELP>	#.in -3 }
%<HELP>	#.sp 1
%<HELP>	#File^Backing^Store
%<HELP>	#.sp 1
%<HELP>	#.in +3 {
%<HELP>	#.in +3 {
%<HELP>	#.ti -3
%<HELP>	#\bReal-Memory^Buffers\r
%<HELP>	#is the number of conventional memory buffers being used
%<HELP>	#to swap blocks in from and out to the backing store file.
%<HELP>	#The \l($249)-vmf\m command line option specifies how many
%<HELP>	#buffers to use.
%<HELP>	#.sp 1
%<HELP>	#.ti -3
%<HELP>	#\bBuffer^(Block)^Size\r
%<HELP>	#is the size of each conventional memory buffer used
%<HELP>	#to swap blocks in from and out to the backing store file.
%<HELP>	#The \l($249)-vmf\m command line option specifies this buffer size.
%<HELP>	#.sp 1
%<HELP>	#The product of \bReal-Memory^Buffers\r times \bBuffer^(Block)^Size\r
%<HELP>	#represents the amount of real memory that the
%<HELP>	#host software can reference directly at any particular time.
%<HELP>	#The larger the value, the more likely that the memory area/node
%<HELP>	#being referenced is directly accessible, and the less likely
%<HELP>	#that the host software will need to swap blocks to/from the backing
%<HELP>	#store file to access the desired memory area/node.
%<HELP>	#.sp 1
%<HELP>	#.ti -3
%<HELP>	#\bFile^Blocks^Allocated\r
%<HELP>	#is the number of blocks (of size \bBuffer^(Block)^Size\r each)
%<HELP>	#currently needed by the host software.
%<HELP>	#Essentially, this is the current size of the backing store file.
%<HELP>	#.sp 1
%<HELP>	#.ti -3
%<HELP>	#\bCurrently^In^Use^by^Host^Software\r
%<HELP>	#is the percentage of file backing store which the host software
%<HELP>	#is currently actually using.
%<HELP>	#When this percentage reaches 100%, the
%<HELP>	#host software will increase the size of the backing store file
%<HELP>	#to create more virtual memory.
%<HELP>	#.in -3 }
%<HELP>	#.in -3 }
%<HELP>	#.in -3 }
%<HELP>	#.sp 1
%<HELP>	#For information on how to control what kind of backing store,
%<HELP>	#if any, to be used for virtual memory,
%<HELP>	#see the description of the \l($249)-vme,^-vmf^and^-vmfn\m command
%<HELP>	#line options.
%<HELP&A80>	#.($124)
%<HELP&A80>	#The Programmer Command is used to pop-up the
%<HELP&A80>	#\l($462)Programmer^Menu\m.  The Programmer Menu gives you the
%<HELP&A80>	#capability to program PROM's and EPROM's.
%<HELP&A51>	#.($125)A-to-D Converter
%<HELP&A51>	#The A-to-D-converter command is used to read the
%<HELP&A51>	#Analog to Digital  converter.
%<HELP&A51>	#The content of each channel is displayed in hexadecimal.
%<HELP&A51>	#NOTE:  Reading the A to D converter will modify certain registers:
%<HELP&A51>	#.sp 1
%<HELP&A51>	#.in +2 {
%<HELP&A51>	#.ba {
%<HELP&A51>	#512,532,515,535:  ADCON, ADDAT, DAPR, and IRCON
%<HELP&A51>	#517,537:          ADCON0, ADCON1, ADDAT, DAPR, and IRCON
%<HELP&A51>	#517A:             ADCON0, ADCON1, ADDATH, ADDATL, and IRCON0
%<HELP&A51>	#550:              ADAT and ADCON
%<HELP&A51>	#552:              ADCH and ADCON
%<HELP&A51>	#752:              ADAT and ADCON
%<HELP&A51>	#.ea }
%<HELP&A51>	#.in -2 }
%<HELP>	#.($126)MDU
%<HELP>	#The Multiplication-division-unit Command is used to display
%<HELP>	#the results of an arithmetic operation involving the
%<HELP>	#Multiplication / Division Unit (MDU) of the
%<HELP&A51>	#'517 and '537.
%<HELP&A80>	#COP888EW and COP888GW.
%<HELP&A65>	#MSM65512, MSM65513, etc.
%<HELP&A51>	#The results are displayed
%<HELP&A51>	#as signed or unsigned decimal numbers.
%<HELP>	#.sp 1
%<HELP>	#Note that this command will be de-activated if the device being used
%<HELP>	#does not have an MDU.
%<HELP&A51>	#.($127)DPTRs (multiple)
%<HELP&A51>	#The \bDPTRs^(multiple)\r command reads and displays all the
%<HELP&A51>	#possible DPTR (Data Pointer) register values for those chips
%<HELP&A51>	#that have multiple DPTRs or an Alternate DPTR.
%<HELP&A51>	#.sp 1
%<HELP&A51>	#Note that this command will be de-activated if the device being
%<HELP&A51>	#used has just one DPTR.
%<HELP&A51>	#.($128)FIFO
%<HELP&A51>	#The \bFIFO\r command reads and displays the FIFO
%<HELP&A51>	#on the 80C152/83C152 and the 80C452.
%<HELP&A51>	#.sp 1
%<HELP&A51>	#Note that this command will be de-activated if the device being
%<HELP&A51>	#used does not have a FIFO.
%<HELP&A51>	#.sp 1
%<HELP&A51>	#\uNOTE\r:^^Once the FIFO is read, the data in the FIFO is lost.
%<HELP>	#.($130)Source/Symbols
%<HELP>	#When the \bSource/Symbols\r command is selected a pull-down menu
%<HELP>	#of options relating to High Level Language and Symbol display
%<HELP>	#and search is displayed.
%<HELP>	#.($131)Source/Symbols|Module Update
%<HELP>	#The \bModule^Update\r command is used to select the
%<HELP>	#\bModule^Update^Mode\r.  This mode determines how the software
%<HELP>	#will decide what the \l($134)Current^Module\m is.  The mode
%<HELP>	#choices are \l($132)Auto\m (automatic) and \l($133)User\m
%<HELP>	#(user-defined).
%<HELP>	#.sp 1
%<HELP>	#Note that this command will be de-activated if the loaded program
%<HELP>	#has no module information.
%<HELP>	#.($132)Source/Symbols|Module Update|Auto
%<HELP>	#The \bAuto\r \l($131)Module^Update\m Mode means that the software will
%<HELP>	#automatically determine what the \l($134)Current^Module\m is.
%<HELP>	#This determination is made based on the PC address.  If the
%<HELP>	#PC address falls within the address range of a module, that
%<HELP>	#module will be made the Current Module.
%<HELP>	#.($133)Source/Symbols|Module Update|User
%<HELP>	#The \bUser\r \l($131)Module^Update\m Mode means that you have set
%<HELP>	#(or will set) the \l($134)Current^Module\m to a specific
%<HELP>	#module which will remain the Current Module until the
%<HELP>	#Module Update Mode is changed to Automatic or until
%<HELP>	#you change the Current Module.
%<HELP>	#.($134)Source/Symbols|Current Module
%<HELP>	#The \bCurrent^Module\r command is used to set the
%<HELP>	#Current Module to a specific module.  When a Current Module
%<HELP>	#has been set this way the \l($131)Module^Update^Mode\m is
%<HELP>	#set to \l($133)User\m.
%<HELP>	#.sp 1
%<HELP>	#The concept of the Current Module is to make Symbolic searches
%<HELP>	#context sensitive.
%<HELP>	#If there are two symbols with the same name (that were defined
%<HELP>	#in two different modules) the Current Module will be searched
%<HELP>	#first.
%<HELP>	#.sp 1
%<HELP>	#Note that this command will be de-activated if the loaded program
%<HELP>	#has no module information.
%<HELP>	#.($135)Source/Symbols|Source Path
%<HELP>	#The \bSource^Path\r command is used to set the  HLL (High Level
%<HELP>	#Language) source search path directory used to locate the source or
%<HELP>	#listing files for each module in the program currently loaded into
%<HELP>	#memory.  The source files (C) or listing files (PL/M) must
%<HELP>	#exist in the HLL source search path to enable the \b%rs1\r host
%<HELP>	#software to locate and display HLL source images.
%<HELP>	#.sp 1
%<HELP>	#You can also set the HLL source search path using the \b'-s'\r
%<HELP>	#\l($249)Command^Line^Option\m.
%<HELP>	#.sp 1
%<HELP>	#NOTE:^^If you do not explicitly set the HLL source search path (using
%<HELP>	#this command or
%<HELP>	#the \b'-s'\r
%<HELP>	#\l($249)Command^Line^Option\m),
%<HELP>	#the \b%rs1\r host software will automatically set the HLL source
%<HELP>	#search path to the same path as the file you most recently loaded
%<HELP>	#using the \l($86)File|Load\m command.
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#If you ever \bdo\r explicitly set the HLL source search path (using
%<HELP>	#this command or
%<HELP>	#the \b'-s'\r
%<HELP>	#\l($249)Command^Line^Option\m),
%<HELP>	#and then later want the host software to automatically set the
%<HELP>	#HLL source search path to the same path as the file you most recently
%<HELP>	#loaded using the \l($86)File|Load\m command,
%<HELP>	#just specify the HLL source search path here as the empty string
%<HELP>	#(no/zero characters).
%<HELP>	#.in -2 }
%<HELP>	#.($136)Source/Symbols|Raw Source
%<HELP>	#The \bRaw^Source\r command can be used to display the raw source
%<HELP>	#file for a specified module or any plain text file.  A raw source
%<HELP>	#file will be displayed if a valid module name is entered at the
%<HELP>	#\bModule/File\r prompt.  If a non-module name is entered it will
%<HELP>	#be treated as a standard file name and displayed if found.  Note
%<HELP>	#that raw source files will be searched for in the directory specified
%<HELP>	#by the \l($135)Source^Path\m command.  Other files must use the
%<HELP>	#full DOS specification (drive and path) if not located in the
%<HELP>	#current directory.
%<HELP>	#.sp 1
%<HELP>	#When a raw source file is displayed each source line image is
%<HELP>	#preceded by its line number.  The line numbers that are highlighted
%<HELP>	#specially correspond to line numbers with
%<HELP>	#entries in that module's line number table, meaning they may
%<HELP>	#be referenced symbolically throughout the software.  In addition,
%<HELP>	#file information, such as the source language and source filename
%<HELP>	#are displayed along with the name of the module.  The module
%<HELP>	#being displayed can be changed by typing a new module name at the
%<HELP>	#\bModule/File\r prompt.
%<HELP>	#.sp 1
%<HELP>	#When a plain text file is displayed each line is displayed without
%<HELP>	#line numbers.  The total number of lines in the file is displayed
%<HELP>	#in the upper right corner of the window.
%<HELP>	#.sp 1
%<HELP>	#The displayed source images or lines can be positioned quickly to a
%<HELP>	#particular line number by typing the desired line number
%<HELP>	#at the \bLine Number\r prompt.
%<HELP>	#.($137)Source/Symbols|Modules
%<HELP>	#The \bModules\r command displays module information for all
%<HELP>	#modules.  The information is displayed sorted by module
%<HELP>	#address range.
%<HELP>	#.sp 1
%<HELP>	#Further information for the \bModules\r command is available for:
%<HELP>	#.in +4 {
%<HELP>	#.sp 1
%<HELP>	#.ti -2
%<HELP>	#\l($365)Enter^Module^Prompt\m
%<HELP>	#.sp 1
%<HELP>	#.ti -2
%<HELP>	#\l($367)Screen^Content\m
%<HELP>	#.in -4 }
%<HELP>	#.sp 1
%<HELP>	#Note that this command will be de-activated if the loaded program
%<HELP>	#has no module information.
%<HELP>	#.($138)Source/Symbols|Scopes
%<HELP>	#The \bScopes\r command displays scope information for all
%<HELP>	#modules and procedures.  The information is displayed sorted
%<HELP>	#first by module address range and then alphabetically by
%<HELP>	#procedure name within each module.
%<HELP>	#.sp 1
%<HELP>	#Further information for the \bScopes\r command is available for:
%<HELP>	#.in +4 {
%<HELP>	#.sp 1
%<HELP>	#.ti -2
%<HELP>	#\l($365)Enter^Mod/Proc^Prompt\m
%<HELP>	#.sp 1
%<HELP>	#.ti -2
%<HELP>	#\l($367)Screen^Content\m
%<HELP>	#.in -4 }
%<HELP>	#.sp 1
%<HELP>	#Note that this command will be de-activated if the loaded program
%<HELP>	#has no scope information.
%<HELP>	#.($139)Source/Symbols|Line Numbers
%<HELP>	#The \bLine^Numbers\r command displays line number information for
%<HELP>	#all modules.  The information is displayed sorted first by module
%<HELP>	#address range and then by ascending line numbers within each module.
%<HELP>	#.sp 1
%<HELP>	#Two screen modes are available for line number information for
%<HELP>	#this command.  The \bnarrow\r screen contains the \bLine^Number\r,
%<HELP>	#its \bAddress\r and the names of any \bSymbols\r defined at
%<HELP>	#that address.
%<HELP>	#The \bwide\r screen contains (in addition to the line number,
%<HELP>	#address and symbol name) the \bSource Image\r for the line number.
%<HELP>	#For lines describing modules, the information displayed for
%<HELP>	#each module is the \baddress^range\r and \bname\r.
%<HELP>	#.sp 1
%<HELP>	#Further information for the \bLine^Numbers\r command is available for:
%<HELP>	#.in +4 {
%<HELP>	#.sp 1
%<HELP>	#.ti -2
%<HELP>	#\l($365)Enter^Module^Prompt\m
%<HELP>	#.in -4 }
%<HELP>	#.sp 1
%<HELP>	#Note that this command will be de-activated if the loaded program
%<HELP>	#has no line number information.
%<HELP>	#.($140)Source/Symbols|Global
%<HELP>	#The \bGlobal\r command displays all global
%<HELP>	#(public) symbols associated with the program currently loaded in
%<HELP>	#memory.  Symbols are listed sorted alphabetically.
%<HELP>	#.sp 1
%<HELP>	#Further information for the \bGlobal\r command is available for:
%<HELP>	#.in +4 {
%<HELP>	#.sp 1
%<HELP>	#.ti -2
%<HELP>	#\l($365)Enter^Symbol^Prompt\m
%<HELP>	#.sp 1
%<HELP>	#.ti -2
%<HELP>	#\l($366)Screen^Content\m
%<HELP>	#.in -4 }
%<HELP>	#.($141)Source/Symbols|Local
%<HELP>	#The \bLocal\r command displays all local symbols
%<HELP>	#associated with the program currently loaded in memory.
%<HELP>	#Symbols are listed sorted first by module (or procedure) and
%<HELP>	#then alphabetically within each module.
%<HELP>	#.sp 1
%<HELP>	#In addition to the normal screen content for the symbol displays
%<HELP>	#the address range and name for each module (or procedure) is
%<HELP>	#displayed before the symbols for that module (or procedure).
%<HELP>	#.sp 1
%<HELP>	#Further information for the \bLocal\r command is available for:
%<HELP>	#.in +4 {
%<HELP>	#.sp 1
%<HELP>	#.ti -2
%<HELP>	#\l($365)Enter^Symbol^Prompt\m
%<HELP>	#.sp 1
%<HELP>	#.ti -2
%<HELP>	#\l($366)Screen^Content\m
%<HELP>	#.in -4 }
%<HELP>	#.sp 1
%<HELP>	#Note that this command will be de-activated if the loaded program
%<HELP>	#has no local symbols.
%<HELP>	#.($142)Source/Symbols|Alpha
%<HELP>	#The \bAlpha\r command displays all local and global
%<HELP>	#(public) symbols associated with the program currently loaded in
%<HELP>	#memory.  Symbols are listed sorted alphabetically.
%<HELP>	#.sp 1
%<HELP>	#Further information for the \bAlpha\r command is available for:
%<HELP>	#.in +4 {
%<HELP>	#.sp 1
%<HELP>	#.ti -2
%<HELP>	#\l($365)Enter^Symbol^Prompt\m
%<HELP>	#.sp 1
%<HELP>	#.ti -2
%<HELP>	#\l($366)Screen^Content\m
%<HELP>	#.in -4 }
%<HELP>	#.($143)Source/Symbols|Address
%<HELP>	#The \bAddress\r command displays all local and global
%<HELP>	#(public) symbols associated with the program currently loaded in
%<HELP>	#memory.  Symbols are listed sorted first by memory space
%<HELP>	#and then by address within each memory space.
%<HELP>	#The Left-arrow (\x1B) and Right-arrow (\x1A) keys select the
%<HELP>	#desired memory space
%<HELP>	#and scroll the display to the first symbol in that memory space.
%<HELP>	#If no symbols exist in a particular memory space the
%<HELP>	#Left-arrow (\x1B) and Right-arrow (\x1A) keys will
%<HELP>	#skip that memory space.
%<HELP>	#.sp 1
%<HELP>	#Further information for the \bAddress\r command is available for:
%<HELP>	#.in +4 {
%<HELP>	#.sp 1
%<HELP>	#.ti -2
%<HELP>	#\l($365)Enter^Symbol^Prompt\m
%<HELP>	#.sp 1
%<HELP>	#.ti -2
%<HELP>	#\l($366)Screen^Content\m
%<HELP>	#.in -4 }
%<HELP>	#.($144)Break/Trace
%<HELP>	#The \bBreak/Trace\r command pulls down a menu which gives you direct
%<HELP>	#access the the break-point and tracing features of the emulator.
%<HELP>	#.($145)Trace Trigger
%<HELP>	#The \bTrace^Trigger\r command is used to select
%<HELP>	#either the \l($146)Start\m, \l($147)Center\m, \l($148)End\m
%<HELP>	#or \l($149)Variable\m settings for the Trace Trigger.
%<HELP>	#.sp 1
%<HELP>	#The Status Window shows the current value of the trace trigger
%<HELP>	#in the "Trig:" field.
%<HELP>	#.sp 1
%<HELP>	#The Trace Trigger controls when emulation stops,
%<HELP>	#relative to the actual break-point, in terms of the amount of
%<HELP>	#information captured into the trace buffer.
%<HELP>	#.($146)Start
%<HELP>	#When you select the \bStart\r Trace Trigger,
%<HELP>	#emulation does not actually stop until another buffer full of
%<HELP>	#trace frames accumulate in the emulator's Trace Memory
%<HELP>	#\ufollowing\r execution of the instruction at the break-point.
%<HELP>	#(One buffer full of trace frames is the number
%<HELP>	#of trace frames in the emulator's Trace Memory.)
%<HELP>	#.($147)Center
%<HELP>	#When you select the \bCenter\r Trace Trigger,
%<HELP>	#emulation does not actually stop until another \uhalf\r buffer full of
%<HELP>	#trace frames accumulate in the emulator's Trace Memory
%<HELP>	#\ufollowing\r execution of the instruction at the break-point.
%<HELP>	#(One buffer full of trace frames is the number
%<HELP>	#of trace frames in the emulator's Trace Memory.)
%<HELP>	#.($148)End
%<HELP>	#When you select the \bEnd\r Trace Trigger,
%<HELP>	#emulation stops immediately upon reaching the first break-point
%<HELP>	#(i.e., zero (0) additional frames accumulate in the
%<HELP>	#trace buffer following the break-point).
%<HELP>	#.sp 1
%<HELP>	#This is the default Trace Trigger value.
%<HELP>	#.($149)Variable
%<HELP>	#When you select the \bVariable\r Trace Trigger,
%<HELP>	#you can specify exactly how many trace frames will accumulate in the
%<HELP>	#trace buffer following the break-point before emulation actually stops.
%<HELP&(A51|A68|A05)>	#.($150)Break-Count
%<HELP&(A51|A68|A05)>	#You use the \bBreak-Count\r command to
%<HELP&(A51|A68|A05)>	#specify the number of code-break-points
%<HELP&(A51|A68|A05)>	#to be reached ("passed through") during
%<HELP&(A51|A68|A05)>	#real-time emulation before emulation
%<HELP&(A51|A68|A05)>	#actually stops. Essentially, the emulator
%<HELP&(A51|A68|A05)>	#ignores all break-points until the
%<HELP&(A51|A68|A05)>	#Break-Counter decrements to zero.
%<HELP&(A51|A68|A05)>	#Unlike the \l($271)Repetition^Count\mer,
%<HELP&(A51|A68|A05)>	#the Break-Counter is hardware-controlled
%<HELP&(A51|A68|A05)>	#and operates nonintrusively during
%<HELP&(A51|A68|A05)>	#full-speed, real-time emulation.
%<HELP&(A51|A68|A05)>	#.sp 1
%<HELP&(A51        )>	#Note that xdata-break-points have
%<HELP&(A51        )>	#have no effect on the Break-Count.
%<HELP&(A51        )>	#.sp 1
%<HELP&(A51|A68|A05)>	#The Status Window shows the current
%<HELP&(A51|A68|A05)>	#Break-Count value in the "\bBrkCnt\r" field.
%<HELP>	#.($151)Set
%<HELP>	#The \bSet\r command displays the pop-up \bBreak^Menu\r from which
%<HELP>	#you may \l($161)Add\m, \l($167)Remove\m, \l($154)Edit\m or
%<HELP>	#just view \l($152)Simple\m
%<HELP&CBE>	#and \l($153)Complex\m
%<HELP>	#breaks.
%<HELP>	#If any breaks are added or edited in the pop up \bBreak^Menu\r,
%<HELP>	#they are evaluated and set only upon exit from
%<HELP>	#the pop up \bBreak^Menu\r.
%<HELP&CBE>	#.sp 1
%<HELP&CBE>	#The pop up \bBreak^Menu\r also provides access to the pop up
%<HELP&CBE>	#\l($172)Opcode^Class^Menu\m.
%<HELP>	#.($152)Simple Breaks
%<HELP>	#\bSimple^Breaks\r are single addresses or address ranges where
%<HELP>	#break-points and pass-count-points (if available)
%<HELP>	#are set and where trace is turned ON or OFF.
%<HELP>	#.sp 1
%<HELP&A05>		#A \l($164)Trace-On-Point\m,
%<HELP&A05>		#\l($165)Trace-Off-Point\m and
%<HELP&A05>		#\l($391)Write^Access^Break-Point\m
%<HELP&A05>		#may be set for any code memory address (or range).
%<HELP&A05>		#A \l($162)Code^Break-Point\m
%<HELP&A05>		#may be set for any code memory address (or range)
%<HELP&A05>		#except in the Boot ROM, EEPROM or Register Block areas.
%<HELP&A05>		#A \l($166)Write^Protect^Break-Point\m
%<HELP&A05>		#may be set for any code memory address (or range)
%<HELP&A05>		#mapped to the emulator
%<HELP&A05>		#except in the Boot ROM, EEPROM and Register Block areas.
%<HELP&A25>		#A \l($162)Code^Break-Point\m,
%<HELP&A25>		#\l($164)Trace-On-Point\m,
%<HELP&A25>		#\l($165)Trace-Off-Point\m,
%<HELP&A25>		#\l($168)Pass-Count-Point\m,
%<HELP&A25>		#\l($391)Write^Access^Break-Point\m and
%<HELP&A25>		#\l($534)Data^Address^Break-Point\m
%<HELP&A25>		#may be set for any code memory address (or range)
%<HELP&A25>		#except in the RAM, Boot ROM, EEPROM or Register
%<HELP&A25>		#Block areas.
%<HELP&A51>		#A \l($162)Code^Break-Point\m,
%<HELP&A51>		#\l($164)Trace-On-Point\m,
%<HELP&A51>		#\l($165)Trace-Off-Point\m
%<HELP&A51>		#and \l($168)Pass-Count-Point\m (PE only)
%<HELP&A51>		#may be set for any code memory address (or range).
%<HELP&A51>		#An \l($163)External^Data^Break-Point\m may be set
%<HELP&A51>		#for any External Data address (or range).
%<HELP&A65>		#A \l($162)Code^Break-Point\m,
%<HELP&A65>		#\l($164)Trace-On-Point\m,
%<HELP&A65>		#\l($165)Trace-Off-Point\m,
%<HELP&A65>		#and \l($168)Pass-Count-Point\m
%<HELP&A65>		#may be set for any general memory address (or range).
%<HELP&A65>		#A \l($391)Write^Access^Break-Point\m and
%<HELP&A65>		#\l($534)Data^Address^Break-Point\m may be set for any
%<HELP&A65>		#Data address (or range).
%<HELP&A68>		#A \l($164)Trace-On-Point\m,
%<HELP&A68>		#\l($165)Trace-Off-Point\m and
%<HELP&A68>		#\l($391)Write^Access^Break-Point\m
%<HELP&A68>		#may be set for any code memory address (or range).
%<HELP&A68>		#A \l($162)Code^Break-Point\m
%<HELP&A68>		#may be set for any code memory address (or range)
%<HELP&A68>		#except in the RAM, Boot ROM, EEPROM or Register Block areas.
%<HELP&A68>		#A \l($166)Write^Protect^Break-Point\m
%<HELP&A68>		#may be set for any code memory address (or range)
%<HELP&A68>		#mapped to the emulator
%<HELP&A68>		#except in the RAM, Boot ROM, EEPROM and Register Block areas.
%<HELP&A78>		#A \l($162)Code^Break-Point\m,
%<HELP&A78>		#\l($164)Trace-On-Point\m,
%<HELP&A78>		#\l($165)Trace-Off-Point\m,
%<HELP&A78>		#\l($168)Pass-Count-Point\m,
%<HELP&A78>		#\l($391)Write^Access^Break-Point\m and
%<HELP&A78>		#\l($534)Data^Address^Break-Point\m
%<HELP&A78>		#may be set for any code memory address (or range).
%<HELP&A80>		#A \l($162)Code^Break-Point\m,
%<HELP&A80>		#\l($164)Trace-On-Point\m,
%<HELP&A80>		#\l($165)Trace-Off-Point\m
%<HELP&A80>		#and \l($168)Pass-Count-Point\m
%<HELP&A80>		#may be set for any code memory address (or range).
%<HELP&A85>		#A \l($162)Code^Break-Point\m,
%<HELP&A85>		#\l($164)Trace-On-Point\m,
%<HELP&A85>		#\l($165)Trace-Off-Point\m,
%<HELP&A85>		#\l($168)Pass-Count-Point\m,
%<HELP&A85>		#\l($391)Write^Access^Break-Point\m and
%<HELP&A85>		#\l($534)Data^Address^Break-Point\m may be set for any
%<HELP&A85>		#memory address (or range).
%<HELP&(A05|A25|A68)>	#.sp 1
%<HELP&(A05|A25|A68)>	#Note that if a defined range
%<HELP&(A05|A25|A68)>	#of a \bSimple^Break\r
%<HELP&(A05|A25|A68)>	#element violates any of the
%<HELP&(A05|A25|A68)>	#constraints mentioned above
%<HELP&(A05|A25|A68)>	#the \bSimple^Break\r element
%<HELP&(A05|A25|A68)>	#may be removed or modified,
%<HELP&(A05|A25|A68)>	#and more \bSimple^Break\r
%<HELP&(A05|A25|A68)>	#elements may be created to
%<HELP&(A05|A25|A68)>	#cover the defined range.
%<HELP&CBE>	#.sp 1
%<HELP&CBE>	#Use the \bTAB\r key to toggle between the \bSimple^Break\r
%<HELP&CBE>	#window and the \l($153)Complex^Break\m window.
%<HELP&CBE>	#.($153)Complex Breaks
%<HELP&CBE>	#\bComplex^Breaks\r can be \l($162)Code^Break-Point\ms,
%<HELP&CBE&(A51|A65|A80)>	#\l($168)Pass-Count-Point\ms (if available),
%<HELP&CBE>	#\l($164)Trace-On-Point\ms or \l($165)Trace-Off-Point\ms.
%<HELP&CBE>	#Each \bComplex^Break\r element (one per line) is evaluated as the
%<HELP&CBE>	#\uAND\r condition of a \l($155)Code^Address\m (or range), a
%<HELP&CBE&(!A65)>	#\l($156)Direct^Address\m (or range),
%<HELP&CBE&( A65)>	#\l($156)Local^Memory^Direct^Address\m (or range),
%<HELP&CBE&( A65)>	#\l($535)General^Memory^Direct^Address\m (or range),
%<HELP&CBE&(A51|A65)>	#a \l($157)Bit^Address\m (or range),
%<HELP&CBE&A68>			#a \l($157)Bit^Mask\m (or range),
%<HELP&CBE&(A68|A05)>	#an \l($171)Extended^Address\m (or range),
%<HELP&CBE&(A80|A05)>	#a \l($157)Bit^Number\m (or range),
%<HELP&CBE>	#an \l($158)Opcode^Value\m (or range of values), an
%<HELP&CBE>	#\l($160)Immediate^Operand^Value\m (or range of values) and
%<HELP&CBE>	#an \l($159)Opcode^Class\m.  If any of the fields are left blank
%<HELP&CBE>	#they are not \uAND\red during the evaluation.
%<HELP&CBE>	#.sp 1
%<HELP&CBE>	#Obviously, it is easy to create a \bComplex^Break\r element
%<HELP&CBE>	#that makes no sense.  For example, if an opcode value of
%<HELP&CBE&A05>	#98h (CLC)
%<HELP&CBE&A51>	#80h (SJMP)
%<HELP&CBE&A65>	#3Eh (JC)
%<HELP&CBE&A68>	#7Eh (JMP)
%<HELP&CBE&A80>	#20h (JMP)
%<HELP&CBE>	#is selected along with any direct address this element
%<HELP&CBE>	#will evaluate to NULL.  When the \bComplex^Breaks\r are
%<HELP&CBE>	#evaluated, NULL elements are considered errors and you will
%<HELP&CBE>	#be notified of that by an error message.
%<HELP&CBE>	#The \bComplex^Break\r element(s) that evaluate to NULL will
%<HELP&CBE>	#be marked in the \bComplex^Break\r window by replacing the
%<HELP&CBE>	#break type (\l($162)CBREAK\m, \l($164)TRON\m, \l($165)TROFF\m
%<HELP&CBE&( (A51|A65|A80))>	#and \l($168)PCOUNT\m)
%<HELP&CBE&(!(A51|A65|A80))>	#)
%<HELP&CBE>	#with the type \bNULL\r.  The type will remain \bNULL\r until
%<HELP&CBE>	#\bComplex^Break\r elements are re-evaluated.
%<HELP&CBE>	#.sp 1
%<HELP&CBE>	#The TAB key is used to toggle between the \bComplex^Break\r
%<HELP&CBE>	#window and the \l($152)Simple^Break\m window.  When the
%<HELP&CBE>	#\l($170)Symbolic^Mode\m is active \bCtrl-\x1B\r and \bCtrl-\x1A\r
%<HELP&CBE>	#are used to change the displayed \bComplex^Break\r fields (all
%<HELP&CBE>	#fields cannot fit on the screen at one time).
%<HELP&CBE>	#.sp 1
%<HELP&CBE>	#Note that \bComplex^Break\rs are active only over the span of
%<HELP&CBE>	#the program in memory.  If there is no program in memory
%<HELP&CBE>	#\bComplex^Break\r elements will not be evaluated.  The current
%<HELP&CBE>	#range of the program in memory is displayed on the bar separating
%<HELP&CBE>	#the \l($152)Simple^Break\m and \bComplex^Break\r window.
%<HELP&CBE>	#.sp 1
%<HELP&CBE>	#In addition, \bComplex^Break\rs are not active in
%<HELP&CBE>	#in RAM, Boot ROM, EEPROM or Register Block areas.
%<HELP>	#.($154)Edit
%<HELP>	#If the
%<HELP&CBE>	#\l($152)Simple^Break\m window is the current window when the
%<HELP>	#\bEdit\r command is selected, a dialog box will pop up
%<HELP>	#to prompt for an address range for a \bSimple^Break\r.
%<HELP&CBE>	#.sp 1
%<HELP&CBE>	#If the \l($153)Complex^Break\m window is the current window
%<HELP&CBE>	#when the \bEdit\r command is selected, a pull-down menu is
%<HELP&CBE>	#called from which you can select which \bComplex^Break\r
%<HELP&CBE>	#field to \bEdit\r, \l($155)Code^Address\m,
%<HELP&CBE&(!A65)>	#\l($156)Direct^Address\m,
%<HELP&CBE&( A65)>	#\l($156)Local^Memory^Direct^Address\m,
%<HELP&CBE&( A65)>	#\l($535)General^Memory^Direct^Address\m,
%<HELP&CBE&(A51|A65)>	#\l($157)Bit^Address\m,
%<HELP&CBE&(A68|A05)>	#\l($171)Extended^Address\m,
%<HELP&CBE&A68>			#\l($157)Bit^Mask\m,
%<HELP&CBE&(A80|A05)>	#\l($157)Bit^Number\m,
%<HELP&CBE>	#\l($158)Opcode^Value\m, \l($159)Opcode^Class\m, or
%<HELP&CBE>	#\l($160)Immediate^Operand\m.
%<HELP&CBE>	#.($155)Break-points:  Code Address Range
%<HELP&CBE>	#When the \bCode^Address^Range\r command is selected a dialog box
%<HELP&CBE>	#will pop up to prompt for a \bCode^Address^Range\r.  Either a
%<HELP&CBE>	#single address or an address range may be entered (numerically or
%<HELP&CBE>	#symbolically).
%<HELP&CBE&(!A65)>	#.($156)Break-points:  Direct Address Range
%<HELP&CBE&  A65 >	#.($156)Break-points:  Local Memory Direct Address Range
%<HELP&CBE>	#When the
%<HELP&CBE&A65>	#\bLocal^Memory\r
%<HELP&CBE>	#\bDirect^Address^Range\r command is selected a dialog box
%<HELP&CBE>	#will pop up to prompt for a
%<HELP&CBE&A65>	#\bLocal^Memory\r
%<HELP&CBE>	#\bDirect^Address^Range\r.  Either a
%<HELP&CBE>	#single address or an address range may be entered (numerically or
%<HELP&CBE>	#symbolically).
%<HELP&CBE>	#.sp 1
%<HELP&CBE>	#When \l($153)Complex^Breaks\m are evaluated, a
%<HELP&CBE&A65>	#local memory
%<HELP&CBE>	#direct address
%<HELP&CBE>	#(or range) is evaluated by searching the program loaded in
%<HELP&CBE>	#memory for instructions that have
%<HELP&CBE&A65>	#local memory
%<HELP&CBE>	#direct operands and then comparing
%<HELP&CBE>	#the entered address (or range) with those operands when found.
%<HELP&CBE&A65>	#.sp 1
%<HELP&CBE&A65>	#Note that this will not set breaks on instructions that use
%<HELP&CBE&A65>	#the LMP bit (in PSW) to determine the page because the state
%<HELP&CBE&A65>	#of the LMP bit (at the time the instruction is executed)
%<HELP&CBE&A65>	#cannot be determined when the complex break is evaluated.
%<HELP&CBE&(A51|A65)>	#.($157)Break-points:  Bit Address Range
%<HELP&CBE&(A51|A65)>	#When the \bBit^Address^Range\r command is selected
%<HELP&CBE&(A51|A65)>	#a dialog box will pop up to prompt for a
%<HELP&CBE&(A51|A65)>	#\bBit^Address^Range\r.  Either a single address or
%<HELP&CBE&(A51|A65)>	#an address range may be entered (numerically or
%<HELP&CBE&(A51|A65)>	#symbolically).
%<HELP&CBE&(A51|A65)>	#.sp 1
%<HELP&CBE&(A51|A65)>	#When \l($153)Complex^Breaks\m are evaluated, a bit
%<HELP&CBE&(A51|A65)>	#address (or range) is evaluated by searching the
%<HELP&CBE&(A51|A65)>	#program loaded in memory for instructions that
%<HELP&CBE&(A51|A65)>	#have bit direct operands and then comparing the entered
%<HELP&CBE&(A51|A65)>	#address (or range) with those operands when found.
%<HELP&CBE&(    A65)>	#.sp 1
%<HELP&CBE&(    A65)>	#Note that this command will only set breaks on
%<HELP&CBE&(    A65)>	#instructions that use the bit direct addressing
%<HELP&CBE&(    A65)>	#mode for operands in local memory such as 'SB addrp0.7'
%<HELP&CBE&(    A65)>	#or 'RB addrp1.3' where 'addrp0' is a symbol defined
%<HELP&CBE&(    A65)>	#explicitly in page 0 and 'addrp1' is a symbol defined
%<HELP&CBE&(    A65)>	#explicitly in page 1.
%<HELP&CBE&A68>	#.($157)Break-points:  Bit Mask Range
%<HELP&CBE&A68>	#When the \bBit^Mask^Range\r command is selected a dialog box
%<HELP&CBE&A68>	#will pop up to prompt for a \bBit^Mask^Range\r.  Either a
%<HELP&CBE&A68>	#single mask value or a range of bit mask values may be entered
%<HELP&CBE&A68>	#(numerically or symbolically).
%<HELP&CBE&A68>	#.sp 1
%<HELP&CBE&A68>	#When \l($153)Complex^Breaks\m are evaluated, a bit mask value
%<HELP&CBE&A68>	#(or range) is evaluated by searching the program loaded in
%<HELP&CBE&A68>	#memory for instructions that have bit mask operands and then
%<HELP&CBE&A68>	#comparing the entered mask (or range) with those operands when
%<HELP&CBE&A68>	#found.
%<HELP&CBE&(A80|A05)>	#.($157)Break-points:  Bit Number Range
%<HELP&CBE&(A80|A05)>	#When the \bBit^Number^Range\r command is selected
%<HELP&CBE&(A80|A05)>	#a dailog box will pop up to prompt for a
%<HELP&CBE&(A80|A05)>	#\bBit^Number^Range\r.
%<HELP&CBE&(A80|A05)>	#Either a single number or a number range may be entered
%<HELP&CBE&(A80|A05)>	#(numerically or symbolically).
%<HELP&CBE&(A80|A05)>	#.sp 1
%<HELP&CBE&(A80|A05)>	#When \l($153)Complex^Breaks\m are evaluated, a bit
%<HELP&CBE&(A80|A05)>	#number (or range) is evaluated by searching the program
%<HELP&CBE&(A80|A05)>	#loaded in memory for instructions that have bit numbers
%<HELP&CBE&(A80|A05)>	#operands and then comparing the entered number (or
%<HELP&CBE&(A80|A05)>	#range) with those operands when found.
%<HELP&CBE>	#.($158)Break-points:  Opcode Range
%<HELP&CBE>	#When the \bOpcode^Range\r command is selected a dialog box
%<HELP&CBE>	#will pop up to prompt for an \bOpcode^Range\r.  Either a
%<HELP&CBE>	#single opcode or a range of opcodes may be entered.
%<HELP&CBE>	#.sp 1
%<HELP&CBE>	#When \l($153)Complex^Breaks\m are evaluated, an opcode
%<HELP&CBE>	#(or range) is evaluated by searching the program loaded in
%<HELP&CBE>	#memory for instructions whose opcodes match the entered
%<HELP&CBE>	#opcode (or range).
%<HELP&CBE&A65>	#.sp 1
%<HELP&CBE&A65>	#Note that since only one byte (or range) of an opcode may be
%<HELP&CBE&A65>	#entered, the prebyte information is handled differently than
%<HELP&CBE&A65>	#the opcode part of the instruction.  If a prebyte value is
%<HELP&CBE&A65>	#entered, breaks will be set at any instruction that has that
%<HELP&CBE&A65>	#value as any of the prebytes.  If a non-prebyte value is
%<HELP&CBE&A65>	#entered, prebyte information is ignored and breaks will be
%<HELP&CBE&A65>	#set at any instruction that has the entered opcode, whether
%<HELP&CBE&A65>	#there are prebytes or not.
%<HELP&CBE>	#.($159)Break-points:  Opcode Class
%<HELP&CBE>	#When the \bOpcode^Class\r command is selected a dialog box
%<HELP&CBE>	#will pop up to prompt for an \l($172)Opcode^Class\m name.
%<HELP&CBE>	#.sp 1
%<HELP&CBE>	#When \l($153)Complex^Breaks\m are evaluated and the entered
%<HELP&CBE>	#opcode class is found, the program loaded in memory is
%<HELP&CBE>	#searched for opcodes that match the opcodes found in that
%<HELP&CBE>	#opcode class.
%<HELP&CBE>	#.($160)Break-points:  Immediate Operand Range
%<HELP&CBE>	#When the \bImmediate^Operand^Range\r command is selected a dialog
%<HELP&CBE>	#box will pop up to prompt for a \bImmediate^Operand^Range\r.
%<HELP&CBE>	#Either a single immediate operand or a range of immediate operands
%<HELP&CBE>	#may be entered.
%<HELP&CBE>	#.sp 1
%<HELP&CBE>	#When \l($153)Complex^Breaks\m are evaluated, an immediate operand
%<HELP&CBE>	#(or range) is evaluated by searching the program loaded in
%<HELP&CBE>	#memory for instructions that have immediate operands and then
%<HELP&CBE>	#comparing the entered immediate operand (or range) with those
%<HELP&CBE>	#operands when found.
%<HELP>	#.($161)Add
%<HELP>	#When the \bAdd\r command is selected a menu is pulled-down
%<HELP>	#from which the type of break to \bAdd\r may be set.
%<HELP>	#.sp 1
%<HELP>	#From the \l($152)Simple^Break\m window you may add
%<HELP>	#a \l($162)Code^Break-Point\m,
%<HELP>	#a \l($165)Trace-Off-Point\m,
%<HELP>	#a \l($164)Trace-On-Point\m,
%<HELP&A05>	#a \l($391)Write^Access^Break-Point\m, and
%<HELP&A05>	#a \l($166)Write^Protect^Break-Point\m.
%<HELP&A25>	#a \l($168)Pass-Count-Point\m (depending on mode),
%<HELP&A25>	#a \l($534)Data^Address^Break-Point\m, and
%<HELP&A25>	#a \l($391)Write^Access^Break-Point\m.
%<HELP&A51>	#an \l($163)External^Data^Break-Point\m, and
%<HELP&A51>	#a \l($168)Pass-Count-Point\m (PE only, depending on mode).
%<HELP&A65>	#a \l($168)Pass-Count-Point\m,
%<HELP&A65>	#a \l($534)Data^Address^Break-Point\m, and
%<HELP&A65>	#a \l($391)Write^Access^Break-Point\m.
%<HELP&A68>	#a \l($391)Write^Access^Break-Point\m, and
%<HELP&A68>	#a \l($166)Write^Protect^Break-Point\m.
%<HELP&A78>	#a \l($168)Pass-Count-Point\m (depending on mode),
%<HELP&A78>	#a \l($534)Data^Address^Break-Point\m, and
%<HELP&A78>	#a \l($391)Write^Access^Break-Point\m.
%<HELP&A80>	#and a \l($168)Pass-Count-Point\m.
%<HELP&A85>	#a \l($168)Pass-Count-Point\m (depending on mode),
%<HELP&A85>	#a \l($534)Data^Address^Break-Point\m, and
%<HELP&A85>	#a \l($391)Write^Access^Break-Point\m.
%<HELP&CBE>	#.sp 1
%<HELP&CBE>	#From the \l($153)Complex^Break\m window you may add
%<HELP&CBE>	#a \l($162)Code^Break-Point\m,
%<HELP&CBE&A51>	#a \l($168)Pass-Count-Point\m (PE only, depending on mode),
%<HELP&CBE&A80>	#a \l($168)Pass-Count-Point\m,
%<HELP&CBE&A65>	#a \l($168)Pass-Count-Point\m,
%<HELP&CBE&A85>	#a \l($168)Pass-Count-Point\m (depending on mode),
%<HELP&CBE>	#a \l($165)Trace-Off-Point\m, and
%<HELP&CBE>	#a \l($164)Trace-On-Point\m.
%<HELP>	#.($162)CBREAK: Code Break-Point
%<HELP>	#When you select the \bCBREAK: Code^Break-Point\r command,
%<HELP>	#the type of the break element to be added is set
%<HELP>	#to a \bCode^Break-Point\r.
%<HELP>	#Control then passes immediately to the \l($154)Edit\m command.
%<HELP>	#.sp 1
%<HELP>	#A \bCode^Break-Point\r at a particular location causes
%<HELP>	#emulation to break (stop)
%<HELP&(!A80| DMD| EPU)&(!(A25|A78|A85))>	#\bbefore\r
%<HELP&( A80&!DMD&!EPU)|( (A25|A78|A85))>	#\bafter\r
%<HELP>	#execution of the instruction
%<HELP>	#at that location.
%<HELP&A51>	#.($163)XBREAK: External Data Break-Point
%<HELP&A51>	#When you select the \bXBREAK:^External^Data^Break-Point\r
%<HELP&A51>	#command, the type of break element to be added is set to an
%<HELP&A51>	#\bExternal^Data^Break-Point\r.
%<HELP&A51>	#Control then passes immediately to the \l($154)Edit\m command.
%<HELP&A51>	#.sp 1
%<HELP&A51>	#An \bExternal^Data^Break-Point\r at a particular location causes
%<HELP&A51>	#emulation to break (stop) \uafter\r execution of an instruction
%<HELP&A51>	#referencing that External Data Memory location.
%<HELP&CBE&A51>	#.sp 1
%<HELP&CBE&A51>	#This command is available only for the \l($152)Simple^Break\m
%<HELP&CBE&A51>	#window.
%<HELP>	#.($164)TRON: Trace-On-Point
%<HELP>	#When you select the \bTRON:^Trace-On-Point\r command, the type of
%<HELP>	#break element to be added is set to a \bTrace-On-Point\r.
%<HELP>	#Control then passes immediately to the \l($154)Edit\m command.
%<HELP>	#.sp 1
%<HELP>	#Executing through a \bTrace-On-Point\r resumes capture (writing)
%<HELP>	#of bus-cycle-by-bus-cycle trace information into the trace buffer.
%<HELP>	#.sp 1
%<HELP>	#Note that executing through a \bTrace-On-Point\r also causes the
%<HELP>	#\bTrace^Trigger^Output\r signal to strobe low
%<HELP>	#(see \l($356)Probe^Clip^Assembly\m).
%<HELP&A51&DAL>	#.sp 1
%<HELP&A51&DAL>	#If you set a \bTrace-On-Point\r on an instruction which
%<HELP&A51&DAL>	#immediately follows a MOVC or MOVX instruction,
%<HELP&A51&DAL>	#the trace buffer will capture an "extra" frame
%<HELP&A51&DAL>	#following the opcode-fetch cycle of that instruction.
%<HELP&A51&DAL>	#That extra frame is from the MOVC or MOVX instruction.
%<HELP&A51&DAL>	#The reason this happens is that trace capture resumes
%<HELP&A51&DAL>	#during the opcode-fetch cycle of an instruction at a
%<HELP&A51&DAL>	#\bTrace-On-Point\r.  However,
%<HELP&A51&DAL>	#the opcode-fetch cycle for any instruction following a
%<HELP&A51&DAL>	#MOVC or MOVX instruction actually occurs "in the middle" of
%<HELP&A51&DAL>	#the address/data bus cycles for the MOVC or MOVX instruction.
%<HELP&A51&DAL>	#See \l($211)View^Trace^(Raw^Mode)\m for further information.
%<HELP>	#.($165)TROFF: Trace-Off-Point
%<HELP>	#When you select the \bTROFF:^Trace-Off-Point\r command, the type of
%<HELP>	#break element to be added is set to a \bTrace-Off-Point\r.
%<HELP>	#Control then passes immediately to the \l($154)Edit\m command.
%<HELP>	#.sp 1
%<HELP>	#Executing through a \bTrace-Off-Point\r suspends capture (recording)
%<HELP>	#of bus-cycle-by-bus-cycle trace information into the trace buffer.
%<HELP>	#Trace buffer recording (capture) does not resume until the program
%<HELP>	#executes through a \l($164)Trace^On^Point\m.
%<HELP&A51&DAL>	#.sp 1
%<HELP&A51&DAL>	#If you set a \bTrace-Off-Point\r on an instruction which
%<HELP&A51&DAL>	#immediately follows a MOVC or MOVX instruction,
%<HELP&A51&DAL>	#trace buffer capturing will not be suspended until all cycles
%<HELP&A51&DAL>	#of the MOVC or MOVX instruction have been captured in the
%<HELP&A51&DAL>	#trace buffer.  This is done because
%<HELP&A51&DAL>	#the opcode-fetch cycle for any instruction following a
%<HELP&A51&DAL>	#MOVC or MOVX instruction actually occurs "in the middle" of
%<HELP&A51&DAL>	#the address/data bus cycles for the MOVC or MOVX instruction.
%<HELP&A51&DAL>	#See \l($211)View^Trace^(Raw^Mode)\m for further information.
%<HELP&(A68|A05)>	#.($166)PBREAK: Write Protect Break-Point
%<HELP&(A68|A05)>	#When you select the \bPBREAK:^Write^Protect^Break-Point\r
%<HELP&(A68|A05)>	#command, the type of break element to be added is set to a
%<HELP&(A68|A05)>	#\bWrite^Protect^Break-Point\r.
%<HELP&(A68|A05)>	#Control then passes immediately to the \l($154)Edit\m
%<HELP&(A68|A05)>	#command.
%<HELP&(A68|A05)>	#.sp 1
%<HELP&(A68|A05)>	#.in +4 {
%<HELP&(A68|A05)>	#A \bWrite^Protect^Break-Point\r causes a break to occur any
%<HELP&(A68|A05)>	#time a write (i.e., non-read or non-instruction-fetch)
%<HELP&(A68|A05)>	#access is made to the designated memory location(s)
%<HELP&(A68|A05)>	#during emulation.
%<HELP&(A68|A05)>	#In such a case, the referenced memory location is \unot\r
%<HELP&(A68|A05)>	#updated when the write occurs (i.e., the write is
%<HELP&(A68|A05)>	#suppressed).
%<HELP&(A68|A05)>	#.sp 1
%<HELP&(A68|A05)>	#A \bWrite^Protect^Break-Point\r can only be set for a
%<HELP&(A68|A05)>	#memory location/range mapped to the emulator base,
%<HELP&(A68|A05)>	#not for a memory location/range mapped to the target
%<HELP&(A68|A05)>	#system. Additionally, a \bWrite^Protect^Break-Point\r
%<HELP&(A68|A05)>	#cannot be set for any enabled on-chip memory location/range
%<HELP&(A68|A05)>	#(e.g., in on-chip RAM or in on-chip EEPROM).
%<HELP&(A68|A05)>	#.in -4 }
%<HELP&CBE&(A68|A05)>	#.sp 1
%<HELP&CBE&(A68|A05)>	#This command is available only for
%<HELP&CBE&(A68|A05)>	#the \l($152)Simple^Break\m window.
%<HELP>	#.($167)Remove
%<HELP>	#The \bRemove\r command is used to remove the currently
%<HELP>	#highlighted break element.
%<HELP&(A25|A51|A65|A78|A80|A85)>	#.($168)PCOUNT: Pass-Count-Point
%<HELP&(A25|A51|A65|A78|A80|A85)>	#When you select the
%<HELP&(A25|A51|A65|A78|A80|A85)>	#\bPCOUNT:^Pass-Count-Point\r
%<HELP&(A25|A51|A65|A78|A80|A85)>	#command, the type of break element
%<HELP&(A25|A51|A65|A78|A80|A85)>	#to be added is set to a
%<HELP&(A25|A51|A65|A78|A80|A85)>	#\bPass-Count-Point\r address
%<HELP&(A25|A51|A65|A78|A80|A85)>	#(see \l($431)Pass-Count\m).
%<HELP&(A25|A51|A65|A78|A80|A85)>	#Control is then immediately
%<HELP&(A25|A51|A65|A78|A80|A85)>	#passed to the \l($154)Edit\m command.
%<HELP>	#.($169)Numeric
%<HELP>	#The \bNumeric\r command toggles the \bBreak^Menu\r display mode to
%<HELP>	#numeric mode in which only numeric addresses and values are displayed.
%<HELP>	#This mode has no effect on how addresses and values may be entered.
%<HELP>	#.($170)Symbolic
%<HELP>	#The \bSymbolic\r command toggles the \bBreak^Menu\r display mode to
%<HELP>	#symbolic mode.  In this mode addresses and values are displayed
%<HELP>	#symbolically but has no effect on how
%<HELP>	#addresses and values may be entered.
%<HELP&CBE>	#.sp 1
%<HELP&CBE>	#In the \l($153)Complex^Break\m window
%<HELP&CBE>	#\bCtrl-\x1B\r and \bCtrl-\x1A\r are used to change the
%<HELP&CBE>	#displayed \bComplex^Break\r fields.
%<HELP&CBE&(A68|A05)>	#.($171)Extended Address Range
%<HELP&CBE&(A68|A05)>	#When the \bExtended^Address^Range\r command is
%<HELP&CBE&(A68|A05)>	#selected a dialog box will pop up to prompt for
%<HELP&CBE&(A68|A05)>	#and \bExtended^Address^Range\r. Either a single
%<HELP&CBE&(A68|A05)>	#address or address range may be entered
%<HELP&CBE&(A68|A05)>	#(numerically or symbolically).
%<HELP&CBE&(A68|A05)>	#.sp 1
%<HELP&CBE&(A68|A05)>	#When \l($153)Complex^Breaks\m are evaluated, an
%<HELP&CBE&(A68|A05)>	#extended address (or range) is evaluated by
%<HELP&CBE&(A68|A05)>	#searching the program loaded in memory for
%<HELP&CBE&(A68|A05)>	#instructions that have extended operands and
%<HELP&CBE&(A68|A05)>	#then comparing the entered address (or range)
%<HELP&CBE&(A68|A05)>	#with those operands when found.
%<HELP&CBE>	#.($172)Opcode Class
%<HELP&CBE>	#The \bOpcode^Class\r command displays the pop-up
%<HELP&CBE>	#\bOpcode^Class^Menu\r
%<HELP&CBE>	#from which you can create or modify an opcode class.
%<HELP&CBE>	#An opcode class is a user-defined grouping of instructions.
%<HELP&CBE>	#Each opcode class is made of one or many opcode class elements.
%<HELP&CBE>	#Each opcode class element contains three fields, the
%<HELP&CBE>	#\l($177)Mnemonic\m, \l($178)Operand^1\m
%<HELP&CBE>	#and \l($179)Operand^2\m.  Opcode class elements can be
%<HELP&CBE>	#\l($203)Add\med or \l($204)Remove\md and the fields of an opcode
%<HELP&CBE>	#class element can be \l($175)Edit\med.
%<HELP&CBE>	#.sp 1
%<HELP&CBE>	#When an opcode class element is evaluated the three fields are
%<HELP&CBE>	#effectively \uAND\red together.  Any field left blank is not
%<HELP&CBE>	#included in the \uAND\r evaluation.
%<HELP&CBE&A51>	#.sp 1
%<HELP&CBE&A51>	#Note that although the CJNE class of instructions has three
%<HELP&CBE&A51>	#operands, each CJNE instruction can be uniquely specified
%<HELP&CBE&A51>	#using the provided fields.
%<HELP>	#.($173)Load
%<HELP>	#The \bLoad\r command allows you to restore a previously
%<HELP>	#\l($174)Save\md break setup from a disk file.  Any current
%<HELP>	#break elements are removed.
%<HELP>	#.($174)Save
%<HELP>	#The \bSave\r command allows you to store all the currently
%<HELP>	#defined break elements to a disk file.
%<HELP>	#You can then \l($173)load\m that file at a later time.
%<HELP&CBE>	#.($175)Edit
%<HELP&CBE>	#When the \bEdit\r command is selected a menu is pulled-down
%<HELP&CBE>	#from which you may \l($176)Name\m an \l($172)Opcode^Class\m,
%<HELP&CBE>	#or \bEdit\r the \l($177)Mnemonic\m, \l($178)Operand^1\m or
%<HELP&CBE>	#\l($179)Operand^2\m field of the currently highlighted
%<HELP&CBE>	#opcode class element.
%<HELP&CBE>	#.($176)Name
%<HELP&CBE>	#The \bName\r command allows you to \bName\r an
%<HELP&CBE>	#\l($172)Opcode^Class\m.  The name of an opcode class is special
%<HELP&CBE>	#in that when an opcode class is \l($206)Save\md, it is saved in
%<HELP&CBE>	#a file name that is created automatically using the opcode class
%<HELP&CBE>	#name.  For example, if an opcode class is named "PGMFLOW" the
%<HELP&CBE>	#file name the opcode class will be saved to is "PGMFLOW.$OC".
%<HELP&CBE>	#This is true of the \l($205)Load\m command also.  When the load
%<HELP&CBE>	#command is selected you will be prompted for the opcode class
%<HELP&CBE>	#name to load.  The software will look for a file whose name is
%<HELP&CBE>	#created from the opcode class name in the manner described above.
%<HELP&CBE>	#.($177)Mnemonic
%<HELP&CBE>	#The \bMnemonic\r command allows you to edit the \bMnemonic\r
%<HELP&CBE>	#field of the currently highlighted \l($172)Opcode^Class\m element.
%<HELP&CBE>	#Any valid instruction mnemonic is valid.
%<HELP&CBE>	#.($178)Operand 1
%<HELP&CBE>	#The \bOperand^1\r command displays a pull-down menu from which you
%<HELP&CBE>	#may select the type of
%<HELP&CBE&A05>	#\l($403)Operand\m
%<HELP&CBE&A51>	#\l($373)Operand\m
%<HELP&CBE&A65>	#\l($536)Operand\m
%<HELP&CBE&A68>	#\l($380)Operand\m
%<HELP&CBE&A80>	#\l($374)Operand\m
%<HELP&CBE>	#to use for the \bOperand^1\r field.
%<HELP&CBE&(A51|A80)>	#The first operand of the instruction is often called
%<HELP&CBE&(A51|A80)>	#the destination operand.
%<HELP&CBE&(A68|A05)>	#\bOperand^1\r is the source operand for the instruction.
%<HELP&CBE>			#Note that the operands (as defined here) are derived
%<HELP&CBE&(!A65)>	#from both implicit and explicit operands.
%<HELP&CBE&( A65)>	#only from operands as they appear in the operand field
%<HELP&CBE&( A65)>	#of the instruction (explicitly).
%<HELP&CBE>	#.($179)Operand 2
%<HELP&CBE>	#The \bOperand^2\r command displays a pull-down menu from which you
%<HELP&CBE>	#may select the type of
%<HELP&CBE&A05>	#\l($403)Operand\m
%<HELP&CBE&A51>	#\l($373)Operand\m
%<HELP&CBE&A65>	#\l($536)Operand\m
%<HELP&CBE&A68>	#\l($380)Operand\m
%<HELP&CBE&A80>	#\l($374)Operand\m
%<HELP&CBE>	#to use for the \bOperand^2\r field.
%<HELP&CBE&(A51|A80)>	#The second operand of the instruction is often called
%<HELP&CBE&(A51|A80)>	#the source operand.
%<HELP&CBE&(A68|A05)>	#\bOperand^2\r is the destination operand for
%<HELP&CBE&(A68|A05)>	#the instruction.
%<HELP&CBE>	#Note that the operands (as defined here) are derived
%<HELP&CBE&(!A65)>	#from both implicit and explicit operands.
%<HELP&CBE&( A65)>	#only from operands as they appear in the operand field
%<HELP&CBE&( A65)>	#of the instruction (explicitly).
%<HELP&CBE>	#.($203)Add
%<HELP&CBE>	#The \bAdd\r command adds an empty \l($172)Opcode^Class\m element
%<HELP&CBE>	#and automatically passes control to the \l($175)Edit\m pull-down
%<HELP&CBE>	#menu.  The \bAdd\red opcode class element is then highlighted
%<HELP&CBE>	#(made the current opcode class element).
%<HELP&CBE>	#.($204)Remove
%<HELP&CBE>	#The \bRemove\r command removes the current (highlighted)
%<HELP&CBE>	#\l($172)Opcode^Class\m element.
%<HELP&CBE>	#.($205)Load
%<HELP&CBE>	#The \bLoad\r command allows you to restore a previously
%<HELP&CBE>	#\l($206)Save\md \l($172)Opcode^Class\m.  If an opcode class
%<HELP&CBE>	#is currently loaded in memory it will be cleared before
%<HELP&CBE>	#the new opcode class is \bLoad\red.  When the \bLoad\r command
%<HELP&CBE>	#is selected you will be prompted for the opcode class
%<HELP&CBE>	#\l($176)Name\m to load.  The software will search for the disk
%<HELP&CBE>	#file for that opcode class.  The file name used is created from
%<HELP&CBE>	#the opcode class name.  For example, if the desired opcode class
%<HELP&CBE>	#is named "PGMFLOW" the file name searched for is "PGMFLOW.$OC".
%<HELP&CBE>	#.($206)Save
%<HELP&CBE>	#The \bSave\r command is used to store the currently defined
%<HELP&CBE>	#\l($172)Opcode^Class\m to a disk file.  The disk file name is
%<HELP&CBE>	#created from the opcode class \l($176)Name\m.  For example,
%<HELP&CBE>	#if the opcode class name is "PGMFLOW" the opcode class will
%<HELP&CBE>	#be \bSave\rd to the file named "PGMFLOW.$OC".  If the opcode
%<HELP&CBE>	#class has not been named yet, you will be prompted to enter
%<HELP&CBE>	#the name.
%<HELP>	#.($207)Clear
%<HELP>	#The \bClear\r command is used to clear all breaks set
%<HELP>	#through the \l($151)Break^Menu\m.
%<HELP>	#.($208)Disable
%<HELP>	#The \bDisable\r command is used to temporarily disable all breaks
%<HELP>	#set through the \l($151)Break^Menu\m.  The breaks can be
%<HELP>	#enabled using the \l($209)Enable\m command.
%<HELP>	#.($209)
%<HELP>	#The \bEnable\r command is used to enable breaks (originally
%<HELP>	#set through the \l($151)Break^Menu\m) that were temporarily
%<HELP>	#\l($208)Disabled\m.
%<HELP>	#.($210)View Trace
%<HELP>	#The \bView-Trace\r command is used to examine and/or write to a file
%<HELP>	#the contents of the trace buffer.
%<HELP>	#The trace buffer can be examined/written in several
%<HELP>	#different display modes:
%<HELP>	#\l($211)Raw\m, \l($212)Code\m, \l($213)HLL\m and \l($214)Mixed\m.
%<HELP>	#.($211)Raw
%<HELP>	#In the \bRaw\r display mode, you see the binary content of
%<HELP>	#the address/data bus for each bus cycle (trace frame)
%<HELP>	#in a raw hex format.
%<HELP>	#The fields in the \bRaw\r mode display are:
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#\bFrame^Number\r -- The relative trace buffer frame number,
%<HELP>	#where the frame at the trigger point is numbered zero (0).
%<HELP>	#.sp 1
%<HELP>	#\bAddress\r -- The captured address bus value.
%<HELP>	#.sp 1
%<HELP>	#\bData\r -- The captured data bus (data or opcode) value.
%<HELP&(A85|A25|A78)>	#The display shows one byte (two hexadecimal characters) for
%<HELP&(A85|A25|A78)>	#a byte (8-bit) access and two bytes (four hexadecimal
%<HELP&(A85|A25|A78)>	#characters) for a word (16-bit) access.
%<HELP&(A85|A25|A78)>	#.sp 1
%<HELP&(A85|A25|A78)>	#\bInstruction\r
%<HELP&(A85|A25|A78)>	#.in +2 {
%<HELP&(A85|A25|A78)>	#.in +2 {
%<HELP&(A85|A25|A78)>	#.sp 1
%<HELP&(A85|A25|A78)>	#\b@^Byte^1\r -- The opcode mnemonic, if any, associated
%<HELP&(A85|A25|A78)>	#with the first \bData\r byte in this frame.
%<HELP&(A85|A25|A78)>	#
%<HELP&(A85|A25|A78)>	#.sp 1
%<HELP&(A85|A25|A78)>	#\b@^Byte^2\r -- The opcode mnemonic, if any, associated
%<HELP&(A85|A25|A78)>	#with the second \bData\r byte in this frame.
%<HELP&(A85|A25|A78)>	#.in -2 }
%<HELP&(A85|A25|A78)>	#.sp 1
%<HELP&(A85|A25|A78)>	#There will be an actual opcode mnemonic shown in either of
%<HELP&(A85|A25|A78)>	#the above two \bInstruction\r
%<HELP&(A85|A25|A78)>	#columns if the associated \bData\r byte corresponds to the
%<HELP&(A85|A25|A78)>	#first byte of an instruction which was fetched into the
%<HELP&(A85|A25|A78)>	#CPU's instruction queue and actually executed by the CPU.
%<HELP&(A85|A25|A78)>	#.sp 1
%<HELP&(A85|A25|A78)>	#The entry in either of the above two \bInstruction\r
%<HELP&(A85|A25|A78)>	#columns may be:
%<HELP&(A85|A25|A78)>	#.sp 1
%<HELP&(A85|A25|A78)>	#.in +2 {
%<HELP&(A85|A25|A78)>	#.in +9 {
%<HELP&(A85|A25|A78)>	#.ti -9
%<HELP&(A85|A25|A78)>	#\b(fbne)\r^^^"Fetched, But Not Executed".
%<HELP&(A85|A25|A78)>	#This byte was fetched into the CPU's instruction queue,
%<HELP&(A85|A25|A78)>	#but was not actually executed.  This could happen, for
%<HELP&(A85|A25|A78)>	#example, due to an instruction queue flush caused by
%<HELP&(A85|A25|A78)>	#a branch instruction.
%<HELP&(    A25)>	#This \b(fbne)\r marking is used for the second and
%<HELP&(    A25)>	#subsequent bytes, if any, in an instruction's image.
%<HELP&(    A25)>	#.sp 1
%<HELP&(    A25)>	#.ti -9
%<HELP&(    A25)>	#\b(FBNE)\r^^^"Fetched, But Not Executed".
%<HELP&(    A25)>	#This is just like the \b(fbne)\r marking above, but it
%<HELP&(    A25)>	#appears only on the first byte in an instruction's image.
%<HELP&(A85|A25|A78)>	#.sp 1
%<HELP&(A85|A25|A78)>	#.ti -9
%<HELP&(A85|A25|A78)>	#\b(troff)\r^^"Trace-OFF to Trace-ON Transition Area Byte".
%<HELP&(A85|A25|A78)>	#This byte was fetched into the CPU's instruction
%<HELP&(A85|A25|A78)>	#queue, but because trace collection was suspended
%<HELP&(A85|A25|A78)>	#"in the middle" of this instruction and then resumed
%<HELP&(A85|A25|A78)>	#sometime later, it is not possible to
%<HELP&(A85|A25|A78)>	#determine exactly how this data byte should be
%<HELP&(A85|A25|A78)>	#interpretted.
%<HELP&(A85|A25|A78)>	#.sp 1
%<HELP&(A85|A25|A78)>	#.ti -9
%<HELP&(A85|A25|A78)>	#\b????????\r^Same as "(uncertain)" in
%<HELP&(A85|A25|A78)>	#the \l($212)Code\m display mode.
%<HELP&(    A25)>	#.sp 1
%<HELP&(    A25)>	#.ti -9
%<HELP&(    A25)>	#\b?(fetch)\r^Same as "(uncertain)" in
%<HELP&(    A25)>	#the \l($212)Code\m display mode.  Additionally, this byte
%<HELP&(    A25)>	#is the first byte in an instruction's image.
%<HELP&(A85    )>	#.sp 1
%<HELP&(A85    )>	#.ti -9
%<HELP&(A85    )>	#\b(EVR:^<vector_name>)\r
%<HELP&(A85    )>	#.sp 0
%<HELP&(A85    )>	#The first frame of an "Exception Vector
%<HELP&(A85    )>	#Read" operation.  \b<vector_name>\r indicates which vector,
%<HELP&(A85    )>	#or which type of vector, was read by the processor.
%<HELP&(A85    )>	#.sp 1
%<HELP&(A85    )>	#.ti -9
%<HELP&(A85    )>	#\b(EVR)\r^^^^The second and subsequent frames, if any,
%<HELP&(A85    )>	#of an "Exception Vector Read" operation.
%<HELP&(A85|A25|A78)>	#.in -9 }
%<HELP&(A85|A25|A78)>	#.in -2 }
%<HELP&(A85|A25|A78)>	#.in -2 }
%<HELP&(A85|A25|A78)>	#.sp 1
%<HELP&(A85|A25|A78)>	#\bCycle^Type\r -- The type of cycle being performed,
%<HELP&(A85|A25|A78)>	#as follows:
%<HELP&(A85|A25|A78)>	#.sp 1
%<HELP&(A85|A25|A78)>	#.in +2 {
%<HELP&(A85|A25|A78)>	#.in +8 {
%<HELP&(A85    )>	#.ti -8
%<HELP&(A85    )>	#\bDTC^^^^^\rDirect Transfer Controller operation.
%<HELP&(A85    )>	#.ti -8
%<HELP&(A85    )>	#\bDMAC^^^^\rDirect Memory Access Controller operation.
%<HELP&(A85    )>	#.ti -8
%<HELP&(A85    )>	#\bREFRSH^^\rRefresh unit operation.
%<HELP&(A85|A25|A78)>	#.ti -8
%<HELP&(A85|A25|A78)>	#\b......^^\rCode prefetch operation:  code
%<HELP&(A85|A25|A78)>	#stream byte(s) being fetched into the CPU's
%<HELP&(A85|A25|A78)>	#instruction queue.
%<HELP&(A85    )>	#.ti -8
%<HELP&(A85    )>	#\bSTNDBY^^\rSoftware or hardware standby mode.
%<HELP&(A85    )>	#.ti -8
%<HELP&(A85    )>	#\bSLEEP^^^\rSleep mode.
%<HELP&(A85    )>	#.ti -8
%<HELP&(A85    )>	#\bBUSREL^^\rBus-released state.
%<HELP&(A85|A25|A78)>	#.ti -8
%<HELP&(A85|A25|A78)>	#\bOTHER^^^\rOther cycle types
%<HELP&(A85        )>	#(e.g., reset, and bus-released in some chips).
%<HELP&(    A25    )>	#(e.g., the data cycle of a MOVX instruction).
%<HELP&(        A78)>	#(e.g., a data cycle of some instruction).
%<HELP&(A85|A25|A78)>	#.in -8 }
%<HELP&(A85|A25|A78)>	#.in -2 }
%<HELP&(A85    )>	#.sp 1
%<HELP&(A85    )>	#\bMemory^Area\r -- The memory area being accessed,
%<HELP&(A85    )>	#as follows:
%<HELP&(A85    )>	#.sp 1
%<HELP&(A85    )>	#.in +2 {
%<HELP&(A85    )>	#.in +11 {
%<HELP&(A85    )>	#.ti -11
%<HELP&(A85    )>	#\bI/O^w3cyc^^\rI/O area access (3 word cycles).
%<HELP&(A85    )>	#.ti -11
%<HELP&(A85    )>	#\bROM^^^^^^^^\rROM/FLASH access;  Internal 2 word cycle,
%<HELP&(A85    )>	#except RAM.
%<HELP&(A85    )>	#.ti -11
%<HELP&(A85    )>	#\bRAM^^^^^^^^\rRAM access.
%<HELP&(A85    )>	#.ti -11
%<HELP&(A85    )>	#\bI/O^b3cyc^^\rI/O area access (3 byte cycles).
%<HELP&(A85    )>	#.ti -11
%<HELP&(A85    )>	#\bExt^w2cyc^^\rExternal area access (2 word cycles).
%<HELP&(A85    )>	#(Subject to external WAIT input and may be
%<HELP&(A85    )>	#extended by the user.)
%<HELP&(A85    )>	#.ti -11
%<HELP&(A85    )>	#\bExt^w3cyc^^\rExternal area access (3 word cycles)
%<HELP&(A85    )>	#and FLASH area access.
%<HELP&(A85    )>	#(Subject to external WAIT input and may be
%<HELP&(A85    )>	#extended by the user.)
%<HELP&(A85    )>	#.ti -11
%<HELP&(A85    )>	#\bExt^b2cyc^^\rExternal area access (2 byte cycles).
%<HELP&(A85    )>	#(Subject to external WAIT input and may be
%<HELP&(A85    )>	#extended by the user.)
%<HELP&(A85    )>	#.ti -11
%<HELP&(A85    )>	#\bExt^b3cyc^^\rExternal area access (3 byte cycles)
%<HELP&(A85    )>	#and RAM area access in Mode 7 (RAM is disabled).
%<HELP&(A85    )>	#(Subject to external WAIT input and may be
%<HELP&(A85    )>	#extended by the user.)
%<HELP&(A85    )>	#.in -11 }
%<HELP&(A85    )>	#.in -2 }
%<HELP&(A85    )>	#.sp 1
%<HELP&(A85    )>	#\bR/W\r -- The type of access being performed, as follows:
%<HELP&(A85    )>	#.sp 1
%<HELP&(A85    )>	#.in +2 {
%<HELP&(A85    )>	#.in +3 {
%<HELP&(A85    )>	#.ti -3
%<HELP&(A85    )>	#\bR^^\rRead
%<HELP&(A85    )>	#.ti -3
%<HELP&(A85    )>	#\bW^^\rWrite
%<HELP&(A85    )>	#.in -3 }
%<HELP&(A85    )>	#.in -2 }
%<HELP&(A85|A25|A78)>	#.sp 1
%<HELP&(A85|A25|A78)>	#\bE/T\r -- The location of the access, as follows:
%<HELP&(A85|A25|A78)>	#.sp 1
%<HELP&(A85|A25|A78)>	#.in +2 {
%<HELP&(A85|A25|A78)>	#.in +3 {
%<HELP&(A85|A25|A78)>	#.ti -3
%<HELP&(A85|A25|A78)>	#\bE^^\rEmulator's memory
%<HELP&(A85|A25|A78)>	#.ti -3
%<HELP&(A85|A25|A78)>	#\bT^^\rTarget system's memory
%<HELP&(A85|A25|A78)>	#.in -3 }
%<HELP&(A85|A25|A78)>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#\bProbes\r -- The captured Trace Input signal values
%<HELP>	#(see \l($356)Probe^Clip^Assembly\m).
%<HELP>	#A value of zero (0) reflects a low signal and
%<HELP>	#a value of one (1) reflects a high signal.
%<HELP>	#.in -2 }
%<HELP&(!(A85|A25|A78))>	#.sp 1
%<HELP&(!(A85|A25|A78))>	#The notations used in the \bRaw\r mode display are:
%<HELP&(!(A85|A25|A78))>	#.sp 1
%<HELP&(!(A85|A25|A78))>	#.in +4 {
%<HELP&(!(A85|A25|A78))>	#.in +11 {
%<HELP&(!(A85|A25|A78))>	#.ti -11
%<HELP&(!(A85|A25|A78))>	#*^^^^^^^^^^Opcode-fetch bus cycle
%<HELP&(!(A85|A25|A78))>	#(beginning of instruction's execution).
%<HELP&(!(A85|A25|A78))>	#The opcode mnemonic is displayed to the
%<HELP&(!(A85|A25|A78))>	#right of the '*'.
%<HELP&A51>	#All operand information which can be deduced from just the
%<HELP&A51>	#opcode byte alone is shown to the right of the opcode mnemonic.
%<HELP&A51>	#.ti -11
%<HELP&A51>	#**(LCALL)^^Interrupt (1st ALE (bus) cycle)
%<HELP&A51>	#.ti -11
%<HELP&A51>	#**^^^^^^^^^Interrupt (2nd, 3rd & 4th ALE (bus) cycles)
%<HELP&A51>	#.ti -11
%<HELP&A51>	#R^^^^^^^^^^Reset (1st ALE (bus) cycle).
%<HELP&A51>	#This notation does not appear when the reset occurs at an
%<HELP&A51>	#opcode-fetch boundary.  That is, it appears only when the
%<HELP&A51>	#reset occurs in the middle of an instruction's normal execution.
%<HELP&A51>	#.ti -11
%<HELP&A51>	#DMA^^^^^^^^DMA activity
%<HELP&A51&DAL>	#.ti -11
%<HELP&A51&DAL>	#(Cycle^at^Break)
%<HELP&A51&DAL>	#.sp 0
%<HELP&A51&DAL>	#Same as "Bus^Cycle^At^Break" in the \l($212)Code\m display
%<HELP&A51&DAL>	#mode.
%<HELP&(A80|A65)>	#.ti -11
%<HELP&(A80|A65)>	#\xF7^^^^^^^^^^A frame (bus cycle) in a
%<HELP&(A80    )>	#skipped instruction.
%<HELP&(    A65)>	#conditional jump instruction which did not jump ("no-go").
%<HELP&(A80|A65)>	#If this frame is also for the Opcode-fetch bus cycle
%<HELP&(A80|A65)>	#(beginning of instruction's execution),
%<HELP&(A80|A65)>	#the opcode mnemonic is displayed in lower-case.
%<HELP&(A80|A65)>	#For additional visual feedback, %rs1 displays the entire
%<HELP&(A80|A65)>	#line as "inactive" (see \l($345)Select^Color\m).
%<HELP&(!(A85|A25|A78))>	#.ti -11
%<HELP&(!(A85|A25|A78))>	#?^^^^^^^^^^Same as "(uncertain)" in the \l($212)Code\m display mode.
%<HELP&(!(A85|A25|A78))>	#.in -11 }
%<HELP&(!(A85|A25|A78))>	#.in -4 }
%<HELP&A51&DAL>	#.sp 1
%<HELP&A51&DAL>	#Dallas HSM Devices:
%<HELP&A51&DAL>	#.sp 1
%<HELP&A51&DAL>	#.in +2 {
%<HELP&A51&DAL>	#The \bRaw\r display mode shows address/data bus activity
%<HELP&A51&DAL>	#in the exact order that the address/data bus cycles occurred.
%<HELP&A51&DAL>	#Trace frames are recorded in (written into) the trace buffer
%<HELP&A51&DAL>	#in the same order that the address/data bus cycles occurred.
%<HELP&A51&DAL>	#In most cases, the 'n' trace frames for an 'n-cycle'
%<HELP&A51&DAL>	#instruction appear one right after the other in the trace
%<HELP&A51&DAL>	#buffer.  However, there are some exceptions.
%<HELP&A51&DAL>	#The opcode-fetch bus cycle for any instruction following a
%<HELP&A51&DAL>	#MOVC or MOVX instruction actually occurs "in the middle" of
%<HELP&A51&DAL>	#the address/data bus cycles for the MOVC or MOVX instruction
%<HELP&A51&DAL>	#(between the 2nd and 3rd bus cycles of a MOVC and between
%<HELP&A51&DAL>	#the 1st and 2nd bus cycles of a MOVX).
%<HELP&A51&DAL>	#.sp 1
%<HELP&A51&DAL>	#Note that the trace buffer actually traces bus cycles,
%<HELP&A51&DAL>	#not machine cycles.  Typically, these are the same except
%<HELP&A51&DAL>	#in the case of "stretched" MOVX cycles.  The trace of a MOVX
%<HELP&A51&DAL>	#instruction will always show the same number of bus cycles
%<HELP&A51&DAL>	#regardless of the "stretch" value.  The "stretch" value
%<HELP&A51&DAL>	#changes the number of machine cycles, but not the number of
%<HELP&A51&DAL>	#bus cycles.
%<HELP&A51&DAL>	#.in -2 }
%<HELP>	#.($212)Code
%<HELP>	#In the \bCode\r display mode, you see the content of the trace buffer
%<HELP>	#interpreted as fully disassembled instructions, including all
%<HELP>	#available symbolic information (except HLL source images).
%<HELP>	#The fields in the \bCode\r mode display are:
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#\bFrame^Number\r -- The relative trace buffer frame number,
%<HELP>	#where the frame at the trigger point is numbered zero (0).
%<HELP>	#The frame number displayed here is that of the \ufirst\r
%<HELP>	#frame in the trace of the instruction's execution.
%<HELP>	#.sp 1
%<HELP>	#\bCode^Addr\r -- The captured address value in the first frame
%<HELP>	#(first bus cycle) of the trace of the instruction's execution.
%<HELP>	#.sp 1
%<HELP>	#\bLabel\r -- The label(s), if any, for the instruction at
%<HELP>	#address \bCode^Addr\r.  If there is more than one label
%<HELP>	#at this address and they won't all fit in the \bLabel\r field,
%<HELP>	#%rs1 displays the first label at this address (with preference
%<HELP>	#given to global (public) labels) preceded by a plus sign, \b+\r,
%<HELP>	#to indicate that there is more than one label at this address.
%<HELP&(!(A85|A25))>	#.sp 1
%<HELP&(!(A85|A25))>	#\bCy\r -- The number of bus cycles in the instruction's
%<HELP&(!(A85|A25))>	#execution.  This is the same as the number of frames
%<HELP&(!(A85|A25))>	#laid down in the trace buffer for the instruction.
%<HELP>	#.sp 1
%<HELP>	#\bInstruction\r -- The disassembled instruction at
%<HELP>	#address \bCode^Addr\r.
%<HELP>	#.sp 1
%<HELP>	#\bProbes\r -- The captured Trace Input signal values
%<HELP>	#(see \l($356)Probe^Clip^Assembly\m).
%<HELP>	#A value of zero (0) reflects a low signal and
%<HELP>	#a value of one (1) reflects a high signal.
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#The notations used in the \bCode\r display mode are:
%<HELP>	#.sp 1
%<HELP>	#.in +4 {
%<HELP>	#.in +13 {
%<HELP&A51>	#.ti -13
%<HELP&A51>	#*LCALL^^^^^^^Interrupt
%<HELP&A51>	#.ti -13
%<HELP&A51>	#*R*^^^^^^^^^^Reset (only when in middle of an instruction).
%<HELP&A51>	#This notation does not appear when the reset occurs at an
%<HELP&A51>	#opcode-fetch boundary.  That is, it appears only when the
%<HELP&A51>	#reset occurs in the middle of an instruction's normal execution.
%<HELP&A51>	#.ti -13
%<HELP&A51>	#DMA^Cycle^^^^DMA activity (not part of instruction's execution).
%<HELP&A51&DAL>	#.ti -13
%<HELP&A51&DAL>	#Bus^Cycle^At^Break
%<HELP&A51&DAL>	#.sp 0
%<HELP&A51&DAL>	#When the \l($145)Trace^Trigger\m type is \l($148)End\m trigger,
%<HELP&A51&DAL>	#there will be an "extra" bus cycle at the break-point
%<HELP&A51&DAL>	#(except when the break-point instruction is a MOVX or a MOVC)..
%<HELP&A51&DAL>	#This cycle is for the opcode-fetch of the instruction at
%<HELP&A51&DAL>	#the break-point.  Although emulation breaks (stops) before
%<HELP&A51&DAL>	#the processor executes the instruction, the opcode-fetch
%<HELP&A51&DAL>	#bus cycle does occur.
%<HELP&(A80|A65)>	#.ti -13
%<HELP&(A80|A65)>	#\xF7^^^^^^^^^^^^A
%<HELP&(A80    )>	#skipped instruction.
%<HELP&(    A65)>	#conditional jump instruction which did not jump ("no-go").
%<HELP&(A80|A65)>	#The opcode mnemonic is displayed in lower-case.
%<HELP&(A80|A65)>	#For additional visual feedback, %rs1 displays the entire
%<HELP&(A80|A65)>	#line as "inactive" (see \l($345)Select^Color\m).
%<HELP>	#.ti -13
%<HELP>	#\b(uncertain)\r^^(Unable to decode with absolute certainty
%<HELP>	#because only part of an instruction's
%<HELP>	#execution trace was captured in the
%<HELP>	#buffer due to automatic wraparound in the
%<HELP>	#circular trace memory in the emulator.)
%<HELP&A85>	#.ti -13
%<HELP&A85>	#\b(Exception^Vector^Read:^<vector_name>)\r
%<HELP&A85>	#.sp 0
%<HELP&A85>	#An "Exception Vector
%<HELP&A85>	#Read" operation.  \b<vector_name>\r indicates which vector, or
%<HELP&A85>	#which type of vector, was read by the processor.
%<HELP>	#.in -13 }
%<HELP>	#.in -4 }
%<HELP>	#.($213)HLL
%<HELP>	#In the \bHLL\r display mode, you see the decoded content of the
%<HELP>	#the trace buffer interpreted as HLL source language images.
%<HELP>	#This can be done only if the \b%rs1\r system
%<HELP>	#has access to the source/listing files corresponding to
%<HELP>	#the modules in your program.
%<HELP>	#Source languages supported include C and PL/M-51.
%<HELP>	#.($214)Mixed
%<HELP>	#The \bMixed\r display mode is a combination of the
%<HELP>	#\l($212)Code\m and \l($213)HLL\m display modes.
%<HELP>	#The HLL source images (HLL mode display), if available,
%<HELP>	#appear interspersed appropriately with the generated
%<HELP>	#machine code (Code mode display).
%<HELP>	#.($215)Probes
%<HELP>	#The \bProbes\r command cyclically toggles the display of the captured
%<HELP>	#probe clip (see \l($356)Probe^Clip^Assembly\m) bit values through
%<HELP>	#three display modes:
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#.in +4 {
%<HELP>	#.ti -4
%<HELP>	#1.^^Binary
%<HELP>	#.ti -4
%<HELP>	#2.^^Hexadecimal
%<HELP>	#.ti -4
%<HELP>	#3.^^Digital waveform
%<HELP>	#.in -4 }
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#The \bProbes\r command and its associated display are available in
%<HELP>	#the \l($211)Raw\m, \l($212)Code\m and \l($214)Mixed\m
%<HELP>	#primary display modes.
%<HELP>	#.sp 1
%<HELP>	#The digital waveform display in the \bRaw\r display mode
%<HELP>	#reflects every frame in the trace buffer.
%<HELP>	#However, the waveform display in \bCode\r and \bMixed\r
%<HELP>	#modes reflects only the probe clip values in the first CPU (bus)
%<HELP>	#cycle of each instruction's execution.  Therefore, if a probe signal
%<HELP>	#transitions \uduring\r the CPU (bus) cycles of an instruction's
%<HELP>	#execution, the displayed waveform may appear "broken".
%<HELP>	#When you see this, you can switch into \bRaw\r display mode
%<HELP>	#to get the complete picture.
%<HELP>	#.($216)Search
%<HELP>	#The \bSearch\r command allows you to search the trace buffer
%<HELP>	#for a particular address, label, source line number or trace frame.
%<HELP>	#.sp 1
%<HELP>	#In searching for an address, label or source line number,
%<HELP>	#the search commences from the current position in the trace buffer
%<HELP>	#(the highlighted line).
%<HELP>	#You can search backwards in the trace buffer, looking for older
%<HELP>	#trace frames, or forwards, looking for newer (more recent) trace
%<HELP>	#frames.
%<HELP>	#.($217)Write
%<HELP>	#You can write the entire trace buffer to a disk file by selecting
%<HELP>	#the \bWrite\r command.  The format of the information written to
%<HELP>	#that file will be just as you see it on the screen
%<HELP>	#(i.e., in human-readable form, in the current display mode).
%<HELP>	#.($244)Expression Input
%<HELP>	#Whenever and wherever the iceMASTER Host Software requests an address,
%<HELP>	#count or length, you can enter an arbitrary expression
%<HELP>	#(suitable for the particular context, of course).  Expressions
%<HELP>	#may be edited using the following keys:
%<HELP>	#.sp 1
%<HELP>	#\bKeyboard Expression Editing Control Keys:\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#.in +11 {
%<HELP>	#.ti -11
%<HELP>	#\x1B^^^^^^^^^^move
%<HELP>	#the cursor one character position to the left
%<HELP>	#or scroll field horizontally
%<HELP>	#.ti -11
%<HELP>	#\x1A^^^^^^^^^^move
%<HELP>	#the cursor one character position to the right
%<HELP>	#or scroll field horizontally
%<HELP>	#.ti -11
%<HELP>	#Ctrl-Home^^move to beginning of input field
%<HELP>	#.ti -11
%<HELP>	#Ctrl-End^^^move to end of input field
%<HELP>	#.ti -11
%<HELP>	#Backspace^^delete the character to the left of the cursor
%<HELP>	#.ti -11
%<HELP>	#Del^^^^^^^^delete the character under the cursor
%<HELP>	#.ti -11
%<HELP>	#Ins^^^^^^^^toggle to/from insert mode (to insert a
%<HELP>	#character before the character under the cursor)
%<HELP>	#.ti -11
%<HELP>	#Esc^^^^^^^^immediate exit (cancel input)
%<HELP>	#.ti -11
%<HELP>	#Enter^^^^^^terminate input "normally" (at any character position)
%<HELP>	#.in -11 }
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#Expressions are composed of the following elements:
%<HELP>	#.sp 1
%<HELP>	#\bIdentifiers\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#The first character in an identifier name cannot be a digit
%<HELP>	#or the '$' character:
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#.ba {
%<HELP>	#First character:^^^^^^^^_ ? @ a-z A-Z
%<HELP&(!A78)>	#Subsequent characters:^^_ $ a-z A-Z 0-9
%<HELP&( A78)>	#Subsequent characters:^^_ ? @ $ a-z A-Z 0-9
%<HELP>	#.ea }
%<HELP>	#.in -2 }
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#\bInteger Constants\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#The iceMASTER Host Software supports C style constants as well as a
%<HELP>	#variety of other popular formats.  The following notations are used
%<HELP>	#in subsequent definitions.  A plural suffix (\us\r) means "one or
%<HELP>	#more of" the specified characters or digits.  A suffix of \u-opt\r
%<HELP>	#means that the item is optional (i.e., "zero or more of").  Note
%<HELP>	#that spaces used in the following constant definitions are for
%<HELP>	#readability and should not be used when you type in constants.
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#\uhex-digit\r:^^^^^^^^^^^0-9 a-f A-F
%<HELP>	#.sp 1
%<HELP>	#\udec-digit\r:^^^^^^^^^^^0-9
%<HELP>	#.sp 1
%<HELP>	#\unon-zero-dec-digit\r:^^1-9
%<HELP>	#.sp 1
%<HELP>	#\uoct-digit\r:^^^^^^^^^^^0-7
%<HELP>	#.sp 1
%<HELP>	#\ubin-digit\r:^^^^^^^^^^^0-1
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#\bExplicit Radix\r
%<HELP>	#.in +2 {
%<HELP>	#.sp 1
%<HELP>	#The following constants contain an explicit base (radix) designator,
%<HELP>	#either as a prefix or a suffix.  Such constants will be interpreted
%<HELP>	#in the designated base, regardless of the current setting of the
%<HELP>	#\l($471)Radix\m command.  Following each definition are some
%<HELP>	#examples of that particular style of constant.
%<HELP>	#.sp 1
%<HELP>	#.ba {
%<HELP>	#\u0x^hex-digits\r
%<HELP>	#\u0X^hex-digits\r
%<HELP>	#.ea }
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#Hexadecimal constant with explicit prefix (C style).
%<HELP>	#.sp 1
%<HELP>	#An optional suffix of '\uu\r' or '\uU\r' specifies an unsigned
%<HELP>	#integer.  This is generally unnecessary, as the Host Software
%<HELP>	#treats all constants as unsigned.
%<HELP>	#.sp 1
%<HELP>	#An optional suffix of '\ul\r' or '\uL\r' specifies a long
%<HELP>	#(32-bit) integer rather than a 16-bit integer.
%<HELP>	#.sp 1
%<HELP>	#The suffixes '\uu\r', '\uU\r', '\ul\r' and '\uL\r' can be used
%<HELP>	#at the same time, in either order.
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#.ba {
%<HELP>	#0x12
%<HELP>	#0xa
%<HELP>	#0x1275ul
%<HELP>	#.ea }
%<HELP>	#.in -2 }
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#.ba {
%<HELP>	#\uh'^hex-digits\r
%<HELP>	#\uH'^hex-digits\r
%<HELP>	#.ea }
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#Hexadecimal constant with explicit prefix (Hitachi style).
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#.ba {
%<HELP>	#h'ab
%<HELP>	#h'45
%<HELP>	#H'123456
%<HELP>	#.ea }
%<HELP>	#.in -2 }
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#.ba {
%<HELP>	#\ux'^hex-digits\r
%<HELP>	#\uX'^hex-digits\r
%<HELP>	#.ea }
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#Hexadecimal constant with explicit prefix (National style).
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#.ba {
%<HELP>	#x'ab
%<HELP>	#x'45
%<HELP>	#X'123456
%<HELP>	#.ea }
%<HELP>	#.in -2 }
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#\u$^hex-digits\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#Hexadecimal constant with explicit prefix (Motorola style).
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#.ba {
%<HELP>	#$ab
%<HELP>	#$0045
%<HELP>	#$123456
%<HELP>	#.ea }
%<HELP>	#.in -2 }
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#.ba {
%<HELP>	#\udec-digit^hex-digits-opt^h\r
%<HELP>	#\udec-digit^hex-digits-opt^H\r
%<HELP>	#.ea }
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#Hexadecimal constant with explicit suffix (Intel, et. al., style).
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#.ba {
%<HELP>	#1ah
%<HELP>	#0054h
%<HELP>	#12345678H
%<HELP>	#.ea }
%<HELP>	#.in -2 }
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#.ba {
%<HELP>	#\udec-digits^t\r
%<HELP>	#\udec-digits^T\r
%<HELP>	#\udec-digits^.\r
%<HELP>	#.ea }
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#Decimal constant with explicit suffix.
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#.ba {
%<HELP>	#12t
%<HELP>	#045.
%<HELP>	#.ea }
%<HELP>	#.in -2 }
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#.ba {
%<HELP>	#\unon-zero-dec-digit^dec-digits-opt^u\r
%<HELP>	#\unon-zero-dec-digit^dec-digits-opt^U\r
%<HELP>	#\unon-zero-dec-digit^dec-digits-opt^l\r
%<HELP>	#\unon-zero-dec-digit^dec-digits-opt^L\r
%<HELP>	#.ea }
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#Decimal constant with explicit suffix (C style).
%<HELP>	#.sp 1
%<HELP>	#A suffix of '\uu\r' or '\uU\r' specifies an unsigned
%<HELP>	#integer.  This is generally unnecessary, as the Host Software
%<HELP>	#treats all constants as unsigned.
%<HELP>	#.sp 1
%<HELP>	#A suffix of '\ul\r' or '\uL\r' specifies a long
%<HELP>	#(32-bit) integer rather than a 16-bit integer.
%<HELP>	#.sp 1
%<HELP>	#The suffixes '\uu\r', '\uU\r', '\ul\r' and '\uL\r' can be used
%<HELP>	#at the same time, in either order.
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#.ba {
%<HELP>	#5u
%<HELP>	#23l
%<HELP>	#47UL
%<HELP>	#.ea }
%<HELP>	#.in -2 }
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#.ba {
%<HELP>	#\uoct-digits^o\r
%<HELP>	#\uoct-digits^O\r
%<HELP>	#\uoct-digits^q\r
%<HELP>	#\uoct-digits^Q\r
%<HELP>	#.ea }
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#Octal constant with explicit suffix.
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#.ba {
%<HELP>	#12o
%<HELP>	#045Q
%<HELP>	#.ea }
%<HELP>	#.in -2 }
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#\u0^oct-digits\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#Octal constant with explicit prefix (C style).
%<HELP>	#.sp 1
%<HELP>	#An optional suffix of '\uu\r' or '\uU\r' specifies an unsigned
%<HELP>	#integer.  This is generally unnecessary, as the Host Software
%<HELP>	#treats all constants as unsigned.
%<HELP>	#.sp 1
%<HELP>	#An optional suffix of '\ul\r' or '\uL\r' specifies a long
%<HELP>	#(32-bit) integer rather than a 16-bit integer.
%<HELP>	#.sp 1
%<HELP>	#The suffixes '\uu\r', '\uU\r', '\ul\r' and '\uL\r' can be used
%<HELP>	#at the same time, in either order.
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#.ba {
%<HELP>	#012
%<HELP>	#055u
%<HELP>	#.ea }
%<HELP>	#.in -2 }
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#.ba {
%<HELP>	#\ubin-digits^y\r
%<HELP>	#\ubin-digits^Y\r
%<HELP>	#.ea }
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#Binary constant with explicit suffix.
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#.ba {
%<HELP>	#1011y
%<HELP>	#110011Y
%<HELP>	#.ea }
%<HELP>	#.in -2 }
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#In all cases, if you do not supply an '\ul\r' or '\uL\r' suffix
%<HELP>	#(or if such a suffix is not allowed) and the constant cannot fit
%<HELP>	#in 16 bits, it will automatically be treated as a long value (32 bits).
%<HELP>	#.sp 1
%<HELP>	#If you are unsure of how a particular constant is being interpreted
%<HELP>	#by the Host Software, use the \l($118)Display/Alter|Expression\m
%<HELP>	#command to see how the constant or constant expression is being
%<HELP>	#treated.
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#\bNo Explicit Radix\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#If you enter a number such as 10 or 101, it will be interpreted
%<HELP>	#in the current default base (\l($471)Radix\m).  However, in
%<HELP>	#certain contexts where it makes sense, the Host Software will
%<HELP>	#temporarily override the current default. For example, when you
%<HELP>	#enter a source line number as \b#11\r
%<HELP>	#the software temporarily changes the default radix to 10 (decimal)
%<HELP>	#before translating the value.  In other cases, when the Host
%<HELP>	#Software displays a Dialog Box to obtain input, a message somewhere
%<HELP>	#in the box (usually on the bottom border) indicates if the default
%<HELP>	#radix has been changed temporarily.
%<HELP>	#.sp 1
%<HELP>	#In any case, you can always provide an explicit radix designator
%<HELP>	#in the constant to override any default interpretation.  For
%<HELP>	#example, \b#0x23\r designates source line number 35 (decimal).
%<HELP>	#.sp 1
%<HELP>	#In some cases, the Host Software can automatically determine the
%<HELP>	#appropriate radix based only on the characters and digits present
%<HELP>	#in the constant.  For example, \b1A\r can only be the hexadecimal
%<HELP>	#number 0x1A, even though no explicit prefix or suffix is present.
%<HELP>	#.in -2 }
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#\bFloating-Point Constants\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#The Host Software supports both single-precision and
%<HELP>	#double-precision floating point constants.
%<HELP>	#.sp 1
%<HELP>	#.ba {
%<HELP>	#\udec-digits.dec-digits^exponent-opt\r
%<HELP>	#\udec-digits^exponent\r
%<HELP>	#.ea }
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#The \uexponent\r has the following form:
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#\uexponent\r:^^\uexp-char^sign-opt^dec-digits\r
%<HELP>	#.sp 1
%<HELP>	#\uexp-char\r:^^\be\r or \bE\r
%<HELP>	#.sp 1
%<HELP>	#\usign\r:^^^^^^\b+\r or \b-\r
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#If there is no suffix, the constant is double-precision
%<HELP>	#floating-point (\bdouble\r).  An optional suffix of '\uf\r' or
%<HELP>	#'\uF\r' specifies that the constant is single-precision
%<HELP>	#floating-point (\bfloat\r).  An optional suffix of '\ul\r' or
%<HELP>	#'\uL\r' specifies that the constant is double-precision
%<HELP>	#floating-point (\bdouble\r).
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#.ba {
%<HELP>	#1.2
%<HELP>	#1.2f
%<HELP>	#5.6e5
%<HELP>	#.ea }
%<HELP>	#.in -2 }
%<HELP>	#.in -2 }
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#\bCharacter Constants\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#The value of a character constant is the numerical value of the
%<HELP>	#character interpreted as an integer.  Internally, character
%<HELP>	#constants are treated just as if you had entered an integer constant.
%<HELP>	#.sp 1
%<HELP>	#.ba {
%<HELP>	#\u'\\ 1-to-3-oct-digits'\r
%<HELP>	#\u'\\ x1-to-3-hex-digits'\r
%<HELP>	#\u'\\ escaped-char'\r
%<HELP>	#\u'char'\r
%<HELP>	#.ea }
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#The first form uses an escaped sequence of one to three octal digits.
%<HELP>	#.sp 1
%<HELP>	#The second form uses an escaped sequence of one to three
%<HELP>	#hexadecimal digits.
%<HELP>	#.sp 1
%<HELP>	#The third form (a character escape sequence) specifies one of the
%<HELP>	#following specially recognized escape characters:
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#.ba {
%<HELP>	#Source^Form  Internal^Value        Meaning
%<HELP>	#-----------  --------------  --------------------
%<HELP>	#    \\a            0x07       ANSI Alert (bell)
%<HELP>	#    \\b            0x08       ANSI Backspace
%<HELP>	#    \\e            0x1B       ANSI Esc
%<HELP>	#    \\f            0x0C       ANSI Formfeed
%<HELP>	#    \\n            0x0A       ANSI New Line
%<HELP>	#    \\r            0x0D       ANSI Carriage Return
%<HELP>	#    \\t            0x09       ANSI Horizontal Tab
%<HELP>	#    \\v            0x0B       ANSI Vertical Tab
%<HELP>	#.ea }
%<HELP>	#.sp 1
%<HELP>	#If the backslash precedes a character that does not appear in the
%<HELP>	#table above, the value used is the value of that character itself.
%<HELP>	#That is, '\\w' is the same as 'w'.
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#The fourth form represents the standard, "simple" case.
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#.ba {
%<HELP>	#'\\077'
%<HELP>	#'\\n'
%<HELP>	#'H'
%<HELP>	#.ea }
%<HELP>	#.in -2 }
%<HELP>	#.in -2 }
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#\bString Constants\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#\u"chars-opt"\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#The form of each \uchar\r in \uchars-opt\r is the same as that allowed
%<HELP>	#for character constants.  That is, all forms of escape sequences are
%<HELP>	#allowed internally.
%<HELP>	#.sp 1
%<HELP>	#Currently, string constants can only be used as pattern values in the
%<HELP>	#\l($254)Display/Alter|(memory)|Fill\m commands and
%<HELP>	#\l($489)Display/Alter|(memory)|Search\m commands.
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#.ba {
%<HELP>	#"abcd"
%<HELP>	#"abcd\\n"
%<HELP>	#.ea }
%<HELP>	#.in -2 }
%<HELP>	#.in -2 }
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#The operators and operands which are allowed in expressions are
%<HELP>	#grouped below in decreasing precedence order.  The highest precedence
%<HELP>	#operators and expression elements are listed first.  To simplify
%<HELP>	#the description, the term \uexpr\r means any expression at that
%<HELP>	#precedence level or higher, and the term \uexpression\r means any
%<HELP>	#expression at all.
%<HELP>	#.sp 1
%<HELP>	#\bPrimary Expressions\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#\uidentifier\r
%<HELP>	#.in +2 {
%<HELP>	#.sp 1
%<HELP>	#Denotes a variable, label, module, function or SFR (Special Function
%<HELP>	#Register) name.  In the absence of any qualification on \uidentifier\r,
%<HELP>	#the Host Software first searches for the definition in the following
%<HELP>	#order:
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#.ba {
%<HELP>	#- local symbols in the current module
%<HELP>	#- global symbols
%<HELP>	#.ea }
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#In the following descriptions, we use more meaningful names for
%<HELP>	#indentifiers to denote what kind of identifier is required in a
%<HELP>	#particular context:
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#.ba {
%<HELP>	#- module-name
%<HELP>	#- function-name
%<HELP>	#- SFR-name
%<HELP>	#.ea }
%<HELP>	#.in -2 }
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#\uconstant\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#An integer constant, floating-point constant or character constant.
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#\ustring\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#A character string constant (literal).
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#\u(expression)\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#A parenthesized expression.  Parentheses can be used to change or
%<HELP>	#clarify the order of operator precedence.
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#\u#integer-constant\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#Source line number \uinteger-constant\r in the current module.
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#\umodule-name:#integer-constant\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#Source line number \uinteger-constant\r in the module
%<HELP>	#\umodule-name\r.
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#\umodule-name:identifier\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#Variable or function \uidentifier\r in the module
%<HELP>	#\umodule-name\r.
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#\umodule-name:function-name:identifier\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#The variable \uidentifier\r in the function \ufunction-name\r in
%<HELP>	#module \umodule-name\r.
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#.ba {
%<HELP>	#\uC:integer-constant\r
%<HELP>	#\uX:integer-constant\r
%<HELP>	#\uD:integer-constant\r
%<HELP>	#\uI:integer-constant\r
%<HELP>	#\uB:integer-constant\r
%<HELP>	#.ea }
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#Denotes a \bmemory space qualified constant\r.  In most cases where
%<HELP>	#the Host Software requests an address, you do not need to specify
%<HELP>	#explicitly what memory space to use when you enter a constant or
%<HELP>	#constant expression.  For example, when setting a code-break-point,
%<HELP>	#if you enter \b0x23\r, the Host Software assumes you
%<HELP>	#mean location 0x0023 in
%<HELP&(!A65)>	#code
%<HELP&( A65)>	#general
%<HELP>	#memory.  Similarly, if you use labels
%<HELP>	#or variable names, the symbol/debug information supplied in the
%<HELP>	#program load module file normally tells what memory space the symbol
%<HELP>	#is in.
%<HELP>	#.sp 1
%<HELP>	#However, if you want to change the value in a generic pointer
%<HELP>	#(when using Franklin C, for example) you must tell the Host
%<HELP>	#Software what memory space the address is relative to.
%<HELP>	#.sp 1
%<HELP>	#In addition, you can use the memory space qualified constant to
%<HELP>	#designate an address in other contexts.  For example, you can
%<HELP>	#add the Watch Expression \bC:0x23\r to the \l($384)Watch^Window\m.
%<HELP>	#This will allow you to monitor location 0x0023 in Code Memory.
%<HELP>	#The designator's used to specify a memory space are described
%<HELP>	#in \l($574)Memory^Space^Constants\m.
%<HELP>	#.sp 1
%<HELP>	#.in -2 }
%<HELP>	#.in -2 }
%<HELP>	#\bPostfix Expressions\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#\uexpr.member-name\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#Structure or union member \umember-name\r in the structure/union
%<HELP>	#expression \uexpr\r.  The \uexpr\r musr have a \bstruct\r or
%<HELP>	#\bunion\r type.
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP&(A51|A65|A78)>	#\uexpr.integer-constant\r
%<HELP&(A51|A65|A78)>	#.sp 1
%<HELP&(A51|A65|A78)>	#.in +2 {
%<HELP&(A51        )>	#(8051 only) Designates a particular
%<HELP&(A51        )>	#bit in a bit-addressable SFR. The
%<HELP&(A51        )>	#\uinteger-constant\r must be between
%<HELP&(A51        )>	#0 and 7, inclusive.
%<HELP&(    A65    )>	#Designates a particular bit in a
%<HELP&(    A65    )>	#location in Local Memory.
%<HELP&(        A78)>	#Designates a particular bit in a location
%<HELP&(        A78)>	#in memory. The \uinteger-constant\r must
%<HELP&(        A78)>	#be between 0 and 7, inclusive.
%<HELP&(A51|A65|A78)>	#.in -2 }
%<HELP&(A51|A65|A78)>	#.sp 1
%<HELP>	#\uexpr->member-name\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#Structure or union member \umember-name\r in the structure/union
%<HELP>	#pointed at by pointer expression \uexpr\r.  The expression must have
%<HELP>	#the type "pointer to \bstruct\r" or "pointer to \bunion\r".
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#\uexpr[expression]\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#Subscript expression.  The object being subscripted, \uexpr\r, must
%<HELP>	#have the type "array of ..." or "pointer to ...".  The subscript
%<HELP>	#expression, \uexpression\r, must be of an integral type.
%<HELP>	#.in -2 }
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#\bUnary Expressions\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#\u*expr\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#Indirection through the pointer expression \uexpr\r, which must be
%<HELP>	#of the type "pointer to ...".
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#\u-expr\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#Unary minus.  The \uexpr\r can be either integral or a floating-point
%<HELP>	#constant.
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#\u+expr\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#Unary plus.  The \uexpr\r can be either integral or a floating-point
%<HELP>	#constant.
%<HELP>	#.in -2 }
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#\bCast Expressions\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#\u(type-name)expr\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#Casting is intended for use in conjunction with a memory space
%<HELP>	#qualified constant.  The meaning of such an expression is
%<HELP>	#"treat the location \uexpr\r as having data type
%<HELP>	#\l($573)type-name\m".
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#Note that no conversions are performed on the value.  The cast merely
%<HELP>	#serves to change the data type that the Host Software associates
%<HELP>	#with the designated address.
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#\bMultiplicative Expression\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#\uexpr*expr\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#Multiplication.
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#\uexpr/expr\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#Division.
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#\uexpr%expr\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#Modulo division.
%<HELP>	#.in -2 }
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#\bAdditive Expression\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#\uexpr+expr\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#Addition.
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#\uexpr-expr\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#Subtraction.
%<HELP>	#.in -2 }
%<HELP>	#.in -2 }
%<HELP>	#.($245)Help for Help
%<HELP>	#\bGeneral\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#"Boldfaced" text in a Help Topic appears as:^^\bboldfaced\r.
%<HELP>	#"Underlined" text in a Help Topic appears as:^^\uunderlined\r.
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#\bHyperlinks\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#A hyperlink is a viewable cross-reference embedded within one
%<HELP>	#Help Topic to another, related Help Topic.
%<HELP>	#You can "select" this embedded reference to view the Help Topic
%<HELP>	#denoted by the hyperlink.  To do this, you first "position" to
%<HELP>	#the hyperlink of interest (a given Help Topic may contain several
%<HELP>	#embedded hyperlinks) and then "select" it:
%<HELP>	#.sp 1
%<HELP>	#.in +4 {
%<HELP>	#.in +11 {
%<HELP>	#.ti -11
%<HELP>	#\bTab\r^^^^^^^^position to next hyperlink and highlight it
%<HELP>	#.ti -11
%<HELP>	#\bShift-Tab\r^^position to previous hyperlink and highlight it
%<HELP>	#.ti -11
%<HELP>	#\bEnter\r^^^^^^select current (highlighted) hyperlink
%<HELP>	#.in -11 }
%<HELP>	#.in -4 }
%<HELP>	#.sp 1
%<HELP>	#The \l($246)Configure|Options|Stack^Hyperlinks\m toggle controls
%<HELP>	#the behavior of the Help System when a new hyperlink is selected.
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#\bHelp for "Pushed Contexts" (F2)\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#In some cases, the \b%rs1\r context-sensitive Help System is too
%<HELP>	#context-sensitive.  For example, while you are typing the name of
%<HELP>	#a file to be loaded into the emulator,
%<HELP>	#you might press the 'Help' hot key to get help on
%<HELP>	#the acceptable file types.
%<HELP>	#However, since you are in an
%<HELP>	#input dialog box, you will get Help about editing keyboard input.
%<HELP>	#In such cases, you can press the \bF2\r function key to obtain
%<HELP>	#Help for the "outer context(s)".  Pressing \bF2\r repeatedly will take
%<HELP>	#you back on the path that got you to where you are now, showing you
%<HELP>	#each Help Topic along the way.
%<HELP>	#.sp 1
%<HELP>	#To get back to your present position in the Help System,
%<HELP>	#simply press \bEsc\r to get back from the \bF2\r digression.
%<HELP>	#(You will need to press \bEsc\r once for each time you pressed
%<HELP>	#the \bF2\r key.
%<HELP>	#Unlike the \l($246)Configure|Options|Stack^Hyperlinks\m toggle,
%<HELP>	#the \bF2\r type of hyperlinking always "stacks".)
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#\bMove or Resize Help Box\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#.in +8 {
%<HELP>	#.ti -8
%<HELP>	#Ctrl-V^^Enter "Mo\bv\re Help Box" mode.
%<HELP>	#See \l($353)Move^Box\m for more details.
%<HELP>	#.sp 1
%<HELP>	#.ti -8
%<HELP>	#Ctrl-R^^Enter "\bR\resize Help Box" mode.
%<HELP>	#See \l($354)Resize^Box\m for more details.
%<HELP>	#.in -8 }
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#\bWrite Current Help Topic to a File (Ctrl-W)\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#You can press the \bCtrl-W\r key combination to write the current
%<HELP>	#Help Topic to a file of your choice.
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#For your convenience, \l($247)General^Help\m is also available from
%<HELP>	#here.
%<HELP>	#.($246)Stack Hyperlinks
%<HELP>	#The \bStack Hyperlinks\r toggle controls the behavior
%<HELP>	#of the Help System when a new Help Topic is invoked via
%<HELP>	#a hyperlink:
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#.in +6 {
%<HELP>	#.ti -6
%<HELP>	#On:^^^When you select a new Help Topic via a hyperlink
%<HELP>	#in the current Help Topic,
%<HELP>	#the host software "remembers" your position in the
%<HELP>	#current Help Topic.  When you exit that new Help Topic,
%<HELP>	#you return to the "remembered" position in the current
%<HELP>	#Help Topic.  This process applies recursively.
%<HELP>	#.ti -6
%<HELP>	#Off:^^When you select a new Help Topic via a hyperlink
%<HELP>	#in the current Help Topic,
%<HELP>	#the host software does \unot\r "remember" your position in the
%<HELP>	#current Help Topic.  When you exit that new Help Topic,
%<HELP>	#you exit the Help System.
%<HELP>	#.in -6 }
%<HELP>	#.in -2 }
%<HELP>	#.($247)General Help
%<HELP>	#\bContext-Sensitive^Help\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#You can obtain context-sensitive Help information anywhere within
%<HELP>	#the \b%rs1\r host software by pressing the hot key
%<HELP>	#(function key) for Help.
%<HELP>	#The default assignment for the Help hot key is \bF1\r.
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#\bGeneral^Help\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#Following are some hyperlinks to general information and
%<HELP>	#other miscellaneous topics.
%<HELP>	#These topics are grouped together here because they are not associated
%<HELP>	#with any single, particular context within the \b%rs1\r system.
%<HELP>	#.sp 1
%<HELP>	#Press the \bTab\r key
%<HELP>	#to highlight the information you wish to view and then
%<HELP>	#press \bEnter\r:
%<HELP>	#.in +2 {
%<HELP&(DEM|SIM)>		#.sp 1
%<HELP& DEM     >		#\l($350)Description^of^Demo/Simulator\m^
%<HELP&     SIM >		#\l($350)Description^of^Simulator\m^
%<HELP&( (A80&DMD))>	#.sp 1
%<HELP&( (A80&DMD))>	#\l($469)COP8^Debug^Module^Jumpers\m
%<HELP>					#.sp 1
%<HELP>					#\l($249)Command^Line^Options\m
%<HELP&(!(A80&DMD))>	#.sp 1
%<HELP&(!(A80&DMD))>	#\l($356)Probe^Clip^Assembly\m
%<HELP>					#.sp 1
%<HELP>					#\l($346)Pull-down^Menus\m
%<HELP>					#.sp 1
%<HELP>					#\l($434)Recommended^Compilation/Linking^Options\m
%<HELP>					#.sp 1
%<HELP>					#\l($248)Special^Keys\m
%<HELP>					#.sp 1
%<HELP>					#\l($433)Symbolic^Loadable^File^Formats\m
%<HELP>					#.sp 1
%<HELP>					#\l($250)System^Files\m
%<HELP&(!(DEM|SIM))>	#.sp 1
%<HELP&(!(DEM|SIM))>	#\l($352)Sales/Support^Information\m^
%<HELP&( (DEM|SIM))>	#.sp 1
%<HELP&( (DEM    ))>	#\l($349)Catalog^of^iceMASTER^Products\m^
%<HELP&( (    SIM&A51))>#\l($351)Catalog^of^iceMASTER^Products\m^
%<HELP&( (    SIM&A68))>#\l($543)Catalog^of^iceMASTER^Products\m^
%<HELP&( (    SIM&A80))>#\l($542)Catalog^of^iceMASTER^Products\m^
%<HELP&( (    SIM&A05))>#\l($544)Catalog^of^iceMASTER^Products\m^
%<HELP&( (    SIM&A65))>#\l($545)Catalog^of^iceMASTER^Products\m^
%<HELP&( (    SIM&A85))>#\l($546)Catalog^of^iceMASTER^Products\m^
%<HELP&( (    SIM&A25))>#\l($551)Catalog^of^iceMASTER^Products\m^
%<HELP&( (    SIM&A78))>#\l($552)Catalog^of^iceMASTER^Products\m^
%<HELP&( (DEM|SIM))>	#.sp 1
%<HELP&( (DEM|SIM))>	#\l($352)Sales^Information\m^
%<HELP>	#.in -2 }
%<HELP>	#.($248)Special Keys
%<HELP>	#Throughout the \b%rs1\r system, certain special keystrokes and
%<HELP>	#keystroke combinations always have
%<HELP>	#the same meaning (cause the same effect or same action).
%<HELP>	#The following table lists those keys and describes their effects.
%<HELP>	#.sp 1
%<HELP>	#.in +3 {
%<HELP>	#.in +12 {
%<HELP>	#.ti -12
%<HELP>	#Keystroke^^^Effect/Action
%<HELP>	#.ti -12
%<HELP>	#---------^^^-------------
%<HELP>	#.ti -12
%<HELP>	#Esc^^^^^^^^^Exit, or back out of, current menu/command.
%<HELP>	#.ti -12
%<HELP>	#Ctrl-E^^^^^^Exit, or back out of, \uall\r currently popped-up
%<HELP>	#menus/windows/boxes.
%<HELP>	#Pressing this keystroke combination takes you back to the Main Screen.
%<HELP>	#.ti -12
%<HELP>	#\x18^^^^^^^^^^^Move highlight bar or cursor up one line.
%<HELP>	#.ti -12
%<HELP>	#\x19^^^^^^^^^^^Move highlight bar or cursor down one line.
%<HELP>	#.ti -12
%<HELP>	#\x1B^^^^^^^^^^^Move highlight bar or cursor one position
%<HELP>	#to the left.
%<HELP>	#.ti -12
%<HELP>	#\x1A^^^^^^^^^^^Move highlight bar or cursor one position
%<HELP>	#to the right.
%<HELP>	#.ti -12
%<HELP>	#Home^^^^^^^^Move highlight bar or cursor to the beginning
%<HELP>	#of the data in the window/box.
%<HELP>	#.ti -12
%<HELP>	#End^^^^^^^^^Move highlight bar or cursor to the end
%<HELP>	#of the data in the window/box.
%<HELP>	#.ti -12
%<HELP>	#PgUp^^^^^^^^Move highlight bar or cursor one screenful back
%<HELP>	#in the data in the window/box.
%<HELP>	#.ti -12
%<HELP>	#PgDn^^^^^^^^Move highlight bar or cursor one screenful ahead
%<HELP>	#in the data in the window/box.
%<HELP>	#.ti -12
%<HELP>	#Tab^^^^^^^^^Position (move) to the next window or field.
%<HELP>	#.ti -12
%<HELP>	#Shift-Tab^^^Position (move) to the previous window or field.
%<HELP>	#.ti -12
%<HELP>	#Ctrl-B^^^^^^Toggle (on or off) a permanent simple break-point
%<HELP>	#at the currently highlighted location in the Source Window or in
%<HELP>	#the Assembler/Disassembler Menu.
%<HELP>	#.ti -12
%<HELP>	#Ctrl-T^^^^^^Set a temporary break-point
%<HELP>	#at the currently highlighted location in the Source Window and
%<HELP>	#begin emulation immediately.
%<HELP>	#.ti -12
%<HELP>	#Ctrl-V^^^^^^Enter Box/Menu/Window "Mo\bv\re" mode.
%<HELP>	#See \l($353)Move^Box\m for more details.
%<HELP>	#.ti -12
%<HELP>	#Ctrl-R^^^^^^Enter Box/Menu/Window "\bR\resize" mode.
%<HELP>	#See \l($354)Resize^Box\m for more details.
%<HELP>	#\bCtrl-R\r acts as a 3-way toggle when you use it
%<HELP>	#on the pull-down menu boxes themselves.
%<HELP>	#.ti -12
%<HELP>	#Ctrl-W^^^^^^\bW\rrite the data in the window/box to a disk file
%<HELP>	#of your choice.
%<HELP>	#In all cases where the \bWrite\r command is present, \bCtrl-W\r
%<HELP>	#is an alias for \bWrite\r.  In some contexts where it is not
%<HELP>	#appropriate to have a specific \bWrite\r command, \bCtrl-W\r
%<HELP>	#still is available to perform the 'Write' action.
%<HELP>	#For example, \bCtrl-W\r is available in most of the pop-up windows
%<HELP>	#accessible from the \bSource/Symbols\r menu bar command,
%<HELP>	#as well as within the Help system.
%<HELP>	#.in -12 }
%<HELP>	#.in -3 }
%<HELP>	#.($249)Command Line Options
%<HELP>	#You can control several aspects of behavior of the \b%rs1\r host
%<HELP>	#software by supplying one or more options (arguments) on the DOS
%<HELP>	#command line when you invoke the host software.
%<HELP>	#Command line options (arguments) can begin with either a dash, \b-\r,
%<HELP>	#or a forward slash, \b/\r.
%<HELP>	#Command line arguments may be specified in any order;
%<HELP>	#they are \ucase-sensitive\r:
%<HELP>	#.sp 1
%<HELP>	#.in +8 {
%<HELP&A51>	#.ti -8
%<HELP&A51>	#-a
%<HELP&A51>	#.sp 1
%<HELP&A51>	#If you are using a very old version of IAR/Archimedes C,
%<HELP&A51>	#this argument is required for the \b%rs1\r host software to
%<HELP&A51>	#properly handle/display code labels.
%<HELP&A51>	#.sp 1
%<HELP>	#.ti -8
%<HELP>	#-d^<ms>
%<HELP>	#.sp 1
%<HELP>	#Set the macro playback delay between keystrokes
%<HELP>	#to <ms> milliseconds.  \b-d <ms>\r is to be used in conjunction
%<HELP>	#with the \b-i\r command line option.
%<HELP>	#.sp 1
%<HELP>	#.ti -8
%<HELP>	#-g
%<HELP>	#.sp 1
%<HELP>	#By default, the \b%rs1\r host software ignores compiler-generated
%<HELP>	#symbols (usually internal, intermediate labels) when
%<HELP>	#\l($86)load\ming the symbolic debug information from a file.
%<HELP>	#You can force the host software to enter (retain) these symbols in the
%<HELP>	#internal symbol table by specifying the \b-g\r command line option.
%<HELP>	#Currently, symbols which fall into this category are those of the
%<HELP>	#form:
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#.in +9 {
%<HELP>	#.ti -9
%<HELP>	#?nnnn^^^^where 'nnnn' is a 4-digit number.
%<HELP>	#.in -9 }
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#Such symbols are found in load modules
%<HELP>	#in the following formats:
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#IAR/Archimedes Debug Format
%<HELP>	#.sp 1
%<HELP>	#Intel Absolute Object Module Format (AOMF)
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#.ti -8
%<HELP>	#-i^<macrofile_name>
%<HELP>	#.sp 1
%<HELP>	#Use <macrofile_name> as the startup macro input file.
%<HELP>	#.sp 1
%<HELP>	#.ti -8
%<HELP>	#-kf
%<HELP>	#.sp 1
%<HELP>	#Commands will 'flicker' when selected.  Note that 'flickering'
%<HELP>	#can be disabled by turning the \l($70)Flicker\m configuration
%<HELP>	#option OFF.
%<HELP>	#.sp 1
%<HELP>	#.ti -8
%<HELP>	#-l
%<HELP>	#.sp 1
%<HELP>	#Ignore \blocal\r symbols when loading an absolute object
%<HELP>	#module format file.  Use where some symbolic debug is
%<HELP>	#desired when there are an extremely large number of
%<HELP>	#local symbols.  This is provided as an
%<HELP>	#alternative to selective
%<HELP>	#re-compiling/re-assembling and relinking without
%<HELP>	#debug information output.
%<HELP>	#.sp 1
%<HELP>	#.ti -8
%<HELP>	#-m^<file_name>
%<HELP>	#.sp 1
%<HELP>	#Use <file_name> as the Model File (probe card description/definition
%<HELP>	#file) instead of \l($250)$MODEL\m.
%<HELP>	#.sp 1
%<HELP>	#.ti -8
%<HELP>	#-ma^<file_name>
%<HELP>	#.sp 1
%<HELP>	#Use <file_name> to set mapping.  The file must have been created
%<HELP>	#using the
%<HELP&(!A65)>	#\l($37)Configure|Code^Memory|Save\m
%<HELP&( A65)>	#\l($37)Configure|General^Memory|Save\m
%<HELP&A51>	#command or the \l($45)Configure|Xdata^Memory|Save\m
%<HELP>	#command.
%<HELP>	#.sp 1
%<HELP>	#.ti -8
%<HELP>	#-n
%<HELP>	#.sp 1
%<HELP>	#Forces interpretation of the 'blink' video
%<HELP>	#attribute bit to mean "intensify the background color".
%<HELP>	#Effectively, this allows use of 16 background colors
%<HELP>	#rather than the normal 8.
%<HELP>	#This option should be specified only when your PC has
%<HELP>	#an EGA/VGA adapter installed, attached to an EGA/VGA
%<HELP>	#monitor.
%<HELP>	#.sp 1
%<HELP>	#Normally, the \b%rs1\r host software automatically determines how to
%<HELP>	#interpret the 'blink' bit, based on the adapter and
%<HELP>	#monitor installed in the computer.  However, sometimes
%<HELP>	#the software can get "fooled".  This option provides an
%<HELP>	#absolute override.
%<HELP>	#.sp 1
%<HELP>	#.ti -8
%<HELP>	#-naw
%<HELP>	#.sp 1
%<HELP>	#"No Aomf Warnings":  Suppress all warning diagnostics
%<HELP>	#while loading an Intel format AOMF (Absolute Object
%<HELP>	#Module Format) file.  This also applies to Keil/Franklin
%<HELP>	#AOMF files.
%<HELP>	#.sp 1
%<HELP>	#.ti -8
%<HELP>	#-o
%<HELP>	#.sp 1
%<HELP>	#Forces interpretation of the 'blink' video
%<HELP>	#attribute bit to mean "blink the foreground character".
%<HELP>	#This option should be specified when your PC has
%<HELP>	#a Monochrome or CGA adapter installed, attached to a
%<HELP>	#monochrome or CGA monitor.
%<HELP>	#Normally, the \b%rs1\r host software automatically determines how to
%<HELP>	#interpret the 'blink' bit, based on the adapter and
%<HELP>	#monitor installed in the system.  However, sometimes
%<HELP>	#the software can get "fooled".  This option provides an
%<HELP>	#absolute override.
%<HELP>	#.sp 1
%<HELP>	#.ti -8
%<HELP>	#-osd
%<HELP>	#.sp 1
%<HELP>	#OS-Escape:  Totally disable the "swap host software out
%<HELP>	#of memory" feature during an \l($122)OS-Escape\m (shell-out
%<HELP>	#to DOS).  This option overrides the \b-ose\r and \b-osx\r
%<HELP>	#options.
%<HELP>	#.sp 1
%<HELP>	#.ti -8
%<HELP>	#-ose
%<HELP>	#.sp 1
%<HELP>	#OS-Escape:  Before an \l($122)OS-Escape\m (shell-out to DOS),
%<HELP>	#the host software will swap itself out of memory by
%<HELP>	#copying conventional memory to Extended Memory (XMS),
%<HELP>	#if available, and then to disk.
%<HELP>	#This option (\b-ose\r) means "do not use Expanded
%<HELP>	#Memory (EMS) for swapping during the OS-Escape".
%<HELP>	#The default is to use both Extended Memory (XMS) and
%<HELP>	#Expanded Memory (EMS), if available, and then disk.
%<HELP>	#This option has no effect if you specify the \b-osd\r
%<HELP>	#option.
%<HELP>	#.sp 1
%<HELP>	#.ti -8
%<HELP>	#-osx
%<HELP>	#.sp 1
%<HELP>	#OS-Escape:  Before an \l($122)OS-Escape\m (shell-out to DOS),
%<HELP>	#the host software will swap itself out of memory by
%<HELP>	#copying conventional memory to Expanded Memory (EMS),
%<HELP>	#if available, and then to disk.
%<HELP>	#This option (\b-osx\r) means "do not use Extended
%<HELP>	#Memory (XMS) for swapping during the OS-Escape".
%<HELP>	#The default is to use both Extended Memory (XMS) and
%<HELP>	#Expanded Memory (EMS), if available, and then disk.
%<HELP>	#This option has no effect if you specify the \b-osd\r
%<HELP>	#option.
%<HELP>	#.sp 1
%<HELP>	#.in +4 {
%<HELP>	#SUMMARY of \b-osd\r, \b-ose\r and \b-osx\r:
%<HELP>	#.sp 1
%<HELP>	#.in +4 {
%<HELP>	#.in +12 {
%<HELP>	#.ti -12
%<HELP>	#(nothing)^^^before OS-Escape, swap host software to
%<HELP>	#EMS or XMS, if available, then to disk
%<HELP>	#.ti -12
%<HELP>	#-ose^^^^^^^^before OS-Escape, swap host software to
%<HELP>	#XMS, if available, then to disk
%<HELP>	#.ti -12
%<HELP>	#-osx^^^^^^^^before OS-Escape, swap host software to
%<HELP>	#EMS, if available, then to disk
%<HELP>	#.ti -12
%<HELP>	#-ose^-osx^^^before OS-Escape, swap host software to disk (only)
%<HELP>	#.ti -12
%<HELP>	#-osd^^^^^^^^do not swap host software at all before OS-Escape
%<HELP>	#.sp 0
%<HELP>	#("old" behavior)
%<HELP>	#.in -12 }
%<HELP>	#.in -4 }
%<HELP>	#.in -4 }
%<HELP>	#.sp 1
%<HELP>	#.ti -8
%<HELP>	#-p^<file_name>
%<HELP>	#.sp 1
%<HELP>	#Use <file_name> as the Help File
%<HELP>	#instead of \l($250)$HELP\m.
%<HELP>	#.sp 1
%<HELP>	#.ti -8
%<HELP>	#-pi^<file_name>
%<HELP>	#.sp 1
%<HELP>	#Use <file_name> as the Help Index File
%<HELP>	#instead of \l($250)$HELPNDX\m.
%<HELP>	#.sp 1
%<HELP>	#.ti -8
%<HELP>	#-q
%<HELP>	#.sp 1
%<HELP>	#Generates a \uterse\r Pull-Down Menu Command Reference
%<HELP>	#(one line per command in the host software).
%<HELP>	#The command reference is generated after the \b%rs1\r host software
%<HELP>	#performs all internal initialization.  Thus, the
%<HELP>	#generated command reference reflects any changes made
%<HELP>	#to the function key assignments and stored in the
%<HELP>	#\l($250)$FKEYDEF\m file.
%<HELP>	#The generated command reference is written to a file
%<HELP>	#whose name is based on the name of the family of
%<HELP>	#processors/derivatives supported by the host software:
%<HELP>	#.sp 1
%<HELP>	#.in +4 {
%<HELP>	#.ba {
%<HELP&A51>	#%rs1-%rs5:   crq_51.txt
%<HELP&A68>	#%rs1-%rs5:   crq_11.txt
%<HELP&A80>	#%rs1-%rs5:   crq_c8.txt
%<HELP&A05>	#%rs1-%rs5:   crq_05.txt
%<HELP&A65>	#%rs1-%rs5:   crq_65.txt
%<HELP&A85>	#%rs1-%rs5:   crq_85.txt
%<HELP&A25>	#%rs1-%rs5:   crq_25.txt
%<HELP&A78>	#%rs1-%rs5:   crq_78.txt
%<HELP>	#.ea }
%<HELP>	#.in -4 }
%<HELP>	#.sp 1
%<HELP>	#.ti -8
%<HELP>	#-qv
%<HELP>	#.sp 1
%<HELP>	#Generates a \uverbose\r Pull-Down Menu Command Reference,
%<HELP>	#where all on-line Help Topics are also included.
%<HELP>	#The command reference is generated after the \b%rs1\r host software
%<HELP>	#performs all internal initialization.  Thus, the
%<HELP>	#generated command reference reflects any changes made
%<HELP>	#to the function key assignments and stored in the
%<HELP>	#\l($250)$FKEYDEF\m file.
%<HELP>	#The generated command reference is written to a file
%<HELP>	#whose name is based on the name of the family of
%<HELP>	#processors/derivatives supported by the host software:
%<HELP>	#.sp 1
%<HELP>	#.in +4 {
%<HELP>	#.ba {
%<HELP&A51>	#%rs1-%rs5:   crqv_51.txt
%<HELP&A68>	#%rs1-%rs5:   crqv_11.txt
%<HELP&A80>	#%rs1-%rs5:   crqv_c8.txt
%<HELP&A05>	#%rs1-%rs5:   crqv_05.txt
%<HELP&A65>	#%rs1-%rs5:   crqv_65.txt
%<HELP&A85>	#%rs1-%rs5:   crqv_85.txt
%<HELP&A25>	#%rs1-%rs5:   crqv_25.txt
%<HELP&A78>	#%rs1-%rs5:   crqv_78.txt
%<HELP>	#.ea }
%<HELP>	#.in -4 }
%<HELP>	#.sp 1
%<HELP>	#The generated file contains line numbers running down the
%<HELP>	#left hand side.
%<HELP>	#Hyperlinks in the help topics appear as:
%<HELP>	#.sp 1
%<HELP>	#.in +4 {
%<HELP>	#<hyperlink_name>{nnnn}
%<HELP>	#.in -4 }
%<HELP>	#.sp 1
%<HELP>	#where '<hyperlink_name>' is the text that appears highlighted
%<HELP>	#when the hyperlink is displayed on the screen and 'nnnn' is
%<HELP>	#the line number in the Command & Help Topic reference for the
%<HELP>	#text in the referenced help topic.
%<HELP>	#The text in '<hyperlink_name>' is underlined.
%<HELP>	#.sp 1
%<HELP>	#.ti -8
%<HELP>	#-qven
%<HELP>	#.sp 1
%<HELP>	#Generates both of the above ('-q' and '-qv' files),
%<HELP>	#but the files will be created in a format suitable for
%<HELP>	#input to / processing by Ventura Publisher.
%<HELP>	#.sp 1
%<HELP>	#In this variation of the two files, hyperlinks within
%<HELP>	#the Command Reference (verbose listing:  crqv_xx.txt)
%<HELP>	#refer to page numbers in the Command Reference, using
%<HELP>	#Ventura's cross-referencing capability.
%<HELP>	#.sp 1
%<HELP>	#.ti -8
%<HELP>	#-qvenl
%<HELP>	#.sp 1
%<HELP>	#Just like '-qven' above, except that hyperlinks within
%<HELP>	#the Command Reference (verbose listing:  crqv_xx.txt)
%<HELP>	#refer to line numbers in the Command Reference, just as
%<HELP>	#with the plain '-qv' option.
%<HELP>	#(The same output files are generated (same names), and
%<HELP>	#you use the same Style Sheets as '-qven' to format
%<HELP>	#the text.)
%<HELP>	#.sp 1
%<HELP>	#.ti -8
%<HELP>	#-rtn
%<HELP>	#.sp 1
%<HELP>	#"Reverse Type Names".  The host software provides
%<HELP>	#data type support for both the "Big Endian" and the
%<HELP>	#"Little Endian" varieties of multi-byte scalar values
%<HELP>	#(e.g., 16-bit integers).  "Big Endian" and "Little
%<HELP>	#Endian" refer to way the bytes are stored in memory.
%<HELP>	#In the "Big Endian" method, the bytes are ordered
%<HELP>	#from most significant to least significant (going from
%<HELP>	#the lowest memory address to the highest).
%<HELP>	#In the "Little Endian" method, the bytes are ordered
%<HELP>	#from least significant to most significant (again, going
%<HELP>	#from the lowest memory address to the highest).
%<HELP>	#.sp 1
%<HELP>	#For a given chip architecture (e.g., 8051) one
%<HELP>	#"Endian" style is usually more natural than the other.
%<HELP>	#Since the host software provides simultaneous support
%<HELP>	#for both "Endian" styles, \l($573)type-names\m are needed for
%<HELP>	#both the "Big" and "Little" endian varieties of the
%<HELP>	#the same data type (e.g., unsigned integer).
%<HELP>	#.sp 1
%<HELP>	#.sp 1
%<HELP>	#The '-rtn' ("Reverse Type Names") command line option
%<HELP>	#allows you to change the default set of type names.
%<HELP>	#That is, it allows you to default to "Little Endian"
%<HELP>	#names on a "Big Endian" machine, and vice versa.
%<HELP>	#.sp 1
%<HELP>	#.ti -8
%<HELP>	#-s <path>
%<HELP>	#.sp 1
%<HELP>	#<path> to use in locating Higher-Level Language (HLL)
%<HELP>	#source files;  if not specified, the default is the directory
%<HELP>	#from which the current program file was \l($86)load\med.
%<HELP>	#You can also change the <path> dynamically using
%<HELP>	#the \l($135)Source/Symbols|Source^Path\m command.
%<HELP>	#.sp 1
%<HELP>	#.ti -8
%<HELP>	#-ty200
%<HELP>	#.sp 1
%<HELP>	#(Effective only in the Demo instance
%<HELP>	#of the host software.)
%<HELP>	#.sp 1
%<HELP>	#This option causes the Demo to behave
%<HELP>	#like a Model 200,
%<HELP>	#rather than the default of a Model 400.
%<HELP&A80>	#.sp 1
%<HELP&A80>	#.ti -8
%<HELP&A80>	#-tydmd or -tyudm
%<HELP&A80>	#.sp 1
%<HELP&A80>	#(Effective only in the Demo instance
%<HELP&A80>	#of the host software.)
%<HELP&A80>	#.sp 1
%<HELP&A80>	#This option causes the Demo to behave
%<HELP&A80>	#like a Debug Module,
%<HELP&A80>	#rather than the default of a Model 400.
%<HELP&A51>	#.sp 1
%<HELP&A51>	#.ti -8
%<HELP&A51>	#-type
%<HELP&A51>	#.sp 1
%<HELP&A51>	#(Effective only in the Demo instance
%<HELP&A51>	#of the host software.)
%<HELP&A51>	#.sp 1
%<HELP&A51>	#This option causes the Demo to behave
%<HELP&A51>	#like an %rs1-PE,
%<HELP&A51>	#rather than the default of an %rs1 Model 400.
%<HELP&A51>	#The following differences exist between this Demo
%<HELP&A51>	#version of the %rs1-PE and the actual hardware emulator:
%<HELP&A51>	#.sp 1
%<HELP&A51>	#.in +2 {
%<HELP&A51>	#.in +4 {
%<HELP&A51>	#.ti -4
%<HELP&A51>	#1)^^The trace memory size supported in this environment
%<HELP&A51>	#is only 4K frames;  the actual hardware unit has a 16K frame
%<HELP&A51>	#trace buffer.
%<HELP&A51>	#.sp 1
%<HELP&A51>	#.ti -4
%<HELP&A51>	#2)^^When you invoke the
%<HELP&A51>	#\l($430)Misc|Emulator^Self-Test\m command,
%<HELP&A51>	#it will alternately report "pass", then "fail".
%<HELP&A51>	#.sp 1
%<HELP&A51>	#.ti -4
%<HELP&A51>	#3)^^When you view the \l($432)transparent^trace\m during emulation,
%<HELP&A51>	#the chip simulator stops simulating instructions until
%<HELP&A51>	#you return back to the Main Screen from the View Trace Menu.
%<HELP&A51>	#The actual hardware emulator continues full-speed real-time
%<HELP&A51>	#emulation while you are viewing a snapshot of the transparent
%<HELP&A51>	#trace memory during emulation.
%<HELP&A51>	#.in -4 }
%<HELP&A51>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#.ti -8
%<HELP>	#-v
%<HELP>	#.sp 1
%<HELP>	#Disable testing (loading) of all possible video
%<HELP>	#character sets (screen sizes) during host software initialization.
%<HELP>	#This option is handy when you want to use a screen size
%<HELP>	#(number of rows) which is not directly settable from
%<HELP>	#within the host software using the
%<HELP>	#\l($47)Configure|Display^Attributes|Lines\m command.
%<HELP>	#If you specify the \b-v\r option,
%<HELP>	#the \b%rs1\r host software will respect (use, retain, not change)
%<HELP>	#the screen size (number of rows) in effect on entry to
%<HELP>	#the host software.
%<HELP>	#.sp 1
%<HELP>	#For example, you can use the Norton
%<HELP>	#Utilities' Norton Control Center to set a screen
%<HELP>	#size and then invoke the host software with the \b-v\r option
%<HELP>	#to retain that screen size while using the host software.
%<HELP>	#.sp 1
%<HELP>	#If you use this option, you must ensure that the PC is in some usable
%<HELP>	#video mode when the host software is invoked
%<HELP>	#(e.g., BIOS Video Mode 3, the default for CGA,EGA,VGA monitors).
%<HELP>	#.sp 1
%<HELP>	#When you use this option, the
%<HELP>	#\l($47)Configure|Display^Attributes|Lines\m will be inaccessible.
%<HELP>	#.sp 1
%<HELP>	#.ti -8
%<HELP>	#-vt^<video_display_technique>
%<HELP>	#.sp 1
%<HELP>	#.in +3 {
%<HELP>	#.ti -3
%<HELP>	#0^^{default} Perform PC video display output by
%<HELP>	#writing directly to video RAM.
%<HELP>	#This option should be specified only when using
%<HELP>	#PC's that are 100%-IBM-hardware-compatible.
%<HELP>	#This is the fastest technique.
%<HELP>	#.sp 1
%<HELP>	#If you have an older CGA video controller, you may notice
%<HELP>	#some flickering in the display when this technique is used.
%<HELP>	#The flickering can be eliminated by choosing
%<HELP>	#<video_display_technique> 1 below.
%<HELP>	#.sp 1
%<HELP>	#See also '-va^<video_RAM_address_override>' below.
%<HELP>	#.sp 1
%<HELP>	#.ti -3
%<HELP>	#1^^Perform PC video display output by
%<HELP>	#using BIOS "write string" interrupts.
%<HELP>	#This option should be specified when using
%<HELP>	#PC's that are not 100%-IBM-hardware-compatible,
%<HELP>	#but that do have a 100%-IBM-compatible BIOS.
%<HELP>	#This is the next fastest technique.
%<HELP>	#.sp 1
%<HELP>	#.ti -3
%<HELP>	#2^^Perform PC video display output by
%<HELP>	#using BIOS "write character" (one character at a time) interrupts.
%<HELP>	#This option should be specified when using
%<HELP>	#PC's that are not 100%-IBM-hardware-compatible
%<HELP>	#and do not have a 100%-IBM-compatible BIOS.
%<HELP>	#This is the slowest technique.
%<HELP>	#.in -3 }
%<HELP>	#.sp 1
%<HELP>	#.ti -8
%<HELP>	#-va^<video_RAM_address_override>
%<HELP>	#.sp 1
%<HELP>	#The value in this field has meaning only when the
%<HELP>	#<video_display_technique> above is 0 (write directly
%<HELP>	#to video RAM).  The host software automatically uses
%<HELP>	#the following base addresses for video RAM:
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#.ba {
%<HELP>	#B000   for a Monochrome     Display Adapter
%<HELP>	#B800   for a Color/EGA/VGA  Display Adapter
%<HELP>	#.ea }
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#If your display adapter is set up to use a different address,
%<HELP>	#then specify that address here.  It should be in the form
%<HELP>	#hhhh, where "hhhh" is the hexadecimal address of the base
%<HELP>	#of the video RAM segment.
%<HELP>	#.sp 1
%<HELP>	#.ti -8
%<HELP>	#-vme^^<pages_per_allocation_request>
%<HELP>	#.ti -8
%<HELP>	#-vmf^^<num_bufs>^<buf_size>
%<HELP>	#.ti -8
%<HELP>	#-vmfn^<file_name>
%<HELP>	#.sp 1
%<HELP>	#These options control how virtual heap memory will be used.
%<HELP>	#.sp 1
%<HELP>	#(For a general description of virtual memory -- what it is,
%<HELP>	#when/why should you use it,
%<HELP>	#etc. -- see \l($398)Using^Virtual^Memory\m.)
%<HELP>	#.sp 1
%<HELP>	#Virtual heap memory can be supported
%<HELP>	#by two kinds of backing store
%<HELP>	#(one, or the other, or both):
%<HELP>	#.sp 1
%<HELP>	#.in +4 {
%<HELP>	#.in +3 {
%<HELP>	#.ti -3
%<HELP>	#1.^^LIM EMS 3.2/4.0 Expanded Memory
%<HELP>	#.ti -3
%<HELP>	#2.^^a temporary file
%<HELP>	#.in -3 }
%<HELP>	#.in -4 }
%<HELP>	#.sp 1
%<HELP>	#.ti -3 #kludgey
%<HELP>	#-vme^<pages_per_allocation_request>
%<HELP>	#.sp 1
%<HELP>	#If you have Expanded Memory (LIM-compatible) in your computer,
%<HELP>	#the \b%rs1\r host software will automatically use it as a
%<HELP>	#backing store medium for virtual heap memory.
%<HELP>	#To enable access to Expanded Memory, you must have the
%<HELP>	#appropriate 'DEVICE=...' statement in your 'CONFIG.SYS' file.
%<HELP>	#See the documentation accompanying your Expanded Memory board
%<HELP>	#for the specific details on how to do this.
%<HELP>	#.sp 1
%<HELP>	#The \b-vme^<pages_per_allocation_request>\r option
%<HELP>	#allows you to specify the number
%<HELP>	#of pages (16Kb per page) of Expanded Memory to request from the
%<HELP>	#Expanded Memory Manager (EMM) each time the host software needs
%<HELP>	#more Expanded Memory. If the \b-vme^<pages_per_allocation_request>\r
%<HELP>	#is not specified, the host software will use 8 pages per
%<HELP>	#request (as if \b-vme^8\r were used).
%<HELP>	#.sp 1
%<HELP>	#.in +4 {
%<HELP>	#Whenever a program requests some number of logical pages of expanded
%<HELP>	#memory from the EMM, those pages are internally associated with
%<HELP>	#a 'handle'.  The total number of available handles, as well as the
%<HELP>	#total number of available logical pages of expanded memory, are
%<HELP>	#resources which could easily be exhausted.  If the total number of
%<HELP>	#EMM handles in your system is small, you may have to increase
%<HELP>	#the number of pages per request using the
%<HELP>	#\b-vme^<pages_per_allocation_request>\r option.
%<HELP>	#This will ensure that the available handles are not exhausted before
%<HELP>	#the available logical pages of expanded memory.
%<HELP>	#.in -4 }
%<HELP>	#.sp 1
%<HELP>	#To disable use of Expanded Memory as a backing store medium altogether,
%<HELP>	#specify \b-vme^0\r (default).
%<HELP>	#.sp 1
%<HELP>	#.ti -3 #kludgey
%<HELP>	#-vmf^<num_bufs>^<buf_size>
%<HELP>	#.sp 1
%<HELP>	#specifies the number and size of the real-memory buffers
%<HELP>	#to be used to support file backing store as a medium for virtual
%<HELP>	#memory.  If either <num_bufs> or <buf_siz> is zero,
%<HELP>	#file backing store will not be used at all
%<HELP>	#(i.e., it will be disabled (default)).
%<HELP>	#The integer specified for <buf_size> is the number
%<HELP>	#of K-bytes to allocate for each real-memory buffer.
%<HELP>	#.sp 1
%<HELP>	#By default, the backing store file is created as a temporary file
%<HELP>	#in the directory specified by the \bTMP\r environment variable.
%<HELP>	#If the \bTMP\r environment variable is
%<HELP>	#not defined or does not designate an existing directory,
%<HELP>	#the backing store temporary file is created in the current working
%<HELP>	#directory.  You can set the \bTMP\r environment variable by adding
%<HELP>	#a line like the following to your AUTOEXEC.BAT file:
%<HELP>	#.sp 1
%<HELP>	#.in +4 {
%<HELP>	#.ba {
%<HELP>	#\bSET TMP=C:\\TMP\r
%<HELP>	#.ea }
%<HELP>	#.sp 1
%<HELP>	#NOTE:  Make sure that you actually create the \\TMP subdirectory
%<HELP>	#on the C: drive (i.e., type \bMKDIR C:\\TMP\r at the DOS prompt).
%<HELP>	#.in -4 }
%<HELP>	#.sp 1
%<HELP>	#Alternatively, you can specify the path/name of the backing store file
%<HELP>	#using the
%<HELP>	#.sp 1
%<HELP>	#.in +4 {
%<HELP>	#\b-vmfn^<file_name>\r
%<HELP>	#.in -4 }
%<HELP>	#.sp 1
%<HELP>	#command line option.
%<HELP>	#If your system has only Extended Memory, but no Expanded Memory,
%<HELP>	#you can significantly speed up access to the backing store file
%<HELP>	#by creating a RAM disk in Extended Memory and then specifying
%<HELP>	#the TMP environment variable as a directory on that RAM disk
%<HELP>	#(e.g., \bSET TMP=E:\\\r, where \bE:\r is the RAM disk drive)
%<HELP>	#or you can specify
%<HELP>	#the backing store file name as a file on that RAM disk
%<HELP>	#(e.g., \b-vmfn^E:\TMPFILE\r, where \bE:\r is the RAM disk drive).
%<HELP>	#.sp 1
%<HELP>	#To disable use of the file backing store medium altogether,
%<HELP>	#specify \b-vmf^0^0\r (default).
%<HELP>	#.sp 1
%<HELP>	#.ti -8
%<HELP>	#<file_name>
%<HELP>	#.sp 1
%<HELP>	#name of file to be \l($86)Load\med automatically into the \b%rs1\r
%<HELP>	#emulator when the host software is invoked from the DOS command line.
%<HELP>	#.in -8 }
%<HELP>	#.($250)System Files
%<HELP>	#The host software reads and/or writes the following files
%<HELP>	#in order to configure various aspects of the host software
%<HELP>	#environment.  When the host software attempts to open these files,
%<HELP>	#it searches the following locations, in this order:
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#.in +4 {
%<HELP>	#.ti -4
%<HELP>	#1)^^The current directory.
%<HELP>	#.ti -4
%<HELP>	#2)^^The paths you may have defined within the DOS \bAPPEND\r statement.
%<HELP>	#.ti -4
%<HELP>	#3)^^The path specified by the \bEHSFP\r
%<HELP>	#(\bE\rmulator \bH\rost \bS\roftware \bF\rile \bP\rath)
%<HELP>	#environment variable.
%<HELP>	#.in -4 }
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#Following is a short description of each system file:
%<HELP>	#.sp 1
%<HELP>	#.in +5 {
%<HELP>	#.ti -5
%<HELP>	#\b$ALERT\r
%<HELP>	#.sp 1
%<HELP>	#Optional File:  Yes
%<HELP>	#.sp 1
%<HELP>	#Usage:  The $ALERT file contains the Alert options settings specified
%<HELP>	#in the \l($65)Configure|Options\m pull-down menu.
%<HELP>	#The host software reads the $ALERT file during initialization and
%<HELP>	#when you select the \l($84)Configure|Restore\m command.
%<HELP>	#.sp 1
%<HELP>	#How Created:  The host software creates (writes) the $ALERT file
%<HELP>	#whenever you select the \l($77)Configure|Save|Save\m command,
%<HELP>	#and the setting for the \l($81)Configure|Save|(Save^Opts)Alert\m
%<HELP>	#toggle is "on".
%<HELP>	#The $ALERT file is a binary file and must not be modified.
%<HELP>	#.sp 1
%<HELP>	#.ti -5
%<HELP>	#\b$CLR1$\r
%<HELP>	#.sp 1
%<HELP>	#Optional File:  Yes
%<HELP>	#.sp 1
%<HELP>	#Usage:  The $CLR1$ file contains the default color and video attribute
%<HELP>	#settings suitable for CGA monitors.  The $CLR1$ file is read
%<HELP>	#by the host software during video initialization if there is no
%<HELP>	#$COLOR file and the display adapter on your computer is a CGA
%<HELP>	#adapter.  The host software unconditionally reads the $CLR1$ file
%<HELP>	#if you select the \l($53)CGA/EGA/VGA^Default\m command.
%<HELP>	#.sp 1
%<HELP>	#How Created:  The $CLR1$ file is supplied as part of the host software
%<HELP>	#system and will never be written to by the host software.
%<HELP>	#The $CLR1$ file is a binary file and must not be modified.
%<HELP>	#.sp 1
%<HELP>	#.ti -5
%<HELP>	#\b$CLR2$\r
%<HELP>	#.sp 1
%<HELP>	#Optional File:  Yes
%<HELP>	#.sp 1
%<HELP>	#Usage:  The $CLR2$ file contains the default color and video attribute
%<HELP>	#settings suitable for EGA/VGA monitors.  The $CLR2$ file is read
%<HELP>	#by the host software during video initialization if there is no
%<HELP>	#$COLOR file and the display adapter on your computer is an EGA or a VGA
%<HELP>	#adapter.  The host software unconditionally reads the $CLR2$ file
%<HELP>	#if you select the \l($54)EGA/VGA^Default\m command.
%<HELP>	#.sp 1
%<HELP>	#How Created:  The $CLR2$ file is supplied as part of the host software
%<HELP>	#system and will never be written to by the host software.
%<HELP>	#The $CLR2$ file is a binary file and must not be modified.
%<HELP>	#.sp 1
%<HELP>	#.ti -5
%<HELP>	#\b$CLRL$\r
%<HELP>	#.sp 1
%<HELP>	#Optional File:  Yes
%<HELP>	#.sp 1
%<HELP>	#Usage:  The $CLRL$ file contains the default color and video attribute
%<HELP>	#settings suitable for LCD monitors used in notebook and laptop
%<HELP>	#computers.  The $CLRL$ file is \unot\r automatically read
%<HELP>	#by the host software during video initialization.
%<HELP>	#The host software does read the $CLRL$ file
%<HELP>	#when you select the \l($490)Notebook/Laptop^(LCD)^Default\m command.
%<HELP>	#.sp 1
%<HELP>	#How Created:  The $CLRL$ file is supplied as part of the host software
%<HELP>	#system and will never be written to by the host software.
%<HELP>	#The $CLRL$ file is a binary file and must not be modified.
%<HELP>	#.sp 1
%<HELP>	#.ti -5
%<HELP>	#\b$CLRM$\r
%<HELP>	#.sp 1
%<HELP>	#Optional File:  Yes
%<HELP>	#.sp 1
%<HELP>	#Usage:  The $CLRM$ file contains the default color and video attribute
%<HELP>	#settings suitable for Monochrome monitors.  The $CLRM$ file is read
%<HELP>	#by the host software during video initialization if there is no
%<HELP>	#$COLOR file and the display adapter on your computer is a Monochrome
%<HELP>	#adapter.  The host software unconditionally reads the $CLRM$ file
%<HELP>	#if you select the \l($55)Monochrome^Default\m command.
%<HELP>	#.sp 1
%<HELP>	#How Created:  The $CLRM$ file is supplied as part of the host software
%<HELP>	#system and will never be written to by the host software.
%<HELP>	#The $CLRM$ file is a binary file and must not be modified.
%<HELP>	#.sp 1
%<HELP>	#.ti -5
%<HELP>	#\b$COLOR\r
%<HELP>	#.sp 1
%<HELP>	#Optional File:  Yes
%<HELP>	#.sp 1
%<HELP>	#If the $COLOR file does not exist, the host software will use default
%<HELP>	#colors and video attributes, based on the type of display adapter
%<HELP>	#installed in your host computer.
%<HELP>	#.sp 1
%<HELP>	#Usage:  The $COLOR file is read by the host software during its
%<HELP>	#one-time initialization sequence, or when you select either of the
%<HELP>	#\l($84)Configure|Restore\m or \l($56)Configure|Attributes|User\m
%<HELP>	#commands.  The $COLOR file contains your customized color and
%<HELP>	#video attribute settings to be used by the host software.
%<HELP>	#.sp 1
%<HELP>	#How Created:  The $COLOR file is created, or rewritten (updated),
%<HELP>	#only when you save the current color and video attribute settings
%<HELP>	#by selecting the \l($77)Configure|Save|Save\m command,
%<HELP>	#with the setting for the \l($79)Configure|Save|(Save^Opts)Colors\m
%<HELP>	#toggle "on".
%<HELP>	#The $COLOR file is a binary file and must not be modified.
%<HELP>	#.sp 1
%<HELP>	#.ti -5
%<HELP>	#\b$CONFIG\r
%<HELP>	#.sp 1
%<HELP>	#Optional File:  Yes
%<HELP>	#.sp 1
%<HELP>	#If the $CONFIG file does not exist, the host software will use default
%<HELP>	#configuration settings when establishing communication with the
%<HELP>	#emulator.
%<HELP>	#.sp 1
%<HELP>	#Usage:  The $CONFIG file is read by the host software during its
%<HELP>	#one-time initialization sequence, and whenever the emulator must
%<HELP>	#be reconfigured.  The $CONFIG file contains an encoding of:
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#.in +4 {
%<HELP>	#.ti -4
%<HELP>	#1)^^a code defining the processor type being used
%<HELP>	#.sp 1
%<HELP>	#.ti -4
%<HELP>	#1)^^the baud rate to be used in communication between the host
%<HELP>	#computer and the emulator
%<HELP>	#(see \l($20)Configure|Emulator|Baud^rate\m)
%<HELP>	#.sp 1
%<HELP>	#.ti -4
%<HELP>	#2)^^the RS-232 communication port to be used in communication between
%<HELP>	#the host computer and the emulator
%<HELP>	#(see \l($17)Configure|Emulator|Comm^port\m)
%<HELP>	#.sp 1
%<HELP>	#.ti -4
%<HELP>	#3)^^the current "chip mode of operation"
%<HELP>	#(see \l($6)Configure|Emulator|Mode\m)
%<HELP&A68>	#.sp 1
%<HELP&A68>	#.ti -4
%<HELP&A68>	#4)^^the value for the INIT register
%<HELP&A68>	#.sp 1
%<HELP&A68>	#.ti -4
%<HELP&A68>	#5)^^the value of the EEPROM on/off toggle
%<HELP>	#.in -4 }
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#How Created:  The $CONFIG file is created, or rewritten (updated),
%<HELP>	#whenever you select any of the following commands:
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#\l($6)Configure|Emulator|Mode\m
%<HELP>	#.sp 1
%<HELP>	#\l($20)Configure|Emulator|Baud^rate\m
%<HELP>	#.sp 1
%<HELP>	#\l($17)Configure|Emulator|Comm^port\m
%<HELP&A68>	#.sp 1
%<HELP&A68>	#\l($386)Configure|Emulator|INIT^register\m
%<HELP&A68>	#.sp 1
%<HELP&A68>	#\l($392)Configure|Emulator|EEPROM\m
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#The $CONFIG file is a binary file and must not be modified.
%<HELP>	#.sp 1
%<HELP>	#.ti -5
%<HELP>	#\b$FKEYDEF\r
%<HELP>	#.sp 1
%<HELP>	#Optional File:  Yes
%<HELP>	#.sp 1
%<HELP>	#If the $FKEYDEF file does not exist, the host software will use default
%<HELP>	#Function Key (Hot Key) settings and will display the default number (2)
%<HELP>	#of Function Key label lines at the bottom of the screen.
%<HELP>	#.sp 1
%<HELP>	#Usage:  The $FKEYDEF file is read by the host software during its
%<HELP>	#one-time initialization sequence, or when you select the
%<HELP>	#\l($84)Configure|Restore\m command.  The $FKEYDEF file contains an
%<HELP>	#encoding of:
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#.in +4 {
%<HELP>	#.ti -4
%<HELP>	#1)^^the 40 Function Key assignments
%<HELP>	#.sp 1
%<HELP>	#.ti -4
%<HELP>	#2)^^the number of Function Key label lines to be displayed at the
%<HELP>	#bottom of the screen.
%<HELP>	#.sp 1
%<HELP>	#.in -4 }
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#How Created:  The $FKEYDEF file is created, or rewritten (updated),
%<HELP>	#when you select the \l($77)Configure|Save|Save\m command and
%<HELP>	#the setting for the \l($83)Configure|Save|(Save^Opts)Function^Keys\m
%<HELP>	#toggle is "on".
%<HELP>	#The $FKEYDEF file is a binary file and must not be modified.
%<HELP>	#.sp 1
%<HELP>	#.ti -5
%<HELP>	#\b$HELP\r
%<HELP>	#.sp 1
%<HELP>	#Optional File:  Yes
%<HELP>	#.sp 1
%<HELP>	#Usage:  The $HELP file is read by the host software during its
%<HELP>	#one-time initialization sequence.  The $HELP file contains the
%<HELP>	#text of the help topics for the online help system.
%<HELP>	#.sp 1
%<HELP>	#How Created:  The $HELP file is created along with the $MODEL file by
%<HELP>	#using the MF_GEN.EXE
%<HELP>	#utility program distributed with the files on the Probe Card Software
%<HELP>	#distribution diskette.
%<HELP>	#The $HELP file is a plain ASCII text file, but you should not modify
%<HELP>	#it because the $HELPNDX file contains absolute "pointers" into the
%<HELP>	#$HELP file.
%<HELP>	#.sp 1
%<HELP>	#.ti -5
%<HELP>	#\b$HELPNDX\r
%<HELP>	#.sp 1
%<HELP>	#Optional File:  Yes
%<HELP>	#.sp 1
%<HELP>	#Usage:  The $HELPNDX file is read by the host software during its
%<HELP>	#one-time initialization sequence.  The $HELPNDX file contains
%<HELP>	#pointers into the $HELP file, allowing the host software to
%<HELP>	#quickly retrieve the text for a particular help topic in the online
%<HELP>	#help system.
%<HELP>	#.sp 1
%<HELP>	#How Created:  The $HELPNDX file is created along with the
%<HELP>	#$HELP and $MODEL files by using the MF_GEN.EXE
%<HELP>	#utility program distributed with the files on the Probe Card Software
%<HELP>	#distribution diskette.
%<HELP>	#The $HELPNDX file is a binary file and must not be modified.
%<HELP>	#.sp 1
%<HELP>	#.ti -5
%<HELP>	#\b$LINE\r
%<HELP>	#.sp 1
%<HELP>	#Optional File:  Yes
%<HELP>	#.sp 1
%<HELP>	#If the $LINE file does not exist, the host software will use the
%<HELP>	#default screen size.
%<HELP>	#.sp 1
%<HELP>	#Usage:  The $LINE file is read by the host software during its
%<HELP>	#one-time initialization sequence, or when you select the
%<HELP>	#\l($84)Configure|Restore\m command.  The $LINE file contains an
%<HELP>	#encoding of screen size (number of screen display rows).
%<HELP>	#.sp 1
%<HELP>	#How Created:  The $LINE file is created, or rewritten (updated),
%<HELP>	#when you select the \l($77)Configure|Save|Save\m command and
%<HELP>	#the setting for the \l($78)Configure|Save|(Save^Opts)Lines\m
%<HELP>	#toggle is "on".
%<HELP>	#The $LINE file is a binary file and must not be modified.
%<HELP>	#.sp 1
%<HELP>	#.ti -5
%<HELP>	#\b$MISC\r
%<HELP>	#.sp 1
%<HELP>	#Optional File:  Yes
%<HELP>	#.sp 1
%<HELP>	#Usage:  The $MISC file contains the Miscellaneous options settings
%<HELP>	#specified in the \l($65)Configure|Options\m pull-down menu.
%<HELP>	#The $MISC file is read during the host software's one-time
%<HELP>	#initialization and whenever you select the
%<HELP>	#\l($84)Configure|Restore\m command.
%<HELP>	#.sp 1
%<HELP>	#How Created:  The $MISC file is created, or rewritten (updated),
%<HELP>	#when you select the \l($77)Configure|Save|Save\m command and
%<HELP>	#the setting for the \l($82)Configure|Save|(Save^Opts)Misc\m
%<HELP>	#toggle is "on".
%<HELP>	#The $MISC file is a binary file and must not be modified.
%<HELP>	#.sp 1
%<HELP>	#.ti -5
%<HELP>	#\b$MODEL\r
%<HELP>	#.sp 1
%<HELP>	#Optional File:  No
%<HELP>	#.sp 1
%<HELP>	#Usage:  The $MODEL file is read by the host software during its
%<HELP>	#one-time initialization sequence.  The $MODEL file defines the
%<HELP>	#operational properties of the particular probe card (target
%<HELP>	#processor) you are using.  The $MODEL file also specifies the settings
%<HELP>	#for several user-configurable aspects of the host software's
%<HELP>	#operating environment.
%<HELP>	#.sp 1
%<HELP>	#How Created:  The $MODEL file is created by using the MF_GEN.EXE
%<HELP>	#utility program distributed with the files on the Host Software
%<HELP>	#distribution diskette.  After creation, you may modify certain
%<HELP>	#designated (commented) directives in the $MODEL file using any text
%<HELP>	#editor.  The $MODEL file is a plain ASCII text file.
%<HELP>	#.sp 1
%<HELP>	#.ti -5
%<HELP>	#\b$WINDOW\r
%<HELP>	#.sp 1
%<HELP>	#Optional File:  Yes
%<HELP>	#.sp 1
%<HELP>	#Usage:  The $WINDOW file contains the current window definitions
%<HELP>	#(size and position) of the Main Screen Windows and other windows
%<HELP>	#capable of being resized or moved.  The $WINDOW file is read during
%<HELP>	#the host software's
%<HELP>	#one-time initialization sequence, or when you select the
%<HELP>	#\l($84)Configure|Restore\m command.
%<HELP>	#.sp 1
%<HELP>	#How Created:  The $WINDOW file is created, or rewritten (updated),
%<HELP>	#when you select the \l($77)Configure|Save|Save\m command and
%<HELP>	#the setting for the \l($80)Configure|Save|(Save^Opts)Windows\m
%<HELP>	#toggle is "on".
%<HELP>	#The $WINDOW file is a binary file and must not be modified.
%<HELP>	#.in -5 }
%<HELP>	#.($251)Configure|Windows|Repaint
%<HELP>	#The \bRepaint\r windows command simply repaints all the windows on the
%<HELP>	#main screen.  The host software first reads all necessary information
%<HELP>	#from the emulator (e.g., memory and register contents) and then
%<HELP>	#repaints all the windows.
%<HELP>	#.sp 1
%<HELP>	#You can select this command (repeatedly) to monitor the values
%<HELP>	#of a port's pins if you suspect that they are changing when the
%<HELP>	#emulator is in "break condition"
%<HELP>	#(i.e., emulator not currently emulating).
%<HELP&(!A65)>	#.($252)Code
%<HELP&( A65)>	#.($252)General
%<HELP&(!A65)>	#The \bCode\r
%<HELP&( A65)>	#The \bGeneral\r
%<HELP>	#command displays a pop-up menu which allows you to manipulate
%<HELP&(!A65)>	#code
%<HELP&( A65)>	#general
%<HELP>	#memory in several ways.  You may
%<HELP>	#\l($254)Fill\m, \l($255)Move\m or \l($257)Write\m blocks of
%<HELP>	#memory, \l($256)Compare\m two blocks of raw memory and
%<HELP>	#\l($489)Search\m memory for a value (or values) match/mismatch.
%<HELP>	#There is also a \l($253)Browse\m mode available to allow you
%<HELP>	#to browse through raw memory.
%<HELP>	#.($253)Browse
%<HELP>	#You enter \bBrowse^Mode\r by selecting the \bBrowse\r command
%<HELP>	#or by using any of the keypad cursor keys (\uexcept\r the left '\x1B'
%<HELP>	#and right '\x1A' arrow keys).
%<HELP>	#In browse mode you can scroll through memory by using
%<HELP>	#\uany\r of the keypad cursor keys or can type an address
%<HELP>	#(absolute or symbolic) to quickly view an area in memory.
%<HELP>	#.sp 1
%<HELP>	#Once in \bBrowse^Mode\r, you may switch between
%<HELP>	#\bBrowse^Mode\r and \bChange^Mode\r by using the TAB key.
%<HELP>	#In \bChange^Mode\r you can scroll through memory in the
%<HELP>	#same manner as \bBrowse^Mode\r but may also change the value of
%<HELP>	#a memory address.  This is done by pressing 'Enter' when
%<HELP>	#positioned at the desired address.  You will then be
%<HELP>	#prompted to enter the value to store at that address.
%<HELP>	#.($254)Fill
%<HELP>	#The \bFill\r command lets you quickly fill a block a memory
%<HELP>	#with some value (or values).  When you select the \bFill\r command
%<HELP>	#a dialog box will pop up to prompt for the address
%<HELP>	#range to fill and the pattern to fill that range with.
%<HELP>	#.sp 1
%<HELP>	#The fill pattern may contain one or many \l($244)expressions\m up to
%<HELP>	#a total typed length of about 80 characters.  If multiple
%<HELP>	#expressions are needed, they must be separated by commas (',') or
%<HELP>	#spaces (' ').
%<HELP>	#ASCII literals must be quoted (e.g, use 'A' to put the ASCII
%<HELP>	#value of 'A' in memory and "ab" to put the ASCII values for 'a'
%<HELP>	#and 'b' in memory).
%<HELP>	#.($255)Move
%<HELP>	#You can use the \bMove\r command to move (copy) a block of memory
%<HELP>	#to another location in memory.  When you select the \bMove\r command,
%<HELP>	#a dialog box will pop up to prompt for the address
%<HELP>	#range for the source block and the starting address of the
%<HELP>	#target block.
%<HELP>	#.($256)Compare
%<HELP>	#You can use the \bCompare\r command to compare two blocks of memory.
%<HELP>	#When you select the \bCompare\r command, a dialog box will
%<HELP>	#pop up to prompt for the address range of one block and the
%<HELP>	#starting address of the second block.  If the blocks are the
%<HELP>	#the same a message will inform you of that.  If the blocks are
%<HELP>	#not the same, the addresses and values of the mismatches will
%<HELP>	#be displayed, along with a count of the total number of
%<HELP>	#mismatches found.
%<HELP>	#.($257)Write
%<HELP>	#The \bWrite\r command displays a pop-up menu from which you may
%<HELP&(!A65)>	#write code
%<HELP&( A65)>	#write general
%<HELP>	#memory to a disk file in a \l($375)Dump\m format,
%<HELP>	#a reloadable \l($376)Hex\m format and a reloadable
%<HELP>	#\l($377)S-Record\m format.
%<HELP&( A51)>	#.($258)Idata
%<HELP&( A68)>	#.($258)Idata
%<HELP&( A05)>	#.($258)Idata
%<HELP&( A80)>	#.($258)RAM
%<HELP&( A65)>	#.($258)Local Memory
%<HELP&( A51)>	#The \bIdata\r
%<HELP&( A68)>	#The \bIdata\r
%<HELP&( A05)>	#The \bIdata\r
%<HELP&( A80)>	#The \bRAM\r
%<HELP&( A65)>	#The \bLocal^Memory\r
%<HELP>	#command displays a pop-up menu which allows you to
%<HELP>	#\l($254)Fill\m, \l($255)Move\m and \l($263)Write\m blocks of
%<HELP&A51>	#Indirectly-addressable
%<HELP&(!A65)>	#Internal Data
%<HELP&( A65)>	#Local
%<HELP>	#memory, to \l($256)Compare\m two blocks of
%<HELP&A51>	#Indirectly-addressable
%<HELP&(!A65)>	#Internal Data
%<HELP&( A65)>	#Local
%<HELP>	#memory and to \l($489)Search\m
%<HELP&A51>	#Indirectly-addressable
%<HELP&(!A65)>	#Internal Data
%<HELP&( A65)>	#Local
%<HELP>	#memory for a value (or values) match/mismatch.
%<HELP>	#There is also a \l($253)Browse\m mode available to allow you
%<HELP>	#to browse through
%<HELP&A51>	#Indirectly-addressable
%<HELP&(!A65)>	#Internal Data
%<HELP&( A65)>	#Local
%<HELP>	#memory.
%<HELP&A51>	#Note that it is not possible to modify SFR's through
%<HELP&A51>	#Indirectly-addressable Internal Data memory as they
%<HELP&A51>	#are in Directly-addressable Internal Data memory.
%<HELP>	#.($263)Write
%<HELP>	#You can use the \bWrite\r command to write a block of memory
%<HELP>	#to a disk file.  The block will be written in the same format
%<HELP>	#that the data is displayed on screen.  When you select the \bWrite\r
%<HELP>	#command, a dialog box will pop up to prompt for
%<HELP>	#the address range of the block to write and for the name
%<HELP>	#of the file to write the data to.
%<HELP&A51>	#.($264)Xdata
%<HELP&A51>	#The \bXdata\r command displays a pop-up menu which allows you to
%<HELP&A51>	#\l($254)Fill\m, \l($255)Move\m or \l($269)Write\m a block of
%<HELP&A51>	#External Data memory, to \l($256)Compare\m two blocks of
%<HELP&A51>	#External Data memory and to
%<HELP&A51>	#\l($489)Search\m External Data Memory for a value (or values)
%<HELP&A51>	#match/mismatch.
%<HELP&A51>	#There is also a \l($253)Browse\m mode available to allow you
%<HELP&A51>	#to browse through External Data memory.
%<HELP&A51>	#.sp 1
%<HELP&A51>	#Note that this command will be de-activated if the device being
%<HELP&A51>	#used cannot access External Data Memory.
%<HELP>	#.($269)Write
%<HELP>	#The \bWrite\r command displays a pop-up menu from which you may
%<HELP>	#write external data memory to a disk file in a \l($465)Dump\m format,
%<HELP>	#a reloadable \l($466)Hex\m format and a reloadable
%<HELP>	#\l($467)S-Record\m format.  To write external data memory
%<HELP>	#using a loadable disk file (such as \bHex\r or
%<HELP>	#\bS-Record\r) use the \l($89)Download\m command.
%<HELP>	#.($270)Unknown Data Type Size
%<HELP>	#The \bUnknown Data Type Size\r command is used to set the number of
%<HELP>	#bytes to display for the value of an unknown data type in the
%<HELP>	#\l($140)Global\m, \l($141)Local\m, \l($142)Alpha\m, and
%<HELP>	#\l($143)Address\m symbol displays,
%<HELP>	#the Watch Window and the \l($118)Display/Alter|Expression\m pop-up
%<HELP>	#dialog box.
%<HELP>	#Up to 4 bytes can be displayed.
%<HELP>	#.($271)Repetition Counter
%<HELP>	#The \bRepetition Counter\r specifies how many
%<HELP>	#emulation cycles will occur, after the next
%<HELP>	#\l($96)Run\m-type command is issued,
%<HELP>	#before "everything finally stops".
%<HELP>	#.sp 1
%<HELP>	#The steps in this process are:
%<HELP>	#.sp 1
%<HELP>	#.in +4 {
%<HELP>	#.in +4 {
%<HELP>	#.ti -4
%<HELP>	#1)^^Set the Repetition Counter to some value greater than one.
%<HELP>	#.sp 1
%<HELP>	#.ti -4
%<HELP>	#2)^^Select one of the \bRun\r commands (\bReset\r, \bGo\r or \bStep\r).
%<HELP>	#.sp 1
%<HELP>	#.ti -4
%<HELP>	#3)^^Emulation begins.
%<HELP>	#.sp 1
%<HELP>	#.ti -4
%<HELP>	#4)^^Hardware break-point reached and real-time emulation stops.
%<HELP>	#.sp 1
%<HELP&(   (A51|A68|A05))>	#(If the \l($150)Break-Count\mer
%<HELP&(   (A51|A68|A05))>	#is non-zero, emulation does not
%<HELP&(   (A51|A68|A05))>	#actually stop until the program's
%<HELP&(   (A51|A68|A05))>	#flow-of-control passes through the
%<HELP&(   (A51|A68|A05))>	#specified number of break-points.)
%<HELP&(  !(    A68|A05))>	#.sp 1
%<HELP&(  !(    A68|A05))>	#(If the \l($431)Pass-Count\mer
%<HELP&(  !(    A68|A05))>	#is non-zero, emulation does not
%<HELP&(  !(    A68|A05))>	#actually stop until the program's
%<HELP&(  !(    A68|A05))>	#flow-of-control passes through the
%<HELP&(  !(    A68|A05))>	#specified number of pass-count-points.)
%<HELP>	#.sp 1
%<HELP>	#.ti -4
%<HELP>	#5)^^Host software updates all windows.
%<HELP>	#.sp 1
%<HELP>	#.ti -4
%<HELP>	#6)^^Host software decrements Repetition Counter.  If result is
%<HELP>	#not zero, emulation resumes (at current PC) and goto \b4)\r above.
%<HELP>	#.in -4 }
%<HELP>	#.in -4 }
%<HELP>	#.($272)Slow Motion|Instruction
%<HELP>	#The \bSlow^Motion|Instruction\r command starts an automatically
%<HELP>	#repeated cycle of \l($102)Run|Step\m commands (single-step by machine
%<HELP>	#instruction).
%<HELP>	#For more information about slow motion emulation,
%<HELP>	#see \l($540)Run|Slow^Motion\m.
%<HELP>	#.($273)Performance Analyzer
%<HELP&A80&(DMD|EPU)>	#(Note:  The \bPerformance Analyzer\r is not available
%<HELP&A80&(DMD|EPU)>	#in the COP8 Debug Module or EPU.)
%<HELP&A80&(DMD|EPU)>	#.sp 1
%<HELP>	#The \bPerformance^Analyzer\r allows you to monitor the
%<HELP>	#amount of time spent executing specified parts of the program
%<HELP>	#loaded in memory.  There are several reasons for using
%<HELP>	#a performance analyzer:
%<HELP>	#.sp 1
%<HELP>	#.in +8 {
%<HELP>	#.ti -4
%<HELP>	#To identify and optimize program "hot spots".
%<HELP>	#.ti -4
%<HELP>	#To verify there is no "dead" (unexecuted) code.
%<HELP>	#.ti -4
%<HELP>	#To verify that execution is always within program bounds.
%<HELP>	#.ti -4
%<HELP>	#To verify execution of certain code in response to some
%<HELP>	#internal or external condition/stimulus.
%<HELP>	#.in -8 }
%<HELP>	#.sp 1
%<HELP>	#Each portion of the program to be monitored is called a bin.
%<HELP>	#A bin contains a \l($370)Type\m, a \l($372)Number\m,
%<HELP>	#a \l($369)Capture^Range\m and a \l($371)Description\m.
%<HELP>	#Usually, each bin will consist of a single address
%<HELP>	#range (starting address through ending address, inclusive),
%<HELP>	#although a bin may be created with several address
%<HELP>	#ranges which are not contiguous.  PC sample counts and
%<HELP>	#percentages are collected on a per-bin basis.
%<HELP>	#.($274)Statistics
%<HELP>	#The \bStatistics\r pull-down menu allows you to
%<HELP>	#\l($276)Accumulate\m, \l($275)Clear\m and \l($277)View\m
%<HELP>	#performance analysis statistics (sample counts).
%<HELP>	#.($275)Statistics|Clear
%<HELP>	#The \bClear\r command clears any statistics (sample counts)
%<HELP>	#gathered during previous performance analysis emulation(s).
%<HELP>	#.($276)Statistics|Accumulate
%<HELP>	#The \bAccumulate\r command allows you to control
%<HELP>	#whether or not statistics (sample counts) from one
%<HELP>	#performance analysis emulation to the next will be
%<HELP>	#accumulated.  When accumulate is \bOFF\r any statistics
%<HELP>	#from previous emulations are cleared before subsequent
%<HELP>	#emulations.  When accumulate is \bON\r any statistics from new
%<HELP>	#emulations are added to the statistics from previous emulations.
%<HELP>	#The state the accumulate command is displayed in the
%<HELP>	#Statistics Pull-down Menu and on the performance analyzer
%<HELP>	#setup screen.
%<HELP>	#.($277)Statistics|View
%<HELP>	#The \bView\r command allows you to view the results of
%<HELP>	#previous performance analysis emulations.
%<HELP>	#.($278)Run
%<HELP>	#The \bRun\r pull-down menu allows you to start a
%<HELP>	#performance analysis emulation in three ways, by
%<HELP>	#\l($279)Emulator^Reset\m, by \l($280)Target^Reset\m
%<HELP>	#and by \l($281)Go\m (from PC).  Note that a
%<HELP>	#performance analysis setup must be defined before any of
%<HELP>	#these commands will function.
%<HELP>	#.($279)Run|Reset (Emulator)
%<HELP>	#The \bReset^(Emulator)\r command starts a performance
%<HELP>	#analysis emulation from a reset condition.  The reset signal
%<HELP>	#will be supplied by the emulator itself.
%<HELP>	#.($280)Run|Reset (Target)
%<HELP>	#The \bReset^(Target)\r command starts a performance
%<HELP>	#analysis emulation from a reset condition.  The reset signal
%<HELP>	#will be supplied by the target system.  Emulation will not
%<HELP>	#begin until a reset signal is received from the target system.
%<HELP>	#.($281)Run|Go
%<HELP>	#The \bGo\r command starts a performance analysis emulation.
%<HELP>	#Emulation begins at the address indicated by
%<HELP>	#the PC.
%<HELP>	#.($282)Quick-setup
%<HELP>	#The \bQuick-setup\r pull-down allows you to quickly
%<HELP>	#define one of four types of performance analysis setups.
%<HELP>	#They are \l($283)N-Equal\m, \l($284)Module\m,
%<HELP>	#\l($285)Procedure\m and \l($286)Line^Numbers\m.
%<HELP>	#The number of \l($291)Bins\m used for a quick-setup can
%<HELP>	#also be set, otherwise the default number of bins will be used.
%<HELP>	#No bins will be created with \l($369)Capture^Ranges\m
%<HELP>	#out of the \l($290)Capture^Span\m used for the setup.
%<HELP>	#.($283)Quick-setup|N-Equal
%<HELP>	#The \bN-Equal\r command is used to quickly define a setup
%<HELP>	#of equally sized bins.  It does this by partitioning the
%<HELP>	#\l($290)Capture^Span\m into N equally sized areas (where
%<HELP>	#N is the number of \l($291)Bins\m).
%<HELP>	#Each created bin
%<HELP>	#will be created as \l($370)Type\m 'Neql' with the
%<HELP>	#\l($371)Description\m set with the number of bytes
%<HELP>	#in the \l($369)Capture^Range\m.
%<HELP>	#.($284)Quick_setup|Module
%<HELP>	#The \bModule\r command is used to quickly define a setup
%<HELP>	#monitoring module address ranges.  If possible, each bin will
%<HELP>	#monitor one module; as specified by the program
%<HELP>	#currently loaded into memory.  If the program contains
%<HELP>	#more modules than the number of \l($291)Bins\m, each bin
%<HELP>	#may monitor several modules.
%<HELP>	#.sp 1
%<HELP>	#Each created bin will be created as \l($370)Type\m 'Mod' with
%<HELP>	#the \l($371)Description\m set with the name(s) of the module(s)
%<HELP>	#monitored by the bin.  Each bins
%<HELP>	#\l($369)Capture^Range\m will be from the starting address
%<HELP>	#of the first module monitored by the bin through the
%<HELP>	#ending address of the last module monitored by the bin, inclusive.
%<HELP>	#.sp 1
%<HELP>	#Note that this command will be de-activated if the loaded program
%<HELP>	#has no module information.
%<HELP>	#.($285)Quick_setup|Procedure
%<HELP>	#The \bProcedure\r command is used to quickly define a setup
%<HELP>	#to monitor the address ranges between
%<HELP>	#procedures, functions and global (public) code labels.
%<HELP>	#If possible, each bin will monitor the range between one
%<HELP>	#procedure, function, or global code label and the next.
%<HELP>	#If the program contains more procedures, functions, and
%<HELP>	#global code labels than the number of \l($291)Bins\m, each bin
%<HELP>	#may monitor the address range encompassing several
%<HELP>	#procedure, function, or global code labels.
%<HELP>	#.sp 1
%<HELP>	#Each created bin will be created as \l($370)Type\m 'Proc' with
%<HELP>	#the \l($371)Description\m set with the name(s) of the
%<HELP>	#procedure(s), function(s), or global code label(s)
%<HELP>	#monitored by the bin.
%<HELP>	#Each bins \l($369)Capture^Range\m will be from the address
%<HELP>	#of the first procedure, function, or global code label
%<HELP>	#monitored by the bin through the address (-1) of the first
%<HELP>	#procedure, function, or global code label monitored by the next bin.
%<HELP>	#.sp 1
%<HELP>	#Note that global code labels are included because not
%<HELP>	#all language processors (compilers) mark procedures/functions
%<HELP>	#properly in the absolute object module debug records.
%<HELP>	#.sp 1
%<HELP>	#Note that this command will be de-activated if the loaded program
%<HELP>	#has no global symbol information and no functions or procedures.
%<HELP>	#.($286)Quick_setup|Line Numbers
%<HELP>	#The \bLine^Numbers\r command is used to quickly define a setup
%<HELP>	#monitoring line number address ranges.  If possible, each bin will
%<HELP>	#monitor the range between one line number and the next line number.
%<HELP>	#If the program contains more line numbers than the number
%<HELP>	#of \l($291)Bins\m, each bin may monitor the address ranges
%<HELP>	#encompassing several line numbers.
%<HELP>	#.sp 1
%<HELP>	#Each created bin will be created as \l($370)Type\m 'Lnum' with
%<HELP>	#the \l($371)Description\m set with the name(s) of the
%<HELP>	#module(s) and line number(s) monitored by the bin.
%<HELP>	#Each bins \l($369)Capture^Range\m will be from the address
%<HELP>	#of the first line number monitored by the bin through the
%<HELP>	#address (-1) of the first line number of the next bin.
%<HELP>	#.sp 1
%<HELP>	#Note that this command will be de-activated if the loaded program
%<HELP>	#has no line number information.
%<HELP>	#.($287)Misc
%<HELP>	#The \bMisc\r pull-down menu allows you to
%<HELP>	#\l($288)Clear\m a defined performance analyzer setup,
%<HELP>	#to change the \l($289)Sort^Order\m used to display a
%<HELP>	#performance analyzer setup and to define the
%<HELP>	#\l($290)Capture^Span\m the performance analyzer
%<HELP>	#setup will encompass.
%<HELP>	#.($288)Misc|Clear
%<HELP>	#The \bClear\r command is used to clear all bins associated
%<HELP>	#with a defined performance analyzer setup.  This includes any
%<HELP>	#statistics from previous performance analyzer emulations.
%<HELP>	#.($289)Misc|Sort Order
%<HELP>	#The \bSort^Order\r pull-down menu is used to change the sort order
%<HELP>	#of the displayed bins in the current performance analyzer
%<HELP>	#setup.  The setup can be sorted by either \l($372)Bin^Number\m or
%<HELP>	#\l($369)Capture^Range\m.  The current sort order is displayed in
%<HELP>	#the Misc Pull-down Menu and in the title above the bins
%<HELP>	#in the performance analyzer setup menu.
%<HELP>	#.($290)Misc|Capture Span
%<HELP>	#The \bCapture^Span\r command allows you to specify the
%<HELP>	#address span over which the bin \l($369)Capture^Ranges\m
%<HELP>	#may be defined.  Neither \l($282)Quick-setup\m bins or user-defined
%<HELP>	#bins can have a capture range out of that span.
%<HELP>	#The capture span is displayed in the upper left of the
%<HELP>	#performance analyzer setup menu.
%<HELP>	#.sp 1
%<HELP>	#If a quick setup is selected before the capture span has been
%<HELP>	#defined, the capture span will default to the address range
%<HELP>	#covered by the program currently loaded in memory.  If no
%<HELP>	#program is loaded the capture span will then default to all
%<HELP>	#of addressable program memory.
%<HELP>	#.($291)Quick-setup|Bins
%<HELP>	#The \bBins\r command allows you to specify the number of
%<HELP>	#bins to use in a \l($282)Quick-setup\m.  However, if there
%<HELP>	#are not enough ranges (generated by the quick setup)
%<HELP>	#to fill the number of bins specified the number of bins will be
%<HELP>	#be set to the number needed.  For example, if you specify
%<HELP>	#12 bins and then select a \l($284)Module\m quick setup and there
%<HELP>	#are only 4 modules, the number of bins will be set to 4.
%<HELP>	#.sp 1
%<HELP>	#In addition, if the number of bins is not defined before a
%<HELP>	#quick setup is selected, the number of bins will default to
%<HELP>	#15 for a High Resolution Performance Analysis setup
%<HELP>	#and 50 for
%<HELP>	#a High Bin Count Performance Analysis setup.
%<HELP>	#Of course, this number may be
%<HELP>	#automatically adjusted downward as described above.
%<HELP>	#The maximum number of bins that may be specified is 15 for
%<HELP>	#a High Resolution Performance Analysis setup and 999 for
%<HELP>	#a High Bin Count Performance Analysis setup.
%<HELP>	#The number of bins is displayed in the
%<HELP>	#Quick-Setup Pull-down Menu and at the upper right of the
%<HELP>	#performance analyzer setup menu.
%<HELP>	#.sp 1
%<HELP>	#If the maximum number of bins is specified there is a
%<HELP>	#special case where the number of bins may be decremented
%<HELP>	#by one.  This will happen if a \l($370)Miss^Bin\m is needed.
%<HELP>	#.($292)Edit
%<HELP>	#The \bEdit\r command allows you to edit the contents of
%<HELP>	#the currently highlighted bin.  Any bin can be edited except
%<HELP>	#for the \l($370)Miss^Bin\m.
%<HELP>	#All fields of a bin (\l($372)Number\m, \l($369)Capture^Range\m
%<HELP>	#and \l($371)Description\m) can be edited except for bin
%<HELP>	#\l($370)Type\m which is changed automatically by the software
%<HELP>	#depending on how the other fields are edited.  In general,
%<HELP>	#the bin type will be changed to 'User' if any fields of the
%<HELP>	#bin are changed.
%<HELP>	#.sp 1
%<HELP>	#If the edited fields are valid the Miss Bins will be
%<HELP>	#recalculated and the setup will be sorted and redisplayed.
%<HELP>	#.sp 1
%<HELP>	#Note that if the \bEdit\r command is selected when no bins
%<HELP>	#are defined you are given an empty bin to edit, which
%<HELP>	#is effectively the \l($292)Add\m command.
%<HELP>	#.($293)Add
%<HELP>	#The \bAdd\r command allows you to add a bin to the
%<HELP>	#current performance analyzer setup.  When the \bAdd\r
%<HELP>	#command is selected control is automatically passed to the
%<HELP>	#\l($292)Edit\m screen with an empty
%<HELP>	#bin and edit screen rules apply.
%<HELP>	#If the edited fields are valid the bin will be added
%<HELP>	#to the setup, the \l($370)Miss^Bins\m will be recalculated,
%<HELP>	#the number of \l($291)Bins\m will be incremented by one and
%<HELP>	#the setup will be sorted and redisplayed.
%<HELP>	#.($294)Delete
%<HELP>	#The \bDelete\r command is used to delete the currently highlighted
%<HELP>	#bin from the current performance analyzer setup.  Any bin but the
%<HELP>	#\l($370)Miss^Bin\m can be deleted.  After a bin has been deleted
%<HELP>	#the miss bins will be recalculated,
%<HELP>	#the number of \l($291)Bins\m will be decremented by one and
%<HELP>	#the setup will be sorted and redisplayed.
%<HELP>	#.($295)File
%<HELP>	#The \bFile\r Pull-down Menu allows you to \l($296)Save\m
%<HELP>	#a performance analyzer setup to a disk file and to \l($297)Load\m
%<HELP>	#a previously saved performance analyzer setup from a disk file.
%<HELP>	#.($296)File|Save
%<HELP>	#The \bSave\r command allows you to save the currently
%<HELP>	#defined performance analyzer setup to a disk file.  You
%<HELP>	#will be prompted for the name of the file.  A saved setup can
%<HELP>	#be restored later using the \l($297)Load\m command.
%<HELP>	#.($297)File|Load
%<HELP>	#The \bLoad\r command allows you to restore a previously
%<HELP>	#stored performance analyzer setup (via the \l($296)Save\m command).
%<HELP>	#You will be prompted for the name of the file.
%<HELP>	#.($323)Raw
%<HELP>	#The \bRaw\r command changes the display format to Raw Mode.
%<HELP>	#In the Raw Mode, you see only the bar graph (percentage) lines,
%<HELP>	#one per bin.
%<HELP>	#.sp 1
%<HELP>	#Note that the bar graph (percentage) lines exist in all of the
%<HELP>	#other display formats, too.
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#An asterisk following the percentage of time spent in
%<HELP>	#a bin indicates a non-zero sample count for that bin.
%<HELP>	#This indication is useful, as the percentage of time spent
%<HELP>	#in a particular bin may be non-zero,
%<HELP>	#but less than 0.1% (in which case,
%<HELP>	#the percentage of time spent in that bin displays as
%<HELP>	#"0.0*").
%<HELP>	#.in -2 }
%<HELP>	#.($324)Symbolic
%<HELP>	#The \bSymbolic\r command changes the display format to Symbolic Mode.
%<HELP>	#In the Symbolic Mode, you see the bar graph (percentage) line
%<HELP>	#for each bin,
%<HELP>	#followed by one line for each global (PUBLIC) and/or local code
%<HELP>	#label within each address range in that bin.
%<HELP>	#.sp 1
%<HELP>	#The Model File A42 directive controls whether the display contains
%<HELP>	#only global code labels or only local code labels,
%<HELP>	#or both.
%<HELP>	#.sp 1
%<HELP>	#In the display, an asterisk ('*') precedes global code labels
%<HELP>	#to distinguish them from local code labels.
%<HELP>	#.($325)HLL
%<HELP>	#The \bHLL\r command changes the display format to HLL Mode.
%<HELP>	#In the HLL Mode, you see the bar graph (percentage) line
%<HELP>	#for each bin,
%<HELP>	#followed by the HLL source line images
%<HELP>	#within each address range in that bin.
%<HELP>	#If a particular HLL source image is not available to %rs1,
%<HELP>	#the display shows only the module name and line number.
%<HELP>	#If the program loaded into memory does not
%<HELP>	#contain source line number debug records, it is not possible
%<HELP>	#for %rs1 to display either HLL source line images
%<HELP>	#or module names and line numbers.
%<HELP>	#.($326)Mixed
%<HELP>	#The \bMixed\r command changes the display format to Mixed Mode.
%<HELP>	#In the Mixed Mode, you see everything included in the other
%<HELP>	#primary display formats:
%<HELP>	#\l($323)Raw\m, \l($324)Symbolic\m and \l($325)HLL\m.
%<HELP>	#.sp 1
%<HELP>	#If a code label and an HLL source image are located
%<HELP>	#at the same code address, the code label will
%<HELP>	#appear in the display before the HLL source image.
%<HELP>	#.($327)Counts
%<HELP>	#The \bCounts\r command toggles the display
%<HELP>	#from showing a bar graph (percentage) line for each bin
%<HELP>	#to showing the actual sample (hit) count for that bin.
%<HELP>	#The \bCounts\r display mode toggle command operates independently
%<HELP>	#of any other display control command.
%<HELP>	#.sp 1
%<HELP>	#The sum of the sample counts for each bin usually equals the
%<HELP>	#total sample count shown near the top-right of the
%<HELP>	#display at "Samples:";
%<HELP>	#however, the \l($329)Miss^Bin\m may or may not be included in the
%<HELP>	#total "Samples:" count.
%<HELP>	#.($328)Expand
%<HELP>	#The \bExpand\r command toggles the display into and out of
%<HELP>	#expanded display mode.
%<HELP>	#The \bExpand\red display mode toggle command operates independently
%<HELP>	#of any other display control command.
%<HELP>	#.sp 1
%<HELP>	#When expanded mode is on,
%<HELP>	#following each bar graph (percentage) line for each bin,
%<HELP>	#there will be one line showing each address range in the bin
%<HELP>	#if than bin contains (covers) more than one address range.
%<HELP>	#.sp 1
%<HELP>	#You can enter \bExpand\red display mode only if there is at
%<HELP>	#least one bin that contains (covers) more than one address range.
%<HELP>	#.($329)Misses
%<HELP>	#The \bMisses\r toggle command controls whether or not
%<HELP>	#"misses" are included in:
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#.in +4 {
%<HELP>	#.ti -4
%<HELP>	#1)^^the total sample count displayed
%<HELP>	#near the top-right of the screen at "Samples:", and,
%<HELP>	#.ti -4
%<HELP>	#2)^^the cumulative percentage statistic.
%<HELP>	#.in -4 }
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#The Performance Analyzer allocates the "Miss Bin" to
%<HELP>	#monitor program execution in \ueach and every\r memory location
%<HELP>	#which you are not explicitly monitoring.
%<HELP>	#The Miss Bin does not exist if you are explicitly
%<HELP>	#monitoring (via the current Performance Analyzer Setup)
%<HELP>	#every memory location.
%<HELP>	#.sp 1
%<HELP>	#Even when the \bMisses\r command is toggled to the 'OFF'
%<HELP>	#mode (and thus, the percentage for the Miss Bin
%<HELP>	#is computed as zero), you can view the actual sample counts in
%<HELP>	#the Miss Bin by toggling the \l($327)Counts\m mode to 'ON'.
%<HELP>	#.($330)Write
%<HELP>	#The \bWrite\r command allows you to write all current performance
%<HELP>	#analysis results to a file of your choice.
%<HELP>	#The information will be written using the current display formats.
%<HELP>	#.($331)Help (Performance Analyzer View)
%<HELP&A80&(DMD|EPU)>	#(Note:  The \bPerformance Analyzer\r is not available
%<HELP&A80&(DMD|EPU)>	#in the COP8 Debug Module or EPU.)
%<HELP&A80&(DMD|EPU)>	#.sp 1
%<HELP>	#\l($323)Raw\m^^^^^^\l($324)Symbolic\m^^^\l($325)HLL\m^^^\l($326)Mixed\m
%<HELP>	#.sp 1
%<HELP>	#\l($327)Counts\m^^^\l($328)Expand\m^^^^^\l($329)Misses\m
%<HELP>	#.sp 1
%<HELP>	#\l($330)Write\m
%<HELP>	#.($343)Write
%<HELP>	#You can write the disassembled content of
%<HELP&(!A65)>	#code
%<HELP&( A65)>	#general
%<HELP>	#memory to a disk file by selecting the
%<HELP>	#\bWrite\r command.  The format of the information written to
%<HELP>	#the file will be just as you see it on the screen
%<HELP>	#(i.e., in human-readable form, in the current display mode).
%<HELP>	#.($344)Mouse Support
%<HELP>	#While \b%rs1\r currently does not provide internal, direct support
%<HELP>	#for a mouse, you can operate \b%rs1\r with a mouse by using the
%<HELP>	#"mouse menu" utility normally supplied by each mouse manufacturer.
%<HELP>	#These mouse menu utilities allow you to define a mapping from
%<HELP>	#mouse buttons/movements to keyboard keystrokes.
%<HELP>	#.sp 1
%<HELP>	#Regardless of which mouse you are using, mouse movement should
%<HELP>	#always be mapped as:
%<HELP>	#.sp 1
%<HELP>	#.in +4 {
%<HELP>	#.ba {
%<HELP>	#Mouse Movement   Keystroke Mapping
%<HELP>	#--------------   -----------------
%<HELP>	#Left             \x1B (Left Arrow)
%<HELP>	#Right            \x1A (Right Arrow)
%<HELP>	#Up               \x18 (Up Arrow)
%<HELP>	#Down             \x19 (Down Arrow)
%<HELP>	#.ea }
%<HELP>	#.in -4 }
%<HELP>	#.sp 1
%<HELP>	#You can control \b%rs1\r most effectively with a mouse if your
%<HELP>	#mouse menu software allows you to define mouse buttons for at
%<HELP>	#least the following keystrokes (2-button mouse):
%<HELP>	#.sp 1
%<HELP>	#.in +4 {
%<HELP>	#.ba {
%<HELP>	#Mouse Button   Keystroke Mapping
%<HELP>	#------------   -----------------
%<HELP>	#Left           Enter
%<HELP>	#       Right   Esc
%<HELP>	#Left + Right   Tab
%<HELP>	#.ea }
%<HELP>	#.in -4 }
%<HELP>	#.sp 1
%<HELP>	#If you have a 3-button mouse, we recommend the following definitions:
%<HELP>	#.sp 1
%<HELP>	#.in +4 {
%<HELP>	#.ba {
%<HELP>	#Mouse Button            Keystroke Mapping
%<HELP>	#---------------------   -----------------
%<HELP>	#Left                    Enter
%<HELP>	#                Right   Esc
%<HELP>	#       Middle           Tab
%<HELP>	#Left + Middle           Home
%<HELP>	#       Middle + Right   End
%<HELP>	#Left          + Right   Shift-Tab
%<HELP>	#Left + Middle + Right   Ctrl-E
%<HELP>	#.ea }
%<HELP>	#.in -4 }
%<HELP>	#.sp 1
%<HELP>	#Specific details for setting up mouse menus are provided in:
%<HELP>	#.sp 1
%<HELP>	#.in +4 {
%<HELP>	#\l($358)Microsoft^Mouse\m
%<HELP>	#.sp 1
%<HELP>	#\l($359)LOGITECH^Mouse\m
%<HELP>	#.sp 1
%<HELP>	#\l($361)Mouse^Systems^White^Mouse\m
%<HELP>	#.in -4 }
%<HELP>	#.sp 1
%<HELP>	#If your mouse is not listed above, refer to the mouse manufacturer's
%<HELP>	#documentation.
%<HELP>	#.sp 1
%<HELP>	#Additionally, if you decide to use a mouse in this manner,
%<HELP>	#you will probably prefer to set
%<HELP>	#the \l($68)Alert|Bad^Key/Command\m toggle to \bOff\r.
%<HELP>	#.($345)Select Color Menu
%<HELP>	#The column headers on the right hand side of this display
%<HELP>	#are very short abbreviations for the following color controls:
%<HELP>	#.sp 1
%<HELP>	#.in +11 {
%<HELP>	#.ti -11
%<HELP>	#Column^^^^^^^
%<HELP>	#.ti -11
%<HELP>	#Header^^^^^Meaning
%<HELP>	#.ti -11
%<HELP>	#---------^^-------------------------
%<HELP>	#.ti -11
%<HELP>	#Cl^border^^box border, color
%<HELP>	#.ti -11
%<HELP>	#Hl^border^^box border, highlight color
%<HELP>	#.ti -11
%<HELP>	#L^^border^^box border, line style
%<HELP>	#.ti -11
%<HELP>	#S^^border^^box border, -- shadow under box?
%<HELP>	#.ti -11
%<HELP>	#E^^border^^box border, -- exploding box?
%<HELP>	#.ti -11
%<HELP>	#Cl^body^^^^box body, color
%<HELP>	#.ti -11
%<HELP>	#Hl^body^^^^box body, highlight color
%<HELP>	#.ti -11
%<HELP>	#Qk^body^^^^box body, quick-key color
%<HELP>	#.ti -11
%<HELP>	#Hk^body^^^^box body, hot-key color
%<HELP>	#.ti -11
%<HELP>	#Vl^body^^^^box body, value color
%<HELP>	#.ti -11
%<HELP>	#In^body^^^^box body, inactive (inaccessible) command color
%<HELP>	#.ti -11
%<HELP>	#Is^body^^^^box body, inactive (inaccessible)
%<HELP>	#command selected (highlighted) color
%<HELP>	#.in -11 }
%<HELP>	#.sp 1
%<HELP>	#You will notice that the abbreviations and the explanations
%<HELP>	#refer primarily to fields that appear in \l($346)pull-down^menu\ms,
%<HELP>	#although many apply to "boxes" in general.
%<HELP>	#.sp 1
%<HELP>	#Some pop-up windows and menus overload the meaning of some otherwise
%<HELP>	#"Not Applicable" color controls to govern a field or area
%<HELP>	#which is unique to that menu or window.
%<HELP>	#Those cases where the internal usage of a particular
%<HELP>	#color control differs from the definitions given above
%<HELP>	#are:
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#.ti -2
%<HELP>	#\bFunction^Key^label^lines\r
%<HELP>	#.sp 1
%<HELP>	#.in +11 {
%<HELP>	#.ti -11
%<HELP>	#Cl^body^^^^Function key numbers preceding labels.
%<HELP>	#.ti -11
%<HELP>	#Hl^body^^^^Function key labels.
%<HELP>	#.ti -11
%<HELP>	#In^body^^^^Function key label when associated command/menu is
%<HELP>	#already active (invoked).
%<HELP>	#.in -11 }
%<HELP>	#.sp 1
%<HELP>	#.ti -2
%<HELP>	#\bPop-up:^^Yes/No/Cancel^Questions\r
%<HELP>	#.sp 1
%<HELP>	#.in +11 {
%<HELP>	#.ti -11
%<HELP>	#Hl^body^^^^Currently highlighted response.
%<HELP>	#.ti -11
%<HELP>	#Qk^body^^^^Quick-Key for "\bY\res", "\bN\ro" or "\bC\rancel".
%<HELP>	#.in -11 }
%<HELP>	#.sp 1
%<HELP>	#.ti -2
%<HELP>	#\bPop-up:^^0-100%^Status^Messages\r
%<HELP>	#.sp 1
%<HELP>	#.in +11 {
%<HELP>	#.ti -11
%<HELP>	#Hk^body^^^^Percentage bar (foreground).
%<HELP>	#.ti -11
%<HELP>	#Qk^body^^^^Percentage bar (background).
%<HELP>	#.in -11 }
%<HELP>	#.sp 1
%<HELP>	#.ti -2
%<HELP>	#\bWindow:^^Registers\r
%<HELP>	#.sp 1
%<HELP>	#.in +11 {
%<HELP>	#.ti -11
%<HELP>	#Hl^body^^^^Highlighted "current register".
%<HELP>	#.ti -11
%<HELP&A51>	#Qk^body^^^^GPRn values (left side of 1st window line).
%<HELP&A68>	#Qk^body^^^^A, B, X, Y, SP and CCR values (left side of 1st window line).
