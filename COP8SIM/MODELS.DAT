%<HELP>	#Code Break-points              32K
%<HELP>	#Trace-On-points                32K
%<HELP>	#Trace-Off-points               32K
%<HELP>	#Pass-Count-points              32K
%<HELP>	#Trigger Conditions
%<HELP>	#  PC address & range           X
%<HELP&CBE>	#  Opcode Value                 X
%<HELP&CBE>	#  Opcode Class                 X
%<HELP&CBE>	#  Registers/SFRs               X
%<HELP&CBE>	#  Direct byte address & range  X
%<HELP&CBE>	#  Direct bit address & range   X
%<HELP&CBE>	#  Immediate operand value      X
%<HELP&CBE>	#  Read/Write to bit address    X
%<HELP&CBE>	#  Register addressing modes    X
%<HELP&CBE>	#  Read/Write to Register addr  X
%<HELP&CBE>	#  Logical AND/OR of the above  X
%<HELP>	#  Pass Count overflow          X
%<HELP>	#  External input               X
%<HELP>	#Operating Mode
%<HELP>	#  Single-Chip/ROM              X
%<HELP>	#Max # of Main Screen Windows
%<HELP>	#  Internal Data Memory         5
%<HELP>	#  Code Memory Memory           5
%<HELP>	#.ea }
