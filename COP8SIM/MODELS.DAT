%<HELP>	#.sp 2
%<HELP>	#\bEMULATOR BASE & PROBE CARD CATALOG\r
%<HELP>	#.sp 1
%<HELP>	#Effective:  1995 September 15
%<HELP>	#.sp 1
%<HELP>	#.ba {
%<HELP>	#******************
%<HELP>	#* Emulator Bases *
%<HELP>	#******************
%<HELP>	#.ea }
%<HELP>	#.sp 1
%<HELP>	#\b%rs1-nX65K Modular Emulators\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#All \b%rs1-nX65K Modular\r 400 emulators support
%<HELP>	#full probe card interchangeability within the OKI nX65K
%<HELP>	#family of devices.
%<HELP>	#To emulate several different devices, you need purchase only a single
%<HELP>	#emulator base unit and then one probe card for each unique device
%<HELP>	#or group of devices to be emulated.
%<HELP>	#.sp 1
%<HELP>	#The %rs1-nX65K emulator comes with 64K of emulation (General) memory
%<HELP>	#and a 16K-Frame Trace Buffer (which can be viewed during emulation).
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#.ba {
%<HELP>	#***************
%<HELP>	#* Probe Cards *
%<HELP>	#***************
%<HELP>	#.ea }
%<HELP>	#.sp 1
%<HELP>	#All %rs2 %rs1 probe cards include a Break-Input signal clip,
%<HELP>	#a Trigger-Output signal clip and eight user-placeable
%<HELP>	#Trace-Capture-Input signal clips.
%<HELP>	#Most probe cards have
%<HELP>	#user-selectable jumpers to control/configure the
%<HELP>	#unique capabilities of each particular device.
%<HELP>	#\b%rs1\r \ufully\r supports:
%<HELP>	#.sp 1
%<HELP>	#.in +4 {
%<HELP>	#.in +3 {
%<HELP>	#.ti -3
%<HELP>	#\x07^^All I/O ports, with no restrictions.
%<HELP>	#.sp 1
%<HELP>	#.ti -3
%<HELP>	#\x07^^The CMOS Idle and Power Down (Halt) modes of operation,
%<HELP>	#in those devices having such capabilities.
%<HELP>	#.sp 1
%<HELP>	#.ti -3
%<HELP>	#\x07^^The Watchdog Timer (WDT),
%<HELP>	#in those devices having such a capability.
%<HELP>	#.in -3 }
%<HELP>	#.in -4 }
%<HELP>	#.sp 1
%<HELP>	#Following is a list of all OKI nX65K Probe Cards which %rs2
%<HELP>	#currently offers.
%<HELP>	#Since %rs2 is constantly adding to its list of supported devices,
%<HELP>	#please contact %rs2 for information on any device not listed below.
%<HELP>	#.sp 2
%<HELP>	#.ba {
%<HELP>	#\b========== %rs1-nX65K Modular Emulator Base ==========\r
%<HELP>	#.ea }
%<HELP>	#.sp 1
%<HELP>	#If support for a particular device is available in different
%<HELP>	#packages, the description of the Probe Card appears only once,
%<HELP>	#with the packaging variations listed before the description.
%<HELP>	#.sp 1
%<HELP>	#.ba {
%<HELP>	#\bMSM65512^^44-lead^PLCC^^^^^^^^0.5-12MHz,^3V-5V^^Probe Card\r
%<HELP>	#.ea }
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#The OKI nX65K MSM65512 Probe Card supports device operation
%<HELP>	#from 0.5 to 12.0MHz XTAL, at 3.0V-5.0V.
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#.ba {
