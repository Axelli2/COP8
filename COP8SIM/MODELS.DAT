%<HELP&CBE&A65>	#.sp 1
%<HELP&CBE&A65>	#Note that when you specify an operand only explicit references
%<HELP&CBE&A65>	#to that operand are used when checking instructions.  For example,
%<HELP&CBE&A65>	#specifying operand type C will catch specific use of the Carry
%<HELP&CBE&A65>	#Bit by instructions such as CJE but not when the Carry Bit is
%<HELP&CBE&A65>	#set or cleared as the result of an instruction such as ADC.
%<HELP&A80>	#.($537)Halt Option
%<HELP&A80> #From the \bHalt\r pulldown menu you may \l($538)Enable\m
%<HELP&A80> #or \l($539)Disable\m Halt.  The default state of the Halt
%<HELP&A80> #option is \benabled\r.
%<HELP&A80>	#.($538)Halt Enable
%<HELP&A80> #The \bEnable\r command is used to Enable Halt by programming
%<HELP&A80> #0x6F or 0x7F (depending on the \l($436)EPROM^Device\m selected)
%<HELP&A80> #into the configuration byte at 0x1FFF.
%<HELP&A80> #Halt Enable is the default selection.
%<HELP&A80>	#.($539)Halt Disable
%<HELP&A80> #The \bDisable\r command is used to Disable Halt by programming
%<HELP&A80> #0xEF or 0xFF (depending on the \l($436)EPROM^Device\m selected)
%<HELP&A80> #into the configuration byte at 0x1FFF.
%<HELP>	#.($540)Slow Motion
%<HELP>	#The \bSlow^Motion\r command pulls down a menu allowing you to
%<HELP>	#start an automatically repeated cycle of single-step emulations.
%<HELP>	#You can single-step either by machine \l($272)Instruction\m
%<HELP>	#or by HLL source \l($541)Line\m.
%<HELP>	#This is not real-time
%<HELP>	#emulation, since the system executes only one instruction
%<HELP>	#(or the instructions generated for one HLL source line),
%<HELP>	#then breaks and updates the Main Screen Windows, then continues.
%<HELP>	#.sp 1
%<HELP>	#You stop a \bSlow^Motion\r emulation by pressing the \bEsc\r key.
%<HELP>	#.sp 1
%<HELP>	#You control the speed of operation of the \bSlow Motion\r emulation.
%<HELP>	#The default delay between each
%<HELP>	#repetition of the cycle is 500 milliseconds (1/2 second).
%<HELP>	#You can increase the delay (go slower) by pressing the
%<HELP>	#minus key, \b-\r.
%<HELP>	#You can decrease the delay (go faster) by pressing the
%<HELP>	#plus key, \b+\r.
%<HELP>	#The Status Window shows the current delay time in the \bState:\r
%<HELP>	#field.
%<HELP>	#When you change speed, note that only one change increment is allowed
%<HELP>	#per single-step.
%<HELP>	#.sp 1
%<HELP>	#The \bSlow^Motion\r command updates the entire display after each
%<HELP>	#instruction or HLL source line is executed.
%<HELP>	#If you do not need real-time speed,
%<HELP>	#you can use this mode in conjunction with the Watch Window to allow
%<HELP>	#you to identify problems with unexpected data values or register value
%<HELP>	#changes.
%<HELP>	#.sp 1
%<HELP>	#All other break conditions are de-activated during Slow Motion
%<HELP>	#emulation.
%<HELP>	#.($541)Slow Motion|Line
%<HELP>	#The \bSlow^Motion|Line\r command starts an automatically repeated
%<HELP>	#cycle of \l($103)Run|Line\m commands (single-step by HLL source line).
%<HELP>	#For more information about slow motion emulation,
%<HELP>	#see \l($540)Run|Slow^Motion\m.
%<HELP>	#.sp 1
%<HELP>	#Note that this command will be de-activated if the loaded program
%<HELP>	#has no line number information.
%<HELP>	#.($542)Catalog of iceMASTER COP8 Products
%<HELP>	#.sp 1
%<HELP>	#.in +3 {
%<HELP>	#.ti -3
%<HELP>	#\b%rs1-COP8 Modular Emulator:\r
%<HELP>	#.sp 1
%<HELP>	#The %rs2 \b%rs1-COP8 Modular\r emulator consists of a
%<HELP>	#COP8-architecture-specific emulator base unit,
%<HELP>	#attached to a small probe card (pod) via an umbilical cable.
%<HELP>	#The probe card, which contains the device being emulated,
%<HELP>	#inserts into the socket for the device in your target
%<HELP>	#development system.  Many probe cards are available, supporting a
%<HELP>	#wide variety of National COP8 devices.
%<HELP>	#The emulator base unit connects to the
%<HELP>	#host PC (personal computer) via a standard RS-232-C serial
%<HELP>	#communications link operating at 115.2K baud.
%<HELP>	#.sp 1
%<HELP>	#The \b%rs1-COP8 Modular\r emulator is a
%<HELP>	#high-performance, full-featured, economical,
%<HELP>	#small profile/footprint emulator supporting
%<HELP>	#full probe card interchangeability.
%<HELP>	#.in -3 }
%<HELP>	#.sp 2
