%<HELP>	#Probe Card Cable Length:
%<HELP>	#.ba {
%<HELP>	#14.0"   35.6cm
%<HELP>	#.ea }
%<HELP>	#.ti -2
%<HELP>	#Emulator Weight
%<HELP>	#.ba {
%<HELP>	#2.0lbs   0.9kg
%<HELP>	#.ea }
%<HELP>	#.in -2 }
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#.ti -2
