%<HELP>	#.in +2 {
%<HELP>	#All \b%rs1-K4 Modular\r 400 emulators support
%<HELP>	#full probe card interchangeability within the NEC K4
%<HELP>	#family of devices.
%<HELP>	#To emulate several different devices, you need purchase only a single
%<HELP>	#emulator base unit and then one probe card for each unique device
%<HELP>	#or group of devices to be emulated.
%<HELP>	#.sp 1
%<HELP>	#The %rs1-K4 emulator comes with 1Mb of emulation memory
%<HELP>	#and a 16K-Frame Trace Buffer (which can be viewed during emulation).
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#.ba {
%<HELP>	#***************
%<HELP>	#* Probe Cards *
%<HELP>	#***************
%<HELP>	#.ea }
%<HELP>	#.sp 1
%<HELP>	#All %rs2 %rs1 probe cards include a Break-Input signal clip,
%<HELP>	#a Trigger-Output signal clip and eight user-placeable
%<HELP>	#Trace-Capture-Input signal clips.
%<HELP>	#Most probe cards have
%<HELP>	#user-selectable jumpers to control/configure the
%<HELP>	#unique capabilities of each particular device.
%<HELP>	#\b%rs1\r \ufully\r supports:
%<HELP>	#.sp 1
%<HELP>	#.in +4 {
%<HELP>	#.in +3 {
%<HELP>	#.ti -3
%<HELP>	#\x07^^All I/O ports, with no restrictions.
%<HELP>	#.sp 1
%<HELP>	#.ti -3
%<HELP>	#\x07^^The Power Down (Sleep and Standby) modes of operation,
%<HELP>	#in those devices having such capabilities.
%<HELP>	#.sp 1
%<HELP>	#.ti -3
%<HELP>	#\x07^^The Watchdog Timer (WDT),
%<HELP>	#in those devices having such a capability.
%<HELP>	#.in -3 }
%<HELP>	#.in -4 }
%<HELP>	#.sp 1
%<HELP>	#Following is a list of all NEC K4 Probe Cards which %rs2
%<HELP>	#currently offers.
%<HELP>	#Since %rs2 is constantly adding to its list of supported devices,
%<HELP>	#please contact %rs2 for information on any device not listed below.
%<HELP>	#.sp 2
%<HELP>	#.ba {
%<HELP>	#\b========== %rs1-K4 Modular Emulator Base ==========\r
%<HELP>	#.ea }
%<HELP>	#.sp 1
%<HELP>	#If support for a particular device is available in different
%<HELP>	#packages, the description of the Probe Card appears only once,
%<HELP>	#with the packaging variations listed before the description.
%<HELP>	#.sp 1
%<HELP>	#.ba {
%<HELP>	#\b\xE6PD784026^^^^80-lead^QFP^^^^^^^0.5-25MHz,^2.7V-6.0V^^Probe Card\r
%<HELP>	#.ea }
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#The NEC \xE6PD784026 Probe Card supports device operation
%<HELP>	#from 0.5 to 25MHz XTAL, at 2.7V-6.0V.
%<HELP>	#This probe card supports the following K4 devices:
%<HELP>	#\xE6PD784021, \xE6PD784025, \xE6PD784026 and \xE6PD78P4026.
%<HELP>	#.in -2 }
%<HELP&A25>	#.($553)Chip Options
%<HELP&A25>	#The \bChip^Options\r command calls a pulldown menu from
%<HELP&A25>	#which you may set the Chip Options set through the CONFIG0
%<HELP&A25>	#and CONFIG1 configuration registers.
%<HELP&A25>	#.($554)Mode
%<HELP&A25>	#The \bMode\r command calls a pulldown menu from which
%<HELP&A25>	#you may set the chip mode to \l($556)Binary^Mode\m or
%<HELP&A25>	#\l($555)Source^Mode\m.  Only bit 0 (SRC) of CONFIG0
%<HELP&A25>	#is affected.
%<HELP&A25>	#.($555)Source Mode
%<HELP&A25>	#Bit 0 (SRC) of CONFIG0 is set, which sets the
%<HELP&A25>	#chip mode to \bSource^Mode\r (not binary
%<HELP&A25>	#code compatible with the MCS51).
%<HELP&A25>	#.($556)Binary Mode
%<HELP&A25>	#Bit 0 (SRC) of CONFIG0 is cleared, which sets the
%<HELP&A25>	#chip mode to \bBinary^Mode\r (binary code
%<HELP&A25>	#compatible with the MCS51).
%<HELP&A25>	#.($557)Page Mode
%<HELP&A25>	#The \bPage^Mode\r command toggles page mode ON or OFF.
%<HELP&A25>	#When ON is selected, bit 1 (PAGE) of CONFIG0 is cleared,
%<HELP&A25>	#meaning Port 2 is used for data.
%<HELP&A25>	#When OFF is selected, bit 1 (PAGE) of CONFIG0 is set,
%<HELP&A25>	#meaning Port 0 is used for data (MCS51 compatible).
%<HELP&A25>	#.($558)RD#/PSEN#
%<HELP&A25>	#The \bRD#/PSEN#\r command calls a pulldown menu from
%<HELP&A25>	#which you may select the behavior of the RD# and PSEN#
%<HELP&A25>	#signals.  Bits 2 and 3 (RD0, RD1) of CONFIG0 are affected.
%<HELP&A25>	#.($559)A16
%<HELP&A25>	#Selecting the \bA16\r command means RD# will be used as
%<HELP&A25>	#the 17th address bit (A16) and PSEN# will be active for
%<HELP&A25>	#all addresses.  Bit 2 (RD0) of CONFIG0 will be set and
%<HELP&A25>	#bit 3 (RD1) of CONFIG0 will be cleared.
%<HELP&A25>	#.($560)I/O
%<HELP&A25>	#Selecting the \bI/O\r command means Port 3.7 will be
%<HELP&A25>	#used for I/O only (not RD#) and PSEN# will be active for
%<HELP&A25>	#all addresses.  Bit 2 (RD0) of CONFIG0 will be cleared
%<HELP&A25>	#and bit 3 (RD1) of CONFIG0 will be set.
%<HELP&A25>	#.($561)MCS51
%<HELP&A25>	#Selecting the \bMCS51\r command means that RD# will be
%<HELP&A25>	#active for addresses less than or eqaul to 7F:FFFFh
%<HELP&A25>	#and PSEN# will be active for addresses greater than
%<HELP&A25>	#or equal to 80:0000h.  Bit 2 (RD0) and bit 3 (RD1) of
%<HELP&A25>	#CONFIG0 will both be set.
%<HELP&A25>	#This is the MCS51 compatible mode.
%<HELP&A25>	#.($562)Extended ALE
%<HELP&A25>	#The \bExtended^ALE\r command toggles Extended ALE mode
%<HELP&A25>	#ON or OFF.  When ON is selected, bit 4 (XALE) of CONFIG0
%<HELP&A25>	#is cleared, meaning ALE is extended.  When OFF is
%<HELP&A25>	#selected, bit 4 (XALE) of CONFIG0 is set, meaning
%<HELP&A25>	#ALE is not extended.
%<HELP&A25>	#.($563)Wait State A
%<HELP&A25>	#The \bWait^State^A\r command toggles Wait State A ON or
%<HELP&A25>	#OFF.  When ON is selected, bit 5 (WSA) of CONFIG0 is
%<HELP&A25>	#cleared, meaning there is one external wait state
%<HELP&A25>	#generated for memory regions 00:, FE: and FF:.
%<HELP&A25>	#When OFF is selected, bit 5 (WSA) of CONFIG0 is set,
%<HELP&A25>	#meaning no wait state is generated for memory
%<HELP&A25>	#regions 00:, FE: and FF:.
%<HELP&A25>	#.($564)EPROM Mapping
%<HELP&A25>	#The \bEPROM^Mapping\r command toggles EPROM Mapping
%<HELP&A25>	#ON or OFF.  When ON is selected, bit 0 (EMAP) of
%<HELP&A25>	#CONFIG1 is cleared, meaning the upper 8K bytes of
%<HELP&A25>	#on-chip code memory (FF:2000h-FF:3FFFh) are mapped
%<HELP&A25>	#to 00:E000h-00:FFFFh.  When OFF is selected, bit 0
%<HELP&A25>	#(EMAP) of CONFIG1 is set, meaning the upper 8K bytes
%<HELP&A25>	#of on-chip code memory remain at FF:2000h-FF:3FFFh.
%<HELP&A25>	#.($565)Wait State B
%<HELP&A25>	#The \bWait^State^B\r command toggles Wait State B ON or
%<HELP&A25>	#OFF.  When ON is selected, bit 3 (WSB) of CONFIG1 is
%<HELP&A25>	#cleared, meaning there is one external wait state
%<HELP&A25>	#generated for memory region 01:.
%<HELP&A25>	#When OFF is selected, bit 3 (WSB) of CONFIG1 is set,
%<HELP&A25>	#meaning no wait state is generated for memory
%<HELP&A25>	#region 01:.
%<HELP&A25>	#.($566)Interrupt
%<HELP&A25>	#The \bInterrupt\r command is used to set the interrupt
%<HELP&A25>	#behavior to \l($567)MCS51\m mode or \l($568)MCS251\m mode.
%<HELP&A25>	#Only bit 4 (INTR) of CONFIG1 is affected.
%<HELP&A25>	#.($567)MCS51
%<HELP&A25>	#Selecting the \bMCS51\r command sets the MCS51 Interrupt
%<HELP&A25>	#style.  Bit 4 (INTR) of CONFIG1 is cleared.  This means
%<HELP&A25>	#that an interrupt call will push just the lower two bytes
%<HELP&A25>	#of the PC on the stack and the RETI will pop just the lower
%<HELP&A25>	#two bytes of the PC from the stack.
%<HELP&A25>	#.($568)MCS251
%<HELP&A25>	#Selecting the \bMCS251\r command sets the MCS251 Interrupt
%<HELP&A25>	#style.  Bit 4 (INTR) of CONFIG1 is set.  This means that
%<HELP&A25>	#an interrupt call will push all three bytes of the PC and
%<HELP&A25>	#the PSW1 register on the stack and the RETI will pop all
%<HELP&A25>	#three bytes of the PC and the PSW1 register from the stack.
%<HELP&A78>	#.($569)Bus
%<HELP&A78>	#The \bBus\r command lets you configure the trace hardware in
%<HELP&A78>	#the emulator to either
%<HELP&A78>	#trace the sequence of opcode fetches,
%<HELP&A78>	#multiplexed with external memory accesses
%<HELP&A78>	#(\l($571)Bus|Opcode\m),
%<HELP&A78>	#or to trace accesses to most memory locations,
%<HELP&A78>	#independent of code stream execution flow
%<HELP&A78>	#(\l($570)Bus|Access\m).
%<HELP&A78>	#.($570)Access
%<HELP&A78>	#Selecting the \bAccess\r command sets up the trace hardware in
%<HELP&A78>	#the emulator to trace accesses to most memory locations,
%<HELP&A78>	#independent of code stream execution flow.
%<HELP&A78>	#.($571)Opcode
%<HELP&A78>	#Selecting the \bOpcode\r command sets up the trace hardware in
%<HELP&A78>	#the emulator to trace the sequence of opcode fetches,
%<HELP&A78>	#multiplexed with external memory accesses.
%<HELP&V30&(A51|A25)>	#.($572)Bank Switching
%<HELP&V30&(A51|A25)>	#This command displays the current bank switching
%<HELP&V30&(A51|A25)>	#environment and memory structure.
%<HELP&V30&(A51|A25)>	#.sp 1
%<HELP&V30&(A51|A25)>	#(For further information on bank switching,
%<HELP&V30&(A51|A25)>	#for now, see the separate hardcopy supplement on
%<HELP&V30&(A51|A25)>	#bank switching support.)
%<HELP>	#.($573)Fundamental Type Names
%<HELP>	#For chip architectures that are "Big Endian"
%<HELP>	#(8051, MCS251, 68HC11, 68HC05, COP8 and H8/500),
%<HELP>	#the following are the default type names:
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#"Big Endian" Fundamental Type Name Display Format
%<HELP>	#.sp 1
%<HELP>	#.ba {
%<HELP>	#Type Name  C Data Type     Size (Memory Layout)
%<HELP>	#---------  --------------  ------------------
%<HELP>	#\b(unknown)\r                  (see Unknown Data Type Size)
%<HELP>	#\b(untyped)\r                  (see Unknown Data Type Size)
%<HELP>	#\bbit\r        bit             1 bit
%<HELP>	#\bchar\r       char            1 byte
%<HELP>	#\buchar\r      unsigned char   1 byte
%<HELP>	#\bshort\r      short           2 bytes (MSB,LSB)
%<HELP>	#\brshort\r     short           2 bytes (LSB,MSB)
%<HELP>	#\bushort\r     unsigned short  2 bytes (MSB,LSB)
%<HELP>	#\brushort\r    unsigned short  2 bytes (LSB,MSB)
%<HELP>	#\bint\r        int             2 bytes (MSB,LSB)
%<HELP>	#\brint\r       int             2 bytes (LSB,MSB)
%<HELP>	#\buint\r       unsigned int    2 bytes (MSB,LSB)
%<HELP>	#\bruint\r      unsigned int    2 bytes (LSB,MSB)
%<HELP>	#\blong\r       long            4 bytes (MSW,LSW (each MSB,LSB))
%<HELP>	#\brlong\r      long            4 bytes (LSW,MSW (each LSB,MSB))
%<HELP>	#\bulong\r      unsigned long   4 bytes (MSW,LSW (each MSB,LSB))
%<HELP>	#\brulong\r     unsigned long   4 bytes (LSW,MSW (each LSB,MSB))
%<HELP>	#\bfloat\r      float           4 bytes (IEEE single-precision
%<HELP>	#                                    floating-point)
%<HELP>	#\brfloat\r     float           4 bytes (IEEE single-precision
%<HELP>	#                                    floating-point, bytes
%<HELP>	#                                    reversed in memory)
%<HELP>	#\bdouble\r     double          8 bytes (IEEE double-precision
%<HELP>	#                                    floating-point)
%<HELP>	#\brdouble\r    double          8 bytes (IEEE double-precision
%<HELP>	#                                    floating-point, bytes
%<HELP>	#                                    reversed in memory)
%<HELP>	#.ea }
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#For chip architectures that are "Little Endian"
%<HELP>	#(OKI nX65K and NEC K4),
%<HELP>	#the following are the default type names:
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#"Little Endian" Fundamental Type Name Display Format
%<HELP>	#.sp 1
%<HELP>	#.ba {
%<HELP>	#Type Name  C Data Type     Size (Memory Layout)
%<HELP>	#---------  --------------  ------------------
%<HELP>	#\b(unknown)\r                  (see Unknown Data Type Size)
%<HELP>	#\b(untyped)\r                  (see Unknown Data Type Size)
%<HELP>	#\bbit\r        bit             1 bit
%<HELP>	#\bchar\r       char            1 byte
%<HELP>	#\buchar\r      unsigned char   1 byte
%<HELP>	#\brshort\r     short           2 bytes (MSB,LSB)
%<HELP>	#\bshort\r      short           2 bytes (LSB,MSB)
%<HELP>	#\brushort\r    unsigned short  2 bytes (MSB,LSB)
%<HELP>	#\bushort\r     unsigned short  2 bytes (LSB,MSB)
%<HELP>	#\brint\r       int             2 bytes (MSB,LSB)
%<HELP>	#\bint\r        int             2 bytes (LSB,MSB)
%<HELP>	#\bruint\r      unsigned int    2 bytes (MSB,LSB)
%<HELP>	#\buint\r       unsigned int    2 bytes (LSB,MSB)
%<HELP>	#\brlong\r      long            4 bytes (MSW,LSW (each MSB,LSB))
%<HELP>	#\blong\r       long            4 bytes (LSW,MSW (each LSB,MSB))
%<HELP>	#\brulong\r     unsigned long   4 bytes (MSW,LSW (each MSB,LSB))
%<HELP>	#\bulong\r      unsigned long   4 bytes (LSW,MSW (each LSB,MSB))
%<HELP>	#\brfloat\r     float           4 bytes (IEEE single-precision
%<HELP>	#                                    floating-point)
%<HELP>	#\bfloat\r      float           4 bytes (IEEE single-precision
%<HELP>	#                                    floating-point, bytes
%<HELP>	#                                    reversed in memory)
%<HELP>	#\brdouble\r    double          8 bytes (IEEE double-precision
%<HELP>	#                                    floating-point)
%<HELP>	#\bdouble\r     double          8 bytes (IEEE double-precision
%<HELP>	#                                    floating-point, bytes
%<HELP>	#                                    reversed in memory)
%<HELP>	#.ea }
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#Note that all fundamental type names are reserved words.
%<HELP>	#.($574)Memory Space Constants
%<HELP>	#.ba {
%<HELP>				#Designator  Memory Space
%<HELP>				#----------  ---------------
%<HELP&A51>			#    C       Code
%<HELP&A51>			#    D       Direct Data
%<HELP&A51>			#    I       Indirect Data
%<HELP&A51>			#    X       External Data
%<HELP&A51>			#    B       Bit-addressable
%<HELP&A51>			#    N       (none/any)
%<HELP&A80>			#    C       Code
%<HELP&A80>			#    D       Direct Data
%<HELP&A80>			#    N       (none/any)
%<HELP&(A68|A05)>	#    C       Code (memory)
%<HELP&(A68|A05)>	#    N       (none/any)
%<HELP&A65>			#    C       Code (general)
%<HELP&A65>			#    D       Direct Data
%<HELP&A65>			#    B       Bit-addressable
%<HELP&A65>			#    N       (none/any)
%<HELP&A85>			#    C       Code (general)
%<HELP&A85>			#    B       Bit-address
%<HELP&A85>			#    N       (none/any)
%<HELP&A25>			#    C       Code (memory)
%<HELP&A25>			#    B       Bit-addressable
%<HELP&A25>			#    R       Register file
%<HELP&A25>			#    S       SFR
%<HELP&A25>			#    N       (none/any)
%<HELP&A78>			#    C       Code (general)
%<HELP&A78>			#    B       Bit-address
%<HELP&A78>			#    G       General register
%<HELP&A78>			#    N       (none/any)
%<HELP>	#.ea }
%<HELP&A51>	#.($575)MOVX Mode
%<HELP&A51>	#The \bMOVX^Mode\r command allows you to control the "visibility"
%<HELP&A51>	#of MOVX instructions in/to your target system.
%<HELP&A51>	#.sp 1
%<HELP&A51>	#Currently, this command is available and required only when using
%<HELP&A51>	#the \uPhilips PCx509x\r probe card.
%<HELP&A51>	#.($576)MOVX Mode | AUX-RAM + Emulator XDATA
%<HELP&A51>	#The \bAUX-RAM^+^Emulator^XDATA\r command provides the following
%<HELP&A51>	#hardware environment for your application program:
%<HELP&A51>	#.sp 1
%<HELP&A51>	#.in +2 {
%<HELP&A51>	#.in +4 {
%<HELP&A51>	#.ti -4
%<HELP&A51>	#1)^^The host software will \bforce\r the AUX-RAM memory range in
%<HELP&A51>	#the XDATA memory space to be mapped to the target system.
%<HELP&A51>	#This is just a requirement of the emulator hardware:
%<HELP&A51>	#When your program references an XDATA memory address in the
%<HELP&A51>	#AUX-RAM memory range,  the actual memory location used will be
%<HELP&A51>	#.sp 1
%<HELP&A51>	#.in +2 {
%<HELP&A51>	#.in +4 {
%<HELP&A51>	#.ti -4
%<HELP&A51>	#a.^^the on-chip AUX-RAM location
%<HELP&A51>	#(if your program enables the AUX-RAM during execution), or
%<HELP&A51>	#.ti -4
%<HELP&A51>	#b.^^the XDATA location in the emulator base unit
%<HELP&A51>	#(if your program does not enable the AUX-RAM during execution).
%<HELP&A51>	#.in -4 }
%<HELP&A51>	#.in -2 }
%<HELP&A51>	#.sp 1
%<HELP&A51>	#.ti -4
%<HELP&A51>	#2)^^The host software will \bforce\r the remainder of memory in the
%<HELP&A51>	#XDATA memory space to be mapped to the emulator base unit.
%<HELP&A51>	#You cannot access any actual XDATA memory locations in your
%<HELP&A51>	#target system.
%<HELP&A51>	#.sp 1
%<HELP&A51>	#.ti -4
%<HELP&A51>	#3)^^If you have selected a \l($6)ROM^mode\m of operation, P0 and P2
%<HELP&A51>	#remain ports, except when the referenced address is greater than
%<HELP&A51>	#the ROM code rollover boundary.
%<HELP&A51>	#.in -4 }
%<HELP&A51>	#.in -2 }
%<HELP&A51>	#.($577)MOVX Mode | AUX-RAM + Mapped XDATA
%<HELP&A51>	#The \bAUX-RAM^+^Mapped^XDATA\r command provides the following
%<HELP&A51>	#hardware environment for your application program:
%<HELP&A51>	#.sp 1
%<HELP&A51>	#.in +2 {
%<HELP&A51>	#.in +4 {
%<HELP&A51>	#.ti -4
%<HELP&A51>	#1)^^The host software will \bforce\r the AUX-RAM memory range in
%<HELP&A51>	#the XDATA memory space to be mapped to the target system.
%<HELP&A51>	#This is just a requirement of the emulator hardware:
%<HELP&A51>	#When your program references an XDATA memory address in the
%<HELP&A51>	#AUX-RAM memory range,  the actual memory location used will be
%<HELP&A51>	#.sp 1
%<HELP&A51>	#.in +2 {
%<HELP&A51>	#.in +4 {
%<HELP&A51>	#.ti -4
%<HELP&A51>	#a.^^the on-chip AUX-RAM location
%<HELP&A51>	#(if your program enables the AUX-RAM during execution), or
%<HELP&A51>	#.ti -4
%<HELP&A51>	#b.^^the XDATA location in your target system
%<HELP&A51>	#(if your program does not enable the AUX-RAM during execution).
%<HELP&A51>	#.in -4 }
%<HELP&A51>	#.in -2 }
%<HELP&A51>	#.sp 1
%<HELP&A51>	#.ti -4
%<HELP&A51>	#2)^^You can map the remainder of memory in the
%<HELP&A51>	#XDATA memory space to your target system or to the emulator base
%<HELP&A51>	#unit, as desired.
%<HELP&A51>	#.sp 1
%<HELP&A51>	#.ti -4
%<HELP&A51>	#3)^^Dynamic switching of AUX-RAM (enabled vs. disabled)
%<HELP&A51>	#during program execution is allowed only if you map the remainder
%<HELP&A51>	#of memory in the XDATA memory space to your target system
%<HELP&A51>	#(see 2 above).
%<HELP&A51>	#.sp 1
%<HELP&A51>	#.ti -4
%<HELP&A51>	#4)^^If you have selected a \l($6)ROM^mode\m of operation, P0 and P2
%<HELP&A51>	#are active as address/data bus during MOVX cycles and when
%<HELP&A51>	#the referenced address is greater than
%<HELP&A51>	#the ROM code rollover boundary.
%<HELP&A51>	#.in -4 }
%<HELP&A51>	#.in -2 }
%<HELP&A51>	#.($578)MOVX Mode | No AUX-RAM + Mapped XDATA
%<HELP&A51>	#The \bNo^AUX-RAM^+^Mapped^XDATA\r command provides a
%<HELP&A51>	#hardware environment identical to
%<HELP&A51>	#\l($577)AUX-RAM^+^Mapped^XDATA\m
%<HELP&A51>	#for your application program, with the following exception:
%<HELP&A51>	#.sp 1
%<HELP&A51>	#.in +2 {
%<HELP&A51>	#The host software will \bnot\r force the AUX-RAM memory range in
%<HELP&A51>	#the XDATA memory space to be mapped to the target system.
%<HELP&A51>	#If your program enables the on-chip AUX-RAM and the AUX-RAM
%<HELP&A51>	#memory range is mapped to the emulator base unit, then a reference
%<HELP&A51>	#to an XDATA memory address in the AUX-RAM memory range will be
%<HELP&A51>	#directed to the XDATA memory in the emulator base unit, \bnot\r
%<HELP&A51>	#to the on-chip AUX-RAM.
%<HELP&A51>	#.in -2 }
%<HELP>	#.(End_Help_File)
%<HELP&(V21|V22)>	#.mi
%<HELP&(V21|V22)>	#Probe Card Operating Test
%<HELP&(V21|V22)>	#.sp 1
%<HELP&(V21|V22)>	#.in +2 {
%<HELP&(V21|V22)>	#When the Host Software establishes communication
%<HELP&(V21|V22)>	#with the emulator a test is run to determine if
%<HELP&(V21|V22)>	#the probe card is operating.  If it is not, the
%<HELP&(V21|V22)>	#following message is displayed:
%<HELP&(V21|V22)>	#.sp 1
%<HELP&(V21|V22)>	#.in +2
%<HELP&(V21|V22)>	#.ba
%<HELP&(V21|V22)>	#Probe not operating -- check Help for possible causes
%<HELP&(V21|V22)>	#.ea
%<HELP&(V21|V22)>	#.in -2
%<HELP&(V21|V22)>	#.sp 1
%<HELP&(V21|V22)>	#Some of the possible causes are:
%<HELP&(V21|V22)>	#.sp 1
%<HELP&(V21|V22)>	#.in +2
%<HELP&(V21|V22)>	#.ba
%<HELP&(V21|V22)>	#Probe card in target system, P2.0 tied to VCC
%<HELP&(V21|V22)>	#Probe card not in target system, P2.0 tied to VCC
%<HELP&(V21|V22)>	#.ea
%<HELP&(V21|V22)>	#.in -2
%<HELP&(V21|V22)>	#.in -2 }
%<HELP&(!V20)>	#.mi
%<HELP&(!V20)>	#MISCELLANEOUS
%<HELP&(!V20)>	#.sp 1
%<HELP&(!V20)>	#The format of the displayed real-time emulation clock
%<HELP&(!V20)>	#value ("Execution Time:") can be controlled somewhat
%<HELP&(!V20)>	#by the A43 directive in the model file ($MODEL).  The
%<HELP&(!V20)>	#character specified there will be used as the separator
%<HELP&(!V20)>	#between every 3rd digit in the "Execution Time:" value.
%<HELP&(!V20)>	#That same directive controls the format of
%<HELP&(!V20)>	#the "Execution Time:" value and the sample counts
%<HELP&(!V20)>	#in the Performance Analyzer Display menu.
%<HELP&(!V20)>	#The default value for this separator character
%<HELP&(!V20)>	#is a comma (',').
%<HELP&(!V12)>	#.mi
%<HELP&(!V12)>	#MISCELLANEOUS
%<HELP&(!V12)>	#.sp 1
%<HELP&(!V12)>	#The format of the displayed real-time emulation clock ("Time:")
%<HELP&(!V12)>	#and sample count values can be controlled somewhat
%<HELP&(!V12)>	#by the A43 directive in the model file ($MODEL).  The
%<HELP&(!V12)>	#character specified there will be used as the separator
%<HELP&(!V12)>	#between every 3rd digit in the "Time:" and sample count values.
%<HELP&(!V12)>	#The default value for this separator character
%<HELP&(!V12)>	#is a comma (',').
%<HELP&V21>	#.co = = = = = = = = = = = = = = = = = = = = = = = = = = = = = = PROM-Programmer Menu
%<HELP>	#.(End_Help_File)
