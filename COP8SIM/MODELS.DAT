%<HELP&A85>	#Qk^body^^^^Non-SR-bit values (in top 2 lines of window).
%<HELP&A25>	#Qk^body^^^^SPX, DPX, PC values (left side of 1st window line).
%<HELP&A78>	#Qk^body^^^^SP, PSW values (left side of 1st window line).
%<HELP>	#.ti -11
%<HELP&A51>	#Hk^body^^^^PSW bit values (right side of 1st window line).
%<HELP&A68>	#Hk^body^^^^CCR bit values (right side of 1st window line).
