%<HELP&A25>	#\l($545)OKI^nX65K\m^
%<HELP&A78>	#\l($552)NEC^K4\m^
%<HELP&A78>	#.sp 1
%<HELP&A78>	#\l($551)Intel^MCS251\m^
%<HELP&A78>	#.sp 1
%<HELP&A78>	#\l($351)8051^(MCS51)^&^Dallas^HSM\m^
%<HELP&A78>	#.sp 1
%<HELP&A78>	#\l($546)Hitachi^H8/500\m^
%<HELP&A78>	#.sp 1
%<HELP&A78>	#\l($544)Motorola^68HC05\m^
%<HELP&A78>	#.sp 1
%<HELP&A78>	#\l($543)Motorola^68HC11\m^
%<HELP&A78>	#.sp 1
%<HELP&A78>	#\l($542)National^COP8\m^
%<HELP&A78>	#.sp 1
%<HELP&A78>	#\l($545)OKI^nX65K\m^
%<HELP>	#.in -2 }
%<HELP&DEM>	#.($350)Description of Demo
%<HELP&SIM>	#.($350)Description of Simulator
%<HELP>	#The
%<HELP&DEM>	#ICEDEMO.EXE
%<HELP&SIM>	#ICESIM.EXE
%<HELP>	#program (the program you are now using)
%<HELP>	#is a
%<HELP&DEM>	#demonstration
%<HELP&SIM>	#simulator
%<HELP>	#version of the host PC
%<HELP>	#software package with which you would interact to control a "real"
%<HELP>	#%rs2 \b%rs1\r emulator.  Rather than "talking to" an emulator
%<HELP>	#base unit, however, this
%<HELP&DEM>	#demo
%<HELP&SIM>	#simulator
%<HELP>	#version of the host software contains
%<HELP>	#within it software modules which mimic (simulate) the behavior
%<HELP>	#of a true \b%rs1\r hardware emulator base unit and
%<HELP>	#probe card.  Also bundled in is an instruction set simulator
%<HELP>	#for the %rs4 CPU architecture.
%<HELP>	#.sp 1
%<HELP>	#This
%<HELP&DEM>	#demo
%<HELP&DEM>	#simulator
%<HELP>	#version of the host software has the following properties:
%<HELP>	#.sp 1
%<HELP>	#.in +4 {
%<HELP>	#.in +3 {
%<HELP>	#.ti -3
%<HELP>	#*^^The emulator supported is an
%<HELP&A51>	#\b%rs1-%rs5 Model 400\r emulator
%<HELP&A51>	#with 64Kb of Code memory and 64Kb of External Data memory.
%<HELP&A68>	#\b%rs1-%rs5 Model 400\r emulator
%<HELP&A68>	#with 64Kb of Code memory.
%<HELP&A80>	#\b%rs1-%rs5 Model 400\r emulator
%<HELP&A80>	#with 32Kb of Code memory and 4K frames of Trace memory.
%<HELP&A05>	#\b%rs1-%rs5 Model 400\r emulator
%<HELP&A05>	#with 32Kb of Code memory.
%<HELP&A65>	#\b%rs1-%rs5\r emulator
%<HELP&A65>	#with 64Kb of General Memory.
%<HELP&A85>	#\b%rs1-%rs5\r emulator
%<HELP&A85>	#with 1Mb of emulation memory and 16Mb of target memory.
%<HELP&A25>	#\b%rs1-%rs5\r emulator
%<HELP&A25>	#with 256Kb of memory.
%<HELP&A78>	#\b%rs1-%rs5\r emulator
%<HELP&A78>	#with 256Kb of memory.
%<HELP&DEM>	#However, see below for restrictions on the
%<HELP&DEM>	#use of this memory.
%<HELP&DEM>	#The probe card supported is that for
%<HELP&DEM&A51>	#an 8052.
%<HELP&DEM&A68>	#a 68HC11A0.
%<HELP&DEM&A80>	#a COP888CG.
%<HELP&DEM&A05>	#a 68HC05C8.
%<HELP&DEM&A65>	#an MSM65524.
%<HELP&DEM&A85>	#an H8/532.
%<HELP&DEM&A25>	#an 8XC251SB.
%<HELP&DEM&A78>	#a \xE6PD784026.
%<HELP&(A51|A68|A05)>	#.sp 1
%<HELP&(A51|A68|A05)>	#.in +4 {
%<HELP&(A51|A68|A05)>	#.ti -4
%<HELP&(A51|A68|A05)>	#a)^^If you would like to see how the \b%rs1 Model 200\r
%<HELP&(A51|A68|A05)>	#emulator operates, reinvoke the
%<HELP&(A51|A68|A05)>	#host software by typing the following at the DOS
%<HELP&(A51|A68|A05)>	#command prompt:
%<HELP&(A51|A68|A05)>	#.sp 1
%<HELP&(A51|A68|A05)>	#.in +4 {
%<HELP&DEM&(A51|A68|A05)>	#ICEDEMO -ty200
%<HELP&SIM&(A51|A68|A05)>	#ICESIM -ty200
%<HELP&(A51|A68|A05)>	#.in -4 }
%<HELP&(A51|A68|A05)>	#.in -4 }
%<HELP&A51>				#.sp 1
%<HELP&A51>				#.in +4 {
%<HELP&A51>				#.ti -4
%<HELP&A51>				#b)^^If you would like to see how the \b%rs1-PE\r
%<HELP&A51>				#emulator operates, reinvoke the
%<HELP&A51>				#host software by typing the following at the DOS
%<HELP&A51>				#command prompt:
%<HELP&A51>				#.sp 1
%<HELP&A51>				#.in +4 {
%<HELP&DEM&A51>				#ICEDEMO -type
%<HELP&SIM&A51>				#ICESIM -type
%<HELP&A51>				#.in -4 }
%<HELP&A51>				#.sp 1
%<HELP&A51>				#Note that when you invoke the
%<HELP&A51>				#\l($430)Misc|Emulator^Self-Test\m command,
%<HELP&A51>				#it will alternately report "pass", then "fail".
%<HELP&A51>				#See the description of the \l($249)-type\m
%<HELP&A51>				#Command Line Option for other differences
%<HELP&A51>				#between the
%<HELP&DEM&A51>			#demo
%<HELP&SIM&A51>			#simulator
%<HELP&A51>				#version and the actual hardware
%<HELP&A51>				#emulator.
%<HELP&A51>				#.in -4 }
%<HELP&(A80)>	#.sp 1
%<HELP&(A80)>	#.in +4 {
%<HELP&(A80)>	#.ti -4
%<HELP&(A80)>	#1)^^If you would like to see how
%<HELP&(A80)>	#the \b%rs1^Debug^Module\r
%<HELP&(A80)>	#operates, first re-run MF_GEN to generate a $MODEL file
%<HELP&(A80)>	#for the desired Debug Module configuration
%<HELP&(A80)>	#(COP8 device) by typing the following at the DOS
%<HELP&(A80)>	#command prompt:
%<HELP&(A80)>	#.sp 1
%<HELP&(A80)>	#.in +4 {
%<HELP&(A80)>	#MF_GEN
%<HELP&(A80)>	#.in -4 }
%<HELP&(A80)>	#.sp 1
%<HELP&(A80)>	#Then, delete the current $CONFIG file by typing
%<HELP&(A80)>	#.sp 1
%<HELP&(A80)>	#.in +4 {
%<HELP&(A80)>	#DEL $CONFIG
%<HELP&(A80)>	#.in -4 }
%<HELP&(A80)>	#.sp 1
%<HELP&(A80)>	#Finally, reinvoke the
%<HELP&(A80)>	#host software by typing the following at the DOS
%<HELP&(A80)>	#command prompt:
%<HELP&(A80)>	#.sp 1
%<HELP&(A80)>	#.in +4 {
%<HELP&DEM&(A80)>	#ICEDEMO -tyudm
%<HELP&SIM&(A80)>	#ICESIM -tyudm
%<HELP&(A80)>	#.in -4 }
%<HELP&(A80)>	#.sp 1
%<HELP&(A80)>	#When simulating the \b%rs1^Debug^Module\r, be aware of the
%<HELP&(A80)>	#following:
%<HELP&(A80)>	#.sp 1
%<HELP&(A80)>	#.in +4 {
%<HELP&(A80)>	#.ti -4
%<HELP&(A80)>	#1)^^The \l($462)PROM^Programmer^Menu\m is available, but you
%<HELP&(A80)>	#cannot actually program any COP8 devices.  However, all
%<HELP&(A80)>	#commands within the PROM Programmer Menu will operate as if
%<HELP&(A80)>	#a device were actually being programmed.
%<HELP&(A80)>	#.in -4 }
%<HELP&(A80)>	#.in -4 }
%<HELP>	#.sp 1
%<HELP>	#.ti -3
%<HELP>	#*^^Since
%<HELP&DEM>	#ICEDEMO.EXE
%<HELP&SIM>	#ICESIM.EXE
%<HELP>	#contains within it modules which mimic
%<HELP>	#the behavior of the emulator hardware, probe card and %rs4 CPU,
%<HELP&DEM>	#ICEDEMO.EXE
%<HELP&SIM>	#ICESIM.EXE
%<HELP>	#consumes quite a bit more memory in the PC than the
%<HELP&DEM>	#non-demo
%<HELP&SIM>	#non-simulator
%<HELP>	#version of the host software.  This may constrain the size
%<HELP>	#of programs (e.g., total number of symbols) that can be loaded
%<HELP>	#into the
%<HELP&DEM>	#demo emulator.
%<HELP&SIM>	#simulator.
%<HELP>	#.sp 1
%<HELP>	#.ti -3
%<HELP>	#*^^External events and interrupts (e.g., timer interrupts) are not
%<HELP>	#simulated/supported.  Access to a port is treated as an access to the
%<HELP>	#port register, not the port pins.
%<HELP&A51>	#P0 and P2 are not used when accessing external memory.
%<HELP>	#Timers act as simple registers
%<HELP>	#(i.e., they do not count automatically).  Basically, the "chip"
%<HELP>	#simulator built into this system simulates the %rs4
%<HELP>	#CPU \uinstruction^set\r, but does not simulate
%<HELP>	#any \uperipheral^functions\r of the
%<HELP&SIM>		#%rs4
%<HELP&DEM&A51>	#8052
%<HELP&DEM&A68>	#68HC11A0
%<HELP&DEM&A80>	#COP888CG
%<HELP&DEM&A05>	#68HC05C8
%<HELP&DEM&A65>	#MSM65524
%<HELP&DEM&A85>	#H8/532
%<HELP&DEM&A25>	#8XC251SB
%<HELP&DEM&A78>	#\xE6PD784026
%<HELP>	#chip.
%<HELP>	#.sp 1
%<HELP>	#.ti -3
%<HELP>	#*^^When this
%<HELP&DEM>	#"demo emulator"
%<HELP&SIM>	#"emulator simulator"
%<HELP>	#is placed into emulation
%<HELP>	#(as if executing code in the
%<HELP&SIM>		#%rs4
%<HELP&DEM&A51>	#8052
%<HELP&DEM&A68>	#68HC11A0
%<HELP&DEM&A80>	#COP888CG
%<HELP&DEM&A05>	#68HC05C8
%<HELP&DEM&A65>	#MSM65524
%<HELP&DEM&A85>	#H8/532
%<HELP&DEM&A25>	#8XC251SB
%<HELP&DEM&A78>	#\xE6PD784026
%<HELP>	#processor), the execution time reported
%<HELP&DEM&!A78    >	#will be the same as a
%<HELP&DEM&!A78&A51>	#12MHz 8052
%<HELP&DEM&!A78&A68>	#3.3MHz E-Clock (13.2MHz XTAL) 68HC11A0
%<HELP&DEM&!A78&A80>	#10MHz COP888CG
%<HELP&DEM&!A78&A05>	#8MHz 68HC05C8
%<HELP&DEM&!A78&A65>	#10MHz MSM65524
%<HELP&DEM&!A78&A85>	#10MHz H8/532
%<HELP&DEM&!A78&A25>	#16MHz 8XC251SB
%<HELP&SIM&!A78    >	#will be the same as a
%<HELP&SIM&!A78&A51>	#12MHz %rs4
%<HELP&SIM&!A78&A68>	#3.3MHz %rs4
%<HELP&SIM&!A78&A80>	#10MHz %rs4
%<HELP&SIM&!A78&A05>	#8MHz %rs4
%<HELP&SIM&!A78&A65>	#10MHz %rs4
%<HELP&SIM&!A78&A85>	#10MHz %rs4
%<HELP&SIM&!A78&A25>	#16MHz %rs4
%<HELP&!A78    >	#executing the same code.
%<HELP& A78    >	#is determined from the number of bytes in each
%<HELP& A78    >	#instruction (each byte is one microsecond).
%<HELP>	#However, since the execution of
%<HELP>	#each instruction is actually being simulated in software, the elapsed
%<HELP>	#wall clock time will be significantly greater than the
%<HELP>	#execution time displayed in the Status Window.
%<HELP>	#.sp 1
%<HELP>	#.ti -3
%<HELP>	#*^^The sampling rate of the Performance Analyzer is much lower
%<HELP>	#than that in an actual \b%rs1\r emulator hardware base unit.  Again,
%<HELP>	#this is because the execution of each %rs4
%<HELP>	#instruction is being simulated in software.
%<HELP>	#.sp 1
%<HELP>	#.ti -3
%<HELP>	#*^^When beginning execution from the RESET condition,
%<HELP>	#you should select the
%<HELP&A51>	#\l($97)Run|Reset|Emulator\m
%<HELP&A68>	#\l($97)Run|Reset|Normal|Emulator\m
%<HELP&A80>	#\l($97)Run|Reset|Emulator\m
%<HELP&A05>	#\l($97)Run|Reset|Emulator\m
%<HELP&A65>	#\l($97)Run|Reset|Emulator\m
%<HELP&A85>	#\l($97)Run|Reset|Emulator\m
%<HELP&A25>	#\l($97)Run|Reset|Emulator\m
%<HELP&A78>	#\l($97)Run|Reset|Emulator\m
%<HELP>	#command.
%<HELP>	#.sp 1
%<HELP>	#.ti -3
%<HELP>	#*^^The \l($356)Probe^Bit\m values captured in the Trace Buffer are
%<HELP>	#from a simple
%<HELP&( (V30))>	#8-bit
%<HELP&(!(V30))>	#7-bit
%<HELP>	#counter.
%<HELP>	#All other captured values (e.g., address and data) accurately reflect
%<HELP>	#the execution flow within the simulated %rs4 CPU.
%<HELP&(A85|A25)>	#However, see the later note about differences in the
%<HELP&(A85|A25)>	#details of the Raw Mode Trace display.
%<HELP&DEM>	#.sp 1
%<HELP&DEM>	#.ti -3
%<HELP&DEM>	#*^^This demo version of the emulator simulator constrains the size of
%<HELP&DEM>	#programs which can be \l($86)File|Load\med
%<HELP&DEM>	#or \l($115)Display/Alter|Asm/Dasm|Assemble\md into the demo emulator:
%<HELP&DEM>	#.sp 1
%<HELP&DEM>	#.in +4 {
%<HELP&DEM>	#Only
%<HELP&DEM&(!A65)>	#code memory
%<HELP&DEM&( A65)>	#General Memory
%<HELP&DEM>	#locations
%<HELP&DEM&A51>	#0000h-022Dh (557 decimal bytes)
%<HELP&DEM&A68>	#0000h-00FFh (default RAM),
%<HELP&DEM&A68>	#0500h-05FFh,
%<HELP&DEM&A68>	#1000h-103Fh (default Registers),
%<HELP&DEM&A68>	#BFC0h-BFFFh (Special Modes Reset Vector) and
%<HELP&DEM&A68>	#FEF0h-FFFFh (program and interrupt vectors -- 272 decimal bytes)
%<HELP&DEM&A80>	#0000h-0055h (86 decimal bytes)
%<HELP&DEM&A05>	#0000h-001Fh (I/O Registers),
%<HELP&DEM&A05>	#0050h-00FFh (RAM and Stack),
%<HELP&DEM&A05>	#0160h-01A9h (program),
%<HELP&DEM&A05>	#1000h-10FFh,
%<HELP&DEM&A05>	#1FF4h-1FFFh (program and interrupt vectors -- 272 decimal bytes)
%<HELP&DEM&A65>	#0000h-024Fh (592 decimal bytes)
%<HELP&DEM&A85>	#00000h-1FFFFh (128K bytes)
%<HELP&DEM&A25>	#000000h-00041Fh (Register Banks, On-chip RAM)
%<HELP&DEM&A25>	#010000h-0100FFh (Data Memory)
%<HELP&DEM&A25>	#FF0000h-FF0FFFh (Code Memory)
%<HELP&DEM&A78>	#000000h-0FFFFFh
%<HELP&DEM>	#can be loaded (initialized with code stream bytes).
%<HELP&DEM>	#.in -4 }
%<HELP&(A51|A68|V30)>	#.sp 1
%<HELP&(A51|A68|V30)>	#.ti -3
%<HELP&(A51|A68|V30)>	#*^^Requests to map memory
%<HELP&(A51        )>	#(Code or External Data)
%<HELP&(A51|A68|V30)>	#to your target system effectively are ignored.
%<HELP&(A51|A68|V30)>	#However, the software will report that the
%<HELP&(A51|A68|V30)>	#requested block of memory has been mapped (assigned)
%<HELP&(A51|A68|V30)>	#successfully to your target system.
%<HELP&(A51|A68    )>	#It is recommended that all memory be mapped to the
%<HELP&(A51|A68    )>	#emulator as access to memory mapped external may be
%<HELP&(A51|A68    )>	#much slower.
%<HELP&V30>	#.sp 1
%<HELP&V30>	#.ti -3
%<HELP&V30>	#*^^When you invoke the
%<HELP&V30>	#\l($430)Misc|Emulator^Self-Test\m command,
%<HELP&V30>	#it will alternately report "pass", then "fail".
%<HELP&V30>	#.sp 1
%<HELP&V30>	#.ti -3
%<HELP&V30>	#*^^When you view the \l($432)transparent^trace\m during emulation,
%<HELP&V30>	#the chip simulator stops simulating instructions until
%<HELP&V30>	#you return back to the Main Screen from the View Trace Menu.
%<HELP&V30>	#The actual hardware emulator continues full-speed real-time
%<HELP&V30>	#emulation while you are viewing a snapshot of the transparent
%<HELP&V30>	#trace memory during emulation.
%<HELP&V30>	#.sp 1
%<HELP&V30>	#.ti -3
%<HELP&V30>	#*^^The only Break-/Trace-Point types supported are:
%<HELP&V30>	#\l($162)Code^Break-Points\m,
%<HELP&V30>	#\l($164)Trace-On-Points\m and
%<HELP&V30>	#\l($165)Trace-Off-Points\m.
%<HELP&(A85|A25|A78)>	#.sp 1
%<HELP&(A85|A25|A78)>	#.ti -3
%<HELP&(A85|A25|A78)>	#*^^The \l($211)Raw^Mode^Trace\m display is somewhat
%<HELP&(A85|A25|A78)>	#different than that for a real emulator:
%<HELP&(A85|A25|A78)>	#.in +2 {
%<HELP&(A85|A25|A78)>	#.in +4 {
%<HELP&(A85|A25|A78)>	#.sp 1
%<HELP&(A85|A25|A78)>	#.ti -4
%<HELP&(A85|A25|A78)>	#a.^^There are never any "(fbne)" (Fetched, But Not
%<HELP&(A85|A25|A78)>	#Executed) bytes.  These are associated with instruction
%<HELP&(A85|A25|A78)>	#queue flushes in the CPU.
%<HELP&(A85|A25|A78)>	#.sp 1
%<HELP&(A85|A25|A78)>	#.ti -4
%<HELP&(A85|A25|A78)>	#b.^^The first byte of an instruction always starts in a new
%<HELP&(A85|A25|A78)>	#trace frame (i.e., never in the 2nd byte of a 16-bit
%<HELP&(A85|A25|A78)>	#access).
%<HELP&(A85|A25|A78)>	#.sp 1
%<HELP&(A85|A25|A78)>	#.ti -4
%<HELP&(A85|A25|A78)>	#c.^^Every 3rd instruction, the simulator outputs a
%<HELP&(A85|A25|A78)>	#non-code-prefetch frame (just for some variability in the
%<HELP&(A85|A25|A78)>	#Raw Mode display).  The number of bytes in this frame is
%<HELP&(A85|A25|A78)>	#dependent on the current PC value (8 bits if even, 16 bits
%<HELP&(A85|A25|A78)>	#if odd).  The frame alternates between R/W (Read/Write)
%<HELP&(A85|A25|A78)>	#and E/T (emulator memory access vs. target system memory
%<HELP&(A85|A25|A78)>	#access).
%<HELP&(A85|A25|A78)>	#.sp 1
%<HELP&(A85|A25|A78)>	#.ti -4
%<HELP&(A85|A25|A78)>	#d.^^There are never any true data frames (non-code-prefetch
%<HELP&(A85|A25|A78)>	#frames) associated with an instruction
%<HELP&(A85        )>	#(e.g., STM)
%<HELP&(    A25    )>	#(e.g., MOVX)
%<HELP&(A85|A25|A78)>	#as there would be with a real emulator.
%<HELP&(A85|A25|A78)>	#.in -4 }
%<HELP&(A85|A25|A78)>	#.in -2 }
%<HELP&A85>	#.sp 1
%<HELP&A85>	#.ti -3
%<HELP&A85>	#*^^The MDCR (Mode Control Register) is protected against any kind
%<HELP&A85>	#of writing, except implicitly through the
%<HELP&A85>	#\l($5)Configure|Emulator|Execute\m command.
%<HELP&A85>	#You cannot "accidentally" change the operating mode
%<HELP&A85>	#(Minimum vs. Maximum) in the simulator.
%<HELP>	#.in -3 }
%<HELP>	#.in -4 }
%<HELP&SIM>	#.sp 1
%<HELP&SIM>	#Also see the README.DOC file for a description of the system
%<HELP&SIM>	#and example files.
%<HELP&DEM>	#.sp 1
%<HELP&DEM&A51>	#We have included four simple demo programs which can be loaded
%<HELP&DEM&A51>	#into the
%<HELP&DEM&DEM&A51>	#demo emulator
%<HELP&DEM&SIM&A51>	#emulator simulator
%<HELP&DEM&A51>	#system.  The first three programs are
%<HELP&DEM&A51>	#based on a simple scheme of outputting a pulse train on
%<HELP&DEM&A51>	#Port 1, Pin 0 (P1.0) and the other is used for the demo
%<HELP&DEM&A51>	#emulation session to show various features of the host software:
%<HELP&DEM&A51>	#.sp 1
%<HELP&DEM&A51>	#.in +4 {
%<HELP&DEM&A51>	#.in +13 {
%<HELP&DEM&A51>	#.ti -13
%<HELP&DEM&A51>	#DEMO.DBG^^^^^%rs2 ASM51 8051 Macro Cross Assembler version
%<HELP&DEM&A51>	#.ti -13
%<HELP&DEM&A51>	#A_DEMO.AOM^^^Archimedes/IAR C Compiler version
%<HELP&DEM&A51>	#.ti -13
%<HELP&DEM&A51>	#F_DEMO.AOM^^^Franklin/Keil C Compiler version
%<HELP&DEM&A51>	#.ti -13
%<HELP&DEM&A51>	#TD51.AOM^^^^^Franklin/Keil C Compiler version
%<HELP&DEM&A51>	#.in -13 }
%<HELP&DEM&A51>	#.in -4 }
%<HELP&DEM&A68>	#We have included two simple demo programs which can be loaded
%<HELP&DEM&A68>	#into the
%<HELP&DEM&DEM&A68>	#demo emulator
%<HELP&DEM&SIM&A68>	#emulator simulator
%<HELP&DEM&A68>	#system.  Both programs are based on a simple
%<HELP&DEM&A68>	#scheme of outputting a pulse train on Port D, Pin 0 (PD0):
