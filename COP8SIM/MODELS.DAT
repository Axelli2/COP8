%<HELP&DEM&A68>	#DEMO_H11.AOM^^Assembly Language version
%<HELP&DEM&A68>	#.ti -14
%<HELP&DEM&A68>	#H_DEMO.AOM^^^^Archimedes/IAR C Compiler version
%<HELP&DEM&A68>	#.in -14 }
%<HELP&DEM&A68>	#.in -4 }
%<HELP&DEM&A80>	#We have included two simple demo programs which can be loaded
