%<HELP&DEM>	#.sp 1
%<HELP&DEM>	#Or, at the DOS command prompt, just type:
%<HELP&DEM>	#.sp 1
%<HELP&DEM>	#.in +4 {
%<HELP&DEM>	#ICEDEMO
%<HELP&DEM>	#.in -4 }
%<HELP&DEM>	#.sp 1
%<HELP&DEM>	#and then use the \l($86)File|Load\m command to load a program
%<HELP&DEM>	#file into the demo emulator.
%<HELP&DEM>	#.sp 1
%<HELP&DEM>	#Feel free to run your own programs using the demo emulator system,
%<HELP&DEM>	#keeping in mind the constraints mentioned at the beginning of this
%<HELP&DEM>	#Help Topic
%<HELP&DEM>	#(e.g., limited access to
%<HELP&DEM&(!A65)>	#code
%<HELP&DEM&( A65)>	#general
%<HELP&DEM>	#memory and no external events).
%<HELP>	#.($351)Catalog of iceMASTER 8051 Products
%<HELP>	#.sp 1
%<HELP>	#.in +3 {
%<HELP>	#.ti -3
%<HELP>	#\b%rs1-8051 Modular Emulator:\r
%<HELP>	#.sp 1
%<HELP>	#The %rs2 \b%rs1-8051 Modular\r emulator consists of an
%<HELP>	#8051-architecture-specific emulator base unit,
%<HELP>	#attached to a small probe card (pod) via an umbilical cable.
%<HELP>	#The probe card, which contains the device being emulated,
%<HELP>	#inserts into the socket for the device in your target
%<HELP>	#development system.  Many probe cards are available, supporting a
%<HELP>	#wide variety of 8051
%<HELP>	#CMOS, NMOS, ROM, EPROM or ROMless devices.
%<HELP>	#The emulator base unit connects to the
%<HELP>	#host PC (personal computer) via a standard RS-232-C serial
%<HELP>	#communications link operating at 115.2K baud.
%<HELP>	#.sp 1
%<HELP>	#The \b%rs1-8051 Modular\r emulator is a
%<HELP>	#high-performance, full-featured, economical,
%<HELP>	#small profile/footprint emulator supporting
%<HELP>	#full probe card interchangeability.
%<HELP>	#.sp 1
%<HELP>	#.ti -3
%<HELP>	#\b%rs1-PE Integrated Emulator:\r
%<HELP>	#.sp 1
%<HELP>	#The %rs2 \b%rs1-PE Integrated\r emulator consists of
%<HELP>	#a single unit containing both
%<HELP>	#the emulator base electronics and the probe card (pod) electronics.
%<HELP>	#The entire unit (about the size of a PC mouse),
%<HELP>	#inserts into the socket for the device in your target
%<HELP>	#development system.
%<HELP>	#\b%rs1-PE Integrated\r emulators are available for a limited number of
%<HELP>	#8051 family derivative devices.
%<HELP>	#The emulator unit connects to the
%<HELP>	#host PC via a standard RS-232-C serial
%<HELP>	#communications link operating at 57.6K baud.
%<HELP>	#.sp 1
%<HELP>	#The \b%rs1-PE Integrated\r emulators are
%<HELP>	#high-performance, full-featured, economical,
%<HELP>	#tiny profile/footprint emulators;  each
%<HELP>	#emulator is \udedicated\r to a particular 8051 family derivative
%<HELP>	#device.
%<HELP>	#.sp 1
%<HELP>	#.ti -3
%<HELP>	#\b%rs1-HSM Modular Emulator\r:
%<HELP>	#.sp 1
%<HELP>	#The %rs2 \b%rs1-HSM Modular\r emulator supports the
%<HELP>	#Dallas Semiconductor HSM (High Speed Micro) family of 8051-compatible
%<HELP>	#devices.
%<HELP>	#The \b%rs1-HSM Modular\r emulator consists of a small
%<HELP>	#emulator base unit,
%<HELP>	#attached to a small probe card (pod) via an umbilical cable.
%<HELP>	#The probe card, which contains the device being emulated,
%<HELP>	#inserts into the socket for the device in your target
%<HELP>	#development system.  Probe cards are available supporting the entire
%<HELP>	#Dallas HSM family.
%<HELP>	#The emulator base unit connects to the
%<HELP>	#host PC (personal computer) via a standard RS-232-C serial
%<HELP>	#communications link operating at 57.6K baud.
%<HELP>	#.sp 1
%<HELP>	#The \b%rs1-HSM Modular\r emulator is an advanced,
%<HELP>	#high-performance, full-featured, economical,
%<HELP>	#small profile/footprint emulators supporting
%<HELP>	#full probe card interchangeability within the Dallas HSM family.
%<HELP>	#.in -3 }
%<HELP>	#.sp 2
