%<HELP&DEM>	#.sp 1
%<HELP&DEM>	#A detailed description of each file in this directory follows:
%<HELP&DEM>	#.sp 1
%<HELP&DEM>	#\bSystem/Utility Files\r
%<HELP&DEM>	#.sp 1
%<HELP&DEM>	#.in +4 {
%<HELP&DEM>	#.in +13 {
%<HELP&DEM>	#.ti -13
%<HELP&DEM&DEM>	#ICEDEMO.EXE^^The demo version of the emulator host PC software.
%<HELP&DEM&SIM>	#ICESIM.EXE^^^The demo version of the emulator host PC software.
%<HELP&DEM&DEM>	#.sp 1
%<HELP&DEM&DEM>	#.ti -13
%<HELP&DEM>	#$MODEL^^^^^^^Configuration file defining the probe card for the demo
%<HELP&DEM>	#emulator as
%<HELP&DEM&A51>	#an 8052.
%<HELP&DEM&A68>	#a 68HC11A0.
%<HELP&DEM&A80>	#a COP888CG.
%<HELP&DEM&A05>	#a 68HC05C8.
%<HELP&DEM&A65>	#an MSM65524.
%<HELP&DEM&A85>	#an H8/532.
%<HELP&DEM&A25>	#an 8XC251SB.
%<HELP&DEM&A78>	#a \xE6PD784026.
%<HELP&DEM>	#The emulator host software (ICEDEMO.EXE) reads this $MODEL file
%<HELP&DEM>	#during its one-time initialization sequence.
%<HELP&DEM>	#The $MODEL file also contains the Help information.
%<HELP&DEM>	#.sp 1
%<HELP&DEM>	#.ti -13
%<HELP&DEM>	#$CLR1$^^^^^^^File containing default video display color and
%<HELP&DEM>	#highlighting values suitable for color CGA/EGA/VGA monitors.
%<HELP&DEM>	#.ti -13
%<HELP&DEM>	#$CLR2$^^^^^^^File containing default video display color and
%<HELP&DEM>	#highlighting values suitable for color EGA/VGA monitors.
%<HELP&DEM>	#.ti -13
%<HELP&DEM>	#$CLRL$^^^^^^^File containing default video display "color" and
%<HELP&DEM>	#highlighting values suitable for LCD monitors used on notebooks/laptops.
%<HELP&DEM>	#.ti -13
%<HELP&DEM>	#$CLRM$^^^^^^^File containing default video display "color" and
%<HELP&DEM>	#highlighting values suitable for monochrome monitors.
%<HELP&DEM&A51>	#.sp 1
%<HELP&DEM&A51>	#.ti -13
%<HELP&DEM&A51>	#$CONFIG^^^^^^Configuration file defining the default operating
%<HELP&DEM&A51>	#mode as "ROMless".
%<HELP&DEM&A85>	#.sp 1
%<HELP&DEM&A85>	#.ti -13
%<HELP&DEM&A85>	#$CONFIG^^^^^^Configuration file defining the default operating
%<HELP&DEM&A85>	#mode as "singe-chip".
%<HELP&DEM&A80>	#.sp 1
%<HELP&DEM&A80>	#.ti -13
%<HELP&DEM&A80>	#$CR_C888^^^^^Emulator Control RAM initialization file. The host
%<HELP&DEM&A80>	#software automatically downloads this file into
%<HELP&DEM&A80>	#the emulator base unit during initialization.
%<HELP&DEM&A80>	#.sp 1
%<HELP&DEM&A80>	#.ti -13
%<HELP&DEM&A80>	#MKSHF.EXE^^^^A utility program which 'MaKes a Symbolic Hex File'
%<HELP&DEM&A80>	#using as inputs the '.SYM' file produced by the old COP8
%<HELP&DEM&A80>	#Assembler and the '.HEX' file produced by the LMHEX utility.
%<HELP&DEM&A80>	#The file MKSHF.DOC describes how to use MKSHF.
%<HELP&DEM&A80>	#.ti -13
%<HELP&DEM&A80>	#MKSHF.DOC^^^^Describes how to use the MKSHF.EXE utility program.
%<HELP&DEM&A80>	#.ti -13
%<HELP&DEM&A80>	#MKSHF.EXC^^^^Standard "exception" file which can be used to create
%<HELP&DEM&A80>	#a customized exception file for input to the MKSHF utility.
