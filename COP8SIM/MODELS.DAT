%<HELP>	#.ea }
%<HELP>	#.ti -2
%<HELP>	#Emulator Weight
%<HELP>	#.ba {
%<HELP>	#0.5lbs   0.3kg
%<HELP>	#.ea }
%<HELP>	#.in -2 }
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#.ti -2
%<HELP>	#\b%rs1-HSM Modular\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#.in +2 {
%<HELP>	#.ti -2
%<HELP>	#Emulator Dimensions:
%<HELP>	#.ba {
%<HELP>	#1.0"   x   4.0"   x   3.0"
%<HELP>	#.ea }
%<HELP>	#.ti -2
%<HELP>	#Probe Card Cable Length:
