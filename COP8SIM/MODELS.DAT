%<HELP>	#.($544)Catalog of iceMASTER 68HC05 Products
%<HELP>	#.sp 1
%<HELP>	#.in +3 {
%<HELP>	#.ti -3
%<HELP>	#\b%rs1-68HC05 Modular Emulator:\r
%<HELP>	#.sp 1
%<HELP>	#The %rs2 \b%rs1-68HC05 Modular\r emulator consists of a
%<HELP>	#68HC05-architecture-specific emulator base unit,
%<HELP>	#attached to a small probe card (pod) via an umbilical cable.
%<HELP>	#The probe card, which contains the device being emulated,
%<HELP>	#inserts into the socket for the device in your target
%<HELP>	#development system.  Many probe cards are available, supporting a
%<HELP>	#wide variety of 68HC05 devices.
%<HELP>	#The emulator base unit connects to the
%<HELP>	#host PC (personal computer) via a standard RS-232-C serial
%<HELP>	#communications link operating at 115.2K baud.
%<HELP>	#.sp 1
%<HELP>	#The \b%rs1-68HC05 Modular\r emulator is a
%<HELP>	#high-performance, full-featured, economical,
%<HELP>	#small profile/footprint emulator supporting
%<HELP>	#full probe card interchangeability.
%<HELP>	#.in -3 }
%<HELP>	#.sp 2
%<HELP>	#\bSPECIFICATIONS and OPTIONS\r
%<HELP>	#.sp 1
%<HELP>	#\bModels\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#.in +2 {
%<HELP>	#.ti -2
%<HELP>	#Model 200 -- basic emulator.
%<HELP>	#.sp 1
%<HELP>	#.ti -2
%<HELP>	#Model 400 -- Model 200 with:
%<HELP>	#.in +2 {
%<HELP>	#.in +2 {
%<HELP>	#.ti -2
%<HELP>	#Real-Time Trace Buffer
%<HELP>	#.ti -2
%<HELP>	#Performance Analyzer(s)
%<HELP>	#.ti -2
%<HELP>	#Full Watchdog Timer Support
%<HELP>	#.in -2 }
%<HELP>	#.in -2 }
%<HELP>	#.in -2 }
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#\bEmulator System Components\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#.in +2 {
%<HELP>	#.ti -2
%<HELP>	#\b%rs1-68HC05 Modular\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#.in +2 {
%<HELP>	#.ti -2
%<HELP>	#\b%rs1-68HC05\r Emulator Base Unit (Model 200 or 400)
%<HELP>	#.ti -2
%<HELP>	#Interchangeable Probe Card
%<HELP>	#.ti -2
%<HELP>	#+5 Volt 1.5 Ampere Power Source
%<HELP>	#.in -2 }
%<HELP>	#.in -2 }
%<HELP>	#.in -2 }
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
%<HELP>	#\bOperating Modes\r
%<HELP>	#.sp 1
%<HELP>	#.in +2 {
%<HELP>	#.in +2 {
%<HELP>	#.ti -2
%<HELP>	#Single Chip Mode
%<HELP>	#.ti -2
%<HELP>	#Watchdog Timer Enabled/Disabled (\b%rs1 Model 400\r only)
%<HELP>	#.in -2 }
%<HELP>	#.in -2 }
%<HELP>	#.sp 1
