        .form
;************************************************************************
;***********************   AENDERUNGSTEIL   *****************************
;************************************************************************
;*                                                                      *
;* BEARBEITER:  A.Hinkelmanns                                           *
;*                                                                      *
;* Aenderungen gegenueber Version DAFITC20 vom Juli 94                  *
;* - Taktventilansteuerung: an Pin 7 der ECU wird ein Taktventil        *
;*   angeschlossen. Die Fehlerlampe haengt dann an Pin 3.               *
;*   Die Periodendauer, mit der das Taktventil angesteuert wird,        *
;*   betraegt 256 * 41ms = 10,496s                                      *
;* - Fuer die Analogwertausgabe von ca. 4-7 V wird das UP PWM so        *
;*   angepasst, dass mittels zweier Parameter (Steigung und Offset)     *
;*   ein Bereich von einem minimalen Tastverhaeltnis bis zu einem       *
;*   maximalen gefahren werden kann.                                    *
;* - Steht der Funktionsschalter auf MANUELL wird UP LINFUN aufgerufen. *
;* - Am Pin 15 (vorher Geblaesesollwertgeber) wird der Vereisungssensor *
;*   eingelesen.                                                        *
;* - Linearfunktion so geaendert, dass 0 - 100 % Ventilstellung einge-  *
;*   gestellt werden kann.                                              *
;* Aenderungen gegenueber Version 0 vom 30.08.94                        *
;* - Bypassklappenstellung Auf entspricht KLPSOL=0 und ZU entspricht    *
;*   KLPSOL=FF. Entsprechend muss bei REHEAT auch FF stehen (Zu)        *
;* Aenderung gegenueber Version 1                                       *
;* - Ventilkennlinie                                                    *
;* Aenderungen gegenueber Version 2 vom 11.11.94                        *
;* - Ventilkennlinie geaendert                                          *
;* Aenderungen gegenueber Version 3 vom 10.01.95                        *
;* - linearer Uebergang Heizen-Lueften-Kuehlen ueber Ausblassoll        *
;*   wie bei TDK (autom. Kompressoransteuerung noch nicht aktiv)        *
;* - bei Ueberschwinger von mehr als 0,7 Grad werden positive I-Anteile *
;*   gleich Null gesetzt. Wirkt auch bei Sollwertsprung nach unten      *
;* - Maximaldrehzahl Heizen/Lueften/Kuehlen parametrierbar              *
;* - Bei OTPs und Hybridrechnern wird Adresse 1FFF mit FF programmiert  *
;* Aenderungen gegenueber Version 4 vom 25.01.95                        *
;* - Kompressor wird in Abhaengigkeit von der Ausblastemperatur getaktet*
;* - Motor-Laeuft-Signal wird ueber Pin 12 eingelesen.                  *
;*   Dies Signal hat Einfluss auf Geblaesedrehzahl und Kompressorlauf.  *
;*   Beides wird bei stehendem Motor ausgeschaltet.                     *
;* - Ist der Kompressor angefordert, braucht die Mindestausblastemp.    *
;*   nicht mehr eingehalten werden.                                     *
;* - Bei Ausfall des Vereisungssensors wird der Kompressor gesperrt.    *
;* - Bei Ausfall eines der anderen Sensoren, wird Manuellbetrieb gemacht*
;* Aenderungen gegenueber Version 5 vom 06.07.95                        *
;* - Blinkcodefehlerausgabe                                             *
;* - Fehlerspeicher loeschen Åber 2 s low bei Zuendung Ein              *
;* - Im Klimabetrieb gilt jetzt auch die Obergrenze aus Geblaesekennl.  *
;* Aenderungen gegenueber Version 6 vom 14.07.95                        *
;* - bei Unterschwingern von mehr als 0,7 Grad werden negative I-Anteile*
;*   gleich Null gesetzt. Wirkt auch bei Sollwertsprung nach oben       *
;* Aenderungen gegenueber Version 7 vom 20.07.95                        *
;* - das Loeschen der I-Anteile (s.o.) wird nur noch vorgenommen, wenn  *
;*   gleichzeitig eine Sollwertaenderung von mehr als 1 Grad vorliegt.  *
;* - Das Initialisieren des PWM (D/A) Signals wird jetzt vor der Bypass-*
;*   klappeninitialisierung vorgenommen, da sonst nach der Diagnose     *
;*   manchmal das Gbelaese volles Rohr lief.                            *
;************************************************************************
;
        .form
;.......Version & Versionsnummer im ROM ablegen, und vorher noch'ne An-
;       weisung fuer den Assembler, das hier ein COP888-Chip werkeln soll

        .chip 888CF                   ;Programm fuer COP888 Familie        
        
;                MASKE=0                     ;Maskenrechner=1, Hybrid,OTP=0
;
;                .IF MASKE=0                                     ;bei Hybriden und OTPs muss an Adresse
;                .MAXROM 01FFF               ;(8 kByte ROM)
;        .=01FFF                                         ;1FFF FF stehen (Halt mode disabled)
;                .byte 0FF
;                .ENDIF
;;
;;
         VERSNR=08                  ; Software Versionsnummer
;;         
        .sect PRGID,ROM                     ;location pointer auf ROM 0FFA      
        .byte  'ATCMAN',VERSNR      ;Version im ROM ablegen              
        .endsect
;;
;

;
        .form 'Schnittstellenbeschreibung'
;       Beschaltung des Prozessors  COP888CF  (44 PLCC-Gehaeuse)
;       --------------------------------------------------------
;
;                   ⁄ƒƒƒƒƒƒƒƒ¬ƒƒ¬ƒƒƒƒƒƒƒƒø
; Funktionssch.    -≥ 1  C2  ¿ƒƒŸ  C1  44≥- Funktionsschalter 
; Funktionssch.    -≥ 2  C3        C0  43≥- Funktionsschalter
; Mw-SO / KLin     -≥ 3  G4        G3  42≥- PWM-Signal fuer Lueftermodul
; Mw-SK / KLout    -≥ 4  G5        G2  41≥- Eingang Kompressorrelais
; Mw-SI / Lin      -≥ 5  G6        G1  40≥- Watchdog-Output
;           Clock  -≥ 6  G7/CkO    G0  39≥- Abrisserkennung Luftaustrittssensor
;           Clock  -≥ 7  CkI       RES 38≥- Reset
;            +5 V  -≥ 8  Vcc       Gnd 37≥- Ground
; Aussentemperatur -≥ 9  AD0       D7  36≥- Schrittmotor D
; Innentemperatur  -≥10  AD1       D6  35≥- NC                   
; Luftaustritt     -≥11  AD2       D5  34≥- Schrittmotor C
; Sollwert temp.   -≥12  AD3       D4  33≥- Kompressorrelais
; Sollwert gebl.   -≥13  AD4       D3  32≥- Schrittmotor B             
; Vorwahluhr(Zhz.) -≥14  AD5       D2  31≥- Taktventil 
; Klemme 15        -≥15  AD6       D1  30≥- Schrittmotor A
; Vereisungssensor -≥16  AD7       D0  29≥- 
; Analog Ground    -≥17  AGnd      L7  28≥- SiLa
; Referenzspannung -≥18  Vref      L6  27≥- Chip Select EEPROM
; Chip Select Diag -≥19  L2        L5  26≥- \ 
; AGnd-Umschaltg.  -≥20  L3        L4  25≥- /
; UREF schalten    -≥21  C4        C7  24≥- Schutz fuer AD2
; Schutz fuer AD0  -≥22  C5        C6  23≥- Schutz fuer AD1
;                   ¿ƒƒƒƒƒƒƒƒƒƒƒƒƒƒƒƒƒƒƒƒŸ
;
        .form '' 
;
;    ***********************************************
;    * PORT-, CONFIGURATION- AND CONTROL REGISTERS *
;    ***********************************************
;
;    nicht benutzte Port's sind als INPUT declariert und bleiben im
;    High'Z .

PORTLD  =   0D0         ; PORT L DATA
PORTLC  =   0D1         ; PORT L CONFIGURATION
PORTLP  =   0D2         ; PORT L PIN STATUS
;
        ;      = ?? 
        ;      = ?? 
        CSDIAG = 02     ; CHIPSELECT DIAGNOSE IC        OUT
        AGNDSW = 03     ; ANALOG GROUND UMSCHALTUNG     OUT
;                       ; High-Z/Push-Pull"1" Umschaltung
        ;      = 04     ; \                             IN        
        ;      = 05     ; / fuer die Tachomessung       IN     
        CSEEPR = 06     ; Chipselect EEPROM          ** OUT 
        MVCIN  = 07     ; Zusatzausgang MVC3769         OUT     
        SILA   = 07     ; SILA                          OUT
;
        PLCONFG = X'C4          ; 11000100  Ausgang = 1; Eingang = 0
        PLDATA  = X'80          ; 10000000  Grundstellung Port L 
;
;       --- L-PORT CONTROL/DATA REGISTER BITS ---
        T2AO   = 04     ; T2A OUTPUT SELECT (1=OUTPUT)
        T2BO   = 05     ; T2B OUTPUT SELECT
;
;       ---- L-PORT INPUT REGISTER BITS ---
        T2A    = 04     ; T2A PIN STATUS
        T2B    = 05     ; T2B PIN STATUS
;    ___________________________________________________________
;       
PORTCD  =   0D8         ; PORT C DATA
PORTCC  =   0D9         ; PORT C CONFIGURATION
PORTCP  =   0DA         ; PORT C PIN STATUS
;
        EINFAN  =   00  ; FUNKTIONSSCHALTER STELLUNG FAN MANUELL
        EINAUT  =   01  ; FUNKTIONSSCHALTER STELLUNG AUTOMATIK
        EINDRY  =   02  ; FUNKTIONSSCHALTER STELLUNG DRY
        INKL61  =   03  ; Eingang Klemme 61 (Lichtmaschine) Motor-Laeuft
        UREF5V  =   04  ; High-Z/Pushpull "1"         OUT
        PRAUS   =   05  ; \  Schutzbesch. ADW
        PRINN   =   06  ;  | zum Messen High-Z        OUT
        PRLFT   =   07  ; /  sonst auf 0
;
        PCCONFG = X'00          ; 00000000  Ausgang=1; Eingang = 0
        PCDATA  = X'00          ; 00000000  Grundstellung Port C
;    ___________________________________________________________
;
;Note:  Auf diesem Port liegen der externe Interrupt sowie die Mircowire-
;       Schnittstelle, so das dieses evtl. noch zu aendern ist (Bedeutung der
;       Bits 6,7 im Configregister nicht eindeutig klar)
;
PORTGD  =   0D4         ; PORT G DATA
PORTGC  =   0D5         ; PORT G CONFIGURATION
PORTGP  =   0D6         ; PORT G PIN STATUS
;
        LFTABR  =   00  ; Abrisserkennung LFT-Sensor
        ;       =   01  ; unused im Layout !
        KOMPIN  =   02  ; KOMPRESSORRELAIS EINGANG
        ;       =   03  ; Ausgang 
        MWOUT   =   04  ; DataOut an EEPROM (SO)     ** OUT
        MWCLK   =   05  ; SCLOCK an  EEPROM (SK)     ** OUT
        MWIN    =   06  ; DataIn von EEPROM (SI)     ** IN (only)
        ;       =   07  ; intern Quarzoszillator 
;       Microwirepins werden auch als Diagnosebausteine benutzt !   
;       Pins standardmaessig Diagnose zugeordnet, werden bei EEPROM-Aufruf
;       umkonfiguriert !
        KLDATA  =   04  ; K-Leitung In
        KLOUT   =   05  ; K-Leitung Out
        LLIN    =   06  ; L-Leitung In
;
SIOR    =   0E9         ; SIO SHIFT REGISTER
;
        PGCONFG = X'2A  ; 00101010 Ausgang=1; Eingang=0
        PGMWCF  = X'3A  ; 00111010 Ausgang=1; Eingang=0 ;Config fuer Microw.
        PGDATA  = X'29  ; 00101001 Grundstellung Port G 
;
;       --- G-PORT CONTROL/DATA REGISTER BITS ---
        T1AO    =   03     ; T1A  INPUT/OUTPUT SELECT \ 0 = Input 
        T1BO    =   02     ; T2A INPUT/OUTPUT SELECT  / 1 = Output
        SOE     =   04     ; SO OUTPUT ENABLE BIT
        SKS     =   05     ; SK MASTER/SLAVE SELECT; 1=SLAVE 0=MASTER
;
;       --- G-PORT INPUT REGISTER BITS  ---
        INTR    =   00     ; INTERUPT PIN STATUS
        T1A     =   03     ; T1A PIN STATUS BIT
        T1B     =   02     ; T1B PIN STATUS BIT
        SO      =   04     ; SERIAL OUTPUT PIN STATUS
        SK      =   05     ; SHIFT CLOCK PIN STATUS
        SI      =   06     ; SERIAL INPUT PIN STATUS BIT

;    ___________________________________________________________
;
;
PORTD   =   0DC         ; PORT D only OUTputs
        
;              =    00  ; frei (war Steuergeraet Zusatzheizung)
        STEPPA =    01  ; SCHRITTMOTOR A
        WVAUF  =    02  ; Taktventil 
        STEPPB =    03  ; SCHRITTMOTOR B
        KOMREL =    04  ; KOMPRESSORRELAIS
        STEPPC =    05  ; SCHRITTMOTOR C          
        ;      =    06  ; 
        STEPPD =    07  ; SCHRITTMOTOR D

;    ___________________________________________________________
;    

ENAD    =   0CB            ; A/D ENABLE REGISTER
ADRSLT  =   0CC            ; A/D RESULT REGISTER
;
; STEUERBYTES FUER A/D-WANDLER
;
        FUAUS  =  X'07     ; AUSSENTEMPERATUR         CHANNEL 0
        FUINN  =  X'27     ; INNENTEMPERATUR          CHANNEL 1      
        FULFT  =  X'47     ; LUFTAUSTRITTSTEMPERTATUR CHANNEL 2      
        FUSOLT =  X'67     ; SOLLWERT TEMPERATUR      CHANNEL 3
        FUVER  =  X'87     ; Verdampfertemperatur     CHANNEL 4
        FUZHZ  =  X'A7     ; VORWAHLUHR (ZUHEIZ.)     CHANNEL 5
        FUKL15 =  X'C7     ; KLEMME 15                CHANNEL 6
        FUEND  =  X'E7     ; STEPPER ENDSCHALTER      CHANNEL 7
        
;
;    ___________________________________________________________
;
TMR1LO  =   0EA         ; TIMER 1 LOW BYTE
TMR1HI  =   0EB         ; TIMER 1 HIGH BYTE
T1RALO  =   0EC         ; TIMER 1 RA REGISTER LOW BYTE
T1RAHI  =   0ED         ; TIMER 1 RA REGISTER HIGH BYTE
T1RBLO  =   0E6         ; TIMER 1 RB REGISTER LOW BYTE
T1RBHI  =   0E7         ; TIMER 1 RB REGISTER HIGH BYTE
;
TMR2LO  =   0C0         ; TIMER 2 LOW BYTE
TMR2HI  =   0C1         ; TIMER 2 HIGH BYTE
T2RALO  =   0C2         ; TIMER 2 RA REGISTER LOW BYTE
T2RAHI  =   0C3         ; TIMER 2 RA REGISTER HIGH BYTE
T2RBLO  =   0C4         ; TIMER 2 RB REGISTER LOW BYTE
T2RBHI  =   0C5         ; TIMER 2 RB REGISTER HIGH BYTE
T2CNTRL =   0C6         ; TIMER 2 CONTROL REGISTER 
;
        T2ENB  =  00    ; T2 INTERRUPT ENABLE FOR T2B INPUT CAPTURE EDGE
        T2PNDB =  01    ; T2 INTERRUPT PENDING FOR T2B INPUT CAPTURE EDGE
        T2ENA  =  02    ; T2 Int-Enab. Timer underflow or T2A Inp. Cap. edge
        T2PNDA =  03    ; T2 INTERRUPT PENDING: AUTO RA IN MODE 1,T2 UNDERFLOW
                        ; IN MODE 2, T2A CAPTURE EDGE IN MODE 3
        T2C0   =  04    ; T2 START IN MODE 1&2,
                        ; T2 UNDERFLOW INTERRUPT
                        ; PENDING IN MODE 3
        T2C1   =  05    ; TIMER T2 MODE CONTROL BITS
        T2C2   =  06    ;
        T2C3   =  07    ;
;
;    ___________________________________________________________
;
CNTRL   =   0EE         ; CONTROL REGISTER

        SL0    =   00   ; select MICROWIRE clock divide by 00= /2
        SL1    =   01   ; 01 = /4 ; 1x = /8           
        IEDG   =   02   ; EXTERNAL INTERRUPT EDGE POLARITY SELECT 
                        ; (0=RISING EDGE,1=FALLING EDGE)
        MSEL   =   03   ; Selects G5,G4 as Mikrowire SK and SO
        T1C0   =   04   ; T1 Start/Stop Control or Underflow Interupt Flag
        T1C1   =   05   ; \  Timer 1 Mode Control   
        T1C2   =   06   ;  | Bits
        T1C3   =   07   ; /  selects also T1C0 function 
;
         MWT1CF=  090   ; '10010000'   - CNTRL CONFIGURATION
                        ;  ||||||||
                        ;  |||||||+----- \
                        ;  ||||||+------ /  MIKROWIRE CLOCK DIVIDE
                        ;  |||||+-------  
                        ;  ||||+--------    SELECTS MIKROWIRE
                        ;  |||+---------    TIMER 1 STARTEN
                        ;  ||+---------- \
                        ;  |+-----------  | MODE1 (PWM) NO T1A TOGGLE
                        ;  +------------ /
; ___________________________________________________________

PSW     =  0EF          ; PSW REGISTER

        GIE    =   00   ; Global Interrupt enable
        EXEN   =   01   ; External Interrupt enable
        BUSY   =   02   ; MICROwire Busy shifting
        EXPND  =   03   ; External Interr. Pending
        T1ENA  =   04   ; Timer1 Interrupt enable (Underflow or T1A-Pin)
        T1PNDA =   05   ; Timer1 Interrupt pending (Auto RA Mode 1, T1 under-
                        ; flow Mode 2, T1A Input Capture edge MODE 3)
        C      =   06   ; CARRY FLAG
        HC     =   07   ; HALF CARRY FLAG
;    ___________________________________________________________
;
ICNTRL  =   0E8         ; ICNTRL Register

        T1ENB  =   00   ; T1 Interupt ENABLE for T1B Input Capture Edge
        T1PNDB =   01   ; T1 Interupt PENDING for T1B Capture Edge
        UWEN   =   02   ; enable MICROWire/plus Interrupt
        UWPND  =   03   ; MICROWIRE INTERUPT PENDING
        T0EN   =   04   ; TIMER T0 Interrupt enable (12TH BIT Toggle) 
        T0PND  =   05   ; T0 Interrupt Pending
        LPEN   =   06   ; L-PORT Interrupt enable (Multi-Input Wakeup !)
        ;      =   07   ; unused
 
WDSVR  =   0C7         ; WATCH DOG SERVICE REGISTER
WKEDG  =   0C8         ; MIWU EDGE SELECT REGISTER
WKEN   =   0C9         ; MIWU ENABLE REGISTER
WKPND  =   0CA         ; MIWU PENDING REGISTER
;
        .form
;------------------- R A M   B e l e g u n g  ------------------ 
;
;
        R0     = X'F0           ; SERVICE
       ICNTR   = R0             ; TIMER fuer I-Anteil Vorgabe Luftaustritt
        R1     = X'F1           ; SERVICE / MESSTECHNIK
       MESCNT  = X'F1           ; Messtechnik-Ausgabezaehler
        R2     = X'F2           ; 
       WVTIM   = R2             ; Timer fuer Taktventil   
        R3     = X'F3           ; 
       ICNTUR  = R3             ; TIMER fuer I-Anteil unterlagerte Regelung
        R4     = X'F4           ; Software-Timer 41ms Takt bis 1 s
        R5     = X'F5           ; SERVICE / TIMER
       SECTIM  = R5             ; Software-Timer (Sekunden) PWM-Filter, SiLa
        R6     = X'F6           ; EEPROM Adresszaehler
        R7     = X'F7           ; 200ms Zaehler / SERVICE
        R8     = X'F8           ; fuer 5 Baud-Adresse
        R9     = X'F9           ; fuer 5 Baud-Adresse
       COUNT1  = X'FA           ; Delaycounter: Messtechnikausgabe,LESADW
       COUNT   = X'FB           ; Loopcounter Multiplikationsprogramm/
;                               ; Division, Messtechnikausgabe
;
        STSIZE = 012            ; reserviert fuer'n Stack
                                ; max. Verschachtelung incl. PUSH !
        RAMEND = X'6F           ; RAM Ende
        RAMTOP = X'6F-STSIZE    ; max. RAM-Adresse !
        BOTTOM = X'0            ; min RAM-Adresse
;
        ADAUS  = RAMTOP         ; AUSSENTEMPERATUR    (AD-WANDLERWERT) MSB
;                ADAUS -1       ; (Pseudo 16 Bit)                      LSB
        ADINN  = ADAUS -2       ; INNENTEMPERATUR     (AD-WANDLERWERT) MSB
;                ADINN -1       ; (Pseudo 16 Bit)                      LSB
        ADLFT  = ADINN -2       ; Luftaustrittstemp. (AD-Wandlerwert)  MSB
;                ADLFT -1       ; (Pseudo 16 Bit)                      LSB
        ADSOLT = ADLFT -2       ; SOLLTEMPERATUR     (AD-WANDLERWERT)  MSB
;                ADSOLT-1       ; (PSEUDO 16 BIT)                      LSB
        ADVER  = ADSOLT-2       ; Vereisungssensor   (AD-WANDLERWERT)  MSB
;                ADVER -1       ; (PSEUDO 16 BIT)                      LSB
        ADKL15 = ADVER -2       ; KLEMME 15          (AD-WANDLERWERT)  MSB
;
        AUSSEN = ADKL15-1       ; NORMIERTE AUSSENTEMPERATUR
        INNEN  = AUSSEN-1       ; NORMIERTE INNENTEMPERATUR
        LFT    = INNEN -1       ; NORMIERTE LUFTAUSTRITTSTEMPERATUR
        SOLTEM = LFT   -1       ; NORMIERTER SOLLWERT TEMPERATUR
        VEREIS = SOLTEM-1       ; NORMIERTE Verdampfertemperatur      
        LFTSOL = VEREIS-1       ; Sollwert LUFTAUSTRITTSTEMPERATUR normiert
        LFTALT = LFTSOL-1       ; alter Luftaustrittswert fuer Zhz-Betrieb
;              
        ABWOF  = LFTALT-1       ; vorzeichenbeh. Abweichung Soll/Ist-Temp. 
        INTLR  = ABWOF -1       ; Integrationsregister (Abweichung) Vorgabe Luftaustritt        
        ABWLFT = INTLR -1       ; Differenz Soll/Ist Luftaustrittstemp.(unterl.Regel.)
        INTLUR = ABWLFT-1       ; Integrationsregister (Abweichung) unterl.Regel.
        WVSOL  = INTLUR-1       ; "unbehandelter" Wasserventilsollwert (aus unterl.Regel.)
        FILREG = WVSOL-1        ; Uebergaberegister Inkrement fuer FILTER
;
        REGGBL = FILREG-1       ; Flagregister FUER GEBLAESESTEUERUNG/NOTLAUF
;                     = 0       ; 
;                     = 1       ; 
               GBLMAN = 2       ; F-SCHALTER AUF MANUELL ODER AUS
;               GBLDEF = 3       ; F-SCHALTER 
               GBLAUT = 4       ; F-SCHALTER AUF AUTOMATIK
               NOTKOM = 5       ; NOTBETRIEB: Kompressor darf nicht an sein!
               LINEAR = 6       ; Linearsteller im Manuellbetrieb!
               NOTLIN = 7       ; NOTBETRIEB: Linearsteller !
;
        REGRGL = REGGBL-1       ; FLAGREGISTER REGLER
               ACBETR = 0       ; z.Z. nicht benutzt
               HZBETR = 1       ; ANLAGE IM HEIZBETRIEB
               AHZEND = 2       ; AUFHEIZPHASE BEENDET
               ZHBETR = 3       ; Zusatzheizungsbetrieb
               MITEMP = 4       ; MINDESTTEMP. AM LUFTAUSTRITT BRAUCHT NICHT EINGEHALTEN WERDEN
               NOHYST = 5       ; Hysterese beim Filtern !! NICHT !!zugelassen
               FILTON = 6       ; filter eingeschaltet, wenn nicht, dann 
                                ; gemessene Werte = Startwerte
               HEATON = 7       ; Aufheizflag = 1, wenn Aufheizen beendet
;
        REGEXT = REGRGL-1       ; FLAGREGISTER FUER EXTERNE KOMPONENTEN
               KOMPON = 0       ; KOMPRESSOR ANSCHALTEN
               ZHZON  = 1       ; Zusatzheizung eingeschaltet
               KOMPAN = 2       ; Kompressor anfordern
               SILAON = 3       ; FEHLERLAMPE EIN
               SILAIN = 4       ; FEHLERLAMPE EIN DAS ERSTE MAL BEIM INITIALISIEREN
               REFEND = 5       ; REFERENZFAHRT DES STEPPERS BEENDET
               SLTDEF = 6       ; SOLLWERTGEBER TEMPERATUR DEFEKT
               SLGDEF = 7       ; SOLLWERTGEBER GEBLAESE   DEFEKT
;              
        SWITCH = REGEXT-1       ; FLAGREGISTER FUER FUNKTIONSSCHALTERSTELLUNG
        SWIOLD = SWITCH-1       ; DITO, ABER ALTER WERT
               SWAUTO = 0       ; AUTOMATIK
               SWFANM = 1       ; FAN MAN
               SWAUS  = 2       ; AUS
               KL61   = 3       ; Motor-laeuft
               SWDRY  = 4       ; DRY
               SWZHZ  = 5       ; Zusatzheizung eingeschaltet
;                     = 6       ; 
               FSDEFT = 7       ; FUNKTIONSSCHALTER DEFEKT FLAG
;
;        MASKEN FUER SCHALTERAUSBLENDUNG
               MSKAUS = 004     ; SCHALTERBIT -AUS-
               MSKL61 = 008     ; SCHALTERBIT -AC-
               MSKFNM = 002     ; SCHALTERBIT -FANMANUELL-
               MSKDRY = 010     ; SCHALTERBIT -DRY-
               MSKAUT = 001     ; SCHALTERBIT -AUTO-
               MSKALL = 017     ; ALLE SCHALTERBITS ausser AC
               MSKNOT = 0E2     ; Maske fuer FANMAN-Notbetrieb bei FSdefekt
;        Maske fuer unbedrahtenden Funktionsschalter-PIN (z. Zt. = "AUS")
               MSKWIR = MSKFNM+MSKDRY+MSKAUT   
;              
;
;------- RAM-ADRESSEN FUER SERVICE ROUTINE -----------------------------
;
         RXDATA=SWIOLD-1            ; HILFSREGISTER FUER DATENEMPFANG (AUCH 5BAUD)
         FLAG01=RXDATA-1            ; FLAGREGISTER    
                  STATUS=00         ; STATUSBIT FUER EEPROM (=1, WENN DATEN EINGESCHRIEBEN)
                  UNTSP =01         ; UNTERSPANNUNGSFLAG
                  BAUD5 =02         ; 5 BAUD FLAG
                  TRANSM=03         ; SENDE FLAG
                  BAUDFL=04         ; FLAG FUER BAUDRATEN GENERIERUNG
                  TRERR =05         ; TRANSMISSION ERROR FLAG
                  DIAGNO=06         ; DIAGNOSE FLAG
                  NOMOIN=07         ; =1, keine Motoransteuerung in Interrupt
;                 
;!!!!!!! SERVICE UEBERSCHREIBT TEIL DES RAMS !!!!!!!!!!!!!!!!!!!!!!!!
;
         TXDATA=BWINT               ; HILFSREGISTER FUER SER.AUSGABE
         RXBUFF=TXDATA-10           ; EMPFAENGER BUFFER,WAECHST MIT STEIG. ADRESSE
         TXBUFF=RXBUFF              ; SENDE BUFFER 
;
;bei Blincodeausgabe wird RAM auch Åberschrieben
;
        FLAGBC = BWINT              ; Flagregister fuer Blincodeausgabe        
                  LSTAT =00         ; Status der L-Leitung
                  TIME3S=01         ; Startzeit von 3s laeuft
                  TIZST =02         ; Zehnerstelle 
                  TIEST =03         ; Einerstelle
                  TIPZE =04         ; Pause zwischen Zehner und Einer
                  TIPEE =05         ; Pause zwischen Einer und Einer
                  TIPZZ =06         ; Pause zwischen Zehner und Zehner
                  BCTIOT=07         ; Blinkcode Timeout laeuft
                  TIMASK=07E        ; Maske fuer Zeitflags

        BCBUFF = FLAGBC-1           ; Ausgabebuffer fuer Blinkcodefehlernummer
        ERBUFF = BCBUFF-4           ; Ausgabebuffer fuer Fehlerbytes
        FEHLNR = ERBUFF-1           ; Fehlernummer
;
;
;!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
;
;------- RAM-ADRESSEN FUER EEPROM  ROUTINE -----------------------------
;        
         WDATL = WORK +1            ; LOWBYTE DES ZUSCHREIBENDEN 16-BIT WORTES
         WDATH = WORK               ; HIGHBYTE           "             "
         RDATL = WDATL              ; LOWBYTE DES EINGELESENEN 16-BIT WORTES
         RDATH = WDATH              ; HIGHBYTE           "             "
         ADRESS= R6                 ; EEPROM ADRESSE IN DER FORM X X A5 A4 A3 A2 A1 A0
         SNDBUF= FLAG01-1           ; ENTHAELT DAS COMMAND-BYTE, WELCHES AN DAS EEPROM 
                                    ; GESCHICKT WIRD
         FLAG02= SNDBUF-1           ; FLAG ZEIGT FUNKTION FUER UP INIT AN
                   EERDWR=0         ; 00 - ERASE, ENABLE, DISABLE, ERASE ALL 
                   EEWRIT=1         ; 01 - READ
                                    ; 11 - WRITE
                   TAOVFL=2         ; 
                   KLEIN1=3         ; FUER KENNLINIEN UP (=1, WENN STEIGUNG<1)
                   TV1   =4         ; FLAG LUEFTERKENNLINIE F. ZUSATZHEIZUNG
                   TV2   =5         ; FLAG LUEFTERKENNLINIE F. ZUSATZHEIZUNG
                   TV3   =6         ; FLAG LUEFTERKENNLINIE F. ZUSATZHEIZUNG
;                         =7         ; 
;                         =4         ; 
;                         =5         ; 
;                         =6         ; 
;
         DISWSW= FLAG02-1           ; Diff. Sollwert_alt-Sollwert
         DIATLS= DISWSW-1           ; Diff. LFT.Sollwert-Aussentemp+80h
         KLPSOL= DIATLS-1           ; Bypassklappen Sollwert fuer Stepper    
         WVKORR= KLPSOL-1           ; Wasserventil kennlinienkorrigiert
;
         STEPSL= WVKORR-1           ; SCHRITTMOTOR SOLLWERT LOW-BYTE
         STEPSH= STEPSL-1           ;      "          "     HIGH-BYTE
         STEPIL= STEPSH-1           ;      "       ISTWERT  LOW-BYTE
         STEPIH= STEPIL-1           ;      "          "     HIGH-BYTE
         STEP  = STEPIH-1           ; MERKER FUER LETZTEN STEP BEI STILLSTAND
         PWMALT= STEP-1             ; MERKER FUER LUEFTERZUSTAND
;        
;
;******* PARAMETER, DIE AUS DEM EEPROM INS RAM KOPIERT WERDEN ******
;
         KORBEG= PWMALT-1  ; BEGINN DER PARAMETER
;
;-------Korrekturwerte fuer Temperaturfuehler (aus geschuetztem Bereich)
         KORAUS = KORBEG   ; 06H KORREKTURWERT AUSSENTEMPERATUR
         KORINN = KORAUS-1 ; 06L KORREKTURWERT INNENTEMPERATUR
         KORLFT = KORINN-1 ; 05H KORREKTURWERT LUFTAUSTRITTSTEMPERATUR
         KORVER = KORLFT-1 ; 05L Korrekturwert Vereisungssensor
;
;-------sonstige Parameter
         PARBEG = KORVER-1 ;Beginn des Parameterblocks im RAM
                           ;EEPROM-Adresse
         UGPWM  = PARBEG   ; 2EH untere Grenze fuer PWM-Umrechnung
         STPWM  = UGPWM-1  ; 2EL Steigung fuer PWM-Umrechnung
         LFTMIN = STPWM-1  ; 2DH MINDESTLUFTAUSTRITTSTEMPERATUR

;-------NORMIERUNG
         SOLTSP = LFTMIN-1 ; 2DL SPREIZUNG SOLLWERT TEMPERATUR
         SOLTOF = SOLTSP-1 ; 2CH OFFSET SOLLWERT TEMPERATUR
         KOHYON = SOLTOF-1 ; 2CL Kompressor Einschalthysterese
         KOHYOF = KOHYON-1 ; 2BH Kompressor Ausschalthysterese
;
;
;-------REGLER:
;
         BWINT  = KOHYOF-1 ; 2BL INTEGRALBEIWERT
         BWPRO  = BWINT -1 ; 2AH PROPORTIONALBEIWERT
         BWSTR  = BWPRO -1 ; 2AL STOERGROESSENBEIWERT
         TINT   = BWSTR -1 ; 29H INTEGRATIONSZEIT (VORGABE LUFTAUSTRITTSTEMP.)
         INNTOL = TINT  -1 ; 29L ZULAESSIGE TOLERANZ FUER SOLLWERT INNENTEMP.
         INCR   = INNTOL-1 ; 28H SCHRITTWEITE INTEGRAL
         TINTUR = INCR  -1 ; 28L INTEGRATIONSZEIT UNTERLAGERTE REGEL.         
         LFTTOL = TINTUR-1 ; 27H ZULAESSIGE TOLERANZ LUFTAUSTRITTSTEMP.
         INCUR  = LFTTOL-1 ; 27L SCHRITTWEITE INTEGRAL UNTERLAGERTE REGEL.
         URHZB  = INCUR -1 ; 26H HEIZGERAETEBEIWERT (UNTERLAGERTE REGELUNG)
         URIBW  = URHZB -1 ; 26L INTEGRALBEIWERT (UNTERLAGERTE REGELUNG)
         URBPW  = URIBW -1 ; 25H PROPORTIONALBEIWERT (UNTERLAGERTE REGELUNG)
         URSBW  = URBPW -1 ; 25L STOERGROESSENBEIWERT (UNTERLAGERTE REGELUNG)
         STPFKT = URSBW -1 ; 24H UMRECHNUNGSFAKTOR FUER BERECHNUNG STEPPERSCHRITTE
         STPRUH = STPFKT-1 ; 24L RUHEBEREICH FUER "UNBEHANDELTEN" Schrittmotorwert

;
         TLFTK = STPRUH-4  ; LUFTAUSTRITTSTEMP.BEGRENZUNG
                                    ; 22L    0. KNICKPUNKT (XK)
                                    ; 22H    1. STEIGUNG X < XK
                                    ; 23L    2. STEIGUNG X > XK
                                    ; 23H    3. OFFSET F(XK)
;
         BEHGKL= TLFTK-4  ; BEHAGLICHKEITSKENNLINIE
                                    ; 20L    0. KNICKPUNKT (XK)
                                    ; 20H    1. STEIGUNG X < XK
                                    ; 21L    2. STEIGUNG X > XK
                                    ; 21H    3. OFFSET F(XK)
;
         ACBEIN = BEHGKL-1  ; 1FH Aussentemp. ab der AC zugelassen
         VERMIN = ACBEIN-1  ; 1FL Abschaltpunkt f. Kompressor (Verdampfertemp)
         ATALXK = VERMIN-1  ; 1EH AUSSENTEMP.ABHAENGIGE LUEFTERSTEUERUNG KNICKPUNKT
         ATALST = ATALXK-1  ; 1EL    "          "          "       "    STEIGUNG
;
         PAREND = ATALST
;
;------ KENNLINIEN
;
        LKENNL  = PAREND-6
        STARTK  = LKENNL   ; STARTTEMPERATURKENNLINIE
                           ;      OFFSET:
                                    ;30L  0. KNICKPUNKT (XK)
                                    ;30H  1. STEIGUNG X < XK
                                    ;31L  2. STEIGUNG X > XK
                                    ;31H  3. OFFSET F(XK)
                                    ;32L  4. MIN. LUEFTERSPANNUNG
                                    ;32H  5. frei
                                    ;
                           ; LUEFTERKENNLINIE FUER NORMALBETRIEB
                                    ;34L  0. BEREICH MIN. LUEFTERSPAN.KUEHLEN
                                    ;34H  1. BEREICH MIN. LUEFTERSPAN.HEIZEN
                                    ;35L  2. STEIGUNG D. KENNLINIE KUEHLEN
                                    ;35H  3. STEIGUNG D. KENNLINIE HEIZEN
                                    ;36L  4. MIN.SPANNUNG 
                                    ;36H  5. MAX.SPANNUNG 
;
                          ; LUEFTERKENNLINIE FUER ZUSATZHEIZUNGSBETRIEB
                           
                                    ;38L  0. BEREICH MIN. LUEFTERSPANNUNG
                                    ;38H  1. MAX. LUEFTERSPANNUNG
                                    ;39L  2. STEIGUNG
                                    ;39H  3. MIN. LUEFTERSPANNUNG
                                    ;3AL  4. VERZOEGERUNG 1     
                                    ;3AH  5. TEMP.-DIFFERENZ

                                    ;
        HONAUS = LKENNL-1  ;Fehlerzaehler Aussenfuehler Highnible
        LONSLT = LKENNL-1  ;Fehlerzaehler Sollwertgeber Temperatur Lownible
        HONINN = LKENNL-2  ;Fehlerzaehler Innenfuehler Highnible
        LONVER = LKENNL-2  ;Fehlerzaehler Vereisungssensor   Lownible
        HONLFT = LKENNL-3  ;Fehlerzaehler Luftaustrittsfuehler Highnible
        LONFS  = LKENNL-3  ;Fehlerzaehler Funktionsschalter Lownibble
;                                   
        WORK   = BOTTOM             ; Die unteren Bytes sollten fuer Arbeitsregister
;                                     reserviert bleiben.
        .IF HONLFT<=(WORK+3) 
        RAM IST VOLL
        .ENDIF
;       
;
;
;------- EEPROM-ADRESSEN -----------------------------------------------
;
         KEY12 =000                 ; SCHLUESSELWORT 1(LBYTE), 2(HBYTE)
;
         EESTAT=001                 ; ADRESSE DES STATUSBYTES
         EEPKOR=006                 ; KORREKTURWERTE TEMP.-FUEHLER
         EEWDEN=007                 ; ENDE WABCO- UND KORREKTURDATEN
;
         FEHLSP=018                 ; 24 EEPROMADRESSE DES 1. FEHLERWORTES
;               019                 ; 25                   2. FEHLERWORT
;
         ECUADR=01A                 ; ADRESSE DER ECU INCL. PARITY(ODD)
;
         EEKEND=006                 ; 06 Ende Korrekturwerte Temp.-Fuehl.
         EEPEND=02E                 ; 46 ENDE DES PARAMETERBLOCKS
         EEKLST=032                 ; 50 ENDE STARTTEMPERATURKENNLINIE
         EEKLNO=036                 ; 54 ENDE NORMALBETRIEBSKENNLINIE
         EEKLZU=03A                 ; 59 ENDE Zusatzheizungskennlinie
         EEMEST=03D                 ; 62 RAM-ADRESSEN FUER MESSTECHNIKAUSGABE
         EEPTOP=03F                 ; 63 TOP OF THE EEPROM         
;
;........nachstehende Angaben sind  o h n e  die Pruefsumme !!
         WRDKOR=2                   ; Anzahl Woerter fuer Korrekturwerte
         WRDPAR=17                  ; Anzahl Woerter Parameter 
         WRDKEN=3                   ; Anzahl Woerter Luefterkennlinien
;
;******* VORGABEN FUER SERIELLE DATENUEBERTRAGUNG *******
;        
         QUARZ = 5         ; MHZ
         BAUDRT= 600       ; BAUD
;
;        DARAUS ERGEBEN SICH FOLGENDE WERTE FUER DIE 
;------- TIMER DER SERIELLEN DATENUEBERTRAGUNG  ---------->
;        
         TB    = 10000/(BAUDRT/100) ; BITLAENGE IN MIKROSEKUNDEN
         TC    = 10/QUARZ           ; ZYKLUS ZEIT
         TBL   = L(TB/2/TC)         ; HALBE BITLAENGE FUER TIMER REGISTER
         TBH   = H(TB/2/TC)         ; INTERRUPTS ERFOLGEN DANN IN BITABSTAND
;
;------- Timerwerte fuer 100 ms Zeitbasis fuer Blinkcodeausgabe
;
         TBBCL = L(25000)
         TBBCH = H(25000)      
;
;------- KONSTANTEN FUER SERVICE ROUTINE -------------------------------
;

         SYNC  =055                 ; SYNCHRONISATIONSBYTE
;         

;
;------- BEFEHLSSATZ FUER DATENUEBERTRAGUNG NACH altem WABCO-Protokoll
         ERROR =000                 ; FEHLERMELDUNG Z.B. UNGUELTIGER BEFEHL
         ECHO  =X'12                ; Echo-Befehl
         MSTEP =X'20                ; Steppermotor bedienen
         SENS0 =X'30                ; Sensoren Sollwert/Istwert
         SENS2 =X'32                ; Sensoren LFT/Aussen
         SENS4 =X'34                ; Geblaesesoll/ENDSCHALTER
         SENS8 =X'38                ; Versorgungssp./Zhz.-Eingang
         INPU0 =X'C0                ; Eingangsport 0 lesen
         INPU1 =X'C1                ; Eingangsport 1 lesen
         INPU2 =X'C2                ; Eingangsport 2 lesen
         INPU3 =X'C3                ; Eingangsport 3 lesen
         OUTP0 =X'E0                ; Ausgangsport 0 schreiben
         OUTP1 =X'E1                ; Ausgangsport 1 schreiben
         OUTP2 =X'E2                ; Ausgangsport 2 (PWM) beschreiben
         OUTP9 =X'E9                ; Loeschen des Statusbits im RAM !!!
;                                   ;  zum Aendern der WABCO-Daten
;===================================================================
; 
;
;_______________________________________________________________
;
        .form
;------------------- F e h l e r b e h an d l u n g ------------
;
        ERRKEN  = 00   ; Pruefsumme Start-/Luefterkennlinien
        ERRPMR  = 01   ; Pruefsumme Parametersatz 
        ERRSLT  = 02   ; 1. Fehler Sollwertgeber Temperatur (von 2)
        ERRVER  = 05   ; 1. Fehler Vereisungssensor (von 3)
        ERRINN  = 08   ; 1. Fehler Innenfuehler  (von 3)
        ERRLFT  = 11   ; 1. Fehler Luftaustrittsfuehler (von 3)
        ERRAUS  = 14   ; 1. Fehler Aussenfuehler (von 3)
        ERRFS   = 17   ; Fehler Funktionsschalter
        ERRSWC  = 18   ;        
        ERRSWO  = 19   ; 
        ERRKOR  = 20   ; Pruefsumme Korrekturwerte 
;
        HONINC  = X'10  ;Inkrement fuer Highnible
        V4x54V  = X'E6  ;Schwelle fuer Untersch. Abriss/warm Aussen/Innen
        V24V    = X'FE  ;Schaltschwelle fuer +Schluss der Sensoren (+X'FF)
        V200MV  = X'01  ;Schwelle fuer Masseschluss (Agnd auf ca. 100mV)
        ZUNDAN  = 000   ;Schwelle fuer "Zuendung an" (ADWERT Kl.15)
        SOLGUS  = X'10  ;untere Schwelle fuer Sollwertpotis
        SOLGOS  = X'F0  ;obere Schwelle  fuer Sollwertpotis
;
        NOTSLT  = X'9F  ;Vorgabe normierter Sollwert Temp.(=23Grd)
        NOTFKT  = X'05  ;Vorgabe fuer Stepperfaktor 
;
        .form
;------------------- C o n s t a n t e n  ----------------------
;
;-------Allgemein:
;
        HNIBBL  = X'F0  ; Maske fuer Hi-Nibble
        KEYWRD  = WDINIT; Watchdog-Schluesselwort = Initialisierung
        LNIBBL  = X'0F  ; Maske fuer Low-Nibble
        NEG     = 07    ; Test Vorzeichenbit
        SENBIT  = 03    ; Test ob Fehlergruppe Sensoren angesagt ist
        WDINIT  = X'D8  ; Schluesselwort Watchdog
;                       ; 11 01100 0  = X'D8 : Window - 64k Cycles
;                       ; Schluesselw. = 01100; Clock-Mon. disabled !
;
        ADWDEL  = 00A   ; DELAY-ZEIT A/D-WANDLER
        SCHDEL  = 0A5   ; DELAY-ZEIT FUER SCHUTZBESCHALTUNG
;        
;------ GRENZWERTE FUER SCHALTER AM A/D-WANDLER
;
        ZHZEIN = 080    ; FUER ZUSATZHEIZUNGSRELAIS
        ENDEIN = 080    ; FUER SCHRITTMOTORENDSCHALTER
;
;------ GRENZWERT FUER UNTERSPANNUNGSERKENNUNG
;
        UNT17V = 087    ; FUER UNTERSPANNUNGSERKENNUNG
;
;-------MESTEC:
        B10KB   = 03       ; Verzoegerung fuer Daten Messtechnik 
;
;-------FILTER
;
         INCAUS = 005      ; ca. 6.3 s/Grad INKREMENTE FUER Aussentemperatur
         INCINN = 00A      ; ca. 3   s/Grad                Innen-
         INCLFT = 00F      ; ca. 2.0 s/Grad                Luftaustritts-
         INCVER = 00A      ; ca. 3   s/Grad                Verdampfer-
         INCSLT = 010      ;                 SOLLWERT TEMPERATUR
         FIHYST = 003      ; zulaessige Hysterese im Filter (if enabled)
;
;-------GRENZWERTE FUER WASSERVENTIL
;
         MINWV  = 0        ; UNBEHANDELTER WERT FUER STELLUNG 'ZU'
         MAXWV  = 255      ;       "        "    "       "    'AUF' 
;
;-------REGLER
;
         MAXLFT = 0FF      ; MAX. LUFTAUSTRITTSTEMP. BEI UEBERLAUF VORGABE
         MINLFT = 000      ; MIN. LUFTAUSTRITTSTEMP. BEI UNTERLAUF VORGABE
         UMNORM = 05A      ; UMRECHNEN NORMIERUNG AUSSEN/INNEN AUF LFT (+30 GRAD)
         ITIBAS = (4100/(205*TC))    ; ZEITBASIS FUER INTEGRATION CA 410 MS
;
;-------- Zusatzheizungskennlinie
;
         VERZ2 = 014       ; Verzoegerung 2 - Einschaltdauer    [s]
         VERZ3 = 2         ; Verzoegerung 3 - Erhoehungsabstand [s]
;
;-------- Vereisungsschutz
;
         VERHYS = 00F      ; 5 Kelvin Hysterese fuer Vereisungsschutz
;       
;***********************************************************************
;
;
;        .=00                    ;ROM-Pointer auf Start
         .sect Code,ROM
;
START:
        SBIT    GIE,PSW         ;ERSTMAL ALLE INTERRUPTS ZULASSEN
        RPND                    ; SOFTWARETRAP PENDING-FLAG RUECKSETZEN
;
;.......Was ist mit dem Stackpointer ??
;       der bleibt auf 6F (=RAM-Ende) stehen
;
        LD      SP,#RAMEND
;          
;.......Initialisierung der Rechnerports 
        LD      B,#PORTLD       ;Pointer
        LD      [B+],#PLDATA    ;Grundstellung Port L
        LD      [B+],#PLCONFG   ;Configuration Port L
;
        LD      B,#PORTGD       ;
        LD      [B+],#PGDATA    ;Grundstellung Port G
        LD      [B+],#PGCONFG   ;Configuration Port G
;
        LD      B,#PORTCD       ;
        LD      [B+],#PCDATA    ;Grundstellung Port C
        LD      [B+],#PCCONFG   ;Configuration Port C
;
;
;.......TIMER 2 INITIALISIEREN
;
        LD       T2CNTRL,#00   ; TIMER2 
;       
;.......jetzt erstmal um den WATCH-Dog kuemmern !
;
        LD      WDSVR,#WDINIT   ;Watchdog initialisieren
;
;.......MICROWIRE UND TIMER 1 (PWM MODE) INITIALISIEREN
;
        LD      T1RAHI,#000     ; TIMER 1 HIGH BYTES
        LD      T1RBHI,#000     ; ALLE AUF 0 SETZEN
        LD      TMR1HI,#000     ;
        LD      CNTRL,#MWT1CF   ; TIMER1 IN MODE 1 STARTEN, MICROW. INITIALIS.
;                               ; Microwire enablen im EEPROM-UP "INIT"
;.......Clear RAM (ohne !  die Register 0 - 15 )
        LD      B,#RAMEND       ;Pointer auf RAM-Ende
LOOP:   LD      [B],#00         ;loeschen
        DRSZ    B               ;Pointer decrementieren
        JP      LOOP            ;Test Unterlauf      
;
;.......Sila anschalten und fuer 2 Sekunden anlassen
        SBIT    SILA,PORTLD     ;LAMPE AN
        SBIT    SILAIN,REGEXT   ;FLAG SETZEN
        LD      SECTIM,#2       ;2 SEKUNDEN
        LD      R4,#(10000/(205*TC)) ;SEKUNDEN TIMER
        LD      T1RBLO,#0            ; ISTWERT LUEFTER AUF NULL        
;        
;.......SCHALTER-FLAG-REGISTER vorladen
        LD      SWITCH,#07F
;
;.......STATUSBIT AUS EEPROM HOLEN
        LD       B,#FLAG01      ;POINTER SETZEN
        SBIT     STATUS,[B]     ;FLAG ERSTMAL SETZEN
        LD       ADRESS,#EESTAT ;ADRESSE DES STATUSBYTES IM EEPROM
        JSR      READ           ;STATUS HOLEN
        IFBIT    0,RDATL        ;IST STATUSBIT = 1
        RBIT     STATUS,[B]     ;DANN SIND NOCH KEINE DATEN EINGECHRIEBEN
;
;.......warten auf den IDLE-Timer T0 zur Synchronisierung
        LD      B,#ICNTRL       ;Pointer setzen
        RBIT    #T0PND,[B]      ;Ruecksetzen !
DEF00:  IFBIT   #T0PND,[B]      ;warten auf T0-Interrupt (ca. 8 msec !)
        JP      DEF01           ;wenn, dann WEITER
        JP      DEF00           ;wenn nicht, dann warten! 
;
DEF01:  RBIT    #T0PND,[B]      ;Ruecksetzen
        LD      WDSVR,#KEYWRD   ;Watchdog neu triggern 
        JSR     SONFUN          ;Sonderfunktionen (fuer die SILA)        
;
;.......Korrekturwerte aus EEPROM lesen 
         LD      B,#PARBEG       ;Anfangsadresse RAM
         LD      ADRESS,#EEPKOR  ;Endadresse Korrekturwerte EEPROM
         LD      COUNT,#WRDKOR   ;Anzahl zulesender Worte 
         JSR     EEINIT          ;lesen
         IFNC                    ;wenn kein Pruefsummenfehler
         JP      DEF05           ;dann weiter
         LD      A,#ERRKOR       ;Nummer Fehlerbit Parameterfehler
;        JSR     SETERR          ;
         SBIT    LINEAR,REGGBL   ; LINEARSTELLER-NOTBETRIEB
; 
;.......EEPROM lesen (Konstanten ins RAM uebernehmen)
DEF05:   LD      B,#PARBEG       ; PARAMETERBLOCK AUS EEPROM HOLEN
         LD      ADRESS,#EEPEND  ; EEPROM PARAMETERBLOCK ENDADRESSE
         LD      COUNT,#WRDPAR   ; ANZAHL DER ZU LESENDEN WORTE!
         JSR     EEINIT
         IFNC                    ; KEIN PRUEFSUMMENFEHLER
         JP      DEF10           ; JA,DANN WEITER
         LD      A,#ERRPMR       ; NUMMER FEHLERBIT Parameterfehler
         JSR     SETERR          ; SETZEN
         SBIT    LINEAR,REGGBL   ; LINEARSTELLER-NOTBETRIEB
         LD      STPFKT,#NOTFKT  ;VORGBABE EINES FESTEN FAKTORS FUER NOTBETRIEB
;
DEF10:   
         LD      B,#LKENNL+5     ; STARTTEMPERATURKENNLINIE AUS EEPROM HOLEN
         LD      ADRESS,#EEKLST  ; EEPROMBEREICHSENDADRESSE
         LD      COUNT,#WRDKEN   ; ANZAHL DER ZULESENDEN WORTE 
         JSR     EEINIT          ; sollte nicht laenger als 8 msec dauern!
         IFNC                    ; KEIN PRUEFSUMMENFEHLER
         JP      DEF20           ; JA,DANN WEITER
         LD      A,#ERRKEN       ; NUMMER FEHLERBIT
         JSR     SETERN          ; SETZEN und Pruefsummenfehler
;         
DEF20:   
;.......Analogspannung fuer Luefterendstufe auf 0% einstellen
        LD      A,#0            ;0 % einstellen
        SBIT    DIAGNO,FLAG01   ;nur kurz, damit in UP PWM nicht gefiltert wird
        JSR     PWM
        RBIT    DIAGNO,FLAG01
;
;........Initialisieren der Messwertregister usw. und die LSB's der
;        Messwertregister mit '7F vorladen.
USLOOP:  JSR     MESSEN          ;Initialisieren Messwertregister (SENSOREN)
         IFBIT   UNTSP,FLAG01    ;gibts eine Unterspannung ?  !!!!
         JP      USLOOP          ;ja, dann warten bis Spannung > 15 V  !!!!
                                 ; oder der Watchdog zuschlaegt  !!!!
;
         JSR     MESSER          ; MESSEN WAS ZU MESSEN IST (ENDSCHALTER)
         SBIT    #FILTON,REGRGL  ; jetzt die Filterfunktion aktivieren
         JSR     REFSTP          ; SCHRITTMOTOR REFRENZFAHRT
;        
;.......Laden der(s) Softwaretimer(s)
        LD      R7,#ITIBAS      ;Integrationszeitbasis laden
        LD      A,TINT          ; INTEGRATIONSZEIT-PARAMETER HOLEN
        X       A,ICNTR         ; UND IM ZEITZAEHLER ABLEGEN
        LD      A,TINTUR        ; INTEGRATIONSZEIT-PARAMETER HOLEN
        X       A,ICNTUR        ; UND IM ZEITZAEHLER ABLEGEN        
        LD      MESCNT,#20      ;Messtechnikausgabezaehler laden !         
;
;
        .form
;       ********************************************************
;       *                                                      *
;       *           H a u p t s c h l e i f e                  *
;       *                                                      *
;       ********************************************************
;
;.......1. Messprogramm
MAIN00: JSR     PSYNC           ;SNCHRO, WATCHDOG, STEPPER, R5BAUD, RPND
        JSR     SOFTIM          ;Zeitabhaengige Funktionen
        JSR     MESSEN          ;Daten einlesen (Aussen/Innen/LFT/KL15)
                                ;und filtern (Integralfilter)        
;
;.......2. Messprogramm und Normieren       
MAIN02: JSR     PSYNC           ;SNCHRO, WATCHDOG, STEPPER, R5BAUD, RPND
        IFBIT   UNTSP,FLAG01    ;BEI UNTERSPANNUNG WIRD UP NICHT
        JP      MAIN04          ;AUSGEFUEHRT
        JSR     MESSER          ;Daten einlesen (Sollw.Geb.,F-Schalter etc.)
        JSR     NORMI           ;Normieren
;                
;.......Kabinen- und unterlagerte Regelung
MAIN04: JSR     PSYNC           ;SNCHRO, WATCHDOG, STEPPER, R5BAUD, RPND
        IFBIT   UNTSP,FLAG01    ;BEI UNTERSPANNUNG WIRD UP NICHT
        JP      MAIN06          ;AUSGEFUEHRT 
        JSR     REGLER          ;Regelalgorythmus
        JSR     KOMPRE          ;Kompressoreinschaltbedingungen
;       
;.......Luefter, Zusatzheizung und sonsitiges
MAIN06: JSR     PSYNC           ;SNCHRO, WATCHDOG, STEPPER, R5BAUD, RPND
        IFBIT   UNTSP,FLAG01    ;BEI UNTERSPANNUNG WIRD UP NICHT
        JP      MAIN08          ;AUSGEFUEHRT 
        JSR     KLAPPS          ;Klappensteuerung
        JSR     LUEFTR          ;LUEFTERANSTEUERUNG IM NORMALBETRIEB
        JSR     ZUHEIZ          ;ZUSATZHEIZUNGSBETRIEB
        JSR     SONFUN          ;Sonderfunktionen
;
;.......Messtechnik 
MAIN08: JSR     PSYNC           ;SNCHRO, WATCHDOG, STEPPER, R5BAUD, RPND
        JSR     MESTEC          ;Datenausgabe !
        JP      MAIN00          ;zur Synchronisation
;
;
;
;       **************************************************************
;       * Name:       PSYNC                                          *
;       * Funktion: warten auf T0-Interrupt, WATCHDOG triggern,      * 
;       *           Schrittmotor anst., 5-Baud empf. und RPND        *
;       *                                                            *
;       **************************************************************
PSYNC:  IFBIT   #T0PND,ICNTRL   ;warten auf T0-Interrupt (ca. 8 msec !)
        JP      PSYNC1          ;wenn, dann WEITER
        JP      PSYNC           ;wenn nicht, dann warten! 
PSYNC1: RBIT    #T0PND,ICNTRL   ;Ruecksetzen
        LD      WDSVR,#KEYWRD   ;Watchdog triggern 
        JSR     STEPPR          ; SCHRITTMOTOR BEDIENEN
        JSR     R5BAUD          ; Abhorchen der Diagnaoseleitung
        RPND                    ; SOFTWARETRAP PENDING-FLAG RUECKSETZEN   
        RET                     ;
;
;
;
;
        .form
;
;===================================================================         
;         
;
;------------------- INTERRUPT-VERARBEITUNG ------------------
;
;        
;        
         .=00FF                     ; INTERRUPT EINSPRUNG
         
         PUSH     A                 ; AKKU AUF STACK
         LD       A,B
         PUSH     A                 ; B AUF STACK
         LD       A,X               
         PUSH     A                 ; X AUF STACK
         LD       A,PSW
         PUSH     A                 ; STATUS-WORD AUF STACK
         VIS                        ; VECTOR INTERRUPT SELECT
;
                 
;
;***********************************************************************   
;
;
;
;========================================================================
;      S E R V I C E - R O U T I N E 
;========================================================================
;
;  EMPFANGS-ROUTINE FUER BIDIREKTIONALE KOMMUNIKATION MIT DIAGNOSE-GERAET
;  MIT BEFEHLS SPRUNGVERTEILER
;        
;------- UP SERVIC -----------------------------------------------------
;
SERVIC:  LD       R0,#(2000/(41*TC));\
SERVI0:  IFBIT    T0PND,ICNTRL      ; |
         JP       SERVI1            ; | HIER WIRD SICHERHEITSHALBER NOCH
         JP       SERVI0            ; | EINE BITLAENGE (STOPBIT) DER 5-BAUD-
SERVI1:  RBIT     T0PND,ICNTRL      ; | ADRESSE ABGEWARTET, BEVOR DIE 
         LD       WDSVR,#KEYWRD     ; |     (HALLO WATCHDOG !!!)
         DRSZ     R0                ; | SCHLUESSELWOERTER GESENDET WERDEN
         JP       SERVI0            ;/
         JSR      SERVIN            ; SERVICE INITIALISIEREN (SYNC senden
                                    ; Schluesselwoerter und WABCO-Daten)
;
;........jetzt auf den naechsten Befehl vom Servicegeraet warten, WATCHDOG
;        wird im UP RXDAT und evtl. TXDAT bedient !!
RECEIV:  RPND                       ; reset PND-Flag
         JSR      RXDAT             ; K-LEITUNG ABHORCHEN, Daten im A/RXDATA
         LD       B,#RXBUFF         ; POINTER AUF BUFFER-ANFANG
         X        A,[B]             ; ablegen des Bytes !
         LD       A,[B]             ; und wiederholen 
;
;........Befehl fuers EEPROM empfangen ?
         AND      A,#X'C0           ;Ausblenden der unteren Bits
         IFEQ     A,#X'80           ;Schreibbefehl ?
         JMP      WPROMR            ;Befehl EEPROM schreiben
;
         IFEQ     A,#X'40           ;Lesebefehl ?
         JMP      RPROMR            ;Befehl EEPROM lesen          
;
;........Die restlichen Befehle ueber einen Sprungverteiler selektieren
         LD       A,[B]             ; Befehl nochmal reinladen 
         LD       R0,#L((BEFLIS)+0E); MAXIMAL 14 BEFEHLE + 1*Unbekannt
         LD       R1,#00E           ; SCHLEIFENZAEHLER
EXEC2:   LD       A,R0              ; BEFEHLS-POINTER LADEN
         LAID                       ; BEFEHL AUS LISTE LADEN
         IFEQ     A,[B]             ;  UND MIT BEFEHL AUS BUFFER VERGL.
         JP       VERTEI            ; WENN GLEICH, DANN ZUM VERTEILER
         DRSZ     R0                ; BEFEHLS-POINTER DEKREMENTIEREN
         RPND                       ; DUMMY SPRUNGZIEL
         DRSZ     R1                ; SCHLEIFENZAEHLER INKREMENTIEREN
         JP       EXEC2             ; WENN R1<>0 WEITER SUCHEN
;
;........hier gehts gleich durch den Sprungverteiler
VERTEI:  LD       A,R0              ; BEFEHLS-POINTER LADEN UND

         .sect SPRUNG,ROM,INPAGE

         ADD      A,#(SPRLIS-BEFLIS); umrechnen in Sprung-Pointer
         JID                        ; JUMP INDIRECT
;         
;------- LISTE DER AUSFUEHRBAREN BEFEHLE -------------------------------
;        MUSS AUF GLEICHER PAGE WIE 'LAID' BEFEHL STEHEN 
;   (ERROR-BEFEHL DIENT ALS SPRUNGZIEL FUER UNBEKANNTE BEFEHLE)
;
BEFLIS:  .BYTE    ERROR,ECHO,MSTEP,SENS0,SENS2,SENS4,SENS8
         .BYTE    INPU0,INPU1,INPU2,INPU3,OUTP0,OUTP1,OUTP2,OUTP9
;
;------- LISTE DER EINSPRUENGE FUER DIE BEFEHLE ------------------------
;        MUSS AUF GLEICHER PAGE WIE 'JID' BEFEHL STEHEN
;
SPRLIS:  .ADDR    ERRORJ,ECHOJ,MSTEPJ,SENS0J,SENS2J,SENS4J,SENS8J
         .ADDR    INPU0J,INPU1J,INPU2J,INPU3J,OUTP0J,OUTP1J,OUTP2J,OUTP9J
;        
;------- VON HIER ERFOLGEN DIE SPRUENGE IN DIE BEFEHLS-ROUTINEN --------
;
ERRORJ:  JMP      RECEIV            ; wenn unbekannt, Ignorieren 
ECHOJ:   JMP      ECHOR             ; Echo senden 
MSTEPJ:  JMP      MSTEPR            ; Stepper positionieren 
SENS0J:  JMP      SENS0R            ; AD-Kanal lesen (Soll/Innen)
SENS2J:  JMP      SENS2R            ; AD-Kanal lesen (Luftaustritt/Aussen)
SENS4J:  JMP      SENS4R            ; AD-Kanal lesen (Geblaesesoll/Endschalter)
SENS8J:  JMP      SENS8R            ; AD-Kanal lesen (Versorgungssp./Zhz-Heiz.)
INPU0J:  JMP      INPU0R            ; Lesen Eingangsport 0
INPU1J:  JMP      INPU1R            ; Lesen Eingangsport 1
INPU2J:  JMP      INPU2R            ; Lesen Eingangsport 2
INPU3J:  JMP      INPU3R            ; Lesen Eingangsport 3 (Softwareversion)
OUTP0J:  JMP      OUTP0R            ; Ausgangsport 0 ansteuern
OUTP1J:  JMP      OUTP1R            ; Ausgangsport 1 ansteuern
OUTP2J:  JMP      OUTP2R            ; Ausgangsport 2 ansteuern (Luefter)
OUTP9J:  JMP      OUTP9R            ; Statusbit im RAM ! loeschen
;
         .endsect
;
;
;       **************************************************************
;       *                                                            *
;       *               SERVICE INITIALISIERUNG                      *
;       *                                                            *
;       * Der Timer 2 wird auf die Baudrate fuer die serielle        *
;       * Kommunikation eingestellt. Ferner sollen hier die Grund-   *
;       * stellungen fuer Luefter, Ventile etc. eingenommen werden.  *
;       * Anschliessend werden das Synchronisationsbyte und die      *
;       * Schluesselworte gesendet.                                  *  
;       *                                                            *  
;       **************************************************************
;
SERVIN:  SBIT     DIAGNO,FLAG01     ; DIAGNOSE FLAG SETZEN
                                    ; TIMER 2 AUF BAUDRATE EINSTELLEN
         RBIT     #FILTON,REGRGL    ; Filter abschalten 
         LD       B,#TMR2LO         ; POINTER SETZEN
         LD       [B+],#TBL         ; T2 LBYTE     \
         LD       [B+],#TBH         ; T2 HBYTE      |
         LD       [B+],#TBL         ; T2 RA LBYTE   | Bitdauer
         LD       [B+],#TBH         ; T2 RA HBYTE   | in den 
         LD       [B+],#TBL         ; T2 RB LBYTE   | Timer laden
         LD       [B+],#TBH         ; T2 RB HBYTE  /
         LD       T2CNTRL,#094      ; TIMER2 STARTEN IN MODE1
                                    ; UNDERFLOW INTERRUPT         
         JSR      DELGO             ; DELAY 3.5 MSEC 
         LD       R5,#10            ; DELAY-ZAEHLER FUER STEPPER
         LD       A,#000
         JSR      PWM               ; LUEFTER STOPPEN
         LD       B,#PORTD          ; POINTER LADEN
         SBIT     KOMREL,[B]        ; KOMPRESSOR AUSSCHALTEN
         SBIT     SILA,PORTLD       ; SILA ANSCHALTEN
         LD       B,#STEPSL         ; B-POINTER LADEN
         LD       [B-],#000         ; SOLLSTELLUNG DES STEPPERS 
         LD       [B-],#000         ;  AUF VENTIL ZU
         JSR      DELGO             ; 3.5 msec Delay
         LD       A,#SYNC
         JSR      TXDAT             ; SYNCHRONISATIONSBYTE AUSGEBEN
         LD       ADRESS,#KEY12     ; SCHLUESSELWORTE LIEGEN IM EEPROM
         JSR      READ              ; SELBIGE LESEN
;
         JSR      DELGO             ; Delay 3.5 msec
         LD       A,RDATH           ; SCHLUESSELWORT High-Byte HOLEN
         JSR      TXDAT             ; SCHLUESSELWORT High-Byte SENDEN
         JSR      DELGO             ; Delay 3.5 msec
         LD       A,RDATL
         JSR      TXDAT             ; SCHLUESSELWORT Low-Byte SENDEN
         JSR      DELGO             ; Delay 3.5 msec
;
;........und nun die WABCO-Daten aus dem EEPROM hintendranhaengen
         LD       ADRESS,#003       ; EEPROM ADRESSE WABCO-Daten
         LD       R7,#003           ; R7 WIRD ALS SCHLEIFENZAEHLER GEBRAUCHT
IDENT1:  JSR      READ              ; EEPROM LESEN
         LD       A,RDATH           ; HIGH-BYTE HOLEN
         JSR      TXDAT             ; und ausgeben 
         LD       A,RDATL           ; LOW-BYTE HOLEN
         JSR      TXDAT             ; und ausgeben 
         DRSZ     ADRESS            ; EEPROM ADRESSE DEKREMENTIEREN
         NOP                        ; DUMMY SPRUNGZIEL
         DRSZ     R7                ; SCHLEIFENZAEHLER DEKREMENTIEREN
         JP       IDENT1
         RET                                    
;
;
;-----------------------------------------------------------------------
;
;
;
;
;========= INTERRUPT-VEKTOREN (01E0 - 01FF) ============================
;
         .=01E0
         .BYTE    H(STRAP),L(STRAP) ; 1E0  DEFAULT VIS 
         .BYTE    H(STRAP),L(STRAP) ; 1E2  PORTL/WAKEUP 
         .BYTE    H(STRAP),L(STRAP) ; 1E4  TIMER T3B    
         .BYTE    H(STRAP),L(STRAP) ; 1E6  TIMER T3A/UNDERFLOW 
;         .=01E8
         .BYTE    H(STRAP),L(STRAP) ; 1E8  TIMER2 T2B TRIGGER
         .BYTE    H(T2INTR),L(T2INTR) ;-1EA  TIMER2 A UNDERFLOW/T2A TRIGGER 
;
         .BYTE    H(STRAP),L(STRAP) ; 1EC
         .BYTE    H(STRAP),L(STRAP) ; 1EE 
         .BYTE    H(STRAP),L(STRAP) ; 1F0  FUTURE TBD
         .BYTE    H(STRAP),L(STRAP) ; 1F2  MICROWIRE BUSY LOW
         .BYTE    H(STRAP),L(STRAP) ; 1F4  TIMER T1B
         .BYTE    H(STRAP),L(STRAP) ; 1F6  TIMER T1A/UNDERFLOW
         .BYTE    H(STRAP),L(STRAP) ; 1F8  TIMER T0 UNDERFLOW
         .BYTE    H(STRAP),L(STRAP) ; 1FA  INTERRUPT AN G0
         .BYTE    H(STRAP),L(STRAP) ; 1FC  NMI
;         .=01FE
         .BYTE    H(STRAP),L(STRAP) ; 1FE  SOFTWARE-TRAP       
;        
;         .=0200                       ; PC AUF ENDE VEKTORLISTE
;
;***********************************************************************
        .form
;-----------------  U N T E R P R O G R A M M E  ---------------
;
;       **************************************************************
;       * Name:         SONFUN                                       *
;       * Funktion: Bearbeiten von externen Geraeten wie z. B.       * 
;       *           Kompressor, Fehlerlampe                          *
;       *                                                            *
;       *                                                            *
;       *                                                            *
;       * Input:                                                     *
;       *                                                            *
;       * Output:                                                    *
;       *                                                            *
;       * Veraendert:                                                *
;       **************************************************************
;
;....... KOMPRESSOR FUER AIRCONDITION
;
SONFUN:  
         LD       B,#PORTD         ; POINTER SETZEN 
         IFBIT    NOTKOM,REGGBL    ; darf der Kompressor eingeschaltet werden?
         JP       SONFK2           ; nein, weil der Vereisungssensor defekt ist
         IFBIT    KOMPON,REGEXT    ; SOLL KOMPRESSOR EINGESCHALTET WERDEN
         JP       SONFU0           ; einschalten versuchen
SONFK2:  SBIT     KOMREL,[B]       ; KOMPRESSOR AUSSCHALTEN         
         JP       SONFU1           ; und bei SiLa weiter
SONFU0:     
;....... hier wird noch geschaut, ob der Verdampfer eventuell vereist ist.

         LD       A,VERMIN         ; Abschalttemp. holen
         IFGT     A,VEREIS         ; Verdampfertemp.<=VERMIN,vereist ?
         JP       SONFK2           ; ja, dann Kompressor ausschalten
         RC                        ; nein, dann
         ADD      A,#VERHYS        ; Hysterese auf Schaltpkt.addieren
         IFC
         LD       A,#0FF           ; bei Ueberlauf begrenzen
         IFGT     A,VEREIS         ; Verdampfertemp. innerhalb der  Hysterese?
         JP       SONFU1           ; dann nix veraendern
         RBIT     KOMREL,[B]       ; sonst KOMPRESSOR EINSCHALTEN
;
;
;....... SILA
;
SONFU1:  
         LD       B,#PORTLD                  ; POINTER LADEN
         IFBIT    SILAIN,REGEXT              ; IST SILA NOCH AN VOM INITIALISIEREN
         JP       SONFU2                     ; JA, DANN
         JP       SONFU3                     ; NEIN
SONFU2:  IFEQ     SECTIM,#0                  ; SIND DIE ZWEI SEKUNDEN UM ?
         JP       SONFA2                     ; JA, DANN
         JP       SONFU4                     ; NEIN, DANN BLEIBT SIE AN
SONFA2:  RBIT     SILAIN,REGEXT              ; INITIALISIERUNG (2 SEC) ZUENDE
         JP       SONFA3                     ; DA SILAON=0 IST SILA GLEICH AUS
SONFU3:  IFBIT    SILAON,REGEXT              ; SOLL SILA ANGESCHALTET WERDEN
         JP       SONFU4                     ; JA
SONFA3:  RBIT     SILA,[B]                   ; NEIN, AUSSCHALTEN
         JP       SONFU5
SONFU4:  SBIT     SILA,[B]                   ; SILA ANSCHALTEN
;
;....... Taktventil
;        ^
;        ≥
;        ≥
;    auf ¥                      ⁄ƒƒƒƒƒƒƒƒƒƒƒƒƒƒƒƒø
;        ≥        zu            ≥      auf       ≥
;       ƒ≈ƒƒƒƒƒƒƒƒƒƒƒƒƒƒƒƒƒƒƒƒƒƒ≈ƒƒƒƒƒƒƒƒƒƒƒƒƒƒƒƒ≈ƒƒ> WVTIM
;       255                   WVSOL              0
; 
;
SONFU5:  
;     WVSOL noch invertieren fuer das Kennlinienunterprogramm
;     dieses arbeitet nur mit fallenden Kennlinien
         LD       A,WVSOL     ; Sollstellung (Heizleistung)  
         XOR      A,#0FF      ; invertieren, wg. fallender Kennlinie (s.SRNORM)
         X        A,WVSOL     ; und wieder ablegen
         
         LD       X,#WVSOL    ; Pointer auf Sollstellung vom Regler
         LD       WORK+1,#L(TABWV)  ;Anfang Tabelle Wasserventilkennlinie
         JSR      SRNORM      ; Berechnung des Kennlinienwertes (Taktzeit)!
         X        A,WVKORR    ; fuer Messtechnik ablegen

         LD       A,WVSOL     ; Sollstellung (Heizleistung)  
         XOR      A,#0FF      ; wieder zurueckinvertieren
         X        A,WVSOL     ; und wieder ablegen fuer Hysterese

         LD       A,WVKORR    ; Kennlinienwert wiederholen
; 
         LD       B,#PORTD    ; POINTER SETZEN 
         IFEQ     A,#MAXWV    ; soll Ventil ganz auf ?
         JP       SONFU7      ; ja, dann aufreissen
                              ; nein, dann 
         IFEQ     WVTIM,#255  ; sind die 10,4 s rum ?
         JP       SONFU8      ; dann Ventil schliessen

         IFGT     A,WVTIM     ; Solltaktzeit groesser als noch ablaufende Zeit
         JP       SONFU7      ; ja, dann Taktventil ausschalten (aufmachen)
         JP       SONFU8      ; nein, dann bleibt Ventil zu
SONFU7:  
         SBIT     WVAUF,[B]   ; Ventil ausschalten (oeffnen)
         JP       SONFU9
SONFU8:  
         RBIT     WVAUF,[B]   ; Ventil einschalten (schliessen)
SONFU9:         
         RET
;
;
;       --- Regelroutinen ---
;       Nach "RESET" steh'n die Parameter fuer die "Starttemperatur
;       kurve" im RAM !
;
;       **************************************************************
;       * Name:         REGLER                                       *
;       * Funktion: Vorgabe der Luftaustrittstemperatur und Be-      * 
;       *           rechnen der Wasserventilstellung. (unterlagerte  *
;       *           Regelung)                                        *
;       *                                                            *
;       * Input:  AUSSEN, INNEN, LFT, SOLTEM                         *
;       *                                                            *  
;       *         BWINT : Integralbeiwert                 \          *
;       *         BWSTR : Stoergroessenbeiwert             |Vorgabe  *
;       *         BWPRO : Proportionalbeiwert              |LFT      *
;       *         INTZT : Integrationszeit                /          *
;       *                                                            *  
;       *       /UHGBWT : Beiwert Heizgeraet&Wasserventil (K/rad)    *
;       *unter | UPFAKT : Proportionalanteil der Rueckfuehrung       *
;       *lager | UTINT  : Integrationsinterwall                      *  
;       *te reg| UINCV  : Schrittweite/Verstaerkung I-Anteil         *  
;       *elung | UINTMX : Begrenzung I-Anteil unterlagerte Regelung  *
;       *       \USTFKT : Einfluss Aussentemp. (Stoergroessenaufsch.)*
;       *                                                            *
;       * Output: ABWOF : Soll-/Istdifferenz Temperatur              *
;       *         LFTSOL: Vorgabe Luftaustritt (unterlagerte Regel.) *
;       *         ABWLFT: Soll-/Istdiffernz Luftaustrittstemp.       *
;       *         WVSOL:  Oeffnungsgrad des Wasserventil's           *
;       *                                                            *
;       *                                                            *
;       * Veraendert: A, B, X, WORK, WORK+1, WORK+2, WORK+3          *
;       *                                                            *
;       * Unterprog.: SUBOV                                          *
;       *                                                            *
;       **************************************************************
;
REGLER:  
;.......zu Anfang berechnen wir die SOLL/Istdiffernz, da die u. U. auch
;       noch woanders gebraucht wird
        LD      X,#SOLTEM       ;\
        LD      B,#INNEN        ;/ Pointer setzen
        JSR     SUBOV           ;Differenz [X] - [B] bilden
                                ;Abweichung ohne Offset (vorzeichenbehaftet)
        X       A,ABWOF         ;abspeichern
;
;.......Ist vielleicht die Zusatzheizung an ??
        IFBIT   #SWZHZ,SWITCH   ;
        JP      RGLF10          ;jump on WESBATO
        JMP     RGLF16          ;weiter
RGLF10: LD      WVSOL,#MAXWV    ;Wasserventil voll auf
        LD      B,#REGEXT       ;Pointer setzen
        SBIT    #ZHZON,[B]      ;Zusatzheizung einschalten setzen
;        RBIT    #KOMPAN,[B]     ;Kompressor aus usw. 
;
        IFBIT   #ZHBETR,REGRGL
        JP      RGLF12
        LD      B,#LKENNL+5     ;\
        LD      ADRESS,#EEKLZU  ; |Uebernehmen der ZHZ-Parameter
        LD      COUNT,#WRDKEN   ; |ins RAM
        JSR     EEINIT          ;/
        IFNC                    ; KEIN PRUEFSUMMENFEHLER
        JP      RGLF11          ; JA,DANN WEITER
        LD      A,#ERRKEN       ; NUMMER FEHLERBIT
        JSR     SETERN          ; SETZEN und Pruefsummenfehler
;
RGLF11: LD      B,#REGRGL       ;Pointer setzen
        SBIT    #ZHBETR,[B]     ;Flag "Zusatzheizungsparameter" geladen
;        RBIT    #ACBETR,[B]     ;\
        RBIT    #HZBETR,[B]     ;/die anderen ruecksetzen
;

RGLF12: 
        JMP     URGL30          ;jetzt noch die Schrittzahl fuer
                                ;den Stepper ausrechnen
;
;.......nun die Sonderfunktionen der DAF-ITC (Funktionsschalter)
;        Die Zusatzheizung ist offensichtlich nicht an
;        Die Frage ist nun, ob sie vielleicht gerade an war, und ob
;        die Mindestluftaustrittstemperatur ueberhaupt schon ueberschritten
;        wurde. Deshalb muss, wenn sie an war, erstmal die Starttemperatur-
;        kennlinie geladen werden.
;
RGLF16: IFBIT   ZHZON,REGEXT    ; WAR DIE ZUSATZHEIZUNG AN ?
        JP      RGLF17          ; DANN AUSMACHEN UND STARTTEMP.KL. LADEN
        JP      RGLF19          ; NEIN, DANN WEITER
RGLF17: RBIT    #ZHZON,REGEXT   ; Zusatzheizung ausschalten !
        LD      SECTIM,#0       ; SEKUNDENTIMER RUECKSETZEN
        LD      B,#LKENNL+5     ; STARTTEMPERATURKENNLINIE AUS EEPROM HOLEN
        LD      ADRESS,#EEKLST  ; EEPROMBEREICHSENDADRESSE
        LD      COUNT,#WRDKEN   ; INSGESAMT 4PARAMETER 
        JSR     EEINIT          ; LADEN
        IFNC                    ; KEIN PRUEFSUMMENFEHLER
        JP      RGLF18          ; JA,DANN WEITER
        LD      A,#ERRKEN       ; NUMMER FEHLERBIT
        JSR     SETERN          ; SETZEN und Pruefsummenfehler
;
RGLF18: LD      B,#REGRGL
        RBIT    ZHBETR,[B]      ; \    
;        RBIT    ACBETR,[B]      ;  | KEINE ANDEREN KENNLINIEN GELADEN
        RBIT    HZBETR,[B]      ; /
        RBIT    AHZEND,[B]      ; AUFHEIZPHASE NOCH NICHT ZUENDE (VIELLEICHT !)
;        
RGLF19: LD      X,#SWITCH
        LD      B,#WORK
        LD      A,[X]           ;\ = CPL A 
        XOR     A,#X'FF         ;/ (eins ist keins)
        OR      A,#%MSKALL      ;die anderen Bits setzen (Bit 0,1,7)
        X       A,[B]           ;Merken in [B] (=WORK)
;
        IFBIT   #SWAUS,[B]      ;
        JP      RGLF20          ;Schalter steht wohl woanders 
;.......Funktionsschalter steht auf "Regelung Aus", d.h. Wasserventil
;       schliessen und der Luefter wird manuell gesteuert.
        LD      A,[B]           ;und wiederholen
        XOR     A,#(%MSKAUS)    ;Test, ob auch nur das eine Schalterbit
        IFNE    A,#00           ;gesetzt ist (SW... = 0 ... 7 !!)
        JP      RGLF22          ;wenn nicht, weiter (F-Schalter ungueltig !)
;.......Funktionsschalter auf "Regelung aus"
        LD      WVSOL,#MINWV    ;Ventil zu !
;        RBIT    ACBETR,REGRGL   ; AC nicht zugelassen
        RBIT    LINEAR,REGGBL   ;kein Linearbetrieb des Wasserventils
        SBIT    #GBLMAN,REGGBL  ;Geblaese wird nun manuell gesteuert setzen
        JMP     URGL30          ;Stepperpostion berechnen
;
;
RGLF20: RBIT    #GBLMAN,REGGBL  ;der F-Schalter steht nicht (mehr) auf "AUS"
RGLF22: 
RGLF30: IFBIT   #SWFANM,[B]     ;
        JP      RGLF36          ;Schalter steht wohl woanders 
;.......Funktionsschalter steht auf "MANUELL", d.h. das Taktventil
;       wird nun linear zum Sollwert eingestellt !
        LD      A,[B]           ;und wiederholen
        XOR     A,#(%MSKFNM)    ;Test, ob auch nur das eine Schalterbit
        IFNE    A,#00           ;gesetzt ist
        JP      RGLF38          ;wenn nicht, weiter (F-Schalter ungueltig !)
;.......Funktionsschalter auf "Fan manuell"
        SBIT    #GBLMAN,REGGBL  ;Geblaese auf manuell setzen !
                                ;Berechnung in UP "Geblaese"
        SBIT    LINEAR,REGGBL   ;Linearbetrieb des Wasserventils
;        IFBIT   ACBETR,REGRGL   ;SIND WIR IM AC-BETRIEB?
;        JMP     REGL00          ;weiter im Regler, Berechnung LFTSOL, eine
                                ;evtl. "Startphase" muss! vom Steuerprogramm
                                ;fuers Geblaese     ~~~~~  ignoriert werden
                                ;da "FAN MAN" vorrangig ist.
        JMP     REGL00          ;UND DANN WEITER IM REGLER
;
RGLF36: RBIT    #GBLMAN,REGGBL  ;der F-Schalter steht nicht (mehr) auf "FANMAN"
RGLF38: IFBIT   #SWDRY,[B]      ;
        JP      RGLF44          ;Schalter steht wohl woanders 
;.......Funktionsschalter steht auf "DRY", d.h. der Kompressor
;       laueft immer (bis der Vereisungsschalter ihn abschaltet !)
        LD      A,[B]           ;und wiederholen
        XOR     A,#(%MSKDRY)    ;Test, ob auch nur das eine Schalterbit
        IFNE    A,#00           ;gesetzt ist
        JP      RGLF46          ;wenn nicht, weiter (F-Schalter ungueltig !)
;.......Funktionsschalter auf "DRY"
;
        RBIT    LINEAR,REGGBL   ;kein Linearbetrieb des Wasserventils
        JP      REGL00          ;weiter im Regler
;
RGLF44:                         ;der F-Schalter steht nicht (mehr) auf "DRY"
RGLF46: IFBIT   #SWAUTO,[B]     ;
        JP      RGLF52          ;Schalter steht wohl woanders 
;.......Funktionsschalter steht auf "AUTO" d.h. alles automatisch 
        LD      A,[B]           ;und wiederholen
        XOR     A,#(%MSKAUT)    ;Test, ob auch nur das eine Schalterbit
        IFNE    A,#00           ;gesetzt ist
        JP      REGL00          ;wenn nicht, weiter (F-Schalter ungueltig !)
;.......Funktionsschalter auf "AUTO"
        RBIT    LINEAR,REGGBL   ;kein Linearbetrieb des Wasserventils
        SBIT    #GBLAUT,REGGBL  ;Automatik im Geblaeseregister setzen
;        IFBIT   ACBETR,REGRGL   ;SIND WIR IM AC-BETRIEB?        
;        JP      REGL00          ;weiter im Regler
;        RBIT    KOMPON,REGEXT   ;SONST AC AUSSCHALTEN, FALLS VORHER "DRY"
        JP      REGL00          ;UND DANN WEITER IM REGLER        
;
RGLF52: RBIT    #GBLAUT,REGGBL  ;
;
;-----------------   E n d e   F u n k t i o n s s c h a l t e r   -----------
REGL00:
;.......ist etwa ein Fehler aufgetreten oder Manuell-Betrieb? Mal schauen !
;        
REGL04:
        IFBIT   LINEAR,REGGBL   ;Linearbetrieb aufgrund Manuellbetrieb?
        JP      LINFUN          ;dann gibt der Sollwertsteller Wasserventilst.
        IFBIT   NOTLIN,REGGBL   ;liegt ein Notbetrieb vor?
        JP      LINFUN          ;ja, also dann
        JP      REGL10          ;sonst normale Regelung
;
;
;.......hier sind die Notbetriebsarten
;
; ADSOLT bewegt sich zwischen 40 und 182
;
LINFUN: 
        LD      A,ADSOLT        ;auf Ub normierter AD-Wert vom Sollwertgeber
        SC
        SUBC    A,#032          ;50 abziehen
        IFNC
        LD      A,#MINWV        ;Unterlauf
        RC
        RLC     A               ;Wert verdoppeln
        IFC
        LD      A,#MAXWV        ;Ueberlauf
        X       A,WVSOL         ;ADW-Wert des Sollwertst. = WVSOL vorgeben !
        JMP     URGL30          ;und berechnen der Ventilstellung
;
;--------------------   B e g i n n   d e r   R e g e l u n g   --------------
REGL10:
        LD      A,ABWOF         ;Vorzeichenbehaftete Differenz 
        ADD     A,#X'80         ;Offset drauf   
        LD      B,#WORK         ;OFFSETbehaftete Differenz (0 = 80Hex)
        X       A,[B]           ;in WORK merken !
;
;damit bei Sollwertverringerung schneller gekuehlt
;werden kann, d.h. mit temperierter Luft, werden positive Integralanteile
;in beiden Regelkreisen genullt.
;entsprechend soll bei Sollwertspruengen nach oben
;im Klimabetrieb schneller mit der warmen Aussenluft aufgeheizt werden
;koennen, es werden also die negativen Integralteile geloescht
;
;
        LD      A,#03           ;Sollwertaenderung muss > 1 Grad sein
        IFGT    A,DISWSW        ;war's ne grosse Sollwertaenderung
        JMP     REGL32          ;nein, dann normal weiter
                                ;ja, dann evtl. I-Anteile loeschen
        LD      A,[B]           ;Offsetbehaftete Soll/Istdifferenz 
        IFGT    A,#07E          ;nicht mehr als 0,7 Grad ueber Soll?
        JP      REGL12          ;ja, dann eventuell zu kalt
        JP      REGL19          ;nein, dann ggf. positive I-Anteile loeschen
REGL12:
        IFGT    A,#082          ;ist es mehr als 0,7 Grad zu kalt
        JP      REGL13          ;ja, dann ggf. negative I-Anteile loeschen
        JP      REGL32          ;nein, dann normal weiter
REGL13:
        LD      B,#INTLR        ;Pointer auf Integral ueberlagerter Regelkreis
        IFBIT   NEG,[B]         ;negativ ?
        JP      REGL14          ;ja, dann dies Integral kappen
        JP      REGL15          ;wenn positiv, dann nicht kappen
REGL14:
        CLR     A
        X       A,[B]           ;Integral loeschen
REGL15: 
        LD      B,#INTLUR       ;Pointer auf Integral unterlagerter Kreis
        IFBIT   NEG,[B]         ;negativ ?
        JP      REGL16          ;ja, dann Integral loeschen
        JMP     REGL32          ;nein, dann sofort in den Regler
REGL16:
        CLR     A
        X       A,[B]           ;Integral loeschen
        JMP     REGL32          ;und weiter im Regler    
;
REGL19:                         ;mehr als 0,7 Grad zu warm
        LD      B,#INTLR        ;Pointer auf Integral ueberlagerter Regelkreis
        IFBIT   NEG,[B]         ;negativ ?
        JP      REGL20          ;ja, dann dies Integral nicht kappen
                                ;wenn positiv, dann kappen
        CLR     A
        X       A,[B]           ;Integral loeschen
;
REGL20: LD      B,#INTLUR       ;Pointer auf Integral unterlagerter Kreis
        IFBIT   NEG,[B]         ;negativ ?
        JP      REGL38          ;dann sofort in den Regler
;
        CLR     A
        X       A,[B]           ;Integral loeschen
        JP      REGL38          ;und weiter im Regler    
;
;
;...... Ist die Anlage noch in der Aufheizphase ? 
;
REGL32: IFBIT   #AHZEND,REGRGL   
        JP      REGL38          ;Aufheizphase vorbei !
;
;.......Test, ob LFT die Starttemperatur (f/Aussen) ueberschritten hat 
        LD      A,AUSSEN        ;Wert der X-Achse
        LD      B,#STARTK       ;Zeiger auf Knickpunkt Kennlinie
        SBIT    KLEIN1,FLAG02   ; KENNLINIENSTEIGUNG < 1
        JSR     KENNLI          ;Starttemperatur berechnen
        IFGT    A,LFT           ;ist nun im Akku !
        JP      REGL36          ;Starttemperatur noch nicht erreicht
        JP      REGL38          ;Beginn der "normalen" Regelung
;
;.......Wasserventil oeffnen, Geblaese auf Minimaldrehzahl stellen
REGL36: LD      WVSOL,#MAXWV    ;
        LD      LFTSOL,#0FF     ;Ausblassollwert auf Maximum wg. Kompressor
        LD      DIATLS,#0FF     ;Diff.LFTSOL-AUSSEN auch auf Max.
        JMP     URGL30          ;zum Berechnen der Stepperstellung  
;
;.......Startphase auch schon vorbei ! Loeschen der Startphasenbedingungen
;       und dann aber los !!
REGL38: SBIT    #AHZEND,REGRGL  ;Flag "Aufheizphase" vorbei setzen
;
        IFBIT   #HZBETR,REGRGL  ;
        JP      REGL40          ;Heiz-Parameter schon drin !
        LD      B,#LKENNL+5     ;\
        LD      ADRESS,#EEKLNO  ; |Uebernehmen der Heiz-Parameter
        LD      COUNT,#WRDKEN   ; |ins RAM
        JSR     EEINIT          ;/
        IFNC                    ; KEIN PRUEFSUMMENFEHLER
        JP      REGL39          ; JA,DANN WEITER
        LD      A,#ERRKEN       ; NUMMER FEHLERBIT
        JSR     SETERN          ; SETZEN und Pruefsummenfehler
;
REGL39: LD      B,#REGRGL       ;Pointer laden
        SBIT    #HZBETR,[B]     ;Flag "Heizparameter geladen" setzen
;        RBIT    #ACBETR,[B]     ;\
        RBIT    #ZHBETR,[B]     ;/ die anderen ruecks !
;
;
REGL40: 
        LD      B,#ABWOF        ;vorzeichenbehaftete Abweichung   
        IFBIT   NEG,[B]         ;Abweichung negativ, d.h. Ist > Soll
        JP      REGL50          ;dann rein in den Regler
        LD      A,[B]           ;sonst positive Abweichung laden = zu kalt
        IFGT    A,LKENNL+1      ;>BEGINN BEREICH MIN.LUEFTERSP. HEIZBETRIEB 
        RBIT    #MITEMP,REGRGL  ;ueberschritten, also wieder die Mindesttemp.
                                ;am Luftaustritt einhalten
;
;.......Vorgabe der Luftaustrittstemperatur
;       LFTSOL = SOLTEM+(SOLTEM-AUSSEN)*BWSTR+(SOLTEM-INNEN)*BWPRO+INTLR*BWINT
;                   |    \_________________/   \________________/   \________/
;               Konstante         |             Proportionalteil         |
;                             Stoergrosse                            I-Anteil
;
;     Achtung: Unterschiedliche Normierung (AUSSEN/INNEN <-> LFT) !!
; *********>   (Aussen/Innen : -30 ... +55    LFT: 0....85)    <************
;
;.......Konstante
REGL50: 
        LD      X,#SOLTEM       ;
        LD      B,#WORK+1       ;WORK & WORK+1=Ergebnis (16Bit mit Vorzeichen)
        LD      A,[X]           ; MSB    LSB
        X       A,[B-]          ;Konstantenteil im LSB merken
        LD      [B],#00         ;loeschen MSB !
;
;.......Stoergroesse
        LD      B,#AUSSEN       ;Pointer neu setzen !
        JSR     SUBOV           ;Differenz [X]-[B] bilden (Ergebnis in A)
        LD      B,#WORK+2       ;
        X       A,[B+]          ;Differenz in WORK+2
        LD      A,BWSTR         ;
        X       A,[B-]          ;Stoergroessenbeiwert in WORK+3
        JSR     RVMULT          ;vorzeichenbehaftete Multiplikation
                                ;Ergebnis in WORK+2 
                                ;(gerundeter vorzeichenbehaft. 8 Bit Wert)
        JSR     MALTWO          ;verdoppeln des vorzeichenbehafteten Wertes
        JSR     RGLADD          ;[B] auf (WORK & WORK+1) addieren 
;
;.......Proportionalanteil
        LD      B,#ABWOF        ;Soll-/Istdifferenz (SOLTEM-INNEN)
        LD      A,[B]           ;in den Akku laden !
        LD      B,#WORK+2       ;
        X       A,[B+]          ;Differenz in WORK+2
        LD      A,BWPRO         ;
        X       A,[B-]          ;Proportionalbeiwert in WORK+3
        JSR     RVMULT          ;vorzeichenbehaftete Multiplikation [B]*[B+1]
        JSR     MALTWO          ;verdoppeln des vorzeichenbehafteten Wertes
        JSR     RGLADD          ;[B] auf (WORK & WORK+1) addieren     
;
;.......Integralanteil
        LD      X,#TINT         ;Zeiger auf Beginn Parametersatz fuer
        LD      B,#ICNTR        ;Integrationszeit-Counter Regelung 
        CLR     A               ;
        IFNE    A,[B]           ;Integrationszeit abgelaufen ?
        JMP     REGL60          ;nee, weiter im Rechenprogramm
;
;.......Int-Zeit abgelaufen, integrieren ! Zuerst aber mal die zulaessigen
;       Toleranzen in WORK+2 (positiv) und WORK+3 (negativ) ablegen.
;       In WORK/WORK+1 steht das bisherige Zwischenergebnis !!!!
        LD      A,[X-]          ;Integrationszeitcounter mit Zeit, Zeiger auf INNTOL
        X       A,[B]           ;aus Parametertabelle nachladen
        LD      B,#WORK+2       ;da soll'n die Toleranzen hin
        LD      A,[X]           ;Toleranz laden
        X       A,[B+]          ;abspeichern, B auf WORK+3
        LD      A,[X-]          ;Toleranz nochmal, Zeiger auf Schrittweite
        XOR     A,#X'FF         ;\
        INC     A               ;/ Zweierkomplement 
        X       A,[B]           ;unteres Toleranzband in WORK+1
        LD      B,#ABWOF        ;Zeiger auf Soll/Istabweichung
        JSR     INTEGR          ;Integrationsunterprogramm
; notwendiger RAM-Aufbau:     B-Pointer     X-Pointer
;               (bei Aufruf ->) ABWOF         TINT   (=Beginn Param.-Tab.)
;                            -1 INTLR      -1 INNTOL 
;                                          -1 INCR   (X bei Aufruf des UP's)
;
;
;.......ist nun das Carry gesetzt, so ist die Regelung ausserhalb des 
;       vorgegebenen Toleranzbandes !
        IFC                     ;wenn ausserhalb des Toleranzbandes
        JP      REGL60          ;passiert nix!
        IFBIT   #HEATON,REGRGL  ;und wenn die Aufheizphase schon verbei
        JP      REGL60          ;ist, passiert auch nix !
;.......beim 1. "Eintauchen" ins Toleranzband (=Aufheizphase beendet) wird
;       der I-Anteil der Regelung einfach halbiert, um so einen evtl.
;       Ueberschwinger abzumildern ! Danach das Bit "HEATON" setzen, damit
;       dies nicht staendig passsiert.
        RC                      ;ist ja eigenlich schon Null (aber trotzdem)
        LD      A,INTLR         ;Integral holen !
        IFBIT   #NEG,A          ;wenn's Integral Negativ ist, dann
        SC                      ;ne "1" reinrotieren (dann bleibt's negativ)
        RRC     A               ;positives wird ab-, negatives aufgerundet
                                ;dieses ist aber tolerierbar
        X       A,INTLR         ;neuen Wert merken
        SBIT    #HEATON,REGRGL  ;und nun noch das Bit setzen
;
;
REGL60: LD      A,INTLR         ;Integral laden
        LD      B,#WORK+2       ;
        X       A,[B+]          ;Integral in WORK+2
        LD      A,BWINT         ;
        X       A,[B-]          ;Integralbeiwert in WORK+3
        JSR     RVMULT          ;vorzeichenbehaftete Multiplikation
        JSR     RGLADD          ;[B] auf (WORK & WORK+1) addieren     
;
;.......In WORK (MSB) und WORK+1 (LSB) steht jetzt die berechnete Luft-
;       austrittstemperatur in der Normierung wie fuer Aussen-/Innen-
;       temperatur. Zum "Umnormieren" sind 30 Grd abzuziehen. Bei einer
;       Aufloesung von ca. 3 Bit/Grd sind das 90 !
        LD      B,#WORK+2       ;
        LD      [B],#-UMNORM    ;fuer Umnormierung
        JSR     RGLADD          ;Aufaddieren der Regelabweichung !
        LD      A,[X+]          ;Ergebnis MSB laden (X im UP RGLADD gesetzt)
        IFEQ    A,#00           ;Test auf Ueberlauf 
        JP      REGL68          ;wenn 0 dann LSB = LFTSOL !
;
        IFBIT   #NEG,A          ;etwa das Negativ-Flag gesetzt !
        JP      REGL66          ;Au backe ! (LFTSOL < 0 ?!)
        
;
;.......Ueberlauf ! Berechnete Luftaustrittstemperatur soll ueber 85 Grad
;       liegen, so das hier erstmal eine Begrenzung stattfindet !
        LD      WORK+1,#MAXLFT  ;Maximalwert ins LSB packen
        JP      REGL68
;
;.......Unterlauf ! Berechnete Luftaustrittstemperatur soll unter 0 liegen !
REGL66: LD      WORK+1,#MINLFT  ;Minimalwert ins LSB packen
;
;.......in WORK+1 steht nun die Luftaustrittstemperatur, die evtl. noch 
;       durch die Kennlinie begrenzt, bzw. Mindestaustrittstemperatur ein-
;       zuhalten ist !!  Pointer X zeigt auf LSB (WORK+1)
REGL68: LD      A,[X]           ;Laden des berechneten Wertes
        LD      X,#LFTSOL       ;Zeiger setzen
        X       A,[X]           ;erstmal als richtig merken
;
        LD      B,#TLFTK        ;Knickpunkt
        LD      A,AUSSEN        ;Wert der X-Achse !
        SBIT    KLEIN1,FLAG02   ; KENNLINIENSTEIGUNG < 1
        JSR     KENNLI          ;maximal zulaessige LFT berechnen
        ADD     A,#080          ; OFFSET DRAUFADDIEREN, DA KENNLINIE EINEN WERT LIEFERT,
                                ; DER IM BEREICH -128 BIS +127 LIEGT
        LD      B,#LFTSOL       ;
        IFGT    A,[B]           ;berechnete Temperatur im zulaessigen Bereich
        JP      REGL70          ;o.k. auf evtl. Unterlauf abfragen
        X       A,[B]           ;wenn nicht, maximal zulaessige rein !
        JP      URGL00          ;ab zur unterlagerten Regelung
;
;.......wenn Flag "Mindestaustritt einhalten" gesetzt, dann auf Unter-
;       temperatur testen.
REGL70: IFBIT   #MITEMP,REGRGL  ;
        JP      URGL00          ;nix mit Mindesttemperatur !
;
        LD      A,LFTMIN        ;Mindesttemperatur in den Akku
        IFGT    A,[B]           ;
        X       A,[B]           ;wenn A >, dann ist LFTMIN=LFTSOL !!
;        
;.......Nun steht in LFTSOL die gewuenschte Luftaustrittstemperatur. Eine
;       "unterlagerte Regelung" hat nun die Aufgabe diese Temperatur am Aus-
;       gang bereit zustellen.
;
;---------  D i e  u n t e r l a g e r t e  R e g e l u n g  ---------------
;
;.......Vorgabe der Ventilposition          
;   WVSOL = LFTSOL*URHZB+(LFTSOL-AUSSEN)*URSBW+(LFTSOL-LFT)*URPBW+INTLUR*URIBW
;               |         \_________________/   \_____________/    \________/
;           Konstante              |            Proportionalteil        |
;                             Stoergroesse                          I-Anteil
;
;.......WORK & WORK+1=Ergebnis (16Bit mit Vorzeichen)
;
;.......Berechnen der Soll-/Istdifferenz
URGL00: 
        LD      X,#LFTSOL       ;\
        LD      B,#LFT          ;/ Pointer setzen
        JSR     SUBOV           ;Differenz [X] - [B] bilden
        LD      B,#ABWLFT       ;Abweichung ohne Offset (vorzeichenbehaftet)
        X       A,[B]           ;abspeichern
        LD      A,[B]           ;und wieder in den Akku
;
;.......Konstante
        LD      B,#WORK+2       ;
        LD      X,#LFTSOL       ;
        LD      A,[X]           ;            
        X       A,[B+]          ;berechneter LFT-Sollwert in WORK+2
        LD      A,URHZB         ;Heizgeraetebeiwert 
        X       A,[B-]          ;in WORK+3
        JSR     RMULT           ;Multiplikation OHNE VORZEICHEN
                                ;notwendig wegen LFTSOL > 0 !)
        LD      A,[B-]          ;Ergebnis MSB Multiplik. laden, B auf WORK+1
        X       A,[B-]          ;LSB in WORK+1 merken, Zeiger auf WORK
        LD      [B],#00         ;MSB loeschen 
;       Das UP 'RGLADD' kann hier nicht benutzt werden, da dieses UP vor-
;       zeichenbehaftete Werte aufaddiert, der Konstantenteil aber nur positiv
;       ist und den vollen Wertebereich benutzt!
;
        
;.......Stoergroesse Aussentemp.
        LD      A,LFTSOL
        RC
        ADC     A,#90           ;wegen ungleicher Normierung von LFTSOL
        IFC                     ;bei Ueberlauf
        LD      A,#0FF          ;begrenzen
        X       A,DIATLS        ;RAMzelle wird als Zwischenspeicher missbraucht
        LD      X,#DIATLS       ;zeiger auf umnormierten LFTSOL
        LD      B,#AUSSEN       ;Pointer neu setzen !
        JSR     SUBOV           ;Differenz [X]-[B] bilden (Ergebnis in A)
        LD      B,#WORK+2       ;
        X       A,[B]           ;Differenz in WORK+2
        LD      A,[B+]          ;und wiederholen
        ADD     A,#080          ;Offset draufaddieren fuer einfacheren CMP
        X       A,DIATLS        ;abspeichern fuer Kompressoreinschaltbeding.
        LD      A,URSBW         ;
        X       A,[B-]          ;Stoergroessenbeiwert "unterl. Reg." in WORK+3
        JSR     RVMULT          ;vorzeichenbehaftete Multiplikation
                                ;Ergebnis in WORK+2 
                                ;(gerundeter vorzeichenbehaft. 8 Bit Wert)
        JSR     MALTWO          ;verdoppeln des vorzeichenbehafteten Wertes
        JSR     RGLADD          ;[B] auf (WORK & WORK+1) addieren 
;
;.......Proportionalanteil
        LD      B,#ABWLFT        ;Soll-/Istdifferenz (LFTSOL-LFT)
        LD      A,[B]           ;in den Akku laden !
        LD      B,#WORK+2       ;
        X       A,[B+]          ;Differenz in WORK+2
        LD      A,URBPW         ;
        X       A,[B-]          ;Stoergroessenbeiwert in WORK+3
        JSR     RVMULT          ;vorzeichenbehaftete Multiplikation
        JSR     MALTWO          ;verdoppeln des vorzeichenbehafteten Wertes
        JSR     RGLADD          ;[B] auf (WORK & WORK+1) addieren     
;
;.......Integralanteil
        LD      X,#TINTUR       ;Zeiger auf Beginn Parametersatz fuer
        LD      B,#ICNTUR       ;Integrationszeit-Counter Regelung 
        CLR     A               ;
        IFNE    A,[B]           ;Integrationszeit abgelaufen ?
        JP      URGL10          ;nee, weiter im Rechenprogramm
;
;.......Int-Zeit abgelaufen, integrieren ! Zuerst aber mal die zulaessigen
;       Toleranzen in WORK+2 (positiv) und WORK+3 (negativ) ablegen.
;       In WORK/WORK+1 steht das bisherige Zwischenergebnis !!!
        LD      A,[X-]          ;Integrationszeitcounter mit Zeit,Zeifer auf LFTTOL
        X       A,[B]           ;aus Parametertabelle nachladen
        LD      B,#WORK+2       ;da soll'n die Toleranzen hin
        LD      A,[X]           ;Toleranz laden
        X       A,[B+]          ;abspeichern, B auf WORK+3
        LD      A,[X-]          ;Toleranz nochmal, Zeiger auf Schrittweite
        XOR     A,#X'FF         ;\                        ! bei LFT evtl. als !
        INC     A               ;/ Zweierkomplement       ! unteres Band "0"  !
        X       A,[B]           ;unter. T.-Band in WORK+1 ! vorgeben !        !
        LD      B,#ABWLFT       ;Zeiger auf Soll/Istabweichung
        JSR     INTEGR          ;Integrationsunterprogramm
; notwendiger RAM-Aufbau:     B-Pointer     X-Pointer
;               (bei Aufruf ->) ABWLFT        TINTUR  (=Beginn Param.-Tab.)
;                               INTLUR        LFTTOL 
;                                             INCUR   (X bei Aufruf des UP's)
;
;
URGL10: LD      A,INTLUR        ;Integral laden
        LD      B,#WORK+2       ;
        X       A,[B+]          ;Integral in WORK+2
        LD      A,URIBW         ;
        X       A,[B-]          ;Integralbeiwert "unterlagerte Reg." in WORK+3
        JSR     RVMULT          ;vorzeichenbehaftete Multiplikation
        JSR     RGLADD          ;[B] auf (WORK & WORK+1) addieren     
;
;.......In WORK (MSB) und WORK+1 (LSB) steht jetzt die berechnete Wasserventil-
;       stellung. Muss nun noch an das Stellglied angepasst werden.
;        Berechnet werden 0 - 255 !
;        Umrechnung in Motorschritte mit Wert aus Parametertabelle
        LD      A,[X+]          ;Ergebnis MSB laden (X im UP RGLADD gesetzt)
        IFEQ    A,#00           ;Test auf Ueberlauf 
        JP      URGL20          ;wenn 0 dann LSB Iin Ordnung
;
        IFBIT   #NEG,A          ;etwa das Negativ-Flag gesetzt !
        JP      URGL18          ;Au backe ! (WVSOL = 00?!)
;
;.......Ueberlauf ! D. h. es sollte reichen, wenn das Ventil voll geoeffnet
;       wird.
        LD      WORK+1,#MAXWV   ;Maximalwert ins LSB packen
        JP      URGL20
;
;.......Unterlauf ! Berechnete Luftaustrittstemperatur soll unter 0 liegen !
URGL18: LD      WORK+1,#MINWV   ;Minimalwert ins LSB packen
;
;.......liegt neue Wasserventilstellung ausserhalb der Hysterese?
;       dann wird neuer wert uebernommen. 

URGL20: LD      B,#WVSOL        ;Pointer setzen (X auf WORK+1)
        JSR     SUBOV           ;Differenz bilden 
        IFBIT   #NEG,A          ;Differenz negativ ?
        JP      URGL22          ;noch nicht!
        XOR     A,#X'FF         ;\
        INC     A               ;/jetzt aber !
URGL22: RC                      ;
        ADC     A,STPRUH        ;Ruhebereich Stepper addieren
        IFC        
        JP      URGL30          ;noch im Ruhebereich !
;
;.......Ruhebereich verlassen, neuen Wert uebernehmen
        LD      A,[X]           ;neue berechnete Wasserventilstellung
        X       A,[B]           ;merken in WVSOL !
        LD      A,[B]           ;und wiederholen
;
URGL30:                         ;ausser bei REHEAT (DRY) kein Gegenheizen
        IFBIT   KOMPAN,REGEXT   ;ist der Kompressor angefordert? (s. KOMPRE)
        JP      URGL35          ;ja, dann Wasserventil zumachen
        JP      URGL40          ;nein, dann Ende
URGL35:
        LD      WVSOL,#MINWV    ;Wasserventil schliessen
        SBIT    MITEMP,REGRGL   ;Mindestausblastemp. braucht nicht mehr
                                ;eingehalten zu werden
URGL40: RET                     ;das war's !
;
;
;
;       **************************************************************
;       * Name:         INTEGR                                       *
;       * Funktion: Test, ob Abweichung vom Sollwert eine vorgege-   * 
;       *           bene Abweichung ueberschritten hat. Unter Be-    *
;       *           ruecksichtigung der Wasserventilstellung wird    *
;       *           dann das Integrationsregister mit dem in [X]     *
;       *           stehenden Wert erhoeht/erniedrigt (mit Ueber-    *
;       *           mit Ueberlaufkontrolle)                          *
;       *                                                            *
;       * Input:  B = Pointer auf ABWOF,INTLR                        *
;       *                   (bzw. ABWFUR,INTLUR)                     *
;       *         X = Pointer auf Schrittweite INT-Register          *  
;       *    WORK+2 = positiv zulaessige Abweichung                  *
;       *    WORK+3 = negativ zulaessige Abweichung                  *
;       *                                                            *
;       * Output: Zeiger B: B-1                                      *
;       *         Zeiger X: X                                        *
;       *         Integrationsregister                               *
;       *         Carry =1 wenn Istwert ausserhalb der Toleranz      *
;       *         Carry =0 wenn IStwert innerhalb der Toleranz       *
;       *                                                            *
;       * Veraendert: A, B,Carry                                     *
;       *                                                            *
;       **************************************************************
;
INTEGR: 
;.......Test, ob Abweichung die zulaessige Toleranz ueberschritten hat
        RC                      ;fall's es hier gleich raus geht (IST=SOLL)
        CLR     A               ;
        IFEQ    A,[B]           ;Abweichung = 0 ??
        RET                     ;das war's (raus mit Carry=0)
        LD      A,[B-]          ;Abweichung laden,Zeiger auf Integral 
        IFBIT   #NEG,A          ;Abweichung negativ ?
        JP      INTG50          ;ja !!! 
;
;.......Abweichung ist positiv !
        IFGT    A,WORK+2        ;WORK+2 = INNTOL oder LFTTOL
        JP      INTG10          ;wenn groesser, weiter aufintegrieren !
        RET                     ;in der Toleranz 
;
;.......Zulaessige Toleranz der Temperatur ueberschritten, Integrations-
;       register bedienen! Ausnahme: Falls das Stellglied schon den oberen
;       Anschlag erreicht hat, bleibt's so.
INTG10: SC                      ;fuer ausserhalb der Toleranz
        LD      A,WVSOL         ;Ventilstellung laden !
        IFGT    A,#MAXWV        ;groesser max. Ventilstellung ??
        RET                     ;RET wenn groesser !
        IFEQ    A,#MAXWV        ;
        RET
;
        LD      A,[X]           ;
        IFBIT   #NEG,[B]        ;Integrierreg. negativ ??
        JP      INTG20          ;dann addieren ohne Ueberlaufabfrage
        ADD     A,[B]           ;Integral rauf !
        IFBIT   #NEG,A          ;Ueberlauf ??
        LD      A,#X'7F         ;Maxwert rein bei Ueberlauf
INTG18: X       A,[B]           ;neuen Wert merken
        SC                      ;Carry steht fuer ausserhalb der Toleranz
        RET                     ;das war's
;
INTG20: ADD     A,[B]           ;
        JP      INTG18          ;merken und RETurnen  
;               
;.......Abweichung ist NEGATIV !
INTG50: SC                      ;fuer ausserhalb der Toleranz
        IFEQ    WORK+3,#00      ;wenn Toleranz = 0 ?? aber negative Abweichung
        JP      INTG51          ;dann muss runterintegriert werden,
;da nachfolgende Abfrage in diesem Fall zu einen Fehler fuehren wuerde !!
        IFGT    A,WORK+3        ;WORK+3 = -INNTOL oder -LFTTOL  (Akku <> 0 !)
        RET                     ;\  negativ! wenn groesser dann ist's o.k.
        IFEQ    A,WORK+3        ; | wenn beide gleich
        RET                     ; | dann ist das auch noch in Ordnung
;
;.......Zulaessige Toleranz der Innentemperatur unterschritten, Integrations-
;       register bedienen! Ausnahme: Falls das Stellglied schon den unteren
;       Anschlag erreicht hat, bleibt's so.
INTG51: LD      A,WVSOL         ;UNBEHANDELTE Ventilstellung laden !
;        IFEQ    A,#MINWV        ;gleich?
;        RET                     ;dann RETurn
;        IFGT    A,#MINWV        ;groesser min. Ventilstellung ??
;        JP      INTG52          ;ist groesser !     
;        RET                     ;oder kleiner als minimale Ventilstellung
;
INTG52: LD      A,[X]           ;Schrittweite des Integrals laden
        XOR     A,#X'FF         ;\
        INC     A               ;/ Komplement bilden !! zum Aufaddieren
        IFBIT   #NEG,[B]        ;Integrationsregister schon negativ ?
        JP      INTG54          ;subtrahieren mit Unterlaufkontrolle
        JP      INTG20          ;wenn positiv, dann ohne Unterlaufabfrage
;
;.......Addition des Zweierkomplements mit Unterlaufabfrage (=Subtraktion)
INTG54: ADD     A,[B]           ;B zeigt auf INTLR (INTLUR)
        IFBIT   #NEG,A          ;noch negativ ??
        JMP     INTG18          ;o.k.,abspeichern
        LD      A,#X'80         ;MAX-Wert rein     
        JMP     INTG18          ;und den nun abspeichern
;
;
;
;       **************************************************************
;       * Name:        MALTWO                                        *
;       * Funktion: verdoppeln des Akkus (vorzeichenbehaftet)        * 
;       *                                                            *
;       * Input:    A     : 7-Bit + Vorzeichen                       *
;       *                                                            *
;       * Output:   A     : 7 Bit mit Vorzeichen                     *
;       * Veraendert: A                                              *
;       **************************************************************
MALTWO: RC                      ; reset Carry
        IFBIT    #NEG,A
        JP       MALTW1         ; ist negativ !
;
        RLC      A              ; *2
        IFBIT    #NEG,A         ; wenn Ueberlauf,
        LD       A,#X'7F        ; maximalen Wert rein
        RET                     ; und zurueck
;
MALTW1: RLC      A              ;
        IFBIT    #NEG,A         ;Wert noch negativ ??
        RET                     ;dann return
        LD       A,#X'80        ;maximalen negativen Wert rein
        RET                     ;   
;         
;
;
;       **************************************************************
;       * Name:         RGLADD                                       *
;       * Funktion: Addieren der durch den [B]-Pointer adressierten  * 
;       *           8-Bit Wert zu dem Wert in WORK & WORK+1          *
;       *           (MSB&LSB). Beide Summanden sind vorzeichen-      *
;       *           behaftet.                                        *  
;       *                                                            *
;       * Input:  [B] = Pointer auf 8-Bit Summand mit Vorzeichen     *
;       *                                                            *
;       * Output: WORK  : MSB \ Ergebnis der vorzeichenbehafteten    *
;       *         WORK+1: LSB / Addition                             *
;       *         B     : wie bei Aufruf                             *
;       *         X     : zeigt auf MSB der Addition                 *
;       *                                                            *
;       * Veraendert: A, B, X, WORK, WORK+1                          *
;       *                                                            *
;       **************************************************************
RGLADD: 
        RPND 
        LD      X,#WORK+1       ;
        LD      A,[X]           ;LSB laden
        RC                      ;
        ADC     A,[B]           ;Addieren
        X       A,[X-]          ;Abspeichern und Zeiger auf's MSB
        LD      A,[X]           ;MSB laden
;
        IFBIT   #NEG,[B]        ;wenn der 8-Bit Summand negativ war,
        ADD     A,#X'FF         ;negatives Quasi-MSB darauf (ohne Carry !)
        ADC     A,#00           ;positives Quasi-MSB bzw. Ueberl. aufaddieren
        X       A,[X]           ;merken, alten Summanden (MSB) in den Akku
;
;.......jetzt noch die Sache mit den Vorzeichen
        XOR     A,[B]           ;Vorzeichenvergleich
        IFBIT   #NEG,A          ;
        RET                     ;sind ungleich ! Ergebnis i. O.
;
;.......beide gleich, negativ oder positiv ?
        LD      A,[X]           ;Ergebnis (MSB) der Addtion holen
        IFBIT   #NEG,[B]        ;Abfrage des 8-Bit Summanden
        JP      RGLAD2          ;jump wenn beide negativ
;
;.......beide Summanden waren positiv, Bit7 gibt evtl. Ueberlauf an
        IFBIT   #NEG,A          ;wenn Bit7=1 dann Ueberlauf !!
        JP      RGLAD1          ;leider Ueberlauf
        RET
;       
RGLAD1: LD      A,#X'7F         ;Ueberlauf, Maximalwert rein
        X       A,[X+]          ;MSB auf MAXWERT
        LD      A,#X'FF         ;LSB ebenfalls
        X       A,[X-]          ;Zeiger wieder auf MSB
        RET
;
;.......beide Summanden waren negativ, Bit7 gibt evtl. Unterlauf an
RGLAD2: IFBIT   #NEG,A          ;wenn Bit7=1 DES ERGEBNIS MSB
        RET                     ;dann ist's in Ordnung
;       
        LD      A,#X'80         ;Unterlauf, Minimmalwert rein
        X       A,[X+]          ;MSB auf MINWERT
        LD      A,#X'00         ;LSB ebenfalls
        X       A,[X-]          ;Zeiger wieder auf MSB
        RET
;
;
;   
        .form
;       **************************************************************
;       * Name:     KOMPRE                                           *
;       * Funktion: Kompressoreinschaltbedingungen bearbeiten        * 
;       *           In Abhaengigkeit von der Stellung des Funktions- *
;       *           schalters bzw. der Differenz Sollwert Luftvorgabe*
;       *           und Aussentemperatur wird, wenn der Motor laeuft *
;       *           der Kompressor eingeschaltet                     *
;       * Input:                                                     *
;       *                                                            *
;       * Output:                                                    *
;       *                                                            *
;       * Veraendert: A, B, X, WORK                                  *
;       *                                                            *
;       * Unterprog.:                                                *
;       *                                                            *
;       **************************************************************
;
KOMPRE: 
        LD      B,#REGEXT           ;Pointer laden
        IFBIT   KL61,SWITCH         ;laeuft der Motor ?
        JP      KOMP03              ; ja, dann koennte der Kompressor laufen
        JMP     KOMP80              ; nein, dann ausschalten
KOMP03:
        IFBIT   SWDRY,SWITCH        ;ist Dry-Betrieb zugelassen?
        JMP     KOMP70              ;ja, dann Kompressor einschalten
                                    ;nein, dann
        IFBIT   NOTLIN,REGGBL       ;ist Notbetrieb (Linearsteller)?
        JMP     KOMP80              ;ja, dann ausschalten wg. Fuehlerabriss
                                    ;sonst weiter
        IFBIT   SWAUTO,SWITCH       ;ist Automatik-Betrieb?
        JP      KOMP05              ;ja, dann schaun wir mal
        JMP     KOMP80              ;nein, dann kein Kompressorbetrieb
KOMP05:
;--------  bei Kompressoranforderung ueber Luftaustrittsvorgabe -------
;
;              |<ƒƒƒ 1K ƒƒ>|
;  ƒƒƒƒƒƒƒƒƒƒƒƒ¬ƒƒƒƒƒ>ƒƒƒƒƒø                    Kompressoranf.Ein
;              ^           v
;  Kuehlen     ≥           ≥  heizen
;  ƒƒƒƒƒƒƒƒƒƒƒƒ¡ƒƒƒƒƒ<ƒƒƒƒƒ¡ƒƒƒƒƒƒƒƒƒƒƒƒƒƒƒ>         "        Aus
;             80h         83h           LFTSOL-AUSSEN+80h
; LFTSOL<AUSSEN     LFTSOL>AUSSEN
;
;
        LD      A,DIATLS            ;Diff.LFTSollwert-Aussentemp.+80h holen
        IFGT    A,#07F              ;ist LFTSollwert >= Aussentemp.?
        JP      KOMP10              ;ja, also nur lueften bzw. heizen
                                    ;nein, also Luft soll kaelter sein als draussen

;-------- Einschaltbedingung Aussentemp > AC-Einschaltpunkt
        LD      A,AUSSEN            ;dann Aussentemperatur holen
        IFGT    A,ACBEIN            ;ist sie groesser als AC-Einschaltpunkt
        JMP     KOMP50              ;dann Kompressor anfordern
        JP      KOMP30              ;sonst schauen, ob sie eventuell an ist
KOMP10:
        LD      A,DIATLS            ;Diff.LFTSollwert-Aussentemp.+80h holen
        IFGT    A,#083              ;ist LFTSollwert >= Aussentemp.+ 1Grad ?
        JMP     KOMP80              ;ja, dann abschalten und raus
        JP      KOMP60              ;nein, dann noch LFTSOLL pruefen
KOMP30:
        LD      A,AUSSEN            ;dann Aussentemperatur holen
        RC
        ADC     A,#3                ;Hysterese addieren
        IFC
        LD      A,#0FF              ;bei Ueberlauf begrenzen
        IFGT    A,ACBEIN            ;ist sie groesser als AC-Einschaltpunkt
        JP      KOMP60              ;dann bleibt er an, LFTSOLL noch pruefen
        JMP     KOMP80              ;abschalten und tschuess   
;----------------------------------------------------------
; Hier wird der Kompressor eingeschaltet, und entsprechend des
; Luftaustrittstemperatursollwertes getaktet. Das Wasserventil wird
; in Stellung AUTO in der Reglerroutine geschlossen, wenn der Kompressor
; angefordert wird.
;
;    Kompressorschaltdiagramm in Abhaengigkeit von Ausblastemperatur
;
;              KOHYOF KOHYON
;              |<-ƒƒ>|<--->|
;              ⁄ƒƒƒƒƒ<ƒƒƒƒƒ¬ƒƒƒƒƒƒ<ƒƒƒƒƒƒ       Kompressor Ein
;              v           ^
;              ≥           ≥
;  ƒƒƒƒƒƒƒƒƒƒƒƒ¡ƒƒ>ƒƒ+ƒƒ>ƒƒ¡ƒƒƒƒƒƒƒƒƒƒƒƒƒƒƒ>         "     Aus
;                  LFTSOL               Ausblastemp.
;                          
KOMP50:
        SBIT    KOMPAN,[B]          ;Kompressor ist angefordert (Wasserventil!)
        IFBIT   KOMPON,[B]          ;ist der Kompressor schon an
        JP      KOMP60              ;ja, dann mal sehen, ob er an bleibt
                                    ;ne er ist aus
        LD      A,LFTSOL            ;Ausblassollwert holen
        RC                          ;vielleicht darf er angeschaltet werden
        ADD     A,KOHYON            ;Hysterese addieren
        IFC
        LD      A,#0FF              ;bei Ueberlauf begrenzen
        IFGT    A,LFT               ;Einschaltpkt. > Ausblastemp.?
        JP      KOMP99              ;innerhalb der Hysterese nix machen
        JP      KOMP70              ;Kompressor einschalten
KOMP60:                      ;Achtung hier auch Einsprung, wenn innerhab der
                             ;anderen Hysteresen (s.o.).
        LD      A,LFTSOL            ;Ausblassollwert holen
        SC
        SUBC    A,KOHYOF             ; Hysterese abziehen
        IFNC
        LD      A,#0                 ;Unterlauf abfangen
        IFGT    A,LFT                ;Abschaltpkt. groesser als Ausblastemp.?
        JP      KOMP85               ;ja, dann abschalten
        JP      KOMP99               ;nein, dann unveraendert lassen
KOMP70:
        SBIT    KOMPON,[B]          ;dann einschalten
        JP      KOMP99
KOMP80:
        RBIT    KOMPAN,[B]          ;Kompressoranforderung zuruecknehmen
KOMP85:
        RBIT    KOMPON,[B]          ;sonst abschalten
KOMP99:          
        RET
;
;
;
;
;
;       --- Messroutinen ----
;      
;       **************************************************************
;       * Name:         MESSEN                                       *
;       * Funktion: Messen der ADW-Kanaele, sowie der anderen Ein-   * 
;       *           gaenge (Schalter usw.) incl. Filterung/Ent-      *
;       *           prellung. Plausibilitaet der Messwerte pruefen   *
;       * Input:                                                     *
;       *                                                            *
;       * Output: Analogwerte                                        *
;       *               ADAUS,ADINN,ADKL15,ADLFT                     *
;       *                                                            *
;       * Veraendert: A, B, X, WORK , SWIOLD, COUNT, FILREG          *
;       *                                                            *
;       * Unterprog.: LESADW, FILTER, PLAUSI                         *
;       *                                                            *
;       **************************************************************
;
MESSEN: 
;
;
;************** K L E M M E    1 5 **********************************
        SBIT    #PRLFT,PORTCC   ;Schutzbeschaltung ein
        LD      B,#ENAD         ;Adresse Control-Register ADC
        LD      [B+],#FUKL15    ;Controlregister ADW laden
        JSR     LESADW          ;warten, ADW lesen, Messwert in A
        IFGT    A,#UNT17V       ;IST DIE SPANNUNG UEBER 17 V 
        JP      MESS10          ; JA, DANN IST ALLES O.K.
        SBIT    UNTSP,FLAG01    ; UNTERSPANNUNGSFLAG SETZEN
        JMP     MESS26          ; UND RAUS AUS DEM UP
;
MESS10: RBIT    UNTSP,FLAG01    ; UNTERSPANNUNGSFLAG RUECKSETZEN
                                ; UND NORMAL WEITER
        X       A,ADKL15        ;merken fuer Relativ-Bezug Sollwertgeber
;          
;
;.......die AD-Wandler Kanaele der Sensoren (Kanal 0,1,2) sind mit einer
;       Schutzbeschaltung versehen, so das vor Beginn der Messung zum
;       Einschwingen eine Delayzeit notwendig ist. Diese wird bei der 
;       1. Messung extern erzeugt! sonst durch das UP"FILTER" generiert.
;
        SBIT    #NOHYST,REGRGL  ;Filterhysterese abschalten !
        RBIT    #PRAUS,PORTCC   ;Schutzeingang auf High-Z
;
;************** A U S S E N T E M P E R A T U R *********************
        LD      A,#FUAUS        ;Aussenfuehler messen
        LD      X,#HONAUS       ;Adresse Fehlerzaehler (immer HON)
        LD      WORK,#ERRAUS    ;1. Fehlernummer Gruppe Aussenfuehler
        RC                      ;Bereichsgrenze ist 4.545 Volt
        JSR     ADWPL           ;AD-Wandler lesen und auf Fehler testen
                                ;Fehlerzaehler immer HighOrderNible
        JP      MESS12          ;alles o.k., FILTERN !
        IFNC                    ;wenn RETSK und kein Carry ist der
        JP      MESS13          ;Fehlerzaehler noch nicht uebergelaufen
                                ;dann nur Filter ueberspringen
;.......Abriss/Masseschluss/Kurzschluss des Sensor ist sicher, 
;       Fehler im EEPROM ablegen und den Notbetrieb (hier Wertevorgabe)
        SBIT    NOTLIN,REGGBL   ;Linearsteller Notbetrieb
        JSR     SETERX          ;Fehlernummer in WORK, im UP noch in A laden!
        JP      MESS13          ;fehlerhafte Werte nicht durch den Filter
;
MESS12: 
        LD      B,#ADAUS
        LD      FILREG,#INCAUS  ;Inkrement fuer Temperaturen !
        JSR     FILTER          ;und filtern
;
;
;************** I N N E N T E M P E R A T U R ***********************
MESS13: SBIT    #PRAUS,PORTCC   ;Schutzbeschaltung Aussentemp. wieder ein
        RBIT    #PRINN,PORTCC   ;Schutzeingang auf High-Z (fuer naechste Mess.)
;
        LD      A,#FUINN        ;Innenfuehler messen
        LD      X,#HONINN       ;Adresse Fehlerzaehler (immer HON)
        LD      WORK,#ERRINN    ;1. Fehlernummer einer Gruppe
        RC                      ;Bereichsgrenze 4.545 Volt
        JSR     ADWPL           ;AD-Wandler lesen und auf Fehler testen
                                ;Fehlerzaehler immer in HighOrderNible
        JP      MESS22          ;alles o.k., FILTERN!
        IFNC                    ;wenn RETSK und kein Carry ist der  
        JP      MESS23          ;Fehlerzaehler noch nicht uebergelaufen
                                ;dann nur Filter ueberspringen
;
;.......Abriss/Masseschluss/Kurzschluss des Sensor ist sicher,
;       Fehler im EEPROM ablegen, und in den Notbetrieb (Linearsteller)
        SBIT    NOTLIN,REGGBL   ;Flag"Linearbetrieb" setzen
        JSR     SETERX          ;Fehlernummer aus WORK einschreiben
        JP      MESS23          ;weiter ohne Filter
;
MESS22: LD      B,#ADINN        ;Pointer auf Messwertspeicher 
        LD      FILREG,#INCINN  ;Inkrement fuer Temperaturen
        JSR     FILTER          ;und filtern
;
;
;************** L U F T A U S T R I T T S T E M P E R A T U R *******
MESS23: SBIT    #PRINN,PORTCC   ;Schutzbeschaltung ein
        RBIT    #PRLFT,PORTCC   ;Schutzeingang auf High-Z (fuer naechste Mess.)
;
        LD      A,#FULFT        ;Innenfuehler messen
        LD      X,#HONLFT       ;Adresse Fehlerzaehler (immer HON)
        LD      WORK,#ERRLFT    ;1. Fehlernummer einer Gruppe
        SC                      ;Komperatorabfrage fuer Abriss
        JSR     ADWPL           ;AD-Wandler lesen und auf Fehler testen
                                ;Fehlerzaehler immer in HighOrderNible
        JP      MESS25          ;alles o.k., FILTERN!
        IFNC                    ;wenn RETSK und kein Carry ist der  
        JP      MESS26          ;Fehlerzaehler noch nicht uebergelaufen
                                ;dann nur Filter ueberspringen
;
;.......Abriss/Masseschluss/Kurzschluss des Sensor ist sicher,
;       Fehler im EEPROM ablegen, und in den Notbetrieb (Linearsteller)
        SBIT    NOTLIN,REGGBL   ;Flag"Linearbetrieb" setzen
        JSR     SETERX          ;Fehlernummer aus WORK einschreiben
        JP      MESS26          ;weiter ohne Filter
;
MESS25: LD      B,#ADLFT        ;Pointer auf Messwertspeicher 
        LD      FILREG,#INCLFT  ;Inkrement fuer Temperaturen
        JSR     FILTER          ;und filtern
;
MESS26: RET
;
;
;       **************************************************************
;       * Name:         MESSER  (messe Rest)                         *
;       * Funktion: Messen der ADW-Kanaele, sowie der anderen Ein-   * 
;       *           gaenge (Schalter usw.) incl. Filterung/Ent-      *
;       *           prellung. Plausibilitaet der Messwerte pruefen   *
;       * Input:                                                     *
;       *                                                            *
;       * Output: Analogwerte                                        *
;       *               ADSOLG,ADSOLT                                *
;       *         Schalterflags ueber ADW            \               *
;       *               SWZHZ, SWEND                  | in           *
;       *         Schalterflags ueber Ports           | SWITCH       *
;       *               SWAUTO, SWFANM, SWAUS, KL61  /               *
;       *                                                            *
;       * Veraendert: A, B, X, WORK , SWIOLD, COUNT, FILREG          *
;       *                                                            *
;       * Unterprog.: LESADW, FILTER, PLAUSL                         *
;       *                                                            *
;       **************************************************************
;
;.......die gemessenen Werte der Sollwertgeber sind relativ zur Spannung
;       an Kl. 15 zumessen !! Weiterhin ist im Filterprogramm eine Hysterese-
;       funktion eingebaut, damit der Sollwert keine unnoetigen Schwingungen
;       aufweisst.
MESSER: 
        RBIT    #NOHYST,REGRGL  ;Fuer die Sollwertgeber ist ne Hysterese im
                                ;Filterprogramm zulaessig !!
;
;       
;************** T E M P E R A T U R S O L L W E R T *****************
        LD      B,#ENAD         ;Adresse Control-Register ADC
        LD      [B+],#FUSOLT    ;Controlregister ADW laden

        JSR     LESADW          ;warten, ADW lesen, Messwert in A !
;.......nun den gemessen Wert in Relation zur Kl. 15 setzen 
        LD      B,#ADKL15       ;Pointer auf Divisor setzen!
        LD      X,#WORK+1       ;Arbeitsregister
        X       A,[X-]          ;MSB (Dividend) laden, Zeiger auf LSB
        CLR     A               ;
        X       A,[X+]          ;LSB clearen, Zeiger auf MSB
        JSR     DIVI16          ;(ADSOLT*100h)/ADKL15
        LD      A,[X]           ;Ergebnis in den Akku holen !
;
        LD      X,#LONSLT       ;Adresse Fehlerzaehler (LON)
        LD      WORK,#ERRSLT    ;1. Fehlernummer der Gruppe laden 
        RC
        JSR     SLGERR          ;auf Abriss/Masse-/Plusschluss pruefen
        JP      MESS40          ;alles klar, filtern !!
        IFNC                    ;wenn RETSK und kein Carry, ist der
        JP      MESS42          ;Fehlerzaehler noch nicht uebergelaufen
;
;.......Abriss/Schluss des Sollwertgebers ist sicher,
;       Fehler im EEPROM ablegen, und den Notbetrieb (=Wertevorgabe)
        SBIT    SLTDEF,REGEXT   ;SOLLWERTGEBER DEFEKT-FLAG SETZEN
        JSR     SETERX          ;Fehlerbit EEPROM setzen, Fehlernummer in WORK
        JP      MESS42          ;fehlerhafte Werte nicht durch den Filter
;
MESS40: 
        LD      B,#DISWSW
        X       A,[B]           ;neuen ungefilt.unnorm.Sollwert ablegen
        LD      A,[B]           ;und wiederholen
        SC
        SUBC    A,ADSOLT        ;alten gefilterten Wert abziehen
        IFC                     ;Differenz positiv?
        JP      MESS41          ;ja , dann ablegen
        XOR     A,#0FF          ;sonst Betrag bilden
        INC     A
MESS41:
        X       A,[B]           ;Differenz ablegen und aktuellen Wert holen        
        LD      B,#ADSOLT       ;Pointer auf Messwertspeicher 
        LD      FILREG,#INCSLT  ;Inkrement fuer Temperaturen
        JSR     FILTER          ;und filtern
;        
;************** V E R E I S U N G S S E N S O R *********************
MESS42: 
        LD      A,#FUVER        ;Vereisungsfuehler messen
        LD      X,#LONVER       ;Adresse Fehlerzaehler (immer HON)
        LD      WORK,#ERRVER    ;1. Fehlernummer Gruppe Vereisungssensor
        RC                      ;Bereichsgrenze ist 4.545 Volt
        JSR     ADWPL           ;AD-Wandler lesen und auf Fehler testen
                                ;Fehlerzaehler immer HighOrderNible
        JP      MESS44         ;alles o.k., FILTERN !
        IFNC                    ;wenn RETSK und kein Carry ist der
        JP      MESS52          ;Fehlerzaehler noch nicht uebergelaufen
                                ;dann nur Filter ueberspringen
;.......Abriss/Masseschluss/Kurzschluss des Sensor ist sicher, 
;       Fehler im EEPROM ablegen und den Notbetrieb (hier Wertevorgabe)
        SBIT    NOTKOM,REGGBL   ;Kompressor nicht einschalten 
        JSR     SETERX          ;Fehlernummer in WORK, im UP noch in A laden!
        JP      MESS52          ;fehlerhafte Werte nicht durch den Filter
MESS44: 
        LD      B,#ADVER
        LD      FILREG,#INCVER  ;Inkrement fuer Temperaturen !
        JSR     FILTER          ;und filtern
;
;
;
;************** V O R W A H L U H R - Z U S A T Z H E I Z U N G *****
MESS52: LD      B,#ENAD         ;
        LD      [B+],#FUZHZ     ;Controlregister ADW laden
        JSR     LESADW          ;warten, ADW lesen, Messwert in A
        LD      B,#SWITCH       ;Workspacepointer laden
        SBIT    #SWZHZ,[B]      ;Zusatzheizung an laden !!
        IFGT    A,#ZHZEIN       ;Zusatzheizung eingeschaltet ?
        JP      FUNKT1          ;jump if on
        RBIT    #SWZHZ,[B]      ;Zusatzheizung ist aus !
;
;
FUNKT1: 
        IFBIT   SWZHZ,[B]       ;IST DIE ZUSATZHEIZUNG AN ?
        RET                     ;JA, DANN KEINEN FUNKTIONSSCHALTER EINLESEN,
                                ;DA DEFROSTKLAPPEN-RELAIS PIN AUF MASSE ZIEHT
                                ;UND DAS WUERDE FEHLER AUSLOESEN.
;
;************** F U N K T I O N S S CH A L T E R ********************
        IFBIT   FSDEFT,[B]      ;WENN FUNKTIONSSCHALTER DEFEKT
        RET                     ;DANN RAUS
;                               ;SONST NORMAL WEITER
        CLR     A
        RBIT    #SWAUTO,[B]     ;Funktionsschalter nicht auf "Automatik" 
        IFBIT   #EINAUT,PORTCP  ;Ist er's wirklich nicht?
        JP      FUNKT3          ;weiter
        SBIT    #SWAUTO,[B]     ;ist auf AUTOMATIK !
;
FUNKT3: RBIT    #SWFANM,[B]     ;Funktionsschalter nicht auf "Fan manuel"
        IFBIT   #EINFAN,PORTCP  ;Ist er's wirklich ?
        JP      FUNKT4          ;nein, dann weiter
        SBIT    #SWFANM,[B]     ;ist auf FAN MANUELL!!
        INC     A               ;Fehler auf Verdacht setzen !
        IFBIT   #EINDRY,PORTCP  ;der darf nicht (nur "Nachbarn" sind zulaessig)
        DEC     A               ;ist O.K.
;
FUNKT4: SBIT    #SWDRY,[B]      ;Funktionsschalter auf "DRY"
        IFBIT   #EINDRY,PORTCP  ;Ist er's wirklich ?
        RBIT    #SWDRY,[B]      ;ist nicht auf DRY ! (Fehlertest bei FANMAN)
;
FUNKT5: 
        RBIT    #KL61,[B]       ;Motor laeuft nicht
        IFBIT   #INKL61,PORTCP  ;laeuft er wirklich?
        SBIT    #KL61,[B]       ;er laeuft!
;
;.......sind beim Einlesen Fehler aufgetreten, dann Fehlerzaehler inkrement.
        LD      WORK,#ERRFS     ;Fehlernummer in WORK laden
        IFEQ    A,#00           ;Fehler aufgetreten ?
        JP      FUNKT6          ;nee
;.......Fehlerzaehler einen rauf
        X       A,LONFS         ;Fehlerzaehler laden
        SWAP    A               ;HIGH/LOW NIBBLE TAUSCHEN
        RC
        ADC     A,#HONINC       ;
        SWAP    A               ;ZURUECKTAUSCHEN
        X       A,LONFS         ;FEHLERZAEHLER WIEDER WEGSPEICHERN
        IFNC                    ;weiter mit Carry-Abfrage
        JP      FUNKT7          ;wenn kein Carry, dann noch kein Fehler
;                               ; sonst Fehlerbit im EEPROM setzen
FUNK52: 
;        JSR     SETERX          ;Nummer noch in WORK 
;        LD      B,#SWITCH       ;POINTER LADEN
;        SBIT    #SWFANM,[B]     ;DANN MACHEN WIR AUF JEDEN FALL FAN MAN BETRIEB
;        LD      A,#MSKNOT       ;SICHERSTELLEN, DASS NUR FANMAN-BIT GESETZT IST
;        AND     A,[B]
;        X       A,[B]
;        SBIT    FSDEFT,[B]      ;FLAG FUER FUNKTIONSSCHALTERDEFEKT SETZEN
        RET                     ;
;
FUNKT6:                         ;Fehlerzaehler loeschen, wenn alles o.k.
        X       A,LONFS         ;Fehlerzaehler laden
        AND     A,#0F0          ;Lownibble loeschen
        X       A,LONFS         ;Fehlerzaehler zurueckschreiben
;
;.......zum Schluss noch die  "AUS"-Stellung abfragen
FUNKT7:
        RBIT    SWAUS,[B]       ;Funktionsschalter nicht auf "AUS"
        LD      A,[B]           ;neuen Wert in den Akku holen
        AND     A,#MSKWIR       ;nur die 4 Verdrahteten Kontakte auswaehlen
        IFEQ    A,#0            ;ist ueberhaupt einer der 4 geschlossen
        SBIT    SWAUS,[B]       ;nein, dann Schalter auf "AUS" oder Kabel ab
;        
;.......noch ein kleines Filter und dann raus! 
        LD      A,[B]           ;nochmal wiederholen
        X       A,SWIOLD        ;alten Wert holen/eben eingelesenen abspeichern
        AND     A,[B]           ;verundern !
        X       A,SWITCH        ;und als Schalterstellung merken
        RET
;
;
;
;
;       **************************************************************
;       * Name:         SRNORM                                       *
;       * Funktion: interpoliert aus einer vorgebebenen Tabelle      * 
;       *           "Normwerte"  !!!! nur fallende Kennlinie !!!!    *
;       *                                                            *
;       * Input:  X = Pointer auf AD-Wandlerwert                     *
;       *    WORK+1 = Anfangsadresse Wandlertabelle                  *
;       *                                                            *
;       * Output: A = interpolierter, normierter Messwert            *
;       *                                                            *
;       * Veraendert: A, B, X, WORK, WORK+1                          *
;       **************************************************************
        .sect SRNORM,ROM,INPAGE
SRNORM:
        LD      B,#WORK+1       ;Arbeitsregister
        LD      A,[X]           ;AD-Wandlerwert laden
        RC                      ;Carry ruecks
        AND     A,#LNIBBL       ;ist das LOW-Nibble des Messwert's  0
        IFEQ    A,#00           ;dann erster TAB-Wert = linearisierter 
        SC                      ;Carry setzen, wenn dies der Fall ist !
;                                                                 ^
        LD      A,[X]           ;Messwert laden                   |
        AND     A,#HNIBBL       ;Hi-Nibble isolieren              |
        SWAP    A               ;High & Low tauschen              |
        ADD     A,[B]           ;Tabellenanfang hinzuaddieren     |
        X       A,[B]           ;Tabellenzeiger in [B] retten     |
        LD      A,[B]           ;und wieder in den Akku holen     |
TABUSE: LAID                    ;unteren Tabellenwert laden !     |
        IFC                     ;\wenn's LOW-Nibble 0 ist, -------+ 
        JP      SRNRM9          ;/dann ist das der gesuchte Wert !!
        X       A,[B]           ;Tausch Tabellenwert <-> Zeiger     
        INC     A               ;Zeiger auf naechsten Wert 
        LAID                    ;naechsten TAB-Wert holen
        X       A,[B]           ;tauschen, da dieser kleiner ist !
        SC                      ;Carry setzen
        SUBC    A,[B]           ;Differenz bilden (positiv !)
                                ;        WORK = unterer Messwert  
                                ;        A= Differnz der 2 Tabellenwerte!
        X       A,[B-]          ;Differenz in WORK+1 ablegen
        X       A,[B+]          ;unterer Tabwert in WORK merken!
;
        LD      A,[X]           ;Messwert nochmal holen [B auf Differenz]
        XOR     A,#X'FF         ;Complementieren, da Temp-Tabelle negative 
        INC     A               ;Steigung hat !
        AND     A,#LNIBBL       ;isolieren und mit der Differenz multipliz.
        SWAP    A               ;aber vorher ins HiNibble bringen
        X       A,[B+]          ;und in WORK1 merken,
        X       A,[B-]          ;und in WORK2 die Differenz ! 
;
        JSR     RMULT           ;WORK1 * WORK2 = WORK1 & WORK2
;
        LD      A,[B-]          ;gerundeter Wert der Multiplikation
        ADD     A,[B]           ;Grundwert dazu addieren
SRNRM9: RET
;
;.......Tabellen  der Temperaturfuehler (normierte Temperatuwerte)
;       Aussen/Innenfuehler:  Normierung (-30 ... + 55 Grad) 
;       Luftaustrittsfuehler: Normierung (0 ... + 85 Grad)
;
TABINN: 
TABVER:
TABAUS: .byte   255,228,207,189,173,158,145,133,120,108
        .byte   96,84,71,57,41,22,0
;
TABLFT: .byte   255,255,242,219,200,182,166,150,135,120
        .byte   106,91,75,58,39,16,0
;   
TABWV :  .BYTE   255,217,171,128, 99, 77, 59, 46, 36
         .BYTE    26, 20, 15, 11,  7,  6,  4,  0
;
        .endsect 
;
;
;
;       **************************************************************
;       * Name:         FILTER                                       *
;       * Funktion: Filtern des Messwertes. Bei Gleichheit LSB mit   * 
;       *           7F laden, bei <> INKREM ab- bzw. zuziehen und    *
;       *           dann bei Ueber-/Unterlauf das MSB entsprechend   *
;       *           korigieren.                                      *
;       *                                                            *
;       * Input:  A:gemessener Wert                                  *  
;       *         B:(Zeiger auf MSB Messwert), FILREG:(Filterinkrem. *
;       *         Flag's  NOHYST: keine Hysterese zulaessig          *
;       *                        (Hysterese = FIHYST (ROM-Konstante) *
;       *                 FILTON:damit bei der Initialisierung       *
;       *                        die ersten gemessenen Werte als     *
;       *                        Startwerte genommen werden          *
;       *                                                            *
;       * Output: gefilterter Wert [B], [B-1]                        *
;       *                                                            *
;       * Veraendert: A, B, [B]                                      *
;       **************************************************************
;
FILTER: IFBIT   #FILTON,REGRGL  ;Filter schon eingeschaltet ???
        JP      FILTX0          ;los geht's
        X       A,[B-]          ; \
        LD      [B],#X'7F       ; /Anfangswerte einschreiben
        RET                     ;da war's schon !
;
FILTX0: IFNE    A,[B]           
        JP      FILT00          ;jump if ungleich
FILTX1: LD      A,[B-]          ;= Decrement B
        LD      [B],#X'7F       ;LSB auf Mittelwert
        RET
;
;.......ungleich ! Filterwerte aendern sich
FILT00: IFGT    A,[B]           ;
        JP      FILT20          ;jump if A > [B]
;
;.......A ist kleiner ! Filterwert geht nach unten
        IFBIT   #NOHYST,REGRGL  ;Hysterese zugelassen
        JP      FILT01          ;nee, normal weitermachen
        SC
        SUBC    A,[B]           ;Differenz bilden (ist negativ !)
        IFGT    A,#-FIHYST      ;wenn die Differenz kleiner ist,
        JP      FILTX1          ;TUN wir so, als ob's i. O. waer!! (ACHTUNG,  
;                                dann bleibende Abweichung !!)
;        
FILT01: LD      A,[B-]          ;= Decrement B !
        LD      A,[B]           ;LSB holen
        SC
        SUBC    A,FILREG        ;Inkrementanteil abziehen (steht in FILREG !)
        IFNC                    ;Test auf borgen !
        JP      FILT11          ;jump on "NoCarry"
        X       A,[B]           ;nix geborgt, neuen Wert merken
        RET                     ;und Ende
;
FILT11: LD      [B+],#X'7F      ;LSB wieder auf Mittelwert
        LD      A,[B]           ;Carry noch vom Ueberlauf gesetzt
        DEC     A               ;MSB einen runter
        X       A,[B]           ;neuen Wert merken
        RET                     ;das wars
;
;.......neuer Messwert ist groesser
FILT20: IFBIT   #NOHYST,REGRGL  ;Hysterese zugelassen
        JP      FILT21          ;nee, normal weitermachen
        SC
        SUBC    A,[B]           ;Differenz bilden (ist POSITIV !)
        IFGT    A,#FIHYST       ;wenn die Differenz groesser ist 
        JP      FILT21          ;gehen wir durch den Filter
        JMP     FILTX1          ;oder wir tun so, als ob's i. O. waer!! (ACH-
;                                tung dann bleibende Abweichung !!)
;
FILT21: LD      A,[B-]          ;= Decrement B !
        LD      A,[B]           ;LSB holen
        RC                      ;da ADD-Befehl ein vorh. Carry nicht resetet !!
        ADC     A,FILREG        ;Inkrementanteil addieren (steht in FILREG !)
        IFC     
        JP      FILT23          ;jump on Carry (Ueberlauf)
        X       A,[B]           ;nix geborgt, neuen Wert merken
        RET                     ;und Ende
;
FILT23: LD      [B+],#X'7F
        LD      A,[B]           ;Carry noch vom Ueberlauf gesetzt
        INC     A               ;MSB einen rauf
        X       A,[B]           ;neuen Wert merken
        RET                     ;das wars
;
;

        .form
;        
;
;        
;       **************************************************************
;       * Name:         NORMI                                        *
;       * Funktion: Berechnet aus den gemessenen AD-Werten mit Hilfe * 
;       *           einer Tabelle "normierte" Temperaturen. Zum Ab-  *
;       *           gleich der Toleranzen wird aus dem EEPROM ein    *
;       *           Korrekturwert addiert. Aus dem gemessenen Wert   *
;       *           fuer KL.15 und den Sollwertstellern ( ueber      *  
;       *           Kl.15 versorgt) sowie den entsprechenden         *
;       *           Parametern die normierten Sollwerte.             *
;       *                                                            *  
;       *    ACHTUNG:  Verschiedene Normierungen fuer Aussen-/Innen  *
;       *    ~~~~~~~~  und Luftaustritt                              *
;       *                                                            *
;       * Input:  ADAUS,ADINN,ADLFT,ADSOLT,ADSOLG                    *
;       *         = gelesene AD-Wandlerwerte                         *
;       *                                                            *
;       * Output: AUSSEN,INNEN,LFT,SOLTEM,VEREIS                     *
;       *         = normierte Werte                                  *
;       *                                                            *
;       * Veraendert: A, B, X, WORK, WORK+1                          *
;       **************************************************************
;
NORMI:  
;.......Normieren der Aussentemperatur  

        LD      X,#ADAUS 
        LD      WORK+1,#L(TABAUS)  ;Anfang Wandlertabelle Aussentemperatur
        JSR     SRNORM          ;UP-Aufruf !
        LD      B,#KORAUS       ;Korrekturwert aus EEPROM dazu
        JSR     KORR            ; UND KORRIGIEREN
        X       A,AUSSEN        ;Ablegen der normierten AUSSENtemp.
;
;.......Normieren der Innentemperatur
        LD      X,#ADINN
        LD      WORK+1,#L(TABINN)  ;Anfang Wandlertabelle INNENtemperatur
        JSR     SRNORM          ;UP-Aufruf !
        LD      B,#KORINN       ;Korrekturwert aus EEPROM dazu
        JSR     KORR            ; UND KORRIGIEREN
        X       A,INNEN         ;Ablegen der normierten INNENtemp.
;
;.......Normieren der Luftaustrittstemperatur
        LD      X,#ADLFT
        LD      WORK+1,#L(TABLFT)  ;Anfang Wandlertabelle LUFTAUSTRITTSTemperatur
        JSR     SRNORM          ;UP-Aufruf !
        LD      B,#KORLFT       ;Korrekturwert aus EEPROM dazu
        JSR     KORR            ; KORRIGIEREN
        X       A,LFT           ;Ablegen der normierten Luftaustrittstemp.
;
;.......Normieren der Verdampfertemperatur
;
        LD      X,#ADVER 
        LD      WORK+1,#L(TABVER)  ;Anfang Wandlertabelle Aussentemperatur
        JSR     SRNORM          ;UP-Aufruf !
        LD      B,#KORVER       ;Korrekturwert aus EEPROM dazu
        JSR     KORR            ; UND KORRIGIEREN
        X       A,VEREIS        ;Ablegen der normierten Verdampfertemperatur
;
;.......Normieren der Sollwerte (Innentemperatur)
;         ----- S o l l w e r t    T e m p e r a t u r ----
        LD      B,#WORK
        LD      A,ADSOLT        ;   "      "
        X       A,[B+]          ; 1. Multiplik. ins Arbeitsregister
        LD      A,SOLTSP        ;Spreizung Sollwert Temperatur
        X       A,[B-]          ;= 2. Multipli.
        JSR     RMULT           ;Multiplizieren
        LD      A,[B]           ;Ergebnis holen
        ADD     A,SOLTOF        ;und noch den Sollwertoffset addieren
        IFBIT   SLTDEF,REGEXT   ;IST DER SOLLWERTGEBER VIELLEICHT DEFEKT
        LD      A,#NOTSLT       ;im Fehlerfall SOLLWERT VORGEGEBEN (= 23 GRAD)
                                ;Ablage fuer normierten Sollwert Temperatur
        X       A,SOLTEM        ;und merken
;--- hier noch Sollwertaenderung normieren
        LD      B,#WORK
        LD      A,DISWSW        ; unnormierte Sollwertaenderung
        X       A,[B+]          ; 1. Multiplik. ins Arbeitsregister
        LD      A,SOLTSP        ;Spreizung Sollwert Temperatur
        X       A,[B-]          ;= 2. Multipli.
        JSR     RMULT           ;Multiplizieren
        LD      A,[B]           ;Ergebnis holen
        X       A,DISWSW        ;und ablegen
;----
        IFBIT   DIAGNO,FLAG01   ;IST DIAGNOSE ?
        JP      NORMI2          ;DANN KEINE BEHAGLICHKEIT
;
;...... hier kommt noch die Behaglichkeitskennlinie zum Zuge
;
        LD      B,#BEHGKL       ; ZEIGER AUF KENNLINIE
        LD      A,AUSSEN        ; WERT DER X-ACHSE
        SBIT    KLEIN1,FLAG02   ; KENNLINIENSTEIGUNG < 1
        JSR     KENNLI          ; OFFSET HOLEN
        LD      B,#SOLTEM       ; POINTER SETZEN
        ADD     A,[B]           ; ZU SOLLWERT ADDIEREN
        X       A,[B]           ; UND MERKEN
NORMI2:
        RET
;
;
;       **************************************************************
;       * NAME:         KORR                                         *
;       *                                                            *
;       * FUNKTION: Korrektur der normierten Temperaturen mittels    *
;       *           der Korrekturwerte bei Einbehaltung der Grenzen  *
;       *                                                            *
;       * INPUT:    A = normierter Messwert                          *
;       *          [B]= Korrekturwert                                *
;       *                                                            *
;       * OUTPUT:   A = normierter u. korrigierter Wert              *  
;       **************************************************************
;
KORR:   RC                      ; CARRY LOESCHEN
        ADC     A,[B]           ; KORREKTURWERT HINZUADDIEREN
        IFBIT   NEG,[B]         ; KORREKTURWERT < 0 ?
        JP      KORR2           ; JA
        IFC                     ; NEIN, GAB'S DENN 'NEN UEBERTRAG ?
        LD      A,#0FF          ; JA, DANN OBERER ANSCHLAG
        RET
;
KORR2:  IFNC                    ; GAB'S KEINEN UEBERTRAG ?
        LD      A,#0            ; DANN UNTERER ANSCHLAG
        RET                     ;
;
;
;       **************************************************************
;       * Name:         DIVI16                                       *
;       *                                                            *
;       * Funktion: vorzeichenfreie 16 Bit/ 8 Bit Division           * 
;       *                                                            *
;       *                                                            *
;       * Input:  X = Pointer WORKSPACE & 16 Bit DIVIDENT            *
;       *             bei Aufruf auf MSB zeigend                     *
;       *             ( [X]=MSB ; [X-1]=LSB )                        *
;       *         B = Pointer DIVISOR                                *
;       *                                                            *
;       * Output: [X-1] = Ergebnis Division (Quotient)               *
;       *           [X] =     "       "     (Remainder)              *
;       *         Zeiger= X-1, B                                     *
;       *                                                            *
;       * Veraendert: A, X, [X], [X-1]                               *
;       **************************************************************
DIVI16: LD      COUNT,#8        ;Loopcounter 
        RC                      ;vorbereiten Division
;
;.......check, if result will fit in 8 Bits 
        LD      A,[X-]          ;MSB-Dividend laden, Zeiger auf LSB
        IFGT    A,[B]           ;Vergleich Dividend - Divisor
        JP      DIV169          ;wenn Dividend>Divisor gibt's nen Ueberlauf !
;
;.......result will fit, go on with Division
DIV161: LD      A,[X]           ;LSB Dividend laden      \
        RLC     A               ;den verdoppeln           | 
        X       A,[X+]          ;merken, Zeiger auf MSB   | entspricht
        LD      A,[X]           ;jetzt das MSB            | Dividend * 2
        RLC     A               ;den auch verdoppeln      |
        X       A,[X]           ;merken                  /
;
        IFC                     ;bei Ueberlauf zum Subtrahieren, da dann der
        JP      DIV162          ;Dividend > Divisor ist
        LD      A,[X]           ;
        IFGT    A,[B]           ;wenn MSB Dividend > Divisor dann
        JP      DIV162          ;kanns'te se voneinander abziehen
        JP      DIV164          ;sonst weiter im Schleifenzaehler mit C=0
;
DIV162: 
        SC
        LD      A,[X]           ;MSB Dividend laden
        SUBC    A,[B]           ;MSB Dividend - UEBERTRAG
        X       A,[X]           ;Ergebnis ablegen
        SC                      ;"to be shifted into Result"
DIV164:
        LD      A,[X-]          ;= DEC X  --> Zeiger auf LSB setzen
        DRSZ    COUNT           ;alle durch ?
        JP      DIV161          ;
;
;.......zu allerletzt noch das letzte Carry ins Ergebnisregister schieben
        LD      A,[X]           ;
        RLC     A
DIV166: X       A,[X]           ;
        RET                     ;

;.......Ergebnis passt nicht in die 8 Bits !
DIV169: LD      A,#X'FF         ;Maximalwert laden
        JP      DIV166          ;ab zum (Ab)speichern 
;
        .FORM
;       --- T I M I N G   ---
;       **************************************************************
;       * Name:         SOFTIM                                       *
;       * Funktion: Bearbeiten der zeitabhaengigen Funktionen, wie   * 
;       *           z. B. Integration, usw.                          *
;       *           Dieses UP soll -gesteuert vom IDLE-Timer- alle   *
;       *           41msec aufgerufen werden !                       *
;       *                                                            *
;       * Input:                                                     *
;       *                                                            *
;       * Output:                                                    *
;       *                                                            *
;       * Veraendert: R2,R3,R4,R5                                    *
;       **************************************************************
SOFTIM:  DRSZ     R7                ; 
         JP       SOFT10
         LD       R7,#ITIBAS        ; WIRD AUF ZEITBASIS EINGESTELLT
         IFEQ     ICNTR,#0          ; INTEGRATIONSZEIT SOLLTE 0 NICHT UNTERSCHREITEN
         JP       SOFT01
         DRSZ     ICNTR             ; ZEITZAEHLER VORGABE LUFTAUSTRITT
         NOP      
SOFT01:  IFEQ     ICNTUR,#0         ; DITO
         JP       SOFT10         
         DRSZ     ICNTUR            ; ZEITZAEHLER UNTERLAGERTE REGELUNG
         NOP
;
SOFT10:
        DRSZ    WVTIM               ; Taktventiltimer dekrementieren
        NOP                         ; Timer laeuft staendig im Kreis

;.......---------     41 ms Timing     ----------------------
SOFT20:
        DRSZ    R4                  ; HIER WIRD SEKUNDEN TAKT 
        JP      SOFTRT              ;  ERZEUGT
;.......----------    1     sec   Timing    -----------------
        LD      R4,#(10000/(205*TC)) ;
        IFEQ    SECTIM,#0           ; WENN SEKUNDENZAEHLER=0, DANN BLEIBT ER'S AUCH
        JP      SOFTRT
        DRSZ    SECTIM              ; WENN<>0, DANN DEKREMENTIEREN
        NOP
SOFTRT: RET
;       
;
        .FORM
;
;
;       **************************************************************
;       * Name:         SUBOV                                        *
;       * Funktion: [X] - [B] mit Ueberlaufkontrolle , d.h. Klemmen  * 
;       *           des Maximal-/Minimalwertes vorzeichenbehaftet !  *
;       *                                                            *
;       * Input:    [X]  : Pointer                                   *
;       *           [B]  : Pointer                                   *
;       *                                                            *
;       * Output:   Resultat: A   (= [X] - [B])                      *
;       *                                                            *
;       * Veraendert:                                                *
;       **************************************************************
SUBOV:  LD      A,[X]           ;
        SC                      ;wenn's Ergebn. positiv : Carry = 1
        SUBC    A,[B]           ;wenn's Ergebn. negativ : Carry = 0
;
        IFC     
        JP      SUBOV6          ;Carry = 1, [X] >= [B] sein
; 
        IFBIT   #NEG,A          ;Ergebnis negativ, wenn Bit7 gesetzt ist
        JP      SUBOV4          ;und das ist in Ordnung
        LD      A,#X'80         ;NEGATIVER Maxwert
SUBOV4: RET
;
SUBOV6: IFBIT   #NEG,A          ;Ergebnis positiv, wenn Bit7 gesetzt ist
        JP      SUBOV8          ;wird auf 7F "geklemmt"
        RET                     ;wenn nicht, ist es in Ordnung
SUBOV8: LD      A,#X'7F         ;POSITIVER Maxwert
        RET
;
;
;       **************************************************************
;       * Name:         RUND                                         *
;       * Funktion: Runden eines "16-Bit" Wertes fuer eine 8-Bit     * 
;       *           Weiterverarbeitung                               *
;       *                                                            *
;       * Input:    [B]  : 'Nachkommastelle'                         *
;       *           [B-1]: Wert                                      *
;       *                                                            *
;       * Output:   Resultat: [B]: gerundeter Wert                   *
;       *                                                            *
;       * Veraendert:                                                *
;       **************************************************************
RUND:   LD      A,[B-]          ;Nachkommastelle laden, Zeiger auf davor
        RLC     A               ;Nachkommastelle ins Carry !
        LD      A,[B]           ;
        ADC     A,#00           ;evtl. Carry in Vorkommastelle
        X       A,[B]           ;gerundeten Wert merken
        RET                     ;
;        
;       **************************************************************
;       * Name:        NGRUND                                        *
;       * Funktion: Runden eines vorzeichenbehafteten negativen!!    * 
;       *           16 Bit-Wort fuer 8 Bit Weiterverarbeitung        *
;       *                                                            *
;       * Input:    [B]  : 'Nachkommastelle'                         *
;       *           [B-1]: Wert                                      *
;       *                                                            *
;       * Output:   Resultat: [B]: gerundeter Wert                   *
;       *                                                            *
;       * Veraendert: A,B                                            *
;       **************************************************************
NGRUND: LD      A,[B-]          ;Nachkommastelle laden, Zeiger auf davor
        RLC     A               ;MSBit ins Carry 
        LD      A,[B]           ;
        SUBC    A,#00           ;(Complement-Carry wird addiert !)
        X       A,[B]           ;gerundeten Wert
        RET                     ;
;
;
;       **************************************************************
;       * Name:         RMULT                                        *
;       * Funktion: 8*8 Multiplikation und runden !                  * 
;       *                                                            *
;       * Output:   Resultat: [B]: gerundeter Wert                   *
;       *                                                            *
;       * Veraendert:                                                *
;       **************************************************************
;
RMULT:  JSR     MULT88          ;Nachkommastelle laden, Zeiger auf davor
        JP      RUND            ;statt JSR besser JMP
;       RET                     ;das spart Stack !!!
;
;
;       **************************************************************
;       * Name:         RVMULT                                       *
;       * Funktion: Vorzeichenbehaftete 8*8 Multiplikation mit       * 
;       *           runden des Ergebnisses !                         *
;       *                                                            *
;       * Output:   Resultat: [B]: gerundeter Wert                   *
;       *                                                            *
;       * Veraendert:                                                *
;       **************************************************************
;
RVMULT: JSR     VMULT           ;vorzeichenbehaftete 8*8 Multiplikation 
        LD      A,[B-]          ;
        LD      A,[B+]          ;MSByte im Akku, Zeiger wie bei Aufruf
        IFBIT   #NEG,A          ;
        JP      RVMUL2          ;wenn negativ, dann andere Rundungsroutine
        JSR     RUND
        RET
;
RVMUL2: JSR     NGRUND           ;Rundung fuer vorzeichenbehafteten Wert
        RET 
;
;
;       **************************************************************
;       * Name:         MULT88                                       *
;       * Funktion: 8 * 8 Multiplikation mit 16 Bit Resultat         * 
;       *                                                            *
;       *                                                            *
;       * Input:    [B],[B+1] : Multiplikanten                       *
;       *                                                            *
;       * Output:   Resultat: [B]=MSB/[B+1]=LSB ; [B] auf LSB        *
;       *                                                            *
;       * Veraendert: COUNT                                          *
;       **************************************************************
MULT88: LD      COUNT,#9        ;
        CLR     A               ;Ergebnisregister loeschen
        RC                      ;Vorbereitung abgeschlossen
;
MULOOP: RRCA
        X       A,[B]
        RRCA     
        X       A,[B+]          ;Zeiger auf 2. Multiplikannten
        IFNC                    ;
        JP      NOADD           ;
        RC
        ADC     A,[B]           ;Wenn Carry, dann addieren
NOADD:  X       A,[B]           ;\ Zeiger wieder auf 1.
        X       A,[B-]          ;/ = DEC B !!
        DRSZ    COUNT
        JP      MULOOP          ;alle durch ?
;       
        X       A,[B+]          ;MSB in [B]
        X       A,[B]           ;LSB in [B+1]
        RET                     ;Zeiger bei verlassen auf LSB
;
;
;
;       **************************************************************
;       * Name:         VMULT                                        *
;       * Funktion: vorzeichenbehafte Multiplikation, vorzeichen-    * 
;       *           behafteter Wert in [B] ! Ergebnis in [B] und     *
;       *           [B+1]                                            *
;       *                                                            *
;       *                                                            *
;       * Input:    [B]   : Multiplikant   (pos/neg)                 *
;       *           [B+1] : Multiplikant   (positiv)                 *
;       *                                                            *
;       * Output:   Resultat: [B]=MSB/[B+1]=LSB ; [B] auf LSB        *
;       *                     vorzeichenbehaftet !!                  *
;       * Veraendert: COUNT                                          *
;       **************************************************************
VMULT:  IFBIT   #NEG,[B]        ;Test auf negativ
        JP      VMUL10          ;
;
;.......beide sind positiv !    
        JP      MULT88          ;"normale" 8 * 8 Bit Multiplikation
;       RET                     ;statt JSR besser JMP, das spart Stack
;
;.......ist negativ, so das das Ergebnis auch negativ sein muss
VMUL10: JSR     KOMPL           ; WERT KOMPLEMENTIEREN
        JSR     MULT88          ;
        JSR     KOMPL           ; ERGEBNIS LSB KOMPLEMENTIEREN
        LD      A,[B-]          ; POINTER DEKREMENTIEREN
        LD      A,[B]           ;\
        XOR     A,#X'FF         ; | Komplement MSB bilden
        ADC     A,#00           ; | (evtl. Ueberlauf hinzu)
        X       A,[B+]          ;/
        RET
;
;
;
;       **************************************************************
;       * Name:        VVMULT                                        *
;       * Funktion: vorzeichenbehafte Multiplikation, vorzeichen-    * 
;       *           behafteter Wert in [B] ! Ergebnis in [B] und     *
;       *           [B+1]                                            *
;       *                                                            *
;       *                                                            *
;       * Input:    [B]   : 1.Multiplikant   (pos/neg)               *
;       *           [B+1] : 2.Multiplikant   (pos/neg)               *
;       *                                                            *
;       * Output:   Resultat: [B]=MSB/[B+1]=LSB ; [B] auf LSB        *
;       *                     vorzeichenbehaftet !!                  *
;       * Veraendert: COUNT                                          *
;       **************************************************************
;
VVMULT: LD      A,[B+]          ; 1. HOLEN , POINTER AUF 2.
        AND     A,[B]           ; MIT 2. VERUNDEN
        IFBIT   NEG,A           ; Test, ob beide negativ
        JP      VVMUL3          ; BEIDE SIND NEGATIV
        IFBIT   #NEG,[B]        ; Test, ob DER 2. negativ IST
        JP      VVMUL5          ; JA
        LD      A,[B-]          ; NEIN, DANN POINTER AUF 1.
        JP      VMULT           ; UND DA WEITER    statt JSR besser JMP
;       RET                     ;                  das spart Stack !!
;
VVMUL3: JSR     KOMPL           ; KOMPLEMENTIEREN  
        LD      A,[B-]          ; POINTER AUF 1.
        JSR     KOMPL           ; KOMPLEMENTIEREN
        JMP     MULT88          ;"normale" 8 * 8 Bit Multiplikation
;       RET                     ;statt JSR besser JMP, das spart Stack
;
VVMUL5: 
        LD      A,[B-]          ; POINTER AUF 1.
        X       A,[B+]          ; VERTAUSCHEN , POINTER AUF DEN 2.
        X       A,[B-]          ; JETZT IST DER VORZEICHENBEHAFTETE IN [B]
        JMP     VMULT           ; statt JSR besser JMP
;       RET                     ; das spart RAM
;
;
;
;       **************************************************************
;       * Name:        KOMPL                                         *
;       * Funktion: Komplementiert 8-Bit Zahl in [B]                 * 
;       *                                                            *
;       * Input:    [B]   : 8-Bit Wert                               *
;       *                                                            *
;       * Output:   Resultat: [B]                                    *
;       * Veraendert: A                                              *
;       **************************************************************
;
KOMPL:  LD      A,[B]
        XOR     A,#X'FF         ; INVERTIEREN
        RC                      ; ADD-Befehl setzt/resetzt Carry nicht
        ADC     A,#01           ;  (Ueberlauf evtl. ins Carry)        
        X       A,[B]           ; merken !
        RET
;
;
;     
        .form
;       --- Hilfsroutinen ---
;
;       **************************************************************
;       * Name:        DELADC / LESADW                               *
;       * Funktion: Abwarten der AD-Wandelzeit, Lesen des Messwertes *
;       *           und Ablegen des Messwertes im RAM (X-Pointer)    *
;       *           DELADC zusaetzlich noch'n Delay fuer die Schutz- *
;       *           beschaltung und laden des ADC-Controlreg.        *
;       *                                                            *
;       * Input: Pointer B , A = AD-Kanal/Modeauswahl                *
;       *                                                            *
;       * Output: Messwert im Akku, B= B -1                          *
;       *                                                            *
;       * Veraendert: A, B, COUNT1                                   *
;       *                                                            *
;       **************************************************************
DELADC: LD      B,#ENAD         ;Adresse Control-Register ADC
                                ;(B+1) = Resultregister 
LESADY: LD      COUNT1,#SCHDEL  ;\  
DELAD0: DRSZ    COUNT1          ; |Delayzeit fuer SCHUTZBE-/UM SCHALTUNG
        JP      DELAD0          ;/          
LESADX: X       A,[B+]          ;Controlregister ADW laden
LESADW:  
        LD      COUNT1,#ADWDEL  ;\  
DELAB1: DRSZ    COUNT1          ; |Delayzeit fuer Wandler  
        JP      DELAB1          ;/ 
        LD      A,[B-]          ;Resultat holen 
        RET
;
;
;
;       **************************************************************
;       * Name:         ADWPL                                        *
;       * Funktion: Plausibilitaetskontrolle des Sensorsignals.      * 
;       *           Bei Kurzschluss/Unterbrechung wird das CARRY     *
;       *           gesetzt.                                         *
;       * Input:    CARRY=0    Bereichsgrenze 4.545  Volt            *
;       *                =1    Abfrage des Komperators LFT-Kreis     * 
;       *           WORK       1. Fehlerbit einer Gruppe (Sensor)    *
;       *           X:         Fehlerzaehler-Adresse (LON/HON)       *
;       *                      Ist im Fehlerbit [WORK] das Bit 7 ge- *
;       *                      setzt wird das HON von [X] bearbeitet *
;       *           A:         zumessender AD-Kanal                  *
;       *                                                            *
;       * Output:   mit RET    alles in Ordnung, weiter mit Filter   *  
;       *                      Messwert in A                         *  
;       *           mit RETSK                                        *  
;       *           CARRY=0    Sensor fehlerhaft                     *
;       *           CARRY=1    Fehlerzaehler uebergelaufen !         *
;       *                                                            *
;       **************************************************************
ADWPL:  JSR     DELADC          ;Schutzbeschaltungsdelay, AD-Messung starten
                                ;warten, ADW lesen, Messwert in A 
;
        IFBIT   DIAGNO,FLAG01   ;SIND WIR IM DIAGNOSEBETRIEB ?
        RET                     ;JA, DANN GLEICH WIEDER RAUS
;                               ;SONST MIT FEHLERERKENNUNG WEITER
ADWPL0: IFEQ    A,#X'FF         ;oberer Anschlag ??
        JMP     ADWPL5          ;leider ! (Test Grenze 4.5 Volt/Komperator)
;
;.......Test, ob's Massekurzschluss oder ob's "nur" warm ist
        IFGT    A,#00           ;Messwert ungleich 0 ? dann ist alles i. O. 
        JP      ADWPL2          ;jetzt noch den Fehlerzaehler loeschen
;
        SBIT    #AGNDSW,PORTLD  ;Ausgangspin vorbereiten 
        SBIT    #AGNDSW,PORTLC  ;und Port L auf Ausgang setzen
        LD      A,[B]           ;       
        JSR     LESADY          ;warten,Messung neu starten,warten,AD lesen
        RBIT    #AGNDSW,PORTLC  ;Port wieder als Eingang configurieren
        RBIT    #AGNDSW,PORTLD  ;und auf High'Z schalten
        IFGT    A,#V200MV       ;Messwert > 200 mV ??
        JP      ADWPL1          ;Messung o.k. ,alten Wert wieder rein (0)
                                ;und den Fehlerzaehler loeschen
;
;.......Messwert fehlerhaft ! Es liegt ein Masseschluss vor, Fehlernummer
;       korrigieren, und Fehlerzaehler bedienen
        LD      A,WORK          ;Fehlerbitgruppe laden und
        INC     A               ;auf Masseschlussfehlerbit setzen
        X       A,WORK          ;merken
        JMP     ADWPL9          ;noch den Fehlerzaehler bedienen
;
ADWPL1: CLR     A               ;wenn's nur zu warm ist
ADWPL2: X       A,[X]           ;Einsprung, wenn "normale" Messung o.k. ist
        IFBIT   #SENBIT,WORK    ;sind die Sensoren?
        JP      ADWPL3          ;ja, dann das HON bearbeiten
;
        AND     A,#X'F0         ;LowOrderNible loeschen
        JP      ADWPL4          ;abspeichern und raus !
;
ADWPL3: AND     A,#X'0F         ;Fehlerzaehler HighOrderNible loeschen
ADWPL4: X       A,[X]           ;merken, und alten Akku wieder rein
        RET                     ;weiter mit Filter
;
;...... hier wird die Referenz erhoeht, sowie der Luftaustrittsfuehler 
;       ueber einen Komperator auf Abriss geprueft, um Schluss (24 Volt)
;       bzw. Abriss besser zu kalten Aussentemperaturen unterscheiden zu
;       koennen.
ADWPL5: SBIT    #UREF5V,PORTCC  ;auf Ausgang
        SBIT    #UREF5V,PORTCD  ;Ausgang auf high (Vgnd auf "0")
;                                 
        LD      A,[B]           ;   
        JSR     LESADY          ;warten,Messung neu starten,warten,AD lesen 
        RBIT    #UREF5V,PORTCC  ;wieder auf Eingang-
        RBIT    #UREF5V,PORTCD  ;HIGH-Z
;
;.......Messwert ist jetzt im Akku, jetzt auf Kurzschluss mit Plus pruefen
        IFGT    A,#V24V         ;na, Schluss mit Plus ? (U=24 Volt !)
        JP      ADWPL9          ;AU BACKE ! Schluss mit Plus
;
;.......jetzt auf Abriss! Dabei ist fuer die Fuehler Innen/Aussen eine
;       bestimmte Schwelle einzuhalten, fuer den Luftaustritt muss ein
;       Komperator abgefragt werden
        IFC                     ;wenn's Carry gesetzt
        JP      ADWPL7          ;den Komperator abfragen !
        IFGT    A,#V4x54V       ;ist die 4.5454 Schwelle erreicht?
        JP      ADWPL8          ;dann Abriss!
;
ADWPL6: LD      A,#X'FF         ;nix von alledem, Messwert i. O
        JMP     ADWPL2          ;noch den Fehlerzaehler loeschen
;
ADWPL7: IFBIT   #LFTABR,PORTGP  ;Komperator durchgeschaltet ??
        JP      ADWPL6          ;nein, Messwert wieder rein, und raus !
;
;.......Fehlernummer auf Abriss setzen
ADWPL8: LD      A,WORK          ;Fehlerbitpointer holen
        ADD     A,#2            ;und auf Abriss setzen
        X       A,WORK          ;merken
;
;.......Fehlerzaehler einen rauf
ADWPL9: LD      A,WORK          ;FEHLERNUMMER LADEN
        IFGT    A,#(ERRINN-1)   ;SENSORFEHLER ?
        JP      ADWP10          ;JA
        X       A,[X]           ;Fehlerzaehler laden
        SWAP    A               ;HIGH/LOW NIBBLE TAUSCHEN
        RC
        ADC     A,#HONINC       ;
        SWAP    A               ;ZURUECKTAUSCHEN
        JP      ADWP11
ADWP10: X       A,[X]           ;FEHLERZAEHLER LADEN
        RC
        ADC     A,#HONINC       ;Innen/Aussen/LFT Fehlerzaehler immer HON
ADWP11: X       A,[X]           ;merken !
        RETSK                   ;weiter mit Carry-Abfrage
;                               ;wenn Carry, dann im aufrufenden Programm die
;                               ;Fehlerroutine, sonst nur ohne Filter weiter
;
;
;       **************************************************************
;       * Name:         SLGERR                                       *
;       * Funktion: Plausibilitaetskontrolle der Sollwertgebersignale* 
;       *           Bei Kurzschluss/Unterbrechung wird das CARRY     *
;       *           gesetzt.                                         *
;       * Input:    WORK       1. Fehlerbit einer Gruppe (Sensor)    *
;       *           X:         Fehlerzaehler-Adresse (LON/HON)       *
;       *                      Ist im Fehlerbit [WORK] das Bit 7 ge- *
;       *                      setzt wird das HON von [X] bearbeitet *
;       *                                                            *
;       * Output:   mit RET    alles in Ordnung, weiter mit Filter   *  
;       *           mit RETSK                                        *  
;       *           CARRY=0    Sollwertgeber fehlerhaft              *
;       *           CARRY=1    Fehlerzaehler uebergelaufen !         *
;       *                                                            *
;       **************************************************************
;
SLGERR: IFBIT   DIAGNO,FLAG01   ;SIND WIR IM DIAGNOSEBETRIEB ?
        RET                     ;JA, DANN GLEICH WIEDER RAUS
                                ; SONST MIT FEHLERERKENNUNG WEITER
        IFGT    A,#SOLGOS       ; HAT MESSWERT OBERE SCHWELLE UEBERSCHRITTEN ?
        JP      ADWPL9          ; DANN PLUSSCHLUSS, AB ZUM FEHLERZAEHLER
        IFGT    A,#SOLGUS       ; UEBER UNTERER SCHWELLE ?
        JP      SLGER2          ; JA, DANN O.K.
        JP      SLGER4          ; NEIN, DANN MASSESCHLUSS ODER ABRISS
;
SLGER2: X       A,[X]           ; DANN ALLES O.K.
        AND     A,#0F0          ; FEHLERZAEHLER LOESCHEN
        X       A,[X]           ;
        RET

;
SLGER4: LD      A,WORK          ; SONST 1. FEHLERBIT DER GRUPPE HOLEN
        INC     A               ;  UND AUF MASSESCHLUSS BZW. UNTERBRECHUNG SETZEN
        X       A,WORK          ; UND WIEDER ABLEGEN
        JP      ADWPL9          ; AB ZUM FEHLERZAEHLER
;
;
;       **************************************************************
;       * Name:         KLAPPS                                       *
;       * Funktion: Bestimmung der Stellung der Bypassklappe         * 
;       *           in Abhaengigkeit von der Heizleistung            *
;       *           Im REHEAT-Betrieb ist die Klappe zu.             *
;       *                                                            *
;       * Output:   STPSOL                                           *
;       *                                                            *
;       * Veraendert: A, B, WORK                                     *
;       *                                                            *
;       * Unterprog.:                                                *
;       *                                                            *
;       **************************************************************
;
KLAPPS:
;...... die Bypassklappe soll proportional zur Heizleistung geoeffnet werden
;       moeglich waere (WVSOL * PWMALT)/100
;
        IFBIT   KL61,SWITCH      ;laeuft der Fahrzeugmotor?
        JP      KLAPP0           ;ja, dann Klappenstellung neu berechnen
        JP      KLAPP9           ;nein, Klappe soll aus Geraeuschgruenden 
KLAPP0:                          ; nicht laufen
        LD      A,WVSOL          ; erstmal Ventilstellung als Fuehrungsgroesse
        IFBIT   SWDRY,SWITCH     ;ist Dry-Betrieb zugelassen?
        LD      A,#0FF           ;dann Bypassklappe zu
        X       A,KLPSOL         ; 
        LD      A,KLPSOL         ;
        LD      B,#WORK         ;unbehandelten Wert in 
        X       A,[B+]          ;WORK, Zeiger auf WORK+1
        LD      A,STPFKT        ;Stepperfaktor aus Parametertabelle holen
        X       A,[B-]          ;in WORK+1 bringen, Zeiger wierder auf WORK
        JSR     MULT88          ;Multiplikation (WORK * WORK+1) 
        LD      X,#STEPSL       ;da soll's hin ! (das LSB)
        LD      A,[B-]          ;Ergebnis holen (wo isses denn ?)
        X       A,[X-]          ;LSB abspeichern 
        LD      A,[B]           ;nun das MSB der Multiplikation holen
        X       A,[X]           ;und in STPSOL ablegen
KLAPP9:
        RET
;
;
;
;
;        ****************************************************************
;        *                                                              *
;        *                  UP KENNLI                                   *
;        *                                                              *
;        * BERECHNET KENNLINIEN FUNKTIONSWERT                           *
;        * B-POINTER MUSS AUF TABELLE MIT KENNLINIENPARAMETERN ZEIGEN   *
;        *                                                              *
;        * FUER X < XK     Y = K1 * (X-XK) + YK    MIT YK > 0           *
;        * FUER X > XK     Y = K2 * (X-XK) + YK                         *
;        *                                                              *
;        * KENNLINIENSTEIGUNG WIRD ABHAENGIG VOM KLEIN1-FLAG            *
;        * INTERPRETIERT.  KLEIN1 = 1  ==>  -1 < K < +127/128           *
;        *                 KLEIN1 = 0  ==> -128< K < +127               *
;        *                                                              *
;        * PARAMETERREIHENFOLGE:    XK,K1,K2,YK                         *
;        *                          --> AUFST.ADRESSE                   *
;        * BENUTZTE REGISTER: A,B                                       *
;        * EINGABE          : A                                         *
;        * AUSGABE          : FUNKTIONSWERT IN A (-128 < A < 127)       *
;        * VERAENDERT       : RDATL,RDATH,A,CARRY                       *
;        *                                                              *
;        ****************************************************************
;
KENNLI:  SC                         ; CARRY FUER SUBTR. SETZEN
         SUBC     A,[B]             ; X - XK
         X        A,RDATL           ; RDATL/H WERDEN ALS RECHENREGISTER GEBRAUCHT
         LD       A,[B+]            ; B-POINTER INKREMENTIEREN
         LD       A,B               ; 
         PUSH     A                 ; B-POINTER RETTEN         
         IFC                        ; ERGEBNIS>0
         LD       A,[B+]            ; DANN STEIGUNG K DER ZWEITEN GERADEN
         LD       A,[B+]            ; STEIGUNG K HOLEN
         X        A,RDATH           ; UND IN RECHENREGISTER
         LD       B,#RDATH          ; B-POINTER FUER MULTIPL. SETZEN
         JSR      VVMULT            ; K * (X-XK) 8*8 MULT. MIT VORZEICHEN
         POP      A                 ; 
         ADD      A,#2              ; B-POINTER AUF YK
         IFBIT    KLEIN1,FLAG02     ; SOLL STEIGUNG < 1 SEIN ?
         JMP      FLACH             ; JA, DANN IST ES EINE DER FLACHEN
;
         X        A,B               ; MODIFIZIERTEN B-POINTER ABLEGEN    
         LD       A,RDATL           ; MULTIPLIKATIONS LSB HOLEN
         RC
         ADC      A,[B]             ; YK DRAUFADDIEREN
         LD       B,#RDATL          ; B-POINTER LADEN
         X        A,[B-]            ; LSB ABLEGEN
         LD       A,[B+]            ; MSB HOLEN
         ADC      A,#0              ; CARRY DRAUFADDIEREN
         IFGT     A,#0              ; IST MSB > 0 ODER NEGATIV
         JP       KENNL2
         LD       A,[B]             ; LSB IN AKKU
         IFGT     A,#07F            ; ZU POSITIV?
         LD       [B],#07F          ; POSITIVER ANSCHLAG
         LD       A,[B]             ; ERGEBNIS IM AKKU
         RET
;
KENNL2:  IFBIT    NEG,A             ; NEGATIV ?
         JP       KENNL4            ; JA
         LD       [B],#127          ; NEIN, DANN POSITIVER ANSCHLAG
         LD       A,[B]
         RET
;
KENNL4:  IFEQ     A,#0FF            ; BEREICHSUEBERSCHREITUNG ?
         JP       KENNL6            ; NEIN, BZW NOCH NICHT
         JP       KENNL8            ; JA
;        
KENNL6:  LD       A,[B]             ; LSB HOLEN
         IFGT     A,#07F            ; VIELLEICHT DOCH ZU NEGATIV
         RET                        ; NEIN
;        
KENNL8:  LD       [B],#080          ; NEGATIVER ANSCHLAG
         LD       A,[B]
         RET
;
FLACH:   X        A,B               ; B-POINTER NOCH ABLEGEN
         LD       X,#RDATL          ; X-POINTER LADEN
         LD       A,[X]             ; ERGEBNIS LOWBYTE HOLEN
         RLCA                       ; VERDOPPELN
         X        A,[X-]            ; UND WIEDER ABLEGEN
         LD       A,[X]             ; ERGEBNIS HIGHBYTE HOLEN
         RLCA                       ; VERDOPPELN MIT CARRY
         IFC                        ; WAR MSB NEGATIV
         JP       FLACH2            ; JA
         IFBIT    NEG,A             ; IST POSITVE BEIM DOPPELN UEBERGELAUFEN
         JP       FLACH4            ; JA
FLACH1:  RC
         ADC      A,[B]             ; YK DRAUFADDIEREN
         IFBIT    NEG,A             ; POSITIVER UEBERLAUF
         LD       A,#07F            ; POSITIVER ANSCHLAG
         JP       FLARET
;
FLACH2:  IFGT     A,#07F            ; NEGATIVER ANSCHLAG ?
         JP       FLACH3            ; NEIN
         LD       A,#080            ; JA
         JP       FLARET
;
FLACH3:  RC
         ADC      A,[B]             ; YK DRAUFADDIEREN
         JP       FLARET
;
FLACH4:  LD       A,#07F            ; POSITIVER ANSCHLAG
FLARET:  RBIT     KLEIN1,FLAG02     ; STEIGUNG<1 FLAG ZURUECKSETZEN
         RET
;
;
;
;        ****************************************************************
;        * Name:      STPBER                                            *
;        * Funktion:  Berechnet aus unbehandeltem 8-Bit Positionssollwert*
;        *            die 16-Bit Schrittposition (absolut) mit Hilfe    *
;        *            des im EEPROM abgelegten Getriebefaktors          *
;        *                                                              *
;        * Eingabe :  unbehandelter Wert in A                           *
;        * Ausgabe :  -                                                 *
;        * Veraendert: A, B, X                                          *
;        ****************************************************************
;
STPBER: LD      B,#WORK         ;unbehandelten Wert in 
        X       A,[B+]          ;WORK, Zeiger auf WORK+1
        LD      A,STPFKT        ;Stepperfaktor aus Parametertabelle holen
        X       A,[B-]          ;in WORK+1 bringen, Zeiger wierder auf WORK
        JSR     MULT88          ;Multiplikation (WORK * WORK+1) 
        LD      X,#STEPSL       ;da soll's hin ! (das LSB)
        LD      A,[B-]          ;Ergebnis holen (wo isses denn ?)
        X       A,[X-]          ;LSB abspeichern 
        LD      A,[B]           ;nun das MSB der Multiplikation holen
        X       A,[X]           ;und in STPSOL ablegen
        RET        
;
;
;
;        **************************************************************
;        * Name:     REFSTP                                           *
;        * Funktion: REFERENZFAHRT DES SCHRITTMOTORS                  *
;        *                                                            *
;        **************************************************************
;
REFSTP:  LD      R3,#5           ; SCHLEIFENZAEHLER VORLADEN
         LD      PORTD,#0FF      ; PORTD GRUNDSTELLUNG -MOTORSTILLSTAND
         LD      STEP,#082       ; MIT IRGENDEINEM STEP MUSS MAN JA ANFANGEN
         
;....... NU FAHR'N WIR AUF IN RICHTUNG Klappe ZU
;
INITS0:  
         LD      A,#255          ; Maximalwert
         JSR     STPBER          ; jetzt steht Maximalwert in Sollposition
         LD      B,#STEPSL       ; B-POINTER LADEN mit Sollposition
         LD      X,#STEPIL       ; X-Pointer laden mit Istposition
         LD      A,[B-]          ; SO WIRD SICHERGESTELLT, DASS MOTOR IN  
         X       A,[X-]          ;   RICHTUNG zu LOSLAEUFT
         LD      A,[B]           ; Soll- und Istposition werden vertauscht
         X       A,[X]           ;     
         LD      [B+],#0
         LD      [B],#0          ; Sollposition auf Null setzen
INITST:  IFBIT   #T0PND,ICNTRL   ; warten auf T0-Interrupt (ca. 8.2 msec !)
         JP      INITS1          ; wenn, dann WEITER
         JP      INITST          ; wenn nicht, dann warten! 
INITS1:  JSR     REFGO           ; STEPPEN, R5BAUD, ENDSCHALTER, STILLSTAND
         IFEQ    A,#0AA          ; STEHT MOTOR STILL ?
         JP      INITS2          ; JA, DANN sind wir angekommen
         JP      INITST          ; NEIN, DANN NEXT STEP
;
INITS2:  LD       B,#STEPSL      ; B-POINTER SETZEN
         LD       [B-],#000      ; 
         LD       [B-],#000      ;
         LD       [B-],#0        ; ISTSTELLUNG WIRD 
         LD       [B],#0         ;  ZU NULL DEFINIERT
         LD       KLPSOL,#0
INISRT:  SBIT     #REFEND,REGEXT ; REFERENZFAHRT BENDET SETZEN
         RET
;
;
;
;
;      
;       **************************************************************
;       *   UP FUER REFSTP                                           *  
;       *   RUFT UP STEPPR,R5BAUD,SONFUN,SOFTIM,ENDSCH AUF           *
;       *   UEBERGIBT IN A MOTORZUSTAND (AA = STILLSTAND)            *
;       **************************************************************
;
REFGO:   RBIT    #T0PND,ICNTRL   ; Ruecksetzen
         LD      WDSVR,#KEYWRD   ; Watchdog triggern 
         JSR     STEPPR          ; EIN SCHRITT VOR         
         JSR     R5BAUD          ; 5 BAUD Adresse empfangen         
         JSR     SONFUN          ;Sonderfunktionen         
         DRSZ    R3              ; SCHLEIFENZAEHLER DEKREMENT
         JP      REFGO1          ;  
         LD      R3,#5           ; SOFTTIMER SOLL NUR JEDES 5. MAL
         JSR     SOFTIM          ;  AUFGERUFEN WERDEN
REFGO1:  
         LD      A,#0AA          ; \
         AND     A,PORTD         ;  > STEHT DER MOTOR SCHON ?
         RET
;
;
;
;       **************************************************************
;       * Name:         STEPPR                                       *
;       * Funktion: Vergleicht Soll/Ist-Stellung des Schrittmotors,  * 
;       *           fuehrt gegebenenfalls einen Schritt in die       *
;       *           richtige Richtung aus und korrigiert Istwert.    *  
;       *           Ist die Sollstellung erreicht wird der Motor     *
;       *           stromlos geschaltet, und der letzte Step in      *
;       *           STEP abgelegt.                                   *  
;       *           Die nicht benutzten Portbits bleiben unveraendert*
;       *                                                            *
;       * Input:    STEPSL,STEPSH,STEPIL,STEPIH,STEP                 *
;       *                                                            *
;       * Output:   PORTD, STEPIL,STEPIH,STEP                        *
;       *                                                            *
;       *                                                            *
;       *                                                            *
;       * Veraendert: A, B, X, STEPIL, STEPIH                        *
;       **************************************************************
;
STEPPR:  IFBIT   UNTSP,FLAG01    ;BEI UNTERSPANNUNG WIRD UP NICHT
         RET                     ;AUSGEFUEHRT
;
         LD       B,#STEP           ; B-POINTER AUF PORTD         
         LD       X,#STEPIL         ; X-POINTER AUF STEPIL
         LD       A,STEPSH          ; SOLL-SCHRITTZAHL HIGHBYTE HOLEN
         IFGT     A,STEPIH          ; UND MIT IST-WERT VERGLEICHEN
         JMP      STEPRE            ; WENN SOLL>IST DANN RECHTSDREHEN
         IFEQ     A,STEPIH          ; WENN GLEICH
         JP       STEP1             ; DANN LOW-BYTES VERGLEICHEN
         JP       STEPLI            ; SONST LINKSDREHEN
;
STEP1:   LD       A,STEPSL          ; SOLL-SCHRITTZAHL LOW-BYTE HOLEN
         IFGT     A,STEPIL          ; UND MIT IST-WERT VERGLEICHEN
         JMP      STEPRE            ; WENN SOLL>IST DANN RECHTSDREHEN
         IFEQ     A,STEPIL          ; WENN GLEICH
         JMP      STEND             ; DANN SIND WIR ANGEKOMMEN    
;
STEPLI:                             ; SONST LINKSDREHEN
         LD       A,#0AA            ; MASKE FUER PORTD 
         AND      A,PORTD           ; PORTD MIT MASKE LESEN
         IFEQ     A,#0AA            ; STEHT MOTOR STILL ?
         LD       A,[B]             ; DANN LETZTEN STEP HOLEN
         IFEQ     A,#082            ; \
         LD       [B],#022          ;  |
         IFEQ     A,#022            ;  |
         LD       [B],#028          ;  | EIN SCHRITT NACH DEM ANDEREN
         IFEQ     A,#028            ;  |  
         LD       [B],#088          ;  |
         IFEQ     A,#088            ;  |
         LD       [B],#082          ; /
         LD       A,[X]             ; ISTWERT
         DEC      A                 ; DEKREMENTIEREN
         IFNE     A,#0FF            ; UNDERFLOW?
         JP       STEPL1            ; NEIN
         X        A,[X-]            ; JA, DANN ERSTMAL LOWBYTE ZURUECKSCHREIBEN
         LD       A,[X]             ; HIGHBYTE HOLEN,
         DEC      A                 ; DEKREMENTIEREN
         X        A,[X]             ; UND ZURUECKSCHREIBEN
         JP       STEPL2            ; UND RAUS
;
STEPL1:  X        A,[X]             ; LOWBYTE ZURUECKSCHREIEBEN
STEPL2:  ;IFBIT    SWEND,SWITCH      ; WURDE ENDSCHALTER AUSGELOEST ?
         ;RET                        ; JA, DANN WOLL'N WIR IHN HEIL LASSEN
         JMP      STPOUT              
;
STEPRE:  LD       A,#0AA            ; MASKE FUER PORTD 
         AND      A,PORTD           ; PORTD MIT MASKE LESEN
         IFEQ     A,#0AA            ; STEHT MOTOR STILL ?
         LD       A,[B]             ; DANN LETZTEN STEP HOLEN         
         IFEQ     A,#088            ; \
         LD       [B],#028          ;  |
         IFEQ     A,#028            ;  |
         LD       [B],#022          ;  | EIN SCHRITT NACH DEM ANDEREN
         IFEQ     A,#022            ;  |  NUR GENAU UMGEKEHRT
         LD       [B],#082          ;  |
         IFEQ     A,#082            ;  |
         LD       [B],#088          ; /
         LD       A,[X]             ; ISTWERT
         INC      A                 ; INKREMENTIEREN
         IFNE     A,#000            ; OVERFLOW?
         JP       STEPR1            ; NEIN
         X        A,[X-]            ; JA, DANN ERSTMAL LOWBYTE ZURUECKSCHREIBEN
         LD       A,[X]             ; HIGHBYTE HOLEN,
         INC      A                 ; DEKREMENTIEREN
         X        A,[X]             ; UND ZURUECKSCHREIBEN
         JP       STPOUT            ; UND RAUS
;
STEPR1:  X        A,[X]             ; LOWBYTE ZURUECKSCHREIEBEN
;
STPOUT:  LD       A,#055            ; MASKE LADEN
         AND      A,PORTD           ; FUER NICHT ZU VERAENDERNDE BITS
         OR       A,[B]             ; MIT STEP ODERN
         X        A,PORTD           ; UND  STEP AUSGEBEN
         RET
;        
STEND :  LD       A,#0AA            ; MASKE FUER PORTD 
         AND      A,PORTD           ; PORTD MIT MASKE LESEN
         IFEQ     A,#0AA            ; IST MOTOR SCHON STROMLOS ?
         JP       STEND0            ; JA, DANN RAUS
         X        A,[B]             ; LETZTEN SCHRITT MERKEN
         LD       A,#0AA            ; MASKE
         OR       A,PORTD           ; NUR DIE BENUTZTEN BITS WERDEN NULL
         X        A,PORTD           ; HIER WIRD STEPPER STROMLOS GESCHALTET
STEND0:  RET
;
;
;                                            
;
;       **************************************************************
;       * Name:         PWM                                          *
;       * Funktion: Pulsweitenmodulation fuer Luefterendstufe        *
;       *                                                            *
;       * Input:    Geblaesesollwert in A  (O - 100 % )              *
;       *                                                            *
;       * Output:   Programmiert Timer 1 auf das entsprechende       *
;       *           Puls/Pausenverhaeltnis bei f = 2,5 kHz           *
;       *                                                            *
;       * Veraendert: A,B                                            *
;       *                                                            *
;       **************************************************************
;
PWM:     
         IFGT     A,#99                      ; GROESSER 99% ?
         LD       A,#100                     ; DANN AUF 100 BEGRENZEN     
         X        A,PWMALT                   ; LUEFTERWERT MERKEN
         LD       A,PWMALT                   ; UND WIEDER HOLEN
;
;-------Umrechnung des 0-100% Wertes (A) in Wert zwischen PWMmin und PWMmax
;       Am PWM-Ausgang befindet sich ein RC-Glied, um aus dem PWM-Signal
;       eine Analog-Spannung zwischen Umin und Umax zu machen
;
        LD      B,#WORK
        X       A,[B+]          ; 1. Multiplikanten ins Arbeitsregister
        LD      A,STPWM         ;Steigung fuer PWM-Umrechnung
        X       A,[B-]          ;=2. Multiplikanten
        JSR     RMULT           ;Multiplizieren und runden
        LD      A,[B]           ;Ergebnis holen
        ADD     A,UGPWM         ;und noch den PWMoffset addieren (PWMmin)
        RC
        RLC     A               ;einmal verdoppeln (bessere Aufloesung)
;-------------------------
         IFEQ     A,T1RBLO                   ; HAT SICH WAS GEAENDERT ?
         JMP      PWMRET                     ; NEIN, DANN RAUS
;
         IFBIT    KL61,SWITCH                ;laeuft der Motor?
         JP       PWM2                       ;ja, dann filtern
         JP       PWM5                       ;nein, dann nicht filtern
PWM2:
         LD       B,#REGEXT
         IFBIT    ZHZON,[B]                  ;Zusatzheizung on ??
         JMP      PWM5                       ;dann nicht filtern !!
;
         IFBIT    DIAGNO,FLAG01              ; LAEUFT DIAGNOSE ?
         JMP      PWM5                       ; DANN NICHT FILTERN
;
         IFBIT    SILAIN,[B]                 ; IST SILA NOCH AN VOM INITIALISIEREN?
         JMP      PWMRET                     ; DANN WARTEN BIS SILA AUS UND
;                                            ; SECTIM FREI IST
;
         IFEQ     SECTIM,#0                  ; IST DIE SEKUNDE UM ?
         JP       PWM3
         JMP      PWMRET                     ; NEIN, DANN RAUS
;         
PWM3:    
         LD       B,#T1RBLO                  ; Pointer laden
         LD       SECTIM,#1                  ; TIMER AUF 1 SEKUNDE SETZEN
         IFGT     A,[B]                      ; SOLLWERT > ISTWERT
         JP       PWM4                       ; JA
         LD       A,[B]                      ; NEIN, DANN ISTWERT HOLEN
         DEC      A                          ;  UND DEKREMENTIEREN
         JP       PWM5
PWM4:    LD       A,[B]                      ; ISTWERT HOLEN
         INC      A                          ; INKREMENTIEREN
PWM5:    
         LD       B,#CNTRL                   ; Pointer laden
         RBIT     T1C0,[B]                   ; TIMER 1 STOPPEN, 
         X        A,T1RBLO                   ; HIGHZEIT NACH TIMER REG.A
         LD       A,#200                     ; LOWZEIT
         SC                                  ;      entspricht 2500 Hertz
         SUBC     A,T1RBLO                   ; AUSRECHNEN
         X        A,T1RALO                   ; UND NACH TIMER REG.B SCHREIBEN
         RBIT     T1A,PORTGD                 ; DAMIT GLEICH GETOGGELT WIRD
         SBIT     T1C1,[B]                   ; T1A TOGGLE STARTEN
         SBIT     T1C0,[B]                   ; TIMER 1 STARTEN
PWMRET:  RET
;         
;
;        
;
;       **************************************************************
;       * Name:         EEINIT                                       *
;       * Funktion: Auslesen der Daten aus dem EEPROM (Ablage        *
;       *           im RAM)                                          *
;       *                                                            *
;       * Input:  B      - RAMBEREICHS-ENDADRESSE                    *
;       *         ADRESS - EEPROMBEREICHS-ENDADRESSE                 *
;       *         COUNT  - ANZAHL DER PARAMETER / 2 OHNE PRUEFSUMME  *
;       *                                                            *
;       * Output: LIEST WERTE AUS EEPROM AB ADRESS ABWAERTS EIN UND  *
;       *         LEGT IM RAM ZWISCHEN [B]-2*COUNT UND [B]           *
;       *         PARAMETERLISTE AN                                  *  
;       *         CARRY WIRD GESETZT, WENN PRUEFSUMME FALSCH         *
;       *                                                            *
;       * Veraendert: A,B,X,R6(ADRESS),COUNT                         *
;       *                                                            *
;       **************************************************************
;
EEINIT:  
         LD       A,COUNT                    ; ANZAHL WOERTER
         PUSH     A                          ; AKKU ERSTMAL RETTEN
         CLR      A                          ; UND DANN LOESCHEN
         X        A,WORK+2                   ; REGISTER WIRD ALS AKKU VERWNDET
         LD       X,#RDATH                   ; X POINTER AUF GELESENES LOWBYTE
EEINI1:  JSR      READ                       ; EEPROM LESEN
         X        A,[X+]
         X        A,[B-]                     ; UND IN PARA.LISTE ABLEGEN
         X        A,[X-]                     ; HIGHBYTE HOLEN
         X        A,[B-]                     ; UND IN PARA.LISTE ABLEGEN
         DRSZ     ADRESS                     ; EEPROM ADRESSE DEKREMENTIEREN
         NOP                                 ; DUMMY SPRUNGZIEL         
         DRSZ     COUNT                      ; LETZTES WORD?
         JP       EEINI1                     ; NEIN, DANN NEXT ONE
         JSR      READ                       ; JETZT NOCH DIE PRUEFSUMME HOLEN
;
PRUEFS:  POP      A                          ; ANZAHL WIEDER HOLEN
         X        A,COUNT                    ; UND ALS SCHLEIFENZAEHLER BENUTZEN
         LD       X,#WORK+2                  ; ADDITIONSAKKU
         CLR      A                          ; ERSTMAL LOESCHEN
         X        A,[X+]                     ; REGISTER WERDEN ALS
         CLR      A
         X        A,[X]                      ; 16-BIT ADDITIONS AKKU VERWENDET
         LD       A,[B+]                     ; B(RAM)-POINTER INKREMENTIEREN
PRUEF0:  RC                                  ; CARRY=0
         LD       A,[B+]                     ; LSB  HOLEN
         ADC      A,WORK+3                   ; ZU SUMMEN-LOWBYTE ADDIEREN
         X        A,[X-]                     ; 
         LD       A,[B+]                     ; MSB HOLEN
         ADC      A,WORK+2                   ; UEBERTRAG ZU SUMMEN-HIGHBYTE
         X        A,[X+]                     ;     ADDIEREN
         DRSZ     COUNT                      ; ENDE DER PARA.LISTE ERREICHT
         JP       PRUEF0                     ; NEIN
         RC                                  ; CARRY=0
         LD       A,[X]                      ; SUMMEN LOW-BYTE HOLEN
         ADC      A,#1                       ; NOCH EINEN DRAUFADDIEREN
         X        A,[X-]                     ; ABLEGEN
         LD       A,[X]                      ; SUMMEN HIGH-BYTE HOLEN
         ADC      A,#0                       ; UEBERTRAG DRAUFADDIEREN
         X        A,[X]                      ; UND WIEDER ABLEGEN
         RC                                  ; CARRY LOESCHEN
         LD       A,RDATL                    ; EEPROM-PRUEFSUMMEN-LOWBYTE
         IFNE     A,WORK+3                   ; UNGLEICH ERRECHNETER?
         JP       PRUEFE                     ; JA, DANN FEHLER
         LD       A,RDATH                    ; EEPROM-PRUEFSUMMEN-HIGHBYTE
         IFEQ     A,WORK+2                   ; GLEICH ERRECHNETER?
         RET                                 ; JA, DANN ALLES OK
;
PRUEFE:  
;        SC                                  ; HIER FEHLERFLAG SETZEN ??????
         RET
;
;
;
;       **************************************************************
;       * Name:         SETERR/SETERX/SETERN                         *
;       * Funktion: Setzt Errorflag in EEPROM, welches ueber         *
;       *           den Akku adressiert wird (0-31).                 *
;       *           Und setzt SILAON-Flag.                           *
;       *           1.Fehlerwort: LSByte Bit 7-0, MSByte Bit 15-8    *      
;       *           2.Fehlerwort: LSByte Bit 23-16, MSByte Bit 31-24 *
;       *                                                            *
;       * Input:    Nummer des Fehlerflags in A (0-31)               *
;       *                                                            *
;       * Output:                                                    *
;       *                                                            *
;       * Veraendert: A,B,R6(ADRESS),COUNT                           *    
;       *                                                            *
;       **************************************************************
;
SETERN:  SBIT     NOTLIN,REGGBL              ;Pruefsummenfehler IN LUEFTERKENNLINIE
         JP       SETERR                     ;Fehlernummer aus Akku einschr.
SETERX:  LD       A,WORK                     ;Fehlernummer aus WORK laden 
SETERR:  SBIT     SILAON,REGEXT              ; SILAONFLAG SETZEN
         LD       B,#COUNT
         X        A,[B]                      ; NUMMER RETTEN
         LD       A,#FEHLSP                  ; EEPROMADRESSE DES 1. FEHLERWORTES
         IFBIT    4,[B]                      ; IST NUMMER > 15 ?
         INC      A                          ; JA, DANN 2. FEHLERWORT
         X        A,ADRESS                   ; INS ADRESSREGISTER
         JSR      READ                       ; UND EEPROM LESEN
         LD       B,#RDATL                   ; B-POINTER AUF UNTERES FEHLERBYTE
         IFBIT    3,COUNT                    ; TEST, OB OBERES ODER UNTERES  "
         LD       A,[B-]                     ; OBERES, DANN POINTER DEKREMENTIEREN
         LD       A,#7                       ; MASKE
         AND      A,COUNT                    ; NUR DIE UNTERSTEN 3 BITS
         INC      A                          ; EINEN DRAUF
         X        A,COUNT                    ; BITZAHL INS REGISTER
         CLR      A                          ; AKKU LOESCHEN
         SC
SETER0:  RLCA                                ; CARRY LINKSSCHIEBEN
         DRSZ     COUNT                      ; BITZAEHLER DEKREMENTIEREN
         JP       SETER0                     ; HIER WIRD BIT IN POSITION GEBRACHT
         AND      A,[B]                      ; MAL SEHEN, OB BIT SCHON GELOESCHT
         IFEQ     A,#0                       ; 
         JP       SETER9                     ; BIT IST SCHON NULL, ALSO RAUS
         XOR      A,#0FF                     ; SONST, AKKU INVERTIEREN
         AND      A,[B]                      ; BIT LOESCHEN
         X        A,[B]                      ; UND ZURUECKSCHREIBEN  
         JSR      EWEN                       ; EEPROM WRITE ENABLE
         JSR      WRITE                      ; UND REINSCHREIBEN
         JSR      EWDS                       ; UND WIEDER DISABLEN
SETER9:  RET
;
;

;
;        ****************************************************************
;        *                                                              *
;        *                  UP LUEFTR                                   *
;        *                                                              *
;        * PROGRAMM FUER LUEFTERKENNLINIE IM NORMALBETRIEB              *
;        *                                                              *
;        *                                                              *
;        *                                                              *
;        *                                                              *
;        * BENUTZTE REGISTER: A,B                                       *
;        * EINGABE          : ABWOF,LUEFTERKENNLINIE                    *
;        * AUSGABE          : LUEFTERDREHZAHL UEBER UP-PWM              *
;        * VERAENDERT       : A,B                                       *
;        *                                                              *
;        ****************************************************************
;
LUEFTR:  IFBIT    ZHZON,REGEXT      ; ZUSATZHEIZUNG HAT VORRANG
         RET                        ; IST SIE AN GEHTS GLEICH RAUS
;        
         IFBIT    GBLMAN,REGGBL     ; SOLL LUEFTER MANUELL EINGESTELLT WERDEN?
         JP       LUEMAN            ; JA
;         JP       LUEFTA            ; SONST DA WEITER
;
LUEFTA:  IFBIT    KL61,SWITCH       ; laeuft der Motor
         JP       LUEFTB            ; ja, dann darf auch das Geblaese laufen
                                    ; nein, dann Geblaese aus
LUEMAN:  LD       A,#0              ; Geblaese aus !!!!!
         JMP      LUFPWM            ; UND AN LUEFTERANSTEUERUNG WEITER GEBEN
;        
LUEFTB:  IFBIT    AHZEND,REGRGL     ; IST DIE AUFHEIZPHASE BEENDET ?
         JP       LUEFTC            ; JA, DANN NORMALBETRIEB MIT UND OHNE AC
         LD       A,LKENNL+4        ; MINIMAL LUEFTERSP. AUS STARTTEMP.KENNLINIE
         JMP      LUFPWM            ; AN LUEFTERANSTEUERUNG WEITERGEBEN
;
;....... ab hier folgt der Automatik Betrieb ueber Luefterkennlinie
;
;  %PWM
;     ^
;     |
; max +---------\                /---------
;     |           \            /
; min |  kuehlen    \________/    heizen
;     |                     
;     |              
;     +--------------+---+---+--------------> ABWOF
;                    -1  0   +1
;
LUEFTC:  LD       A,#35             ; FUER NOTBETRIEB MIT 35% LADEN
         IFBIT    NOTLIN,REGGBL     ; Sind die wir im Notbetrieb?
         JP       LUFTH2            ; JA, DANN FESTE 35%
         LD       A,ABWOF           ; DIFFERENZ SOLL/ISTWERT HOLEN
         IFBIT    7,A               ; DIFF. NEGATIV ?
         JP       LUEFT0            ; DIFF<0
         JP       LUEFT1            ; DIFF>0
LUEFT0:  IFGT     A,LKENNL          ; DIFF.>BEREICH MIN. KUEHLBETRIEB
         JP       LUEFT2            ; JA, DANN
         JP       LUFTCL            ; NEIN, DANN KUEHLEN
LUEFT1:  IFGT     A,LKENNL+1        ; DANN VIELLEICHT > MIN.BEREICH HEIZBETRIEB
         JP       LUFTH1            ; JA, DANN HEIZEN
                                    ; NEIN, DANN SIND WIR IM TAL
LUEFT2:  LD       A,LKENNL+4        ; SONST MIN. LUEFTERDREHZAHL
         JP       LUFTH2            ;  EINSTELLEN
;
;        
LUFTH1:  LD       B,#LKENNL+1       ; ZEIGER AUF KENNLINIE
         JSR      KENNLI            ; WERT AUS KENNLINIE BERECHNEN
         IFGT     A,LKENNL+5        ; IST ERRECHNETE DREHZAHL > MAX.DREHZAHL 
         LD       A,LKENNL+5        ; JA, DANN BEGRENZEN         
                                    ; 
LUFTH2:  
         X        A,WORK+3          ; DERHZAHL ZWISCHENSPEICHERN
         JP       LUFTAT            ; ERRECHNETE LUEFTERDREHZAHL EINSTELLEN
;
LUFTCL:  LD       B,#LKENNL         ; B-POINTER AUF LUEFTERKENNLINIE
         JSR      TAUSCH            ; KNICKPUNKT AUSTAUSCHEN
         LD       A,ABWOF           ; DIFFERENZ NOCHMAL HOLEN
         JSR      KENNLI            ; WERT AUS KENNLINIE HOLEN
;         IFBIT    KOMPON,REGEXT     ; LAEUFT DER KOMMPRESSOR ?   
;         JP       LUFTC1            ; JA, DANN MAX.DREHZAHL=100%
         IFGT     A,LKENNL+5        ; IST ERRECHNETE DREHZAHL > MAX.DREHZAHL
         LD       A,LKENNL+5        ; JA, DANN BEGRENZEN         
LUFTC1:  X        A,WORK+3          ; DREHZAHL KURZ ZWISCHENSPEICHERN
         LD       B,#LKENNL         ; B-POINTER AUF LUEFTERKENNLINIE
         JSR      TAUSCH            ; KNICKPUNKT ZURUECKTAUSCHEN

LUFTAT:  LD       A,AUSSEN          ; AUSSENTEMPERATUR HOLEN
         IFGT     A,ATALXK          ; IST SIE GROESSER ALS KNICKPUNKT ?
         JP       LUFTA9            ; JA, DANN KEINE VERAENDERUNG
         SC                         ; NEIN, DANN AUSSENTEMP.ABHAENGIGE OFFSET
         LD       A,ATALXK          ; KNICKPUNKT HOLEN
         SUBC     A,AUSSEN          ; XK-X BILDEN -> IMMER POSITIV
         LD       B,#WORK           ; POINTER AUF RECHENREGISTER
         X        A,[B+]            ; (XK-X) NACH WORK
         LD       A,ATALST          ; STEIGUNG HOLEN (0<M<1)
         X        A,[B-]            ; UND INS RECHENREGISTER STECKEN
         JSR      RMULT             ; M*(XK-X)
         LD       A,[B]             ; 8-BIT ERGEBNIS HOLEN
         RC
         ADC      A,WORK+3          ; OFFSET AUF DREHZAHL ADDIEREN
         IFC                        ; UEBERLAUF ?
         LD       A,#0FF            ; JA, DANN BEGRENZEN
         JP       LUFPWM            ; UND DREHZAHL EINSTELLEN

LUFTA9:  X        A,WORK+3          ; DERHZAHL WIEDER HOLEN

LUFPWM:  JSR      PWM               ; ERRECHNETE LUEFTERDREHZAHL EINSTELLEN
         RET                        ; UND RAUS
;
TAUSCH:  X        A,[B+]            ; \
         X        A,[B-]            ;  | SPEICHERZELLEN AUSTAUSCHEN
         X        A,[B+]            ; /
         RET                        ; A BLEIBT ERHALTEN, B=B+1
;
;
;
;        ****************************************************************
;        *                                                              *
;        *                  UP ZUHEIZ                                   *
;        *                                                              *
;        * PROGRAMM FUER ZUSATZHEIZUNGSBETRIEB                          *
;        *                                                              *
;        * LUEFTERDREHZAHL WIRD                                         *
;        * ENTSPRECHEND KENNLINIEN 2 + 3 GESTEUERT                      *
;        *                                                              *
;        * BENUTZTE REGISTER: A,B                                       *
;        * EINGABE          : ABWOF,LFT   ,LUEFTERKENNLINIE 3           *
;        * AUSGABE          : LUEFTERDREHZAHL UEBER UP-PWM              *
;        * VERAENDERT       : A,B,COUNT,R5                              *
;        *                                                              *
;        ****************************************************************
;
ZUHEIZ:  IFBIT    SILAIN,REGEXT     ; IST SILA NOCH AN VOM INITIALISIEREN
         RET                        ; JA, DANN RAUS
;         
         IFBIT    ZHZON,REGEXT      ; VORWAHLUHR ANGESCHALTET ?
         JP       ZHEIZB            ; JA, DANN ABER LOS
         RET                        ; SONST RAUS
;         
ZHEIZB:  IFBIT    ZHBETR,REGRGL     ; SIND DIE PARAMETER SCHON GELADEN
         JP       ZHEIZG            ; JA, DANN WILLI GO                 
         RET                        ; SONST RAUS
;         
ZHEIZG:  
         LD       B,#FLAG02         ; B-POINTER AUF FLAG02 SETZEN         
         LD       A,ABWOF           ; DIFFERENZ SOLL/ISTWERT HOLEN
         IFBIT    7,A               ; IST DIFFERENZ NEGATIV?
         JP       COOL              ; JA, DANN KUEHLEN
         RBIT     TV1,[B]           ; FALLS MAN GERADE VORHER GEKUEHLT HAT
         RBIT     TV2,[B]           ;  MUESSEN DIE VERZOEGERUNGSZEITEN
         RBIT     TV3,[B]           ;  GEENABELT WERDEN
         LD       SECTIM,#0         ;
         IFGT     A,LKENNL          ; NEIN, DANN VIELLEICHT GROESSER ALS MIN.BEREICH
         JP       ZHEIZ1            ; JA, DANN 
         LD       A,LKENNL+3        ; SONST MIN. LUEFTERDREHZAHL
         JP       ZHEIZ2            ;  EINSTELLEN
;
ZHEIZ1:  LD       B,#LKENNL         ; ZEIGER AUF KENNLINIE
         JSR      KENNLI            ; WERT AUS KENNLINIE BERECHNEN
         IFGT     A,LKENNL+1        ; IST ERRECHNETE DREHZAHL > MAX.DREHZAHL
         LD       A,LKENNL+1        ; JA, DANN BEGRENZEN
ZHEIZ2:  JSR      PWM               ; SONST ERRECHNETE LUEFTERDREHZAHL EINSTELLEN
         RET                        ; UND RAUS
;
COOL:    IFEQ     SECTIM,#0         ; IST TVX ABGELAUFEN
         JP       COOL0             ; DANN FRAGEN WIR UNS WELCHER TV
         RET                        ; NEIN, DANN RAUS
;        
COOL0:   IFBIT    TV1,[B]           ; LIEF TV1 ?
         JP       COOL1             ; JA
         IFBIT    TV2,[B]           ; LIEF TV2 ?
         JP       COOL2             ; JA
         IFBIT    TV3,[B]           ; LIEF TV3 ?
         JMP      COOL3             ; JA
         LD       A,LKENNL+4        ; TV1 STARTEN
         X        A,SECTIM
         SBIT     TV1,[B]           ; SONST TV1 FLAG SETZEN
         CLR      A
         JSR      PWM               ; LUEFTER STOPPEN
         RET                        ;  UND RAUS
;         
COOL1:   RBIT     TV1,[B]           ; TV1 ABGELAUFEN
         SBIT     TV3,[B]           ; TV3 STARTEN
         LD       A,#VERZ3
         X        A,SECTIM
         LD       A,LFT             ; NORMIERTE LUFTAUSTRITTSTEMPERATUR HOLEN
         ADD      A,LKENNL+5        ; DELTAT HINZUADDIEREN
         X        A,LFTALT          ; UND SPEICHERN
         RET                        ; UND RAUS
;
COOL2:   RBIT     TV2,[B]           ; TV2 ABGELAUFEN
         SBIT     TV1,[B]           ; TV1 WIEDER STARTEN
         LD       A,LKENNL+4
         X        A,SECTIM
         CLR      A
         JSR      PWM               ; LUEFTER ANHALTEN
         RET           
;
COOL3:   LD       A,LFT             ; NORM. LUFTAUSTRITTSTEMP. HOLEN
         IFGT     A,LFTALT          ; ISTTEMP.>ISTALT+DELTAT?
         JP       COOL4             ; JA, DANN TV2 STARTEN
         LD       A,PWMALT          ; ALTEN LUEFTERZUSTAND HOLEN
         ADD      A,#2              ; 2% MEHR
         X        A,PWMALT          ; WIEDER SICHERN
         LD       A,PWMALT          ; UND LEIDER NOCHMAL HOLEN
         IFGT     A,LKENNL+3        ; IST MIN. LUEFTERDREHZAHL ERREICHT
         JP       COOL4             ; JA, DANN
         JSR      PWM               ; LUEFTER ANSTEUERN
         LD       A,#VERZ3          ; TV3 NEU STARTEN
         X        A,SECTIM
         RET                        ; UND RAUS
;  
COOL4:   RBIT     TV3,[B]           ; TV3 STOPPEN
         SBIT     TV2,[B]           ; TV2 STARTEN
         LD       A,#VERZ2
         X        A,SECTIM
         RET
;         
;
;
;       **************************************************************
;       * Name:         MESTEC                                       *
;       * Funktion: Senden von Daten an die Messtechnik              *
;       *           6 Bytes (aus Zeitgruenden !)                     *
;       *                                                            *
;       * Input:    -                                                *
;       *                                                            *
;       * Output:   -                                                *
;       *                                                            *
;       * Veraendert: A, COUNT, COUNT1, MESCNT                       *
;       *                                                            *
;       **************************************************************
MESTEC: DRSZ    MESCNT
        JMP      MESTC9         ;Messtechnik nur alle 25 Umlaeufe 
        LD      MESCNT,#25      ;Messtechnikausgebezaehler neu laden !
        IFBIT   T2ENA,T2CNTRL   ; NUR AUSGEBEN WENN NICHT GEMESSEN WIRD
        JMP      MESTC9
        IFBIT   T2ENB,T2CNTRL
        JMP      MESTC9
;       
        LD      ADRESS,#EEMEST  ; RAM-ADRESSEN AUS EEPROM HOLEN
MESTC7: JSR     READ
        LD      A,RDATL
        IFEQ    A,#0            ;IST ERSTE ADRESSE = 0 ?
        JP      MESTC8          ;JA, DANN KEINE MESSTECHNIKAUSGABE
        X       A,X
        LD      A,[X]           ;Auszugebende Daten in Akku 
        JSR     MXDAT           ;
;
        LD      A,RDATH
        X       A,X
        LD      A,[X]           ;Auszugebende Daten in Akku 
        JSR     MXDAT           ;        
        LD      A,ADRESS        ; EEPROM ADRESSE
        INCA                    ;  INKREMENTIEREN
        IFGT    A,#EEMEST+2     ; ENDE ERREICHT ?
        JP      MESTC8
        X       A,ADRESS
        JP      MESTC7
;
;       
MESTC8: 
MESTC9: RET
;
;
MXDAT:  LD      COUNT,#10       ;10 Bit's ausgeben 
        RC
        JP      MXDAT2          ;Startbit ausgeben
MXDAT1: SC                      ;Stopbits nachschieben
        RRC     A
MXDAT2: IFNC    
        JP      MXDAT3          ;ne Null ausgeben !     
;
        NOP                     ;wegen der Datensymetrie (JP = 3 Zyklen)
        NOP                     ;da ein geskippter Befehl nen NOP darstellt
;       RBIT    7,PORTLD        ;ne 1 raus !
        SBIT    KLOUT,PORTGD
        JSR     TXDEL           ;Delay! 
        DRSZ    COUNT
        JP      MXDAT1          ;noch nicht alle durch !
        RET                     ;
;
MXDAT3: 
;       SBIT    7,PORTLD        ;ne 0 ausgeben !
        RBIT    KLOUT,PORTGD
        JSR     TXDEL           ;Delay !(etwas laenger, da kein JP)
MXDAT4: DRSZ    COUNT           ;Bit-Zaehler einen runter
        JP      MXDAT1          ;noch nicht alle durch !
        RET
;
;.......Von einen zum naechsten RBIT/SBIT durchlaeuft das Programm 19 Zyklen
;       die restliche Zeit muss vom UP ausgeglichen werden !
;       Bitdauer fuer  9600 Baud: 104 usec 
;       Bitdauer fuer 10400 Baud:  96 usec
;               Gesamtzyklenzahl = 12 + (COUNT-1)*6 + NOP's
;
;                                                           ~~~~~~~~~~~
;       Bsp. COP888CF/5Mhz - Zyklenzeit 2 usec
;               daraus folgt: UP-Dauer = 29 Zyklen (COUNT1=3) + 5 NOP
;                                                  ~~~~~~~~~~
TXDEL:  LD      COUNT1,#B10KB   ;Delaytime fuer 10400 Baud      3 Zyklen
TXDEL1: DRSZ    COUNT1          ;                               3 Zyklen
        JP      TXDEL1          ;Ablaufen lassen              3(1)Zyklen
        NOP
;        RET                     ; RETURN FUER 10400 BAUD
        NOP                     ; EVTL.
        NOP                     ; Ausgleich fuer andere Frequenzen
        NOP
        NOP                     ;       
        NOP                     ;                               5 Zyklen
        RET                     ; RETURN FUER 9600 BAUD
        NOP
        NOP
;
;
;
         .FORM
;       **************************************************************
;       * Name:         R5BAUD                                       *
;       * Funktion: Abtasten der L-Leitung und Empfang einer         *
;       *           5-Baud-Adresse und 1,8 s Low fuer Diagnose       *
;       *           2 s Low fuer Blinkcodeausgabe                    * 
;       *           2 s Low bei Zuendung Ein zum Fehlerspeicher      *
;       *           loeschen                                         *
;       *           (Fuer Abtastung der K-Leitung muss entsprechend  *
;       *            PORTLP gegen PORTGP ausgetauscht werden und     *
;       *            drei RRCA-Befehle muessen wegfallen.)           *   
;       *                                                            *
;       * Input:                                                     *
;       *                                                            *
;       * Output:                                                    *
;       *                                                            *
;       * Veraendert: A,R8,R9,RXDATA,BAUD5(FLAG01)                   *
;       *                                                            *
;       **************************************************************
;
R5BAUD:  LD       B,#RXDATA                  ; Pointer setzen !
         IFBIT    BAUD5,FLAG01               ; WIRD SCHON MIT 5BAUD EMPFANGEN?
         JP       R5BOD1                     ; JA
         IFBIT    LLIN,PORTGP                ; NEIN, DANN KOMMT VIELLEICHT JETZT WAS
         RET                                 ; NEE, IMMER NOCH NICHT

         SBIT     BAUD5,FLAG01               ; FLAG SETZEN, DA EMPFANGEN WIRD
         CLRA
         X        A,[B]                      ; ZWISCHENSPEICHER LOESCHEN
         LD       R8,#(2000/(41*TC))/2       ; PROGRAMMZYKLENZAEHLER AUF HALBBIT
         LD       R9,#00A                    ; 10 BITS EMPFANGEN
         RET
         
R5BOD1:  DRSZ     R8                         ; SCHON DRAN?
         RET                                 ; NEIN
;        
         RC 
         IFBIT    LLIN,PORTGP                ; PROBE VON L-LEITUNG
         SC                                  ;\
         LD       A,[B]                      ; DAS BIS JETZT EMPFANGENE
         RRCA                                ; CARRY REINSCHIEBEN
         X        A,[B]                      ; UND ZURUECKSCHREIBEN
         DRSZ     R9                         ; LETZTES BIT ?
         JP       R5BOD2                     ; NEIN
         JP       LSTBIT                     ; JA
R5BOD2:  LD       R8,#(2000/(41*TC))         ; PROGRAMMZYKLEN BIS ZUM NAECHSTEN BIT
         RET                                 ; \ 4096*TC /
         
LSTBIT:  RBIT     BAUD5,FLAG01               ; 5 BAUD FLAG RUECKSETZEN
         LD       A,[B]                      ; ADRESSE HOLEN
         RLCA                                ; EINEN ZUREUCKDREHEN WG. STOPBIT
         IFNC                                ; KEIN STOPBIT ?
         JP       R5BOD3                     ; DANN WARS KEINE 1.8 S INITIALISIERUNG
;        
         IFEQ     A,#000                     ; BIN ICH GEMEINT ?
         JMP      SERVIC                     ; JA, DANN S E R V I C E
         X        A,[B]                      ; ERSTMAL SICHERN
         LD       ADRESS,#ECUADR             ; EEPROM ADRESSE LADEN
         JSR      READ                       ; EEPROM LESEN
         LD       A,RDATL                    ; IN LOWBYTE STEHT ECUADRESSE
         IFEQ     A,[B]                      ; MIT EMPFANGENER VERGLEICHEN
         JMP      SERVIC                     ; WENN GLEICH, DANN S E R V I C E
         RET                                 ; NEIN, DOCH NICHT
;
R5BOD3:                                      
                                        ; Vielleicht Blinkcode gewÅnscht
         IFEQ     A,#0                  ; mindestens 2 s auf Low?
         JP       R5BOD4                ; ja, dann Blinkcodeausgabe oder Clear
         RET                            ; nein, dann raus
R5BOD4:
         IFBIT    SILAIN,REGEXT         ; ist SiLa noch an vom 2 s Lampentest?
         JP       CLEARF                ; ja, dann Fehlerspeicher loeschen
         JMP      BLINKC                ; sonst Blinkcodeausgabe
;
;
;       **************************************************************
;       * Name:     CLEARF                                           *
;       * Funktion: Fehlerspeicher loeschen                          *
;       *                                                            *
;       *                                                            *
;       * Input:                                                     *
;       *                                                            *
;       * Output:                                                    *
;       *                                                            *
;       * Veraendert: A                                              *
;       *                                                            *
;       **************************************************************
;
CLEARF:
        LD      ADRESS,#FEHLSP
        JSR     EWEN
        JSR     ERASE
        LD      ADRESS,#FEHLSP+1
        JSR     ERASE
        JSR     EWDS
        RET
;
;
;
;       **************************************************************
;       * Name:         BLINKC                                       *
;       * Funktion: Fehlernummernanzeige mittels Blinkcode           *
;       *                                                            *
;       *                                                            *
;       * Input:                                                     *
;       *              
;       * Output:                                                    *
;       *                                                            *
;       * Veraendert: A                                              *
;       *                                                            *
;       **************************************************************
;
BLINKC:                             ; erstmal alles ausschalten
        SBIT     DIAGNO,FLAG01      ; damit in UP PWM nicht gefiltert wird
        LD       A,#000
        JSR      PWM               ; LUEFTER STOPPEN
        LD       B,#PORTD          ; POINTER LADEN
        SBIT     KOMREL,[B]        ; KOMPRESSOR AUSSCHALTEN
        RBIT     SILA,PORTLD       ; SILA AUSSCHALTEN
        LD       A,#0AA            ; MASKE fuer Stepper
        OR       A,[B]             ; NUR DIE BENUTZTEN BITS WERDEN NULL
        X        A,[B]             ; HIER WIRD STEPPER STROMLOS GESCHALTET

        LD       FLAGBC,#0         ; Flagregister loeschen
        LD       FEHLNR,#0          ; Fehlernummer Null

        LD       B,#ERBUFF+3        ; Anfangsadresse RAM
        LD       ADRESS,#FEHLSP+1   ; Endadresse Fehlerspeicher EEPROM
        LD       COUNT,#2           ; Anzahl zulesender Worte 
        JSR      EEINIT             ; lesen

        LD       B,#TMR2LO         ; POINTER SETZEN
        LD       [B+],#TBBCL       ; T2 LBYTE     \
        LD       [B+],#TBBCH       ; T2 HBYTE      |
        LD       [B+],#TBBCL       ; T2 RA LBYTE   | Timer
        LD       [B+],#TBBCH       ; T2 RA HBYTE   | auf 100 ms 
        LD       [B+],#TBBCL       ; T2 RB LBYTE   | Zeitbasis
        LD       [B+],#TBBCH       ; T2 RB HBYTE  /
        LD       T2CNTRL,#090      ; TIMER2 STARTEN IN MODE1
         
        LD       R0,#0FF            ; Timer erstmal auf Maximum
BLINK0: IFBIT    T2PNDA,T2CNTRL     ; Zeitbasis 100 ms               
        JP       BLINK1             ;
        JP       BLINK0             ;
BLINK1: RBIT     T2PNDA,T2CNTRL     ; alle 100 ms landen wir hier
        LD       WDSVR,#KEYWRD      ; Hallo Wachhund
         
        LD       B,#FLAGBC          ; Pointer setzen
        LD       A,#TIMASK          ; Maske fuer Zeitflags
        AND      A,[B]              ; nur die Zeitflags
        IFNE     A,#0               ; laeuft irgendeine Zeit?
        JP       BLINK6             ; dann L-Leitung nicht abfragen
                                                           
        IFBIT    LLIN,PORTGP        ; L-Leitung auf High?
        JP       BLINK4             ; ja, dann mal sehen
        RBIT     LSTAT,[B]          ; nein, dann merken
        JP       BLINK0             ; und warten
BLINK4:
        IFBIT    LSTAT,[B]          ; war die L-Leitung vorher High?
        JP       BLINK5             ; ja, dann mal sehen was dran ist
                                    ; nein, L-Leitung war auf Masse
        LD      A,FEHLNR            ; Fehlernr. (Bitposition) laden
        IFEQ    A,#33               ; letzte Bitposition schon erreicht?
        JP      BLINK0              ; dann nix mehr machen
        
                                    ; dann gehts jetzt los
        LD      [B],#0              ; sicherheitshalber Flags loeschen
        SBIT    LSTAT,[B]           ; L-Leitung high merken
        SBIT    TIME3S,[B]          ; 3 s Flag setzen
        RBIT    BCTIOT,[B]          ; Timeout stoppen
        LD      R0,#30              ; 3 s einstellen
        JP      BLINK0
BLINK5:
        IFBIT   BCTIOT,[B]          ; laeuft der Timeout schon?
        JP      BLINK6              ; ja, dann Timer dekrementieren
        SBIT    BCTIOT,[B]          ; Timeout starten
        LD      R0,#0FF
        JP      BLINK0              ; und rum
        
BLINK6:         
        SBIT     LSTAT,[B]          ; L-Leitung high merken
        DRSZ     R0                 ; 100 ms abziehen
        JP       BLINK0             ; Zeit noch nicht um
;
        IFBIT   TIME3S,[B]          ; ist gerade die Startzeit abgelaufen?
        JP      BLNK10              ; ja, dann neuen Fehler ausgeben
;
        IFBIT   TIZST,[B]           ; ist gerade ein Zehner abgelaufen?
        JMP     BLNK20              ; ja, dann erstmal Pause
;
        IFBIT   TIPZZ,[B]           ; ist gerade eine Zehnerpause abgelaufen?
        JMP     BLNK30              ; ja, dann naechsten Zehner ausgeben
;
        IFBIT   TIPZE,[B]           ; ist gerade Pause zw. Z.u.E. abgelaufen?
        JMP     BLNK40              ; ja, dann jetzt Einer ausgeben
;
        IFBIT   TIEST,[B]           ; ist gerade ein Einer abgelaufen?
        JMP     BLNK50              ; ja, dann erstmal Pause ausgeben
;
        IFBIT   TIPEE,[B]           ; ist gerade eine Einerpause abgelaufen?
        JMP     BLNK60              ; ja, dann naechsten Einer ausgeben
;                                   t
        IFBIT   BCTIOT,[B]          ; lief der Timeout
        JMP     START               ; dann gibts einen Warmstart
                                    ; fuer den Fall das nix passier
        JP      BLINK0              ; und rein in die Endlosschleife
;
BLNK10:                             ; neuen Fehler ausgeben
        RBIT    TIME3S,[B]          ; Startzeit zuende
BLNK12:
        LD      A,FEHLNR            ; Fehlernr. (Bitposition) laden
        INC     A                   ; dann inkrementieren
        X       A,FEHLNR     
        LD      X,#ERBUFF+3         ; x-Pointer auf Fehlerbytes
        SC
        LD      COUNT,#4            ; maximal 4 Fehlerbytes
BLNK15:
        LD      A,[X]               ; Fehlerbyte holen
        RRC     A                   ; nach rechts durchs Carry schieben
        X       A,[X-]              ; zurueckschreiben und Pointer dekrement.
        DRSZ    COUNT               ; das machen wir 4 Mal
        JP      BLNK15
        IFNC                        ; ein Fehlerbit gefunden?
        JP      BLNK18              ; ja, dann ausgeben
        IFEQ    FEHLNR,#33          ; nein, dann auf Abbruch (Nr = 33) pruefen
        JP      BLINK0              ; kein Fehler (mehr) gespeichert, Abbruch
        JP      BLNK12              ; weitersuchen

BLNK18:
        LD      A,FEHLNR            ; Fehlernummer holen
        X       A,BCBUFF            ; und in Buffer schreiben
        LD      A,FEHLNR            ; nochmal wiederholen
        IFGT    A,#9                ; Fehlernummer > 9?
        JP      BLNK30              ; ja, dann zuerst Zehner ausgeben
        JMP     BLNK40              ; nein, dann gleich Einer ausgeben

BLNK20:                             ; Pause nach Zehner
        RBIT    TIZST,[B]
        RBIT    SILA,PORTLD         ; SILA AUSSCHALTEN
        LD      A,BCBUFF            ; den Rest der Fehlernummer holen
        IFGT    A,#9                ; Fehlernummer > 9?
        JP      BLNK25              ; ja, dann Zehnerpause ausgeben
        JP      BLNK35              ; sonst Zehner/Einerpause starten
BLNK25:
        SBIT    TIPZZ,[B]           ; Pause zwischen Zehnern
        LD      R0,#10              ; auf 1 s setzen
        JP      BLINK0              ; und rum
 
BLNK30:                             ; ggf. naechsten Zehner ausgeben
        RBIT    TIPZZ,[B]           ; Zehnerpause ist zuende
        LD      A,BCBUFF            ; Fehlernummer holen
        SC
        SUBC    A,#10               ; 10 abziehen
        IFNC                        ; Ergebnis kleiner 0
        JP      BLNK35              ; ja, dann Zehner/Einer-Pause
        SBIT    SILA,PORTLD         ; sonst SILA EINSCHALTEN
        X       A,BCBUFF            ; Rest in Buffer zurueckschreiben
        SBIT    TIZST,[B]           ; Zeit fuer Zehnerstelle
        LD      R0,#20              ; 2 s fuer eine Zehnerstelle
        JP      BLINK0              ; und wieder rum
BLNK35:
        SBIT    TIPZE,[B]           ; Zeit fuer Zehner/Einer-Pause
        LD      R0,#30              ; 3 s fuer eine Pause
        JP      BLINK0              ; und wieder rum
         
BLNK40:                             ; anfangen Einer ausgeben
        RBIT    TIPZE,[B]           ; Zeit fuer Zehner/Einer-Pause zuende
        JP      BLNK60

BLNK50:                             ; Pause nach Einer
        RBIT    TIEST,[B]           ; Einer ist zuende
        RBIT    SILA,PORTLD         ; SILA AUSSCHALTEN
        LD      A,BCBUFF            ; Fehlernummer holen
        IFEQ    A,#0                ; kein Einer mehr da?
        JMP     BLINK0              ; ja, dann fertig
        SBIT    TIPEE,[B]           ; Zeit fuer Einer-Pause
        LD      R0,#10              ; auf 1 s setzen
        JP      BLINK0              ; und rum
 
BLNK60:                             ; naechsten Einer ausgeben
        RBIT    TIPEE,[B]           ; Einerpause ist zuende
        LD      A,BCBUFF            ; Fehlernummer holen
        IFEQ    A,#0                ; kein Einer mehr da?
        JMP     BLINK0              ; ja, dann fertig
        SBIT    SILA,PORTLD         ; SILA EINSCHALTEN
        DEC     A                   ; Einer dekrementieren
        X       A,BCBUFF            ; Rest in Buffer zurueckschreiben
        SBIT    TIEST,[B]           ; Zeit fuer Einerstelle
        LD      R0,#5               ; 0.5 s fuer eine Einerstelle
        JP      BLINK0              ; und wieder rum
;
;
;
;
;------------------------------------------------------------------------------
;
;
;       **************************************************************
;       *                                                            *
;       *               SERVICE BEFEHLS-ROUTINEN                     *
;       *                                                            *
;       * ************************************************************
;
;
;
;------- EEPROM SPEICHERZELLE WIRD GELESEN -------------
RPROMR:  
         LD       A,[B]             ; Befehl holen
         AND      A,#X'3F           ; Ausblenden des Lesebefehls
         X        A,ADRESS          ; EEPROM Adresse in den Akku
         JSR      READ              ; EEPROM LESEN
         LD       A,RDATH           ; GELESENES HIGH-BYTE
         JSR      TXDAT             ;  AUSGEBEN (MSB first)
         LD       A,RDATL           ; GELESENES LOW-BYTE
         JSR      TXDAT             ;  AUSGEBEN
         JMP      RECEIV            ; AUF NAECHSTEN BEFEHL WARTEN
;
;
;------- ADRESSIERTE EEPROM SPEICHERZELLE WIRD BESCHRIEBEN -------------
WPROMR:  LD       A,[B+]            ; Zeiger auf RXBUFF+1
         JSR      RXDAT             ; \ 
         X        A,[B+]            ;  |die Daten fuer's EEPROM einlesen
         JSR      RXDAT             ;  |und im Speicher merken !
         X        A,[B+]            ; /
         LD       B,#RXBUFF         ; DORT steht die Adresse drin
         LD       A,[B+]            ; ADRESSE HOLEN
         AND      A,#X'3F           ; Ausblenden des Schreibbefehl
;        
;wenn hier das Statusbit gesetzt ist, dann  sind die Adresse 0-7 
;gesperrt !!!! 
         IFGT     A,#EEWDEN         ; LIEGT ADRESSE AUSSERHALB GESCHUETZTEM BEREICH?
         JP       WPROM2            ; JA, DANN WEITER
         IFBIT    STATUS,FLAG01     ; NEIN, SIND WABCODATEN SCHON EINGECHRIEBEN
         JMP      RECEIV            ; JA, DANN BEFEHL IGNORIEREN
WPROM2:  X        A,ADRESS          ;  UND ABLEGEN
         LD       A,[B+]            ; MSB-DATA HOLEN
         X        A,WDATH           ;  UND ABLEGEN
         LD       A,[B+]            ; LSB-DATA HOLEN
         X        A,WDATL           ;  UND ABLEGEN
         JSR      EWEN              ; ERASE/WRITE ENABLE
         JSR      ERASE             ; ERST SPEICHERSTELLE LOESCHEN !!!
         JSR      WRITE             ; DANN SCHREIBEN
         JSR      EWDS              ; ERASE/WRITE DISABLE
         JMP      RECEIV            ; warten auf naechstes Befehl
;
;
;-------   E c h o b e f e h l  ----------------------------------------
ECHOR:
         JSR      RXDAT             ; das zu "echoende" Byte empfangen
         JSR      TXDAT             ; und zurueckschicken !
         JMP      RECEIV            ; warten auf naechsten Befehl
;
;
;------- SCHRITTMOTOR POSITIONIEREN ------------------------------------
MSTEPR:
         JSR      RXDAT             ; Position von Diagschnittstelle lesen
MSTEP1:  
;?????? IFBIT    REFEND,REGEXT     ; IST REFERENZFAHRT SCHON BEENDET ?
         JP       DO00C             ; JA, DANN AB DIE POST
         JP       MSTEP1            ; NEIN, DANN WARTEN       
DO00C:   JSR      STPBER            ; berechnen der Stepperposition
         JMP      RECEIV            ; und das war's schon
;
;------- Normierte Temperaturen (Innen/Soll) lesen ----------------------
SENS0R:  JSR      MESSEN            ; Alles messen
         JSR      MESSER            ; auch die Sollwertgeber
         JSR      NORMI             ; und normieren
         LD       A,SOLTEM          ;
         JSR      TXDAT             ;
         LD       A,INNEN           ;
         JSR      TXDAT             ; raus damit
         JMP      RECEIV            ; und auf den naechsten Befehl warten
;
;
;------- Normierte Temperaturen (Luftaustritt/Aussen) lesen----------------
SENS2R:  JSR      MESSEN            ; Alles messen
         JSR      NORMI             ; und normieren
         LD       A,LFT             ;
         JSR      TXDAT             ;
         LD       A,AUSSEN          ;
         JSR      TXDAT             ; raus damit
         JMP      RECEIV            ; und auf den naechsten Befehl warten
;
;
;------- Normierte Werte (Geblaesesoll/Endschalter) lesen----------------
SENS4R:  JSR      MESSEN
         JSR      MESSER            ; messen
         JSR      NORMI             ; und normieren
         LD       A,VEREIS          ;
         JSR      TXDAT             ;
         LD       A,SWITCH          ;
         JSR      TXDAT             ; raus damit
         JMP      RECEIV            ; und auf den naechsten Befehl warten
;
;
;------- Normierte Werte (Versorgungsspannung/Zhz-Heiz>) lesen ----------
SENS8R:  JSR      MESSEN
         JSR      MESSER            ; Messen
         LD       A,ADKL15          ; 
         JSR      TXDAT             ;
         LD       A,SWITCH          ; Schalterflagregister
         JSR      TXDAT             ; raus damit
         JMP      RECEIV            ; und auf den naechsten Befehl warten
;
;
;------- Eingangsport 0 lesen -----------------------------------------
INPU0R:  LD       A,PORTCP
         JSR      TXDAT             ; raus damit !
         JMP      RECEIV            ; warten auf naechsten Befehl
;
;         
;------- Eingangsport 1 lesen -----------------------------------------
INPU1R:  LD       A,PORTGP
         JSR      TXDAT             ; raus damit
         JMP      RECEIV            ; warten auf naechsten Befehl
;
;         
;------- Eingangsport 2 lesen -----------------------------------------
INPU2R:  LD       A,PORTLP
         JSR      TXDAT             ; raus damit
         JMP      RECEIV            ; warten auf naechsten Befehl
;
;
;-------  Softwareversionsnummer lesen
INPU3R:  LD       A,#VERSNR
         JSR      TXDAT             ; raus damit
         JMP      RECEIV            ; warten auf naechsten Befehl
;
;
;-------  Ausgangsport 0 beschreiben ------------------
OUTP0R:  JSR      RXDAT             ; empfangen Byte fuer Port
         X        A,PORTD           ; und einschreiben 
         JMP      RECEIV            ; warten auf naechsten Befehl
;
;
;-------  Ausgangsport 1 beschreiben ------------------
OUTP1R:  JSR      RXDAT             ; empfangen Byte fuer Port          
         AND      A,#X'80           ; nur Bit 7 veraenderbar !
         X        A,PORTLD          ; rein damit
         JMP      RECEIV            ; warten auf naechsten Befehl
;
;         
;-------  Ausgangsport 2 beschreiben (PWM) ------------
OUTP2R:  JSR      RXDAT             ; Duty Cyle empfangen
         JSR      PWM               ; UND IN PWM ROUTINE UEBERGEBEN         
         JMP      RECEIV
;
;
;-------  Statusbit im RAM loeschen (WABCO-Daten schreiben) ----------
OUTP9R:  RBIT     STATUS,FLAG01     ; STATUSBIT RUECKSETZEN
         JMP      RECEIV
;
;
;        ****************************************************************
;        *                                                              *
;        *                          UP TXDAT                            *
;        *                                                              *
;        *        BYTE AUSGEBEN AUF K-LEITUNG                           *
;        *                                                              *
;        *        EINGABE :            A: ZU UEBERTRAGENDES BYTE        *
;        *        AUSGABE : -                                           *
;        *        VERWENDETE REGISTER: A,TXDATA, R0                     *
;        *                                                              *
;        ****************************************************************
;
;

TXDAT:   IFBIT   #T0PND,ICNTRL      ; T0-Interrupt (ca. 8 msec !)
         JP       TXDAT4
         JP       TXDAT5
TXDAT4:  LD      WDSVR,#KEYWRD      ; Watchdog triggern 
         RBIT    #T0PND,ICNTRL      ; T0-PENDINGBIT ruecksetzen
;
TXDAT5:  X        A,TXDATA          ; AKKU <--> TXDATA
         CLRA                       ; AKKU LOESCHEN
         LD       R0,#10            ; 10 BITS AUSGEBEN
         SBIT     TRANSM,FLAG01     ; TRANSMISSION-FLAG SETZEN
         SBIT     BAUDFL,FLAG01     ;\
         RPND                       ; SOFTWARETRAP PENDING-FLAG RUECKSETZEN
TXSYNC:  IFBIT    BAUDFL,FLAG01     ; AUF INTERRUPT SYNCHRONISIEREN
         JP       TXSYNC            ;/
TXDAT1:  SC                         ; CARRY=1
         X        A,TXDATA          ; AKKU <--> TXDATA
         RRCA                       ; LSB INS CARRY ROTIEREN
         X        A,TXDATA          ; AKKU <--> TXDATA
         RRCA                       ; CARRY IN BIT7 ROTIEREN
         IFBIT    6,A               ; WENN BIT6=0, DANN SKIP
         JP       TXDAT2
         RBIT     KLOUT,PORTGD      ; 0 AUSGEBEN
         JP       TXDAT3
TXDAT2:  SBIT     KLOUT,PORTGD      ; 1 AUSGEBEN
         NOP                        ; FUER LAUFZEITAUSGLEICH
TXDAT3:  SBIT     BAUDFL,FLAG01     ; BAUDFLAG SETZEN    
         RPND                       ; SOFTWARETRAP PENDING-FLAG RUECKSETZEN
TXDELY:  IFBIT    BAUDFL,FLAG01     ; BAUDFL. ABFRAGEN (WIRD IN T2INTR RESETET)
         JP       TXDELY            ; WENN NOCH 1 DANN IN SCHLEIFE BLEIBEN
         DRSZ     R0                ; LETZTES BIT?
         JP       TXDAT1            ; NEIN, DANN NOCHMAL RUM
         RBIT     TRANSM,FLAG01     ; UEBERTRAGUNG BEENDET
         RET                        ; FERTIG
;
;        ****************************************************************
;        *                                                              *
;        *                  UP RXDAT                                    *
;        *                                                              *
;        * ERWARTET BYTE AUF DER K-LEITUNG                              *
;        * AUSGABE IN AKKU                                              *
;        * WENN BYTE EMPFANGEN WURDE, WIRD CARRY ZURUECKGESETZT (STARTBIT)
;        * SETZT TRERR-FLAG WENN STOPBIT FALSCH IST (KOENNTE 5 BAUD-ADRESSE SEIN)
;        * GIBT EMPFANGENES BYTE IN A UND RXDATA ZURUECK                *
;        *                                                              *
;        * BENUTZTE REGISTER: A,R0,RXDATA                               *
;        * EINGABE          : -                                         *
;        * AUSGABE          : BYTE IN A UND RXDATA                      *
;        * VERAENDERT       : TRERR-FLAG01,CARRY-PSW                    *
;        *                                                              *
;        ****************************************************************
;
RXDAT:   
         LD       R0,#9             ; 9 BITS EMPFANGEN
         CLRA
         X        A,RXDATA          ; DITO LOESCHEN
;
NIXLOS:  IFBIT   #T0PND,ICNTRL      ; T0-Interrupt (ca. 8 msec !)
         JP       RXDAT1
         JP       RXDAT2
RXDAT1:  LD      WDSVR,#KEYWRD      ; Watchdog triggern 
         RBIT    #T0PND,ICNTRL      ; T0-PENDINGBIT ruecksetzen
RXDAT2:  IFBIT    KLDATA,PORTGP     ; IST WAS LOS AUF DER K-LEITUNG?
         JP       NIXLOS            ; NEIN
;
         SBIT     #TRANSM,FLAG01    ; Transmissionflag setzen
         RBIT     T2C0,T2CNTRL      ; EVENTUELL HIER TIMER STOPPEN!
         LD       TMR2LO,#010       ; INTERRUPT MITTEN IM BIT       
         LD       TMR2HI,#000       ; TIMER LADEN ZUR SYNCHRONISATION
         SBIT     T2C0,T2CNTRL      ; GEGEBENENFALLS TIMER HIER STARTEN!
RXDAT0:  SBIT     BAUDFL,FLAG01     ; BAUDFLAG SETZEN
         RPND                       ; SOFTWARETRAP PENDING-FLAG RUECKSETZEN
RBAUD:   IFBIT    BAUDFL,FLAG01
         JP       RBAUD             ; AUF TIMER INTERRUPT WARTEN
         RC
         IFBIT    KLDATA,PORTGP     ; PROBE VON K-LEITUNG IN BIT-MITTE
         SC                         ; AUS AKKU LSBIT IN CARRY SCHIEBEN
         LD       A,RXDATA          ;  |
         RRCA                       ;  |
         X        A,RXDATA          ; UND AUS CARRY IN RXDATA
         DRSZ     R0                ; LETZTES BIT?
         JP       RXDAT0            ; NEIN, DANN NEXT ONE
         SBIT     BAUDFL,FLAG01     ; fuer Empfang Stopbit !
         RPND                       ; SOFTWARETRAP PENDING-FLAG RUECKSETZEN
         LD       A,RXDATA          ; Ergebnis in den Akku holen !
STPBIT:  IFBIT    BAUDFL,FLAG01
         JP       STPBIT            ; AUF TIMER INTERRUPT WARTEN
         RBIT     #TRANSM,FLAG01    ; Transmission-Flag ruecksetzen
         IFBIT    KLDATA,PORTGP     ; PROBE FUER STOPBIT 
         RET                        ; WENN STOPBIT=1 DANN ALLES OK
;
;........wenn Stopbitfehler kann's auch ne 5 Baud-Adresse sein, also Neustart
         JMP      START             ; JA, RAUS AUS SERVICE,5 BAUD-ADR. ERWARTEN
;
;
;-----------------------------------------------------------------------
         .FORM
;
;
;       **************************************************************
;       *                                                            *
;       *          ROUTINEN ZUR BEHANDLUNG DES EEPROMS               *
;       *                                                            *
;       * ADRESSENUEBERGABE ERFOLGT UEBER REGISTER R6                *
;       * UND DIE DER DATEN UEBER :                                  *
;       *                                                            *
;       * WDATL = WORK+1  LOWBYTE DES ZUSCHREIBENDEN 16-BIT WORTES   *
;       * WDATH = WORK    HIGHBYTE           "             "         *
;       * RDATL = WORK+1  LOWBYTE DES EINGELESENEN 16-BIT WORTES     *
;       * RDATH = WORK    HIGHBYTE           "             "         *
;       * ADRESS          EEPROM ADRESSE   X X A5 A4 A3 A2 A1 A0     *
;       * SNDBUF          ENTHAELT DAS COMMAND-BYTE, WELCHES AN DAS  *
;       *                 EEPROM GESCHICKT WIRD                      *
;       * FLAG02          FLAG ZEIGT FUNKTION FUER UP INIT AN        *
;       *            00 - ERASE, ENABLE, DISABLE, ERASE ALL          *
;       *            01 - READ                                       *
;       *            03 - WRITE                                      *
;       *                                                            *
;       * VERAENDERT: A,B,R6(ADRESS),WORK,WORK+1                     *
;       *                                                            *
;       *                                                            *
;       **************************************************************
;
;
;
;-----------------------------------------------------------------------    
;
;      * LOESCHT SPEICHERPLATZ 'ADRESS' *
;
ERASE:                              
         LD       A,ADRESS          ; AKKU MIT EEPROM-ADRESSE LADEN
         OR       A,#0C0            ; ADRESSE MIT OPCODE ODERN
         X        A,SNDBUF          ; ERGEBNIS ABLEGEN
         LD       FLAG02,#0         ; FLAG LOESCHEN
         JMP      INIT              ; ZUR AUSGABEROUTINE
;        RET                        *** STACK RAM SPAREN
;
;      * ENABLES PROGRAMMING *
;
EWEN:    
         LD       SNDBUF,#030       ; OPCODE FUER ERASE/WRITE ENABLE
         LD       FLAG02,#0
         JMP      INIT              ; AB ANS EEPROM
;        RET                        *** STACK RAM SPAREN
;
;      * DISABLES PROGRAMMING
;
EWDS:
         LD       SNDBUF,#0         ; OPCODE FUER ERASE/WRITE DISABLE
         LD       FLAG02,#0
         JP       INIT              ; WEG DAMIT
;        RET                        *** STACK RAM SPAREN
;
;      * LIEST SPEICHERPLATZ 'ADRESS' IN RDATL/H EIN *
;
READ:    
         LD       A,ADRESS          ;\
         OR       A,#080            ; | ADRESSE UND OPCODE VERBINDEN
         X        A,SNDBUF          ;/   UND ABLEGEN
         SBIT     EERDWR,FLAG02     ; FLAG AUF READ
         RBIT     EEWRIT,FLAG02     ; KEIN SCHREIBEN
         JP       INIT              ; AB ANS EEPROM
;        RET                        *** STACK RAM SPAREN
;
;      * SCHREIBT WDATL/H NACH 'ADRESS' IN DAS EEPROM *
;
WRITE:   LD       A,ADRESS          ;\
         OR       A,#040            ; | ADRESSE UND OPCODE VERBINDEN
         X        A,SNDBUF          ;/   UND ABLEGEN
         SBIT     EERDWR,FLAG02     ;
         SBIT     EEWRIT,FLAG02     ; FLAG AUF WRITE
;         JP       INIT              ; AB ANS EEPROM
;        RET                        *** STACK RAM SPAREN
;
;
;      *************************************************************
;      * DIESE ROUTINE SENDET DAS STARTBIT UND DAS COMMAND BYTE    *
;      * UND FUEHRT IN ABHAENGIGKEIT DES FLAG02 DIE SCHREIB-,LESE- *
;      * ODER LOESCH-FUNKTION AUS                                  *
;      *************************************************************
;
INIT:    
         SBIT    CSDIAG,PORTLD      ; CHIP-SELECT DIAGNOSE AUS
         LD      PORTGC,#PGMWCF     ;Configuration Port G als Microwire
         RBIT    #MWCLK,PORTGD      ;Clock auf Low !
         SBIT    #MSEL,CNTRL        ;Microwire enabled
         SBIT    CSEEPR,PORTLD      ; CHIP-SELECT EEPROM an
;
         X        A,B               ; B-POINTER
         PUSH     A                 ;  RETTEN
         LD       B,#PSW            ; POINTER LADEN
         LD       SIOR,#1           ; START-BIT LADEN
         SBIT     BUSY,[B]          ; STARTBIT SENDEN
INIT1:   IFBIT    BUSY,[B]          ; WIRD VON COP RUECKGESETZT
         JP       INIT1             ; 
         LD       A,SNDBUF
         X        A,SIOR            ; SIOR MIT COMMAND BYTE LADEN
         SBIT     BUSY,[B]          ;  UND SENDEN
INIT2:   IFBIT    BUSY,[B]
         JP       INIT2
         IFBIT    EERDWR,FLAG02     ; NOCH EINE ANDERE FUNKTION?
         JP       NOTDON            ; JO, DANN
         JMP      INIT7             ; BUSY ABFRAGEN UND ZURUECK
;
NOTDON:  IFBIT    EEWRIT,FLAG02     ; LESEN ODER SCHREIBEN, DAS IST HIER ...
         JP       WR9346            ; SCHREIBEN ...
         LD       SIOR,#000         ; LESEN ...
         SBIT     BUSY,PSW          ; DUMMY CLOCK, UM 0 ZU LESEN
         RBIT     BUSY,[B]          ; RUECKSETZEN, UM NUR EIN BIT ZUERHALTEN
         SBIT     BUSY,[B]          ; JETZT DIE EIGENTLICHEN 8 BIT HOLEN
INIT3:   IFBIT    BUSY,[B]          ; WARTEN
         JP       INIT3
         X        A,SIOR            ; HIGH-BYTE AUS SIOR ABHOLEN
         SBIT     BUSY,[B]          ; NAECHSTES BYTE EMPFANGEN
         X        A,RDATH           ; HIGH-BYTE IN REGISTER ABLEGEN
INIT4:   IFBIT    BUSY,[B]          ; WARTEN
         JP       INIT4
         LD       A,SIOR            ; LOW-BYTE AUS SIOR HOLEN
         X        A,RDATL           ; UND IN REGISTER ABLEGEN
         JP       INITRT            ; UND RAUS AUS INIT
;
WR9346:  LD       A,WDATH           ; HIGH-BYTE AUS REGISTER HOLEN
         X        A,SIOR            ; UND IN SIOR SCHREIBEN
         SBIT     BUSY,[B]          ; ZUM EEPROM SCHICKEN
INIT5:   IFBIT    BUSY,[B]          ; WARTEN
         JP       INIT5
         LD       A,WDATL           ; LOW-BYTE HOLEN
         X        A,SIOR            ; UND IN SIOR SCHREIBEN
         SBIT     BUSY,[B]          ; AB INS EEPROM
INIT6:   IFBIT    BUSY,[B]          ; UND WIEDER WARTEN
         JP       INIT6
;
INIT7:   RBIT     CSEEPR,PORTLD     ; CHIP-SELECT AUF LOW = DIAG-Baustein an
         SBIT     CSEEPR,PORTLD     ; CHIP-SELECT AUF HIGH FUER STATUS-CHECK
WAIT:    IFBIT    MWIN,PORTGP       ; EEPROM AUSGANG TESTEN
         JP       INITRT            ; WENN =1, DANN FERTIG
         JP       WAIT              ; SONST WARTEN
INITRT:  SBIT     #MWCLK,PORTGD     ; Clock auf HIGH da gleich DIAG enabled
         RBIT     CSEEPR,PORTLD     ; CHIP-SELECT WIEDER AUF LOW/DIAG enabled
         POP      A                 ; B-POINTER
         X        A,B               ; WIEDERHERSTELLEN
;
         RBIT    #MSEL,CNTRL        ;Microwire disabled
         LD      PORTGC,#PGCONFG    ;Configuration Port-G fuer Diag-Betrieb
         RBIT    CSDIAG,PORTLD      ; DIAGNOSE WIEDER AN
;
         RET
;
;
;***********************************************************************
;
;        ****************************************
;        *        Verzoegerung fuer             *     
;        *  Ausgabe Schluesselwoerter 3.5 msec  *  
;        ****************************************
DELGO:   CLR      A                 ; 2 usec/Zyklen bei 5 Mhz !
DELGO1:  IFEQ     A,#X'FF           ; 2 Zyklen
         RET                        ; if skiped = 1 Zyklus
         INC      A                 ; 1 Zyklus
         JP       DELGO1            ; 3 Zyklen
;                                   -----------
;                                     7 Zyklen * 255  -> 3.5 msec 
;
         .FORM
;************************************************************************
;*                                                                      *     
;*            INTERRUPT-ROUTINE - T2A-UNDERFLOW                         *
;*                                                                      *
;*  TIMER 2 LAEUFT MIT TB=1/BAUDRATE UND LOEST PER INTERRUPT            *
;*  ALLE TB DIESE ROUTINE AUS.                                          *
;*  DAS BAUDFLAG WIRD ZURUECKGESETZT, WODURCH DIE BAUDRATEN-            *
;*  GENERIERUNG MOEGLICH WIRD. IST DAS TRANSM-FLAG GESETZT, D.H.        *
;*  ES WERDEN BITS UEBERTRAGEN, WERDEN DIE SOFTWARE-TIMER               *
;*  IGNORIERT, UM EINE KONSTANTE LAUFZEIT DER INTERRUPT-                *
;*  ROUTINE ZU ERREICHEN.                                               *
;*  SONST WERDEN HIER IN ABHAENGIGKEIT DER TIME-OUT ENABLE FLAGS        *
;*  DIE TIME-OUT ZEITEN T0 UND T2 FUER DIE SERIELLE                     *
;*  UEBERTRAGUNG UEBERWACHT. WERDEN DIESE ZEITEN UEBERSCHRITTEN,        *
;*  WERDEN DIE FLAGS TOUT0 BZW. TOUT2 GESETZT.                          *
;*                                                                      *
;*  EBENFALLS WIRD VON HIER DER SCHRITTMOTOR BEDIENT.                   *
;*  MIT R5 WIRD DIE PAUSE ZWISCHEN ZWEI STEPS FESTGELEGT.               *
;*                                                                      *
;*  INTERRUPT-ROUTINE IST BEIM SENDEN UND EMPFANGEN INGESAMT            *
;*  67 ZYKLEN LANG (INCL. RETTEN)                                       *
;*                                                                      *
;*                                                                      *     
;************************************************************************
;
;
T2INTR:  IFBIT    TRANSM,FLAG01     ; WIRD GERADE GESENDET?
         JMP      SHORTI            ; WENN JA, DANN RAUS 
;
         DRSZ     R5                ; IST DER STEPPER DRAN ?
         JP       SHORTI            ; NEIN
         LD       R5,#10            ; EINEN STEP ALLE 8 MS
         IFBIT    #REFEND,REGEXT    ; Referenzfahrt schon bendet ?
         JP       T2INT5            ; ja, BEENDET !
;
         LD      A,#0AA             ; nein, 
         AND     A,PORTD            ;   
         IFEQ    A,#0AA             ; STEHT MOTOR STILL ?
         JSR      INITS2            ; dann Positionsregister auf Null setzen !
;
T2INT5:  JSR      STEPPR            ; SCHRITTMOTOR BEDIENEN
SHORTI:  
         RBIT     BAUDFL,FLAG01     ; FLAG FUER BAUDRATEN GENERIERUNG
         RBIT     T2PNDA,T2CNTRL    ; U. T2 PENDING-BIT RUECKSETZEN
RESTOR:
         POP      A                 ; PSW VOM STACK HOLEN
         X        A,PSW
         POP      A                 ; X VOM STACK HOLEN
         X        A,X      
         POP      A                 ; B VOM STACK HOLEN
         X        A,B               ; 
         POP      A                 ; AKKU HOLEN
         RETI               
;
;
;         
;
;***********************************************************************
;
;
STRAP:   JMP      START             ; SOLLTE MAL EIN SOFTWARE-INTERRUPT
                                    ; DURCH DEN OPCODE H00 AUSGELOEST
                                    ; WERDEN, DANN SOLL DER PROZESSOR
                                    ; NOCH EINE CHANCE BEKOMMEN
;         
;                                             

        .END START

